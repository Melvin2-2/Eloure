---
// Abschluss wie auf der Startseite: Texturfoto (Reliefwand) mit leisem Schleier, grosses Signet,
// eine Überschrift und ein Glas-Button.
import { Image } from 'astro:assets';
import { signetOne } from '../lib/signet';
import imgRelief from '../assets/shoot/detail-relief.jpg';

interface Props {
  title?: string;
  code?: string;
}
const { title = 'Bereit für glatte Haut?', code } = Astro.props;
const q = code ? `?code=${code}` : '';
---

<section class="cta-end" style={`--signet:${signetOne}`}>
  <div class="cta-img" aria-hidden="true">
    <Image src={imgRelief} alt="" widths={[1000, 1600, 2200]} sizes="100vw" />
  </div>
  <div class="cta-signet" aria-hidden="true"></div>
  <div class="cta-inner">
    <h2 class="reveal" set:html={title} />
    <a class="cta-glass reveal" href={`/termin${q}`}>Termin buchen</a>
  </div>
</section>

<style>
  .cta-end {
    position: relative;
    overflow: hidden;
    padding-block: clamp(170px, 17vw, 260px);
    background: #8c8f8f;
    color: #fff;
    --head: #fff;
  }

  .cta-img {
    position: absolute;
    inset: 0;
  }

  .cta-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    filter: contrast(0.9) saturate(0.7);
  }

  .cta-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(40, 46, 54, 0.3), rgba(40, 46, 54, 0.42)),
      rgba(78, 92, 102, 0.3);
  }

  .cta-signet {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 50%;
    width: min(64vw, 820px);
    aspect-ratio: 151 / 78;
    transform: translate(-50%, -50%);
    background-image: var(--signet);
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;
    filter: invert(1);
    opacity: 0.12;
  }

  .cta-inner {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    text-align: center;
  }

  .cta-inner h2 {
    margin: 0 0 44px;
    font-weight: 200;
    font-size: clamp(2.4rem, 5.6vw, 6.4rem);
    line-height: 1;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    color: #fff;
    text-wrap: balance;
    hyphens: manual;
    overflow-wrap: normal;
  }

  @media (max-width: 640px) {
    .cta-inner h2 {
      font-size: 8.4vw;
    }
  }

  /* Glas-Button wie die Ruhepunkt-Karte */
  .cta-glass {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 58px;
    padding: 0 40px;
    font-size: 0.88rem;
    font-weight: 450;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.55);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition:
      background 0.4s ease,
      border-color 0.4s ease;
  }

  .cta-glass:hover {
    background: rgba(255, 255, 255, 0.22);
    border-color: #fff;
  }
</style>
