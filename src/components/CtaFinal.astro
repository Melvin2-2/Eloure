---
// Abschluss im ruhigen Stil: Frost-Fläche, grosses transparentes Signet, eine Überschrift, ein Button.
import { signetOne } from '../lib/signet';

interface Props {
  title?: string;
  code?: string;
}
const { title = 'Bereit für glatte Haut?', code } = Astro.props;
const q = code ? `?code=${code}` : '';
---

<section class="cta-end" style={`--signet:${signetOne}`}>
  <div class="cta-signet" aria-hidden="true"></div>
  <div class="cta-inner">
    <h2 class="reveal" set:html={title} />
    <a class="btn btn-primary reveal" href={`/termin${q}`}>Termin buchen</a>
  </div>
</section>

<style>
  .cta-end {
    position: relative;
    overflow: hidden;
    padding-block: clamp(150px, 15vw, 220px);
    background: var(--frost, var(--salvia));
    --ink: #33363a;
    --head: #33363a;
  }

  .cta-signet {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(64vw, 820px);
    aspect-ratio: 151 / 78;
    transform: translate(-50%, -50%);
    background-image: var(--signet);
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;
    opacity: 0.08;
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    text-align: center;
  }

  .cta-inner h2 {
    margin: 0 0 44px;
  }
</style>
