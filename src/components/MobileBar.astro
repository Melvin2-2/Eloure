---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  href: string;
  label: string;
  note?: string;
}
const { href, label, note } = Astro.props;
---

<div class="mobile-bar" data-mobile-bar aria-hidden="true">
  <a class="mb-icon" href={site.whatsappHref} target="_blank" rel="noopener" tabindex="-1" aria-label="WhatsApp">
    <Icon name="whatsapp" size={22} />
  </a>
  <a class="mb-cta" href={href} tabindex="-1">
    <span class="mb-text">
      {label}
      {note && <small>{note}</small>}
    </span>
    <Icon name="arrow" size={18} />
  </a>
</div>

<style>
  .mobile-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: none;
    padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom));
    gap: 10px;
    background: rgba(43, 47, 64, 0.9);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border-top: 1px solid var(--line-light);
    transform: translateY(110%);
    transition: transform 0.45s var(--ease);
  }

  .mobile-bar.is-visible {
    transform: none;
  }

  @media (max-width: 1180px) {
    .mobile-bar {
      display: flex;
    }
  }

  .mb-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border: 1px solid var(--line-light);
    color: var(--cream);
    --head: currentColor;
  }

  .mb-cta {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    min-height: 54px;
    background: var(--lime);
    color: var(--espresso);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.94rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .mb-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .mb-text small {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    opacity: 0.8;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mobile-bar]');
  if (bar) {
    const update = () => {
      const show = window.scrollY > 500;
      bar.classList.toggle('is-visible', show);
      bar.setAttribute('aria-hidden', String(!show));
      bar.querySelectorAll('a').forEach((a) => (show ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
