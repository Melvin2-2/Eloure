---
import Icon from './Icon.astro';
import { byRegion, chf, duration, firstVisit, priceText, type Group } from '../data/services';

interface Props {
  initial?: Group;
  showFirstVisit?: boolean;
}
const { initial = 'frauen', showFirstVisit = true } = Astro.props;
const groups: { id: Group; label: string }[] = [
  { id: 'frauen', label: 'Frauen' },
  { id: 'maenner', label: 'Männer' },
];
---

<div class="price-table" data-tabs>
  <div class="tabs-wrap"><div class="tabs" role="tablist" aria-label="Preisliste wählen">
    {
      groups.map((g) => (
        <button
          role="tab"
          type="button"
          id={`tab-${g.id}`}
          aria-controls={`panel-${g.id}`}
          aria-selected={String(g.id === initial)}
          data-tab={g.id}
        >
          {g.label}
        </button>
      ))
    }
  </div></div>

  {
    groups.map((g) => (
      <div role="tabpanel" id={`panel-${g.id}`} aria-labelledby={`tab-${g.id}`} hidden={g.id !== initial} data-panel={g.id}>
        {showFirstVisit && (
          <div class="first">
            <div class="first-text">
              <h3>Neu bei uns und noch unsicher?</h3>
              <p class="muted">
                Bei deinem ersten Termin beraten wir dich immer ausführlich. Wenn du vorher in Ruhe alles klären möchtest, geht das
                auch – ganz ohne Verpflichtung.
              </p>
            </div>
            <ul class="rows">
              {firstVisit
                .filter((s) => g.id === 'frauen' || s.id === 'beratungsgespraech')
                .map((s) => (
                  <li>
                    <div class="name">
                      <strong>{s.name}</strong>
                      <span class="meta">
                        {duration(s.minutes)} · {s.note}
                      </span>
                    </div>
                    <span class:list={['price', { free: s.price === null && !s.priceLabel }]}>{priceText(s)}</span>
                    <a class="book" href={`/termin?behandlung=${s.id}&gruppe=${g.id}`} aria-label={`${s.name} buchen`}>
                      <Icon name="arrow" size={16} />
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        )}

        <div class="regions">
          {byRegion(g.id).map(([region, list]) => (
            <section class="region">
              <h3>{region}</h3>
              <ul class="rows">
                {list.map((s) => (
                  <li>
                    <div class="name">
                      <strong>
                        {s.name}
                        {s.popular && <span class="tag">Beliebt</span>}
                      </strong>
                      <span class="meta">
                        {duration(s.minutes)}
                        {s.note && <> · {s.note}</>}
                      </span>
                    </div>
                    <span class="price">{chf(s.price)}</span>
                    <a class="book" href={`/termin?behandlung=${s.id}&gruppe=${g.id}`} aria-label={`${s.name} buchen`}>
                      <Icon name="arrow" size={16} />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    ))
  }
</div>

<style>
  /* ——— Frauen / Männer: zentral und gross ——— */
  .tabs-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: clamp(32px, 4vw, 52px);
  }

  .tabs {
    display: inline-flex;
    border: 1px solid var(--espresso);
    background: var(--paper);
  }

  .tabs button {
    min-width: clamp(140px, 16vw, 200px);
    padding: 18px 28px;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    transition:
      background 0.25s,
      color 0.25s;
  }

  .tabs button:hover {
    background: var(--cream);
  }

  .tabs button[aria-selected='true'] {
    background: var(--espresso);
    color: var(--lime);
  }

  /* ——— Neu bei uns: dunkle Karte ——— */
  .first {
    display: grid;
    gap: 16px 48px;
    padding: clamp(24px, 3.4vw, 40px);
    background: var(--espresso);
    color: var(--cream);
    margin-bottom: 16px;
  }

  @media (min-width: 900px) {
    .first {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: center;
    }
  }

  .first h3 {
    font-family: var(--serif);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    text-transform: uppercase;
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    line-height: 1.05;
    color: var(--cream);
    margin-bottom: 10px;
  }

  .first p {
    font-size: 1rem;
    color: rgba(246, 241, 234, 0.75);
    margin: 0;
  }

  .first .rows li {
    border-bottom-color: rgba(246, 241, 234, 0.18);
  }

  .first .meta {
    color: rgba(246, 241, 234, 0.65);
  }

  .first .price.free {
    color: var(--lime);
  }

  .first .book {
    border-color: rgba(246, 241, 234, 0.4);
    color: var(--cream);
  }

  .first .book:hover {
    background: var(--lime);
    border-color: var(--lime);
    color: var(--espresso);
  }

  /* ——— Zonen: helle Karten, klar getrennt ——— */
  .regions {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 900px) {
    .regions {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .region {
    background: var(--paper);
    padding: clamp(22px, 2.8vw, 36px);
  }

  .region h3 {
    font-family: var(--serif);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    text-transform: uppercase;
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    line-height: 1.05;
    color: var(--ink);
    margin: 0 0 8px;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rows li {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 16px;
    padding: 15px 0;
    border-bottom: 1px solid rgba(47, 33, 25, 0.12);
  }

  .rows li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .name {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .name strong {
    font-weight: 700;
    font-size: 1.08rem;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .first .name strong {
    color: var(--cream);
  }

  .meta {
    font-size: 0.94rem;
    color: var(--muted);
    line-height: 1.45;
  }

  .tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 3px 8px;
    background: var(--lime);
    color: var(--espresso);
  }

  .price {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .first .price {
    color: var(--cream);
  }

  .book {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(47, 33, 25, 0.3);
    color: var(--ink);
    transition:
      background 0.2s,
      border-color 0.2s,
      color 0.2s;
  }

  .book:hover {
    background: var(--espresso);
    color: var(--lime);
    border-color: var(--espresso);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-tab]');
    const panels = root.querySelectorAll<HTMLElement>('[data-panel]');
    const select = (id: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === id)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
    };
    tabs.forEach((t) => t.addEventListener('click', () => select(t.dataset.tab!)));
    const fromHash = location.hash.replace('#', '');
    if (fromHash === 'maenner' || fromHash === 'frauen') select(fromHash);
  });
</script>
