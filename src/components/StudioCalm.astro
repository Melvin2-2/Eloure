---
// Studio-Impression „Ruhepunkt“: fixierte Section, das Raumbild öffnet sich beim
// Scrollen von gerahmt zu randlos, zwei Detailbilder ziehen nach aussen weg,
// das grosse Wort und die Glas-Karte kommen dazu.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import imgMain from '../assets/shoot/lounge-tuer.jpg';
import imgLeft from '../assets/shoot/sessel.jpg';
import imgRight from '../assets/shoot/detail-tuecher.jpg';
---

<section class="calm" data-calm>
  <div class="stage">
    <div class="side left" data-calm-side="-1">
      <Image src={imgLeft} alt="" widths={[400, 700]} sizes="22vw" />
    </div>
    <div class="side right" data-calm-side="1">
      <Image src={imgRight} alt="" widths={[400, 700]} sizes="22vw" />
    </div>
    <div class="frame" data-calm-frame>
      <Image src={imgMain} alt="Blick durch die offene Tür in die helle Lounge des Eloure Studios" widths={[900, 1400, 2000, 2400]} sizes="100vw" />
      <div class="shade"></div>
    </div>
    <p class="word" data-calm-word aria-hidden="true">Ruhepunkt</p>
    <div class="card" data-calm-card>
      <h2>Hier darfst du<br />ankommen</h2>
      <p>Helle Räume, warmes Holz, keine Hektik. Bevor es losgeht, setzt du dich in die Lounge und kommst erst einmal an.</p>
      <a class="card-link" href="/studio">Das Studio ansehen <Icon name="arrow" size={14} /></a>
    </div>
  </div>
</section>

<style>
  .calm {
    position: relative;
    overflow: hidden;
  }

  .stage {
    position: relative;
    height: 100vh;
    min-height: 640px;
  }

  .frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 64%;
  }

  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(27, 30, 42, 0.1) 30%, rgba(27, 30, 42, 0.6) 100%);
  }

  .side {
    position: absolute;
    z-index: 2;
    width: clamp(160px, 17vw, 280px);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    display: none;
  }

  .side :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .side.left {
    left: 8vw;
    top: 22vh;
  }

  .side.right {
    right: 8vw;
    top: 48vh;
  }

  .word {
    position: absolute;
    z-index: 3;
    left: var(--gutter);
    top: 17vh;
    margin: 0;
    font-family: var(--sans);
    font-weight: 200;
    text-transform: uppercase;
    font-size: clamp(3rem, 10vw, 10.5rem);
    line-height: 0.9;
    letter-spacing: 0.06em;
    color: #fff;
    --head: currentColor;
    white-space: nowrap;
    pointer-events: none;
  }

  /* Frosted Glass in hellem Off-White */
  .card {
    position: absolute;
    z-index: 4;
    right: var(--gutter);
    bottom: var(--gutter);
    max-width: 420px;
    padding: clamp(28px, 3.2vw, 44px);
    background: rgba(251, 250, 246, 0.62);
    -webkit-backdrop-filter: blur(22px) saturate(1.2);
    backdrop-filter: blur(22px) saturate(1.2);
    border: 1px solid rgba(255, 255, 255, 0.6);
    color: var(--ink);
    --head: var(--ink);
  }

  .card h2 {
    font-family: var(--sans);
    font-weight: 300;
    font-stretch: 100%;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.1;
    font-size: clamp(1.5rem, 2.1vw, 2rem);
    margin: 0 0 18px;
  }

  .card p {
    font-weight: 300;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--ink-body);
    margin-bottom: 24px;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line-strong);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
  }

  .card-link:hover {
    border-color: var(--ink);
  }

  @media (min-width: 900px) {
    .side {
      display: block;
    }
  }

  @media (max-width: 899px) {
    .stage {
      height: auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }
    .frame {
      position: relative;
      height: 118vw;
    }
    .word {
      bottom: auto;
      top: 16vw;
      font-size: 12.5vw;
    }
    .card {
      position: relative;
      right: auto;
      bottom: auto;
      max-width: none;
      margin: 0;
      padding: 36px var(--gutter) 64px;
      background: var(--bg);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      border: 0;
    }
  }
</style>
