---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section class="legal section-tight">
  <div class="wrap">
    <h1>{title}</h1>
    <div class="prose legal-body">
      <slot />
    </div>
  </div>
</section>

<style>
  .legal h1 {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
  }

  .legal-body {
    overflow-wrap: anywhere;
    hyphens: auto;
    margin-top: 32px;
    color: var(--ink-2);
  }

  .legal-body :global(h2) {
    color: var(--ink);
  }

  .legal-body :global(h3),
  .legal-body :global(h4) {
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 700;
    margin: 1.6em 0 0.4em;
  }

  .legal-body :global(h3) {
    font-size: 1.2rem;
  }

  .legal-body :global(h4) {
    font-size: 1rem;
  }

  .legal-body :global(a) {
    overflow-wrap: anywhere;
  }
</style>
