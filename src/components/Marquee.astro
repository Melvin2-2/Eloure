---
interface Props {
  items: string[];
  tone?: 'soft' | 'dark';
}
const { items, tone = 'soft' } = Astro.props;
const loop = [...items, ...items];
---

<div class:list={['marquee', tone]} aria-hidden="true">
  <div class="track">
    {
      loop.map((t) => (
        <span class="item">
          {t}
          <svg width="14" height="14" viewBox="0 0 24 24" class="sep">
            <path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z" fill="currentColor" />
          </svg>
        </span>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding-block: 22px;
    white-space: nowrap;
    border-block: 1px solid var(--line);
  }

  .soft {
    background: var(--accent-soft);
    color: var(--ink);
  }

  .dark {
    background: var(--deep);
    color: var(--paper);
    border-color: transparent;
  }

  .track {
    display: inline-flex;
    animation: marquee 48s linear infinite;
  }

  .marquee:hover .track {
    animation-play-state: paused;
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding-right: 28px;
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .sep {
    opacity: 0.5;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
