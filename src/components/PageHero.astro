---
// Unterseiten-Hero. Varianten:
//  editorial – helle Fläche, Headline, darunter breites Bild
//  frame     – Vollbild im hellen Passepartout, Rahmen öffnet sich beim Scrollen
//  split     – Text links, gerahmtes Hochformat rechts, Headline überlappt das Bild
//  collage   – Headline überlappt ein grosses Bild, kleines Detailbild schwebt versetzt
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lines from './Lines.astro';

interface Props {
  title: string[];
  sub?: string;
  lead?: string;
  image: ImageMetadata;
  image2?: ImageMetadata;
  alt?: string;
  position?: string;
  variant?: 'editorial' | 'frame' | 'split' | 'collage';
}
const { title, sub, lead, image, image2, alt = '', position = 'center', variant = 'frame' } = Astro.props;
const hasSlot = Astro.slots.has('default');
---

{
  variant === 'editorial' && (
    <section class="ph ph-editorial bg-paper">
      <div class="wrap ph-top">
        <Lines as="h1" class="ph-title" lines={title} />
        <div class="ph-meta">
          {sub && <p class="ph-sub" data-anim="up">{sub}</p>}
          {lead && <p class="ph-lead" data-anim="up">{lead}</p>}
          {hasSlot && <div class="ph-actions" data-anim="up"><slot /></div>}
        </div>
      </div>
      <figure class="ph-figure" data-hero-frame>
        <Image src={image} alt={alt} widths={[800, 1200, 1600, 2000, 2400]} sizes="100vw" loading="eager" fetchpriority="high" style={`object-position:${position}`} />
      </figure>
    </section>
  )
}

{
  variant === 'frame' && (
    <section class="ph ph-frame bg-paper" data-ph-frame>
      <div class="fr-img" data-ph-frame-img>
        <Image src={image} alt={alt} widths={[900, 1400, 2000, 2400]} sizes="100vw" loading="eager" fetchpriority="high" style={`object-position:${position}`} />
        <div class="fr-shade" />
      </div>
      <div class="fr-content">
        <div class="fr-left">
          {sub && <p class="ph-sub on-img" data-anim="up">{sub}</p>}
          <Lines as="h1" class="ph-title fr-title" lines={title} />
        </div>
        <div class="fr-right" data-anim="up">
          {lead && <p class="ph-lead on-img">{lead}</p>}
          {hasSlot && <div class="ph-actions on-dark"><slot /></div>}
        </div>
      </div>
    </section>
  )
}

{
  variant === 'split' && (
    <section class="ph ph-split bg-paper">
      <div class="sp-text">
        {sub && <p class="ph-sub" data-anim="up">{sub}</p>}
        <Lines as="h1" class="ph-title sp-title" lines={title} />
        {lead && <p class="ph-lead" data-anim="up">{lead}</p>}
        {hasSlot && <div class="ph-actions" data-anim="up"><slot /></div>}
      </div>
      <figure class="sp-img" data-anim="img">
        <Image src={image} alt={alt} widths={[700, 1100, 1600, 2000]} sizes="(min-width: 1000px) 46vw, 100vw" loading="eager" fetchpriority="high" style={`object-position:${position}`} data-parallax="8" />
      </figure>
    </section>
  )
}

{
  variant === 'collage' && (
    <section class="ph ph-collage bg-paper">
      <div class="co-text">
        {sub && <p class="ph-sub" data-anim="up">{sub}</p>}
        <Lines as="h1" class="ph-title co-title" lines={title} />
        {lead && <p class="ph-lead" data-anim="up">{lead}</p>}
        {hasSlot && <div class="ph-actions" data-anim="up"><slot /></div>}
      </div>
      <figure class="co-big" data-anim="img">
        <Image src={image} alt={alt} widths={[900, 1400, 2000]} sizes="(min-width: 1000px) 58vw, 100vw" loading="eager" fetchpriority="high" style={`object-position:${position}`} data-parallax="8" />
      </figure>
      {
        image2 && (
          <figure class="co-small" data-drift-y="-18">
            <Image src={image2} alt="" widths={[400, 700]} sizes="(min-width: 1000px) 20vw, 40vw" />
          </figure>
        )
      }
    </section>
  )
}

<style>
  /* ——— gemeinsame Elemente ——— */
  .ph :global(.ph-title) {
    font-size: clamp(2.8rem, 7.4vw, 8.4rem);
    line-height: 0.92;
    margin: 0;
  }

  .ph-sub {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mocha);
  }

  .ph-lead {
    margin: 0;
    max-width: 34em;
    font-size: clamp(1.1rem, 1.35vw, 1.28rem);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .ph-actions :global(.btn-ghost) {
    --btn-fg: var(--ink);
    --btn-border: var(--ink);
  }

  .ph-actions.on-dark :global(.btn-ghost) {
    --btn-fg: var(--cream);
    --btn-border: rgba(246, 241, 234, 0.6);
  }

  .on-img {
    color: var(--cream);
  }

  .ph-sub.on-img {
    color: var(--lime);
  }

  /* ——— editorial ——— */
  .ph-editorial {
    padding-top: calc(var(--header-h) + clamp(40px, 5.5vw, 96px));
  }

  .ph-editorial :global(.ph-title) {
    color: var(--ink);
  }

  .ph-meta {
    display: grid;
    gap: 18px 56px;
    margin-top: clamp(28px, 3.6vw, 52px);
  }

  @media (min-width: 1000px) {
    .ph-meta {
      grid-template-columns: minmax(180px, 0.7fr) 1.5fr auto;
      align-items: start;
    }
    .ph-meta .ph-sub {
      padding-top: 6px;
    }
  }

  .ph-figure {
    position: relative;
    margin: clamp(40px, 4.5vw, 72px) 0 0;
    height: clamp(380px, 74vh, 860px);
    overflow: hidden;
  }

  .ph-figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 999px) {
    .ph-figure {
      height: auto;
      aspect-ratio: 4 / 5;
      max-height: 78vh;
    }
  }

  /* ——— frame ——— */
  .ph-frame {
    position: relative;
    height: 100svh;
    min-height: 640px;
    max-height: 1100px;
  }

  .fr-img {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: inset(var(--header-h) var(--gutter) var(--gutter) var(--gutter));
  }

  .fr-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fr-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(36, 25, 19, 0.72) 0%, rgba(36, 25, 19, 0.25) 42%, rgba(36, 25, 19, 0) 70%);
  }

  .fr-content {
    position: absolute;
    left: calc(var(--gutter) * 2);
    right: calc(var(--gutter) * 2);
    bottom: calc(var(--gutter) * 2);
    z-index: 2;
    display: grid;
    gap: 24px 64px;
    align-items: end;
  }

  .fr-left .ph-sub {
    margin-bottom: 18px;
  }

  .fr-content :global(.fr-title) {
    color: var(--cream);
    font-size: clamp(2.3rem, 5.4vw, 6.4rem);
  }

  .fr-left {
    min-width: 0;
  }

  .fr-right .ph-lead {
    margin-bottom: 24px;
    color: rgba(246, 241, 234, 0.9);
  }

  @media (min-width: 1000px) {
    .fr-content {
      grid-template-columns: minmax(0, 1fr) minmax(300px, 400px);
    }
  }

  @media (max-width: 999px) {
    .fr-shade {
      background: linear-gradient(0deg, rgba(36, 25, 19, 0.85) 0%, rgba(36, 25, 19, 0.45) 55%, rgba(36, 25, 19, 0.1) 85%);
    }
  }

  /* ——— split ——— */
  .ph-split {
    position: relative;
    display: grid;
  }

  .sp-text {
    position: relative;
    z-index: 3;
    padding: calc(var(--header-h) + clamp(40px, 6vw, 96px)) var(--gutter) clamp(48px, 6vw, 96px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 26px;
  }

  .sp-text :global(.sp-title) {
    color: var(--ink);
  }

  .sp-img {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-height: 80vh;
    margin-inline: var(--gutter);
  }

  .sp-img :global(img) {
    position: absolute;
    inset: -6% 0;
    width: 100%;
    height: 112%;
    object-fit: cover;
  }

  @media (min-width: 1000px) {
    .ph-split {
      grid-template-columns: 1fr 0.85fr;
      min-height: 100svh;
    }
    .sp-text :global(.sp-title) {
      width: max-content;
      max-width: 62vw;
      margin-right: -16vw;
    }
    .sp-img {
      aspect-ratio: auto;
      max-height: none;
      margin: calc(var(--header-h) + 24px) var(--gutter) var(--gutter) 0;
    }
  }

  @media (max-width: 999px) {
    .sp-img {
      order: -1;
      margin-top: calc(var(--header-h) + 8px);
    }
    .sp-text {
      padding-top: 0;
      padding-bottom: 32px;
    }
    .sp-text :global(.sp-title) {
      margin-top: -0.55em;
    }
    .sp-text .ph-sub {
      order: 2;
    }
  }

  /* ——— collage ——— */
  .ph-collage {
    position: relative;
    display: grid;
    padding-bottom: clamp(48px, 7vw, 120px);
  }

  .co-text {
    position: relative;
    z-index: 3;
    padding: calc(var(--header-h) + clamp(40px, 6vw, 96px)) var(--gutter) 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .co-text :global(.co-title) {
    color: var(--ink);
  }

  .co-big {
    position: relative;
    margin: 0 var(--gutter);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  @media (max-width: 999px) {
    .co-big {
      order: -2;
      margin-top: calc(var(--header-h) + 8px);
      aspect-ratio: 4 / 4.2;
    }
    .co-small {
      order: -1;
    }
    .co-text {
      padding-top: 8px;
    }
    .co-text .ph-sub {
      order: 2;
    }
  }

  .co-big :global(img),
  .co-small :global(img) {
    position: absolute;
    inset: -6% 0;
    width: 100%;
    height: 112%;
    object-fit: cover;
  }

  .co-small {
    position: relative;
    z-index: 4;
    width: 34vw;
    aspect-ratio: 3 / 4;
    margin: -22vw var(--gutter) 0 auto;
    overflow: hidden;
    outline: 10px solid var(--paper);
  }

  @media (min-width: 1000px) {
    .ph-collage {
      grid-template-columns: 0.95fr 1.05fr;
      grid-template-rows: auto auto;
      min-height: 100svh;
      column-gap: 0;
    }
    .co-text {
      grid-column: 1;
      grid-row: 1 / 3;
      padding-right: 0;
      justify-content: center;
    }
    .co-text :global(.co-title) {
      width: max-content;
      max-width: 62vw;
      margin-right: -14vw;
    }
    .co-big {
      grid-column: 2;
      grid-row: 1;
      margin: calc(var(--header-h) + 32px) var(--gutter) 0 0;
      aspect-ratio: auto;
      height: 70vh;
    }
    .co-small {
      grid-column: 2;
      grid-row: 2;
      justify-self: end;
      width: 14vw;
      margin: -18vh calc(var(--gutter) + 4vw) 0 0;
    }
  }
</style>
