---
// Unterseiten-Startbild im ruhigen Stil der Startseite (nach Whole Body Beauty):
// Vollbild mit gedämpftem Kontrast und leisem Grau-Blau-Schleier, Überschrift mittig in
// Grossbuchstaben, darunter ein Text und ein Button. Eine Überschrift, ein Text – keine Unterzeilen.
// (Alte Props wie variant/sub/lines/glass bleiben erlaubt, werden aber nicht mehr verwendet.)
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string[];
  sub?: string;
  lead?: string;
  image: ImageMetadata;
  alt?: string;
  position?: string;
  variant?: string;
  frame?: string;
  lines?: string;
  glass?: boolean;
  xl?: boolean;
  curtain?: boolean;
}
const { title, lead, image, alt = '', position = 'center' } = Astro.props;
const hasSlot = Astro.slots.has('default');
---

<section class="ph">
  <div class="ph-img">
    <Image src={image} alt={alt} widths={[1200, 1800, 2400]} sizes="100vw" loading="eager" fetchpriority="high" style={`object-position:${position}`} />
  </div>
  <div class="ph-text">
    <h1 data-anim="up">{title.map((t, i) => (i ? [<br />, t] : t))}</h1>
    {lead && <p data-anim="up">{lead}</p>}
    {
      hasSlot && (
        <div class="ph-actions" data-anim="up">
          <slot />
        </div>
      )
    }
  </div>
</section>

<style>
  .ph {
    position: relative;
    height: 82svh;
    min-height: 600px;
    max-height: 960px;
    overflow: hidden;
    background: #6f7378;
  }

  .ph-img {
    position: absolute;
    inset: 0;
  }

  .ph-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(0.86) saturate(0.8);
  }

  .ph-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(17, 19, 28, 0.35) 0%, rgba(17, 19, 28, 0.15) 35%, rgba(17, 19, 28, 0.15) 65%, rgba(17, 19, 28, 0.38) 100%),
      rgba(78, 92, 102, 0.34);
  }

  .ph-text {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    padding: 120px var(--gutter) 40px;
    text-align: center;
    color: #fff;
    --head: #fff;
  }

  .ph-text h1 {
    margin: 0 0 0.4em;
    font-size: clamp(2.6rem, 6vw, 6.6rem);
  }

  .ph-text p {
    max-width: 36em;
    margin: 0 0 40px;
    font-weight: 350;
    font-size: clamp(1.05rem, 1.25vw, 1.2rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.92);
  }

  .ph-actions :global(.btn-row) {
    display: flex;
    justify-content: center;
  }

  /* im Startbild nur ein Button */
  .ph-actions :global(.btn-ghost),
  .ph-actions :global(.btn ~ .btn) {
    display: none;
  }

  @media (max-width: 640px) {
    .ph-text h1 {
      font-size: 8.4vw;
    }
  }
</style>
