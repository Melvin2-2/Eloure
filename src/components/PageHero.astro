---
// Unterseiten-Hero: dunkle Fläche, randloses Bild, Headline läuft über die Bildkante.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lines from './Lines.astro';

interface Props {
  title: string[];
  sub?: string;
  lead?: string;
  image: ImageMetadata;
  alt?: string;
  tone?: 'dark' | 'mocha';
  position?: string;
}
const { title, sub, lead, image, alt = '', tone = 'dark', position = 'center' } = Astro.props;
---

<section class:list={['page-hero', tone === 'mocha' ? 'bg-mocha' : 'bg-dark']}>
  <div class="ph-img">
    <Image src={image} alt={alt} widths={[700, 1100, 1600, 2000]} sizes="(min-width: 1000px) 55vw, 100vw" loading="eager" fetchpriority="high" data-parallax="10" style={`object-position:${position}`} />
    <div class="ph-shade"></div>
  </div>
  <div class="ph-content">
    <Lines as="h1" class="ph-title" lines={title}>
      {sub && <span class="ph-sub" data-anim="up">{sub}</span>}
    </Lines>
    {lead && <p class="lead" data-anim="up">{lead}</p>}
    <div data-anim="up"><slot /></div>
  </div>
  <div class="ph-card" data-anim="up"><slot name="card" /></div>
</section>

<style>
  .page-hero {
    position: relative;
    min-height: min(92svh, 920px);
    display: grid;
    align-items: end;
    overflow: hidden;
  }

  .ph-img {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 55%;
    overflow: hidden;
  }

  .ph-img :global(img) {
    position: absolute;
    inset: -6% 0;
    width: 100%;
    height: 112%;
    object-fit: cover;
  }

  .ph-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(43, 31, 26, 0.8) 0%, rgba(43, 31, 26, 0.1) 45%, rgba(43, 31, 26, 0) 70%),
      linear-gradient(0deg, rgba(43, 31, 26, 0.5), rgba(43, 31, 26, 0) 40%);
  }

  .bg-mocha .ph-shade {
    background: linear-gradient(90deg, rgba(90, 64, 51, 0.85) 0%, rgba(90, 64, 51, 0.1) 45%, rgba(90, 64, 51, 0) 70%);
  }

  .ph-content {
    position: relative;
    z-index: 2;
    padding: calc(var(--header-h) + 72px) var(--gutter) clamp(48px, 7vw, 96px);
    max-width: 900px;
  }

  .ph-content :global(.ph-title) {
    width: max-content;
    max-width: 92vw;
    font-size: clamp(2.5rem, 6.2vw, 6.4rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
    margin-bottom: 26px;
  }

  .ph-sub {
    display: block;
    margin-top: 20px;
    font-family: var(--sans);
    font-size: clamp(0.85rem, 1.1vw, 1rem);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--lime);
  }

  .ph-content .lead {
    max-width: 32em;
  }

  .ph-content :global(.btn-row) {
    margin-top: 32px;
  }

  .ph-card {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(48px, 7vw, 96px);
    z-index: 3;
  }

  .ph-card:empty {
    display: none;
  }

  @media (max-width: 999px) {
    .page-hero {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    .ph-img {
      position: relative;
      width: 100%;
      height: 80vw;
      max-height: 600px;
    }
    .ph-shade,
    .bg-mocha .ph-shade {
      background: linear-gradient(0deg, var(--espresso) 0%, rgba(43, 31, 26, 0) 55%);
    }
    .bg-mocha .ph-shade {
      background: linear-gradient(0deg, var(--mocha) 0%, rgba(90, 64, 51, 0) 55%);
    }
    .ph-content {
      margin-top: -26vw;
      padding-top: 0;
    }
    .ph-card {
      position: relative;
      right: auto;
      bottom: auto;
      margin: 0 var(--gutter) 48px;
    }
  }
</style>
