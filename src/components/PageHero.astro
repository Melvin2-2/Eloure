---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  lead?: string;
  center?: boolean;
  image?: ImageMetadata;
  alt?: string;
}
const { title, lead, center = false, image, alt = '' } = Astro.props;
---

<section class:list={['page-hero', { center, 'has-img': !!image }]}>
  <div class="wrap grid">
    <div class="text">
      <h1 class="reveal" set:html={title} />
      {lead && <p class="lead reveal" style="--d:80ms">{lead}</p>}
      <div class="reveal" style="--d:160ms"><slot /></div>
    </div>
  </div>
  {
    image && (
      <div class="pic">
        <Image src={image} alt={alt} widths={[600, 900, 1300, 1800]} sizes="(min-width: 960px) 50vw, 100vw" loading="eager" fetchpriority="high" data-parallax="0.05" />
      </div>
    )
  }
</section>

<style>
  .page-hero {
    position: relative;
    padding-block: clamp(56px, 9vw, 128px) clamp(40px, 6vw, 88px);
  }

  .page-hero h1 {
    max-width: 11em;
  }

  .center {
    text-align: center;
  }

  .center h1,
  .center .lead {
    margin-inline: auto;
  }

  .text :global(.btn-row) {
    margin-top: 32px;
  }

  .center :global(.btn-row) {
    justify-content: center;
  }

  .pic {
    overflow: hidden;
    background: var(--stone);
  }

  .pic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.12);
  }

  @media (max-width: 959px) {
    .has-img {
      padding-bottom: 0;
    }
    .pic {
      margin-top: 40px;
      height: 62vw;
      max-height: 480px;
    }
  }

  @media (min-width: 960px) {
    .has-img {
      min-height: min(78vh, 760px);
      display: flex;
      align-items: center;
      padding-block: 64px;
    }
    .has-img .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .has-img .text {
      padding-right: 48px;
    }
    .has-img .pic {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 50%;
      border-bottom-left-radius: var(--radius-l);
    }
  }
</style>
