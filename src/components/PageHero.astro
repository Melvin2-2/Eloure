---
// Unterseiten-Hero. Varianten:
//  frame – Vollbild im Passepartout (dunkel oder hell). Links bündig, rechts und
//          unten mit Rand; der Rahmen öffnet sich beim Scrollen bis randlos.
//  shape – Bild randlos, darauf eine dunkelbraune Bogen-Form mit Text und Buttons,
//          die beim Scrollen aufsteigt und sich zum Rechteck wandelt.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lines from './Lines.astro';

interface Props {
  title: string[];
  sub?: string;
  lead?: string;
  image: ImageMetadata;
  alt?: string;
  position?: string;
  variant?: 'frame' | 'shape';
  frame?: 'dark' | 'light';
}
const { title, sub, lead, image, alt = '', position = 'center', variant = 'frame', frame = 'dark' } = Astro.props;
const hasSlot = Astro.slots.has('default');
---

{
  variant === 'frame' && (
    <section class:list={['ph ph-frame', frame === 'light' ? 'bg-paper is-light' : 'bg-dark']} data-ph-frame>
      <div class="fr-img" data-ph-frame-img>
        <Image src={image} alt={alt} widths={[900, 1400, 2000, 2400]} sizes="100vw" loading="eager" fetchpriority="high" style={`object-position:${position}`} />
        <div class="fr-shade" />
      </div>
      <div class="fr-content">
        <div class="fr-left">
          {sub && <p class="ph-sub" data-anim="up">{sub}</p>}
          <Lines as="h1" class="ph-title" lines={title} />
        </div>
        <div class="fr-right" data-anim="up">
          {lead && <p class="ph-lead">{lead}</p>}
          {hasSlot && <div class="ph-actions"><slot /></div>}
        </div>
      </div>
    </section>
  )
}

{
  variant === 'shape' && (
    <section class="ph ph-shape bg-dark" data-ph-shape>
      <div class="sh-img">
        <Image src={image} alt={alt} widths={[900, 1400, 2000, 2400]} sizes="100vw" loading="eager" fetchpriority="high" style={`object-position:${position}`} data-ph-shape-img />
        <div class="sh-shade" />
      </div>
      <div class="sh-title">
        {sub && <p class="ph-sub" data-anim="up">{sub}</p>}
        <Lines as="h1" class="ph-title" lines={title} />
      </div>
      <div class="sh-form" data-ph-shape-form>
        <div class="sh-inner" data-anim="up">
          {lead && <p class="ph-lead">{lead}</p>}
          {hasSlot && <div class="ph-actions"><slot /></div>}
        </div>
      </div>
    </section>
  )
}

<style>
  /* ——— gemeinsam ——— */
  .ph :global(.ph-title) {
    font-size: clamp(2.3rem, 5.4vw, 6.4rem);
    line-height: 0.92;
    margin: 0;
    color: var(--cream);
  }

  .ph-sub {
    margin: 0 0 18px;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--lime);
  }

  .ph-lead {
    margin: 0 0 24px;
    max-width: 34em;
    font-size: clamp(1.05rem, 1.25vw, 1.2rem);
    line-height: 1.55;
    color: rgba(246, 241, 234, 0.9);
  }

  .ph-actions :global(.btn-ghost) {
    --btn-fg: var(--cream);
    --btn-border: rgba(246, 241, 234, 0.6);
  }

  .ph-actions :global(.btn-ghost:hover) {
    --btn-bg: var(--cream);
    --btn-fg: var(--espresso);
    --btn-border: var(--cream);
  }

  .ph-actions :global(.btn-primary) {
    --btn-border: var(--lime);
  }

  /* ——— frame ——— */
  .ph-frame {
    --fr-top: clamp(14px, 2vw, 32px);
    --fr-side: clamp(28px, 6vw, 112px);
    position: relative;
    height: calc(100svh - var(--header-h));
    min-height: 600px;
    max-height: 1000px;
  }

  .fr-img {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: inset(var(--fr-top) var(--fr-side) var(--fr-side) 0);
  }

  .fr-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fr-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(36, 25, 19, 0.75) 0%, rgba(36, 25, 19, 0.28) 42%, rgba(36, 25, 19, 0) 70%);
  }

  .fr-content {
    position: absolute;
    z-index: 2;
    left: calc(var(--gutter) * 1.5);
    right: calc(var(--fr-side) + var(--gutter));
    bottom: calc(var(--fr-side) + var(--gutter));
    display: grid;
    gap: 24px 56px;
    align-items: end;
  }

  .fr-left {
    min-width: 0;
  }

  @media (min-width: 1000px) {
    .fr-content {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 380px);
    }
  }

  @media (max-width: 999px) {
    .ph-frame {
      --fr-side: 18px;
      height: calc(100svh - var(--header-h));
    }
    .fr-shade {
      background: linear-gradient(0deg, rgba(36, 25, 19, 0.85) 0%, rgba(36, 25, 19, 0.45) 55%, rgba(36, 25, 19, 0.1) 85%);
    }
    .fr-content {
      left: var(--gutter);
    }
  }

  /* ——— shape ——— */
  .ph-shape {
    position: relative;
    height: calc(100svh - var(--header-h));
    min-height: 620px;
    max-height: 1000px;
    overflow: hidden;
  }

  .sh-img {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .sh-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sh-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(36, 25, 19, 0.55) 0%, rgba(36, 25, 19, 0.15) 45%, rgba(36, 25, 19, 0) 65%);
  }

  .sh-title {
    position: absolute;
    z-index: 2;
    left: var(--gutter);
    bottom: clamp(48px, 7vw, 110px);
    max-width: 58vw;
  }

  .sh-form {
    position: absolute;
    z-index: 3;
    right: clamp(24px, 7vw, 120px);
    bottom: 0;
    width: clamp(320px, 31vw, 480px);
    height: 74%;
    background: var(--espresso);
    border-radius: 999px 999px 0 0;
    display: flex;
    align-items: flex-end;
    will-change: transform, border-radius;
  }

  .sh-inner {
    padding: 0 clamp(28px, 3vw, 48px) clamp(40px, 5vw, 72px);
  }

  .sh-inner :global(.btn-row) {
    flex-direction: column;
    align-items: stretch;
  }

  @media (max-width: 999px) {
    .ph-shape {
      height: auto;
      min-height: 0;
      max-height: none;
      display: flex;
      flex-direction: column;
      padding-bottom: 0;
    }
    .sh-img {
      position: relative;
      inset: auto;
      height: 100vw;
      max-height: 560px;
    }
    .sh-shade {
      background: linear-gradient(0deg, rgba(36, 25, 19, 0.7) 0%, rgba(36, 25, 19, 0) 60%);
    }
    .sh-title {
      position: relative;
      left: auto;
      bottom: auto;
      max-width: none;
      margin: -9.5rem var(--gutter) 0;
    }
    .sh-form {
      position: relative;
      right: auto;
      width: auto;
      height: auto;
      margin: 32px var(--gutter) 0;
      padding-top: 64px;
      border-radius: 200px 200px 0 0;
      background: var(--mocha);
    }
    .sh-inner {
      padding: 0 24px 40px;
    }
  }
</style>
