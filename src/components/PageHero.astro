---
// Unterseiten-Hero im Editorial-Stil: ruhige helle Fläche, grosse Headline,
// darunter eine Zeile mit Einordnung, Text und Aktionen – und ein breites Bild,
// das sich beim Scrollen bis an die Ränder öffnet.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lines from './Lines.astro';

interface Props {
  title: string[];
  sub?: string;
  lead?: string;
  image: ImageMetadata;
  alt?: string;
  position?: string;
}
const { title, sub, lead, image, alt = '', position = 'center' } = Astro.props;
---

<section class="page-hero bg-paper">
  <div class="wrap ph-top">
    <Lines as="h1" class="ph-title" lines={title} />
    <div class="ph-meta">
      {sub && <p class="ph-sub" data-anim="up">{sub}</p>}
      {lead && <p class="ph-lead" data-anim="up">{lead}</p>}
      {Astro.slots.has('default') && <div class="ph-actions" data-anim="up"><slot /></div>}
    </div>
  </div>
  <figure class="ph-figure" data-hero-frame>
    <Image src={image} alt={alt} widths={[800, 1200, 1600, 2000, 2400]} sizes="100vw" loading="eager" fetchpriority="high" style={`object-position:${position}`} />
  </figure>
</section>

<style>
  .page-hero {
    padding-top: calc(var(--header-h) + clamp(40px, 5.5vw, 96px));
  }

  .ph-top :global(.ph-title) {
    font-size: clamp(2.8rem, 7.4vw, 8.4rem);
    line-height: 0.92;
    margin: 0;
    color: var(--ink);
  }

  .ph-meta {
    display: grid;
    gap: 18px 56px;
    margin-top: clamp(28px, 3.6vw, 52px);
  }

  .ph-sub {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mocha);
  }

  .ph-lead {
    margin: 0;
    max-width: 34em;
    font-size: clamp(1.1rem, 1.35vw, 1.3rem);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .ph-actions :global(.btn-ghost) {
    --btn-fg: var(--ink);
    --btn-border: var(--ink);
  }

  @media (min-width: 1000px) {
    .ph-meta {
      grid-template-columns: minmax(180px, 0.7fr) 1.5fr auto;
      align-items: start;
    }
    .ph-sub {
      padding-top: 6px;
    }
    .ph-actions :global(.btn-row) {
      justify-content: flex-end;
    }
  }

  .ph-figure {
    position: relative;
    margin: clamp(40px, 4.5vw, 72px) 0 0;
    height: clamp(380px, 74vh, 860px);
    overflow: hidden;
  }

  .ph-figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 999px) {
    .ph-figure {
      height: auto;
      aspect-ratio: 4 / 5;
      max-height: 78vh;
    }
  }
</style>
