---
interface Props {
  title: string;
  lead?: string;
  center?: boolean;
}
const { title, lead, center = false } = Astro.props;
---

<section class:list={['page-hero', { center }]}>
  <div class="wrap">
    <h1 set:html={title} />
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(48px, 8vw, 104px) clamp(32px, 5vw, 64px);
  }

  .page-hero h1 {
    max-width: 14em;
  }

  .center {
    text-align: center;
  }

  .center h1,
  .center .lead {
    margin-inline: auto;
  }

  .page-hero :global(.btn-row) {
    margin-top: 28px;
  }

  .center :global(.btn-row) {
    justify-content: center;
  }
</style>
