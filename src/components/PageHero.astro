---
// Unterseiten-Hero. Varianten:
//  frame – Vollbild im Passepartout (dunkel oder hell): oben und links bündig,
//          rechts und unten mit Rand; der Rand verschwindet beim Scrollen.
//  shape – Bild randlos. Darauf ein feiner Neon-Rahmen, der sich zeichnet und beim
//          Scrollen verformt, und eine kantige dunkelbraune Fläche mit Text,
//          deren schräge Kante sich beim Scrollen aufrichtet.
// Aufbau Text: grosse Headline links; rechts ein Textblock mit eigener Überschrift
// (Neon), kurzem Text und Buttons.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lines from './Lines.astro';

interface Props {
  title: string[];
  /** Überschrift des Textblocks */
  sub?: string;
  lead?: string;
  image: ImageMetadata;
  alt?: string;
  position?: string;
  variant?: 'frame' | 'shape';
  frame?: 'dark' | 'light';
}
const { title, sub, lead, image, alt = '', position = 'center', variant = 'frame', frame = 'dark' } = Astro.props;
const hasSlot = Astro.slots.has('default');
---

{
  variant === 'frame' && (
    <section class:list={['ph ph-frame', frame === 'light' ? 'bg-paper' : 'bg-dark']} data-ph-frame>
      <div class="fr-img" data-ph-frame-img>
        <Image src={image} alt={alt} widths={[900, 1400, 2000, 2400]} sizes="100vw" loading="eager" fetchpriority="high" style={`object-position:${position}`} />
        <div class="fr-shade" />
      </div>
      <div class="fr-content">
        <Lines as="h1" class="ph-title" lines={title} />
        <div class="ph-block" data-anim="up">
          {sub && <h2 class="ph-head">{sub}</h2>}
          {lead && <p class="ph-lead">{lead}</p>}
          {hasSlot && <div class="ph-actions"><slot /></div>}
        </div>
      </div>
    </section>
  )
}

{
  variant === 'shape' && (
    <section class="ph ph-shape bg-dark" data-ph-shape>
      <div class="sh-img">
        <Image src={image} alt={alt} widths={[900, 1400, 2000, 2400]} sizes="100vw" loading="eager" fetchpriority="high" style={`object-position:${position}`} data-ph-shape-img />
        <div class="sh-shade" />
        <svg class="sh-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <polygon data-ph-shape-line points="5,7 95,7 95,93 5,93" />
        </svg>
      </div>
      <div class="sh-title">
        <Lines as="h1" class="ph-title" lines={title} />
      </div>
      <div class="sh-form" data-ph-shape-form>
        <div class="ph-block" data-anim="up">
          {sub && <h2 class="ph-head">{sub}</h2>}
          {lead && <p class="ph-lead">{lead}</p>}
          {hasSlot && <div class="ph-actions"><slot /></div>}
        </div>
      </div>
    </section>
  )
}

<style>
  /* ——— gemeinsam ——— */
  .ph :global(.ph-title) {
    font-size: clamp(2.3rem, 5.4vw, 6.4rem);
    line-height: 0.92;
    margin: 0;
    color: var(--cream);
  }

  .ph-head {
    margin: 0 0 12px;
    font-size: clamp(1.25rem, 1.6vw, 1.6rem);
    line-height: 1.1;
    color: var(--lime);
  }

  .ph-lead {
    margin: 0 0 24px;
    max-width: 34em;
    font-size: clamp(1.05rem, 1.2vw, 1.15rem);
    line-height: 1.55;
    color: rgba(246, 241, 234, 0.9);
  }

  .ph-actions :global(.btn-ghost) {
    --btn-fg: var(--cream);
    --btn-border: rgba(246, 241, 234, 0.6);
  }

  .ph-actions :global(.btn-ghost:hover) {
    --btn-bg: var(--lime);
    --btn-fg: var(--espresso);
    --btn-border: var(--lime);
  }

  .ph-actions :global(.btn-primary) {
    --btn-border: var(--lime);
  }

  /* ——— frame ——— */
  .ph-frame {
    --fr-side: clamp(28px, 6vw, 112px);
    position: relative;
    height: calc(100svh - var(--header-h));
    min-height: 600px;
    max-height: 1000px;
  }

  .fr-img {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: inset(0px var(--fr-side) var(--fr-side) 0px);
  }

  .fr-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fr-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(36, 25, 19, 0.78) 0%, rgba(36, 25, 19, 0.3) 42%, rgba(36, 25, 19, 0) 70%);
  }

  .fr-content {
    position: absolute;
    z-index: 2;
    left: calc(var(--gutter) * 1.5);
    right: calc(var(--fr-side) + var(--gutter));
    bottom: calc(var(--fr-side) + var(--gutter));
    display: grid;
    gap: 28px 56px;
    align-items: end;
  }

  .fr-content :global(.ph-title) {
    min-width: 0;
  }

  @media (min-width: 1000px) {
    .fr-content {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 380px);
    }
  }

  @media (max-width: 999px) {
    .ph-frame {
      --fr-side: 18px;
    }
    .fr-shade {
      background: linear-gradient(0deg, rgba(36, 25, 19, 0.86) 0%, rgba(36, 25, 19, 0.5) 55%, rgba(36, 25, 19, 0.1) 85%);
    }
    .fr-content {
      left: var(--gutter);
    }
  }

  /* ——— shape ——— */
  .ph-shape {
    position: relative;
    height: calc(100svh - var(--header-h));
    min-height: 620px;
    max-height: 1000px;
    overflow: hidden;
  }

  .sh-img {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .sh-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sh-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(36, 25, 19, 0.6) 0%, rgba(36, 25, 19, 0.15) 45%, rgba(36, 25, 19, 0) 65%);
  }

  .sh-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }

  .sh-lines polygon {
    fill: none;
    stroke: var(--lime);
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }

  /* Rahmen zeichnet sich beim Laden von links nach rechts */
  :global(.motion) .sh-lines {
    animation: draw 2.2s 0.3s cubic-bezier(0.65, 0, 0.35, 1) both;
  }

  @keyframes draw {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  .sh-title {
    position: absolute;
    z-index: 3;
    left: calc(5% + var(--gutter));
    bottom: calc(7% + clamp(28px, 4vw, 56px));
    max-width: 52vw;
  }

  .sh-form {
    position: absolute;
    z-index: 4;
    right: 5%;
    bottom: 7%;
    width: clamp(340px, 32vw, 480px);
    padding: clamp(80px, 9vw, 130px) clamp(28px, 3vw, 44px) clamp(32px, 3.4vw, 48px) clamp(56px, 6vw, 92px);
    background: var(--espresso);
    clip-path: polygon(22% 0%, 100% 0%, 100% 100%, 0% 100%);
    will-change: clip-path, transform;
  }

  .sh-form :global(.btn-row) {
    flex-direction: column;
    align-items: stretch;
  }

  @media (max-width: 999px) {
    .ph-shape {
      height: auto;
      min-height: 0;
      max-height: none;
      display: flex;
      flex-direction: column;
    }
    .sh-img {
      position: relative;
      inset: auto;
      height: 100vw;
      max-height: 560px;
    }
    .sh-shade {
      background: linear-gradient(0deg, rgba(36, 25, 19, 0.75) 0%, rgba(36, 25, 19, 0) 60%);
    }
    .sh-title {
      position: relative;
      left: auto;
      bottom: auto;
      max-width: none;
      margin: -8.5rem var(--gutter) 0;
    }
    .sh-form {
      position: relative;
      right: auto;
      bottom: auto;
      width: auto;
      margin: 28px 0 0;
      padding: 72px var(--gutter) 48px;
      clip-path: polygon(0% 12%, 100% 0%, 100% 100%, 0% 100%);
      background: var(--mocha);
    }
  }
</style>
