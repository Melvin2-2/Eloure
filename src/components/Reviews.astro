---
import { reviews, googleRating } from '../data/reviews';
interface Props {
  title?: string;
}
const { title = 'Was unsere Kund:innen sagen' } = Astro.props;
---

{
  reviews.length > 0 && (
    <section class="section reviews">
      <div class="wrap">
        <div class="section-head">
          <h2>{title}</h2>
          {googleRating && (
            <p class="lead">
              <a href={googleRating.url} target="_blank" rel="noopener">
                {googleRating.rating.toFixed(1)} von 5 Sternen · {googleRating.count} Google-Bewertungen
              </a>
            </p>
          )}
        </div>
        <div class="grid">
          {reviews.map((r) => (
            <figure class="reveal">
              <div class="stars" aria-label="5 Sterne">★★★★★</div>
              <blockquote>«{r.text}»</blockquote>
              <figcaption>
                <strong>{r.name}</strong>
                {r.treatment && <span> · {r.treatment}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .grid {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  figure {
    margin: 0;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--paper);
    border: 1px solid var(--line);
  }

  .stars {
    letter-spacing: 2px;
    margin-bottom: 12px;
  }

  blockquote {
    margin: 0 0 18px;
    font-family: var(--serif);
    font-size: 1.4rem;
    line-height: 1.3;
  }

  figcaption {
    font-size: 0.9rem;
    color: var(--muted);
  }

  figcaption strong {
    color: var(--ink);
  }
</style>
