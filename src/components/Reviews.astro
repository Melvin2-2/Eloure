---
import Icon from './Icon.astro';
import { reviews, googleRating } from '../data/reviews';
import { site } from '../data/site';

interface Props {
  title?: string;
}
const { title = 'Was unsere Kund:innen sagen' } = Astro.props;
---

<section class="section reviews bg-paper">
  <div class="wrap">
    <div class="head">
      <div>
        <h2 set:html={title} />
        <p class="lead">
          Viele unserer Kundinnen und Kunden haben ihre Erfahrungen auf Google geteilt. Lies selbst, wie sie sich bei uns
          gefühlt haben – vom ersten Termin bis zum Ergebnis.
        </p>
      </div>
      <a class="g-card" href={site.googleReviewsUrl} target="_blank" rel="noopener">
        <span class="g-stars" aria-hidden="true">★★★★★</span>
        <span class="g-title">
          {googleRating ? `${googleRating.rating.toFixed(1).replace('.', ',')} von 5 · ${googleRating.count} Bewertungen` : 'Bewertungen auf Google'}
        </span>
        <span class="g-go">Alle Bewertungen lesen <Icon name="arrow" size={15} /></span>
      </a>
    </div>

    {
      reviews.length > 0 && (
        <div class="grid">
          {reviews.map((r) => (
            <figure class="reveal">
              <div class="stars" aria-label="5 Sterne">★★★★★</div>
              <blockquote>«{r.text}»</blockquote>
              <figcaption>
                <strong>{r.name}</strong>
                {r.treatment && <span> · {r.treatment}</span>}
                <span class="src"> · Google</span>
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: 28px 64px;
    align-items: end;
  }

  @media (min-width: 900px) {
    .head {
      grid-template-columns: 1.4fr 0.6fr;
    }
  }

  .head .lead {
    margin-bottom: 0;
  }

  .g-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    transition: transform 0.25s, box-shadow 0.25s;
  }

  .g-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-l);
  }

  .g-stars {
    color: var(--paper);
    letter-spacing: 3px;
    font-size: 1.2rem;
  }

  .g-title {
    font-family: var(--sans);
    line-height: 1.25;
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .g-go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--paper);
  }

  .grid {
    display: grid;
    gap: 16px;
    margin-top: 48px;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  figure {
    margin: 0;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--bg);
  }

  .stars {
    letter-spacing: 2px;
    margin-bottom: 12px;
  }

  blockquote {
    margin: 0 0 18px;
    font-family: var(--sans);
    line-height: 1.3;
    font-size: 1.08rem;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  figcaption {
    font-size: 0.9rem;
    color: var(--muted);
  }

  figcaption strong {
    color: var(--ink);
  }
</style>
