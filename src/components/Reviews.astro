---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Lines from './Lines.astro';
import { reviews, googleRating } from '../data/reviews';
import { site } from '../data/site';
import img from '../assets/shoot/detail-buch.jpg';

interface Props {
  title?: string[];
  ctaHref?: string;
  ctaLabel?: string;
}
const { title = ['Was unsere', 'Kundinnen sagen.'], ctaHref = '/termin', ctaLabel = 'Termin buchen' } = Astro.props;
const rating = googleRating.rating.toFixed(1).replace('.', ',');
---

<section class="reviews bg-sand" data-reviews>
  <div class="pic" data-anim="img">
    <Image src={img} alt="Bildband von Peter Lindbergh im Sonnenlicht in der Studio-Lounge" widths={[700, 1100, 1600]} sizes="(min-width: 1000px) 40vw, 100vw" />
  </div>

  <div class="content">
    <Lines lines={title} class="r-title" />

    <a class="score reveal" href={site.googleReviewsUrl} target="_blank" rel="noopener" aria-label={`${rating} von 5 Sternen aus ${googleRating.count} Google-Bewertungen`}>
      <span class="num serif">{rating}</span>
      <span class="meta">
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span>aus <b data-count={googleRating.count}>{googleRating.count}</b> Google-Bewertungen</span>
      </span>
    </a>

    <div class="slider reveal">
      {
        reviews.map((r, i) => (
          <figure class:list={['slide', { 'is-active': i === 0 }]} data-slide aria-hidden={i === 0 ? 'false' : 'true'}>
            {r.topic && <span class="topic label">{r.topic}</span>}
            <blockquote>«{r.text}»</blockquote>
            <figcaption>
              <strong>{r.name}</strong> · Google · {r.when}
            </figcaption>
          </figure>
        ))
      }
      <div class="ctrl">
        <button type="button" class="nav" data-prev aria-label="Vorherige Bewertung"><Icon name="arrow" size={18} class="flip" /></button>
        <span class="pos"><span data-pos>01</span> / {String(reviews.length).padStart(2, '0')}</span>
        <button type="button" class="nav" data-next aria-label="Nächste Bewertung"><Icon name="arrow" size={18} /></button>
      </div>
    </div>

    <div class="btn-row reveal">
      <a class="btn btn-dark" href={ctaHref}>{ctaLabel}<span class="arrow"><Icon name="arrow" size={16} /></span></a>
      <a class="text-link" href={site.googleReviewsUrl} target="_blank" rel="noopener">Alle Bewertungen auf Google</a>
    </div>
  </div>
</section>

<style>
  .reviews {
    display: grid;
  }

  @media (min-width: 1000px) {
    .reviews {
      grid-template-columns: 0.8fr 1.2fr;
      min-height: 100vh;
    }
  }

  .pic {
    position: relative;
    overflow: hidden;
    min-height: 70vw;
  }

  @media (min-width: 1000px) {
    .pic {
      min-height: 0;
    }
  }

  .pic :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .content {
    position: relative;
    z-index: 2;
    padding: var(--section) var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 900px;
  }



  .score {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    margin: 8px 0 40px;
    text-decoration: none;
    align-self: flex-start;
  }

  .num {
    font-size: clamp(5rem, 9vw, 8.4rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 1.05rem;
  }

  .stars {
    color: var(--mocha);
    letter-spacing: 4px;
    font-size: 1.4rem;
  }

  .score:hover .meta span:last-child {
    text-decoration: underline;
  }

  .slider {
    position: relative;
    display: grid;
    padding: clamp(28px, 4vw, 44px);
    background: var(--espresso);
    color: var(--cream);
    margin-bottom: 36px;
  }

  .slide {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px);
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease),
      visibility 0.6s;
  }

  .slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .topic {
    color: var(--lime);
    margin-bottom: 18px;
  }

  blockquote {
    margin: 0 0 22px;
    font-size: clamp(1.35rem, 2.1vw, 1.9rem);
    line-height: 1.28;
  }

  figcaption {
    font-size: 0.92rem;
    opacity: 0.75;
    margin-bottom: 72px;
  }

  figcaption strong {
    opacity: 1;
  }

  .ctrl {
    position: absolute;
    left: clamp(28px, 4vw, 44px);
    right: clamp(28px, 4vw, 44px);
    bottom: clamp(24px, 3vw, 36px);
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .pos {
    font-size: 0.94rem;
    letter-spacing: 0.12em;
    opacity: 0.8;
  }

  .nav {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--line-light);
    background: transparent;
    color: var(--cream);
    cursor: pointer;
    transition:
      background 0.25s,
      color 0.25s;
  }

  .nav:hover {
    background: var(--lime);
    color: var(--espresso);
    border-color: var(--lime);
  }

  .nav :global(.flip) {
    transform: rotate(180deg);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const pos = root.querySelector<HTMLElement>('[data-pos]')!;
    let i = 0;
    let timer: number | undefined;
    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, j) => {
        s.classList.toggle('is-active', j === i);
        s.setAttribute('aria-hidden', String(j !== i));
      });
      pos.textContent = String(i + 1).padStart(2, '0');
    };
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const auto = () => {
      if (reduce) return;
      window.clearInterval(timer);
      timer = window.setInterval(() => show(i + 1), 7000);
    };
    root.querySelector('[data-prev]')!.addEventListener('click', () => {
      show(i - 1);
      auto();
    });
    root.querySelector('[data-next]')!.addEventListener('click', () => {
      show(i + 1);
      auto();
    });
    const io = new IntersectionObserver((e) => (e[0].isIntersecting ? auto() : window.clearInterval(timer)));
    io.observe(root);
  });
</script>
