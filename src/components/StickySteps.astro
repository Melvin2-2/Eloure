---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Lines from './Lines.astro';
import img1 from '../assets/shoot/caro-beratung.jpg';
import img2 from '../assets/shoot/gel-achsel.jpg';
import img3 from '../assets/shoot/laser-achsel-quer.jpg';

interface Props {
  title?: string[];
  ctaHref?: string;
  ctaLabel?: string;
}
const { title = ['Dein Weg', 'zu glatter Haut.'], ctaHref = '/termin', ctaLabel = 'Ersten Termin buchen' } = Astro.props;
const steps = [
  {
    img: img1,
    alt: 'Caro im persönlichen Beratungsgespräch mit Tablet',
    title: 'Wir lernen uns kennen',
    text: 'Ausführliches Gespräch: Was wünschst du dir, gibt es medizinische Fragen, welcher Haut- und Haartyp bist du? Daraus entsteht ein ehrlicher Plan – nur für dich.',
    note: 'Bei jedem ersten Termin inklusive',
  },
  {
    img: img2,
    alt: 'Kühlgel wird vor der Laserbehandlung aufgetragen',
    title: 'Deine erste Session',
    text: 'Wir erklären jeden Schritt, bevor er passiert, bereiten die Haut vor und starten mit dem passenden Setting. Fragen und Pausen sind jederzeit okay.',
    note: 'Kleine Zonen dauern 15 bis 30 Minuten',
  },
  {
    img: img3,
    alt: 'Laserbehandlung an der Achsel',
    title: 'Wir bleiben an deiner Seite',
    text: 'Folgetermine planen wir nach deinem Haarzyklus. Wir prüfen den Fortschritt und passen Einstellungen und Abstände laufend an.',
    note: 'Bezahlt wird jeweils vor Ort',
  },
];
---

<section class="steps-sec bg-paper" data-steps>
  <div class="visual">
    {
      steps.map((s, i) => (
        <div class:list={['img', { 'is-active': i === 0 }]} data-step-img>
          <Image src={s.img} alt={s.alt} widths={[700, 1100, 1600]} sizes="(min-width: 1000px) 50vw, 100vw" />
        </div>
      ))
    }
    <span class="counter serif" aria-hidden="true">
      {steps.map((_, i) => <span class:list={['n', { 'is-active': i === 0 }]} data-step-num>0{i + 1}</span>)}
    </span>
  </div>

  <div class="content">
    <Lines lines={title} />
    <ol>
      {
        steps.map((s, i) => (
          <li class:list={['step', { 'is-active': i === 0 }]} data-step-item>
            <div class="m-img">
              <Image src={s.img} alt={s.alt} widths={[600, 900]} sizes="100vw" />
            </div>
            <span class="no label">Schritt {i + 1}</span>
            <h3 class="serif">{s.title}</h3>
            <p>{s.text}</p>
            <span class="note">{s.note}</span>
          </li>
        ))
      }
    </ol>
    <div class="btn-row reveal">
      <a class="btn btn-primary" href={ctaHref}>
        {ctaLabel}
        <span class="arrow">
          <Icon name="arrow" size={16} />
        </span>
      </a>
      <a class="text-link" href="/laserhaarentfernung">Wie der Laser wirkt</a>
    </div>
  </div>
</section>

<style>
  .steps-sec {
    display: grid;
  }

  @media (min-width: 1000px) {
    .steps-sec {
      grid-template-columns: 1fr 1fr;
    }
    .visual {
      position: sticky;
      top: 0;
      height: 100vh;
    }
  }

  .visual {
    position: relative;
    overflow: hidden;
    background: var(--stone);
  }

  .img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 0.9s var(--ease),
      transform 1.4s var(--ease);
  }

  .img.is-active {
    opacity: 1;
    transform: none;
  }

  .img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .counter {
    position: absolute;
    left: var(--gutter);
    bottom: var(--gutter);
    font-size: clamp(5rem, 11vw, 10rem);
    line-height: 0.8;
    color: var(--cream);
    text-shadow: 0 2px 30px rgba(20, 14, 11, 0.45);
  }

  .counter .n {
    position: absolute;
    left: 0;
    bottom: 0;
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease);
  }

  .counter .n.is-active {
    opacity: 1;
    transform: none;
  }

  .content {
    padding: var(--section) var(--gutter);
    max-width: 720px;
  }

  ol {
    list-style: none;
    margin: 40px 0 48px;
    padding: 0;
  }

  .step {
    padding: 44px 0;
    border-top: 1px solid var(--line);
    opacity: 0.35;
    transition: opacity 0.5s ease;
  }

  .step.is-active {
    opacity: 1;
  }

  @media (min-width: 1000px) {
    .step {
      min-height: 52vh;
    }
  }

  .no {
    color: var(--mocha);
  }

  .step h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 3.2vw, 2.9rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 14px 0 16px;
  }

  .step p {
    color: var(--ink-2);
    max-width: 30em;
  }

  .note {
    display: inline-block;
    margin-top: 16px;
    padding: 7px 12px;
    background: var(--lime);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .m-img {
    display: none;
  }

  @media (max-width: 999px) {
    .steps-sec {
      display: block;
    }
    .visual {
      display: none;
    }
    .step {
      opacity: 1;
    }
    .m-img {
      display: block;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      margin: 0 calc(var(--gutter) * -1) 22px;
    }
    .m-img :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  @media (min-width: 1000px) {
    .steps-sec .visual {
      position: sticky;
      top: 0;
      height: 100vh;
    }
  }
</style>
