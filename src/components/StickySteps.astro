---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import img1 from '../assets/img/consultation.jpg';
import img2 from '../assets/img/treatment-session.jpg';
import img3 from '../assets/img/treatment-legs.jpg';

interface Props {
  title?: string;
  ctaHref?: string;
  ctaLabel?: string;
}
const { title = 'So läuft dein Weg zu glatter Haut', ctaHref = '/termin', ctaLabel = 'Ersten Termin buchen' } = Astro.props;
const steps = [
  {
    img: img1,
    alt: 'Persönliches Beratungsgespräch in der Studio-Lounge',
    title: 'Wir lernen uns kennen',
    text: 'Ausführliches Gespräch: Was wünschst du dir, gibt es medizinische Fragen, welcher Haut- und Haartyp bist du? Daraus entsteht ein realistischer Plan – nur für dich.',
    note: 'Bei jedem ersten Termin inklusive',
  },
  {
    img: img2,
    alt: 'Laserbehandlung am Bein mit Kühlgel',
    title: 'Deine erste Laser-Session',
    text: 'Wir erklären jeden Schritt, bevor er passiert, bereiten die Haut vor und starten mit dem passenden Setting. Fragen und Pausen sind jederzeit okay.',
    note: 'Kleine Zonen dauern 15 bis 30 Minuten',
  },
  {
    img: img3,
    alt: 'Markierte Behandlungszonen an den Beinen',
    title: 'Wir begleiten dich bis zum Ziel',
    text: 'Folgetermine planen wir nach deinem Haarzyklus. Wir prüfen den Fortschritt und passen Einstellungen und Abstände laufend an.',
    note: 'Bezahlt wird jeweils vor Ort',
  },
];
---

<section class="section steps-sec" data-steps>
  <div class="wrap grid">
    <div class="visual">
      <div class="frame">
        {
          steps.map((s, i) => (
            <div class:list={['img', { 'is-active': i === 0 }]} data-step-img>
              <Image src={s.img} alt={s.alt} widths={[500, 800, 1100]} sizes="(min-width: 900px) 44vw, 100vw" />
            </div>
          ))
        }
      </div>
    </div>

    <div class="content">
      <h2 class="reveal">{title}</h2>
      <ol>
        {
          steps.map((s, i) => (
            <li class:list={['step', { 'is-active': i === 0 }]} data-step-item>
              <span class="no">0{i + 1}</span>
              <div>
                <div class="m-img">
                  <Image src={s.img} alt={s.alt} widths={[480, 760]} sizes="100vw" />
                </div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
                <span class="note">{s.note}</span>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="btn-row">
        <a class="btn btn-primary" href={ctaHref}>
          {ctaLabel}
          <span class="arrow">
            <Icon name="arrow" size={18} />
          </span>
        </a>
        <a class="text-link" href="/laserhaarentfernung">Wie der Laser wirkt</a>
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 40px clamp(40px, 6vw, 96px);
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
    .visual {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }

  .frame {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: calc(100vh - var(--header-h) - 64px);
    width: 100%;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--stone);
  }

  .img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.04);
    transition:
      opacity 0.8s var(--ease),
      transform 1.2s var(--ease);
  }

  .img.is-active {
    opacity: 1;
    transform: none;
  }

  .img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  ol {
    list-style: none;
    margin: 24px 0 40px;
    padding: 0;
  }

  .step {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 16px;
    padding: 40px 0;
    border-top: 1px solid var(--line);
    opacity: 0.4;
    transition: opacity 0.5s ease;
  }

  .step.is-active {
    opacity: 1;
  }

  @media (max-width: 899px) {
    .visual {
      display: none;
    }
    .step {
      opacity: 1;
    }
  }

  @media (min-width: 900px) {
    .step {
      min-height: 46vh;
    }
  }

  .m-img {
    display: none;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 20px;
  }

  .m-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 899px) {
    .m-img {
      display: block;
    }
    .step {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }

  .no {
    font-size: 1rem;
    font-weight: 500;
    color: var(--accent);
    padding-top: 6px;
  }

  h3 {
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    letter-spacing: -0.025em;
    margin-bottom: 12px;
  }

  p {
    color: var(--ink-2);
    max-width: 30em;
  }

  .note {
    display: inline-block;
    margin-top: 14px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
    font-size: 0.86rem;
    font-weight: 500;
  }
</style>
