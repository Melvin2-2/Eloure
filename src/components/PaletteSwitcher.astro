---
// Nur zur Abstimmung der Farbwelt – über SHOW_PALETTE_SWITCHER in src/data/site.ts abschaltbar.
const palettes = [
  { id: 'espresso', label: 'Espresso', color: '#6b4f3f' },
  { id: 'taubenblau', label: 'Taubenblau', color: '#46636f' },
  { id: 'salbei', label: 'Salbei', color: '#5d6a55' },
  { id: 'rose', label: 'Rosé', color: '#8b5a52' },
  { id: 'original', label: 'Original', color: '#2e2d2b' },
];
---

<div class="pal" data-pal>
  <button type="button" class="pal-toggle" aria-expanded="false" data-pal-toggle>Farbwelt</button>
  <div class="pal-panel" hidden data-pal-panel>
    <p>Farbwelt testen</p>
    <ul>
      {
        palettes.map((p) => (
          <li>
            <button type="button" data-pal-set={p.id}>
              <span class="sw" style={`background:${p.color}`} />
              {p.label}
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .pal {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 60;
    font-size: 0.85rem;
  }

  @media (max-width: 1120px) {
    .pal {
      bottom: 96px;
    }
  }

  .pal-toggle {
    padding: 9px 14px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    box-shadow: var(--shadow);
    cursor: pointer;
    font-weight: 500;
  }

  .pal-panel {
    position: absolute;
    left: 0;
    bottom: calc(100% + 8px);
    min-width: 190px;
    padding: 14px;
    border-radius: 14px;
    background: var(--paper);
    box-shadow: var(--shadow-l);
  }

  .pal-panel[hidden] {
    display: none;
  }

  .pal-panel p {
    margin: 0 0 8px;
    color: var(--muted);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  ul button {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 7px 8px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    text-align: left;
  }

  ul button:hover,
  ul button[aria-pressed='true'] {
    background: var(--linen);
  }

  .sw {
    width: 18px;
    height: 18px;
    border-radius: 50%;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-pal]');
  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-pal-toggle]')!;
    const panel = root.querySelector<HTMLElement>('[data-pal-panel]')!;
    const current = () => document.documentElement.getAttribute('data-palette') || 'espresso';
    const mark = () =>
      root.querySelectorAll<HTMLButtonElement>('[data-pal-set]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.palSet === current())));
    toggle.addEventListener('click', () => {
      panel.hidden = !panel.hidden;
      toggle.setAttribute('aria-expanded', String(!panel.hidden));
      mark();
    });
    root.querySelectorAll<HTMLButtonElement>('[data-pal-set]').forEach((b) =>
      b.addEventListener('click', () => {
        const id = b.dataset.palSet!;
        if (id === 'espresso') document.documentElement.removeAttribute('data-palette');
        else document.documentElement.setAttribute('data-palette', id);
        try {
          localStorage.setItem('eloure-palette', id);
        } catch {}
        mark();
      }),
    );
  }
</script>
