---
// Scroll-Story „Dein Weg zu glatter Haut“: links wechselt das Bild mit der Phase, rechts der Text.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Lines from './Lines.astro';
import img1 from '../assets/shoot/caro-beratung.jpg';
import img2 from '../assets/shoot/kundin-brille.jpg';
import img3 from '../assets/shoot/caro-telefon.jpg';

interface Props {
  title?: string[];
  ctaHref?: string;
  ctaLabel?: string;
}
const { title = ['Dein Weg zu', 'glatter Haut.'], ctaHref = '/termin', ctaLabel = 'Ersten Termin buchen' } = Astro.props;
const phases = [
  {
    img: img1,
    alt: 'Caro im persönlichen Beratungsgespräch mit einer Kundin',
    pos: 'center 30%',
    label: 'Beratung',
    head: 'Erst reden.',
    lead: 'Bevor der Laser zum Einsatz kommt, lernen wir uns kennen.',
    text: 'Wir setzen uns in Ruhe in die Lounge und sprechen über das, was du dir wünschst – und über alles, was dich vielleicht verunsichert. Wir schauen uns deinen Haut- und Haartyp an, klären Fragen zu Medikamenten oder Sonnenbräune und sagen dir ehrlich, was bei dir realistisch ist. Daraus entsteht ein Plan, der zu deinem Körper passt – nicht zu einem Standardpaket.',
    chip: 'Bei jedem ersten Termin inklusive',
  },
  {
    img: img2,
    alt: 'Entspannte Kundin mit Schutzbrille während der Laserbehandlung',
    pos: 'center 35%',
    label: 'Behandlung',
    head: 'Dann lasern.',
    lead: 'Du weisst immer, was als Nächstes passiert.',
    text: 'Wir bereiten die Haut vor, tragen das Kühlgel auf und erklären dir jeden Schritt, bevor er passiert. Während der Behandlung fragen wir immer wieder nach, wie es sich für dich anfühlt, und passen die Einstellungen an. Brauchst du eine Pause, machen wir eine. Kleine Zonen wie Achseln oder Oberlippe dauern oft nur 15 Minuten.',
    chip: 'Du gibst das Tempo vor',
  },
  {
    img: img3,
    alt: 'Caro beantwortet in der Lounge eine Frage am Telefon',
    pos: '60% 40%',
    label: 'Begleitung',
    head: 'Und dranbleiben.',
    lead: 'Glatte Haut entsteht Schritt für Schritt – wir gehen den Weg mit dir.',
    text: 'Weil nicht alle Haare gleichzeitig wachsen, braucht es mehrere Sitzungen. Wir planen deine Folgetermine passend zu deinem Haarzyklus, prüfen den Fortschritt und passen Abstände und Einstellungen laufend an. Und wenn zwischendurch eine Frage auftaucht, erreichst du uns ganz einfach per WhatsApp.',
    chip: 'Bezahlt wird jeweils vor Ort',
  },
];
---

<section class="story bg-paper" data-steps>
  <div class="visual">
    {
      phases.map((p, i) => (
        <Image
          src={p.img}
          alt={i === 0 ? p.alt : ''}
          class:list={['v-img', { 'is-active': i === 0 }]}
          data-step-img
          widths={[700, 1100, 1600]}
          sizes="(min-width: 1000px) 50vw, 100vw"
          style={`object-position:${p.pos}`}
        />
      ))
    }
    <div class="progress glass" aria-hidden="true">
      {
        phases.map((p, i) => (
          <span class:list={['pp', { 'is-active': i === 0 }]} data-step-num>
            <i />
            {p.label}
          </span>
        ))
      }
    </div>
  </div>

  <div class="content">
    <div class="intro">
      <Lines lines={title} class="ol story-title" />
      <p class="lead reveal">Klar, persönlich und in deinem Tempo – so sieht deine Zeit bei uns aus.</p>
    </div>
    {
      phases.map((p, i) => (
        <article class:list={['phase', { 'is-active': i === 0 }]} data-step-item>
          {i > 0 && <Image src={p.img} alt={p.alt} class="p-img" widths={[600, 900]} sizes="100vw" style={`object-position:${p.pos}`} />}
          <h3 class="p-head">{p.head}</h3>
          <p class="p-lead">{p.lead}</p>
          <p class="p-text">{p.text}</p>
          <span class="p-chip">
            <Icon name="check" size={16} /> {p.chip}
          </span>
        </article>
      ))
    }
    <div class="btn-row cta reveal">
      <a class="btn btn-primary" href={ctaHref}>{ctaLabel}<span class="arrow"><Icon name="arrow" size={16} /></span></a>
      <a class="text-link" href="/laserhaarentfernung">Wie der Laser wirkt</a>
    </div>
  </div>
</section>

<style>
  .story {
    display: grid;
  }

  .visual {
    position: relative;
    overflow: hidden;
    height: 100vw;
    max-height: 640px;
  }

  .visual :global(.v-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 0.9s var(--ease),
      transform 1.6s var(--ease);
  }

  .visual :global(.v-img.is-active) {
    opacity: 1;
    transform: none;
  }

  .phase :global(.p-img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    margin-bottom: 24px;
  }

  @media (min-width: 1000px) {
    .phase :global(.p-img) {
      display: none;
    }
  }

  .progress {
    position: absolute;
    z-index: 2;
    left: var(--gutter);
    top: var(--gutter);
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    padding: 14px 18px;
  }

  .pp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.94rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.55;
    transition: opacity 0.4s;
  }

  .pp i {
    width: 10px;
    height: 10px;
    border: 1.5px solid currentColor;
    transition: background 0.4s, border-color 0.4s;
  }

  .pp.is-active {
    opacity: 1;
  }

  .pp.is-active i {
    background: var(--lime);
    border-color: var(--lime);
  }

  .content {
    padding: var(--section) var(--gutter);
    max-width: 760px;
  }

  .content :global(.story-title) {
    font-size: clamp(2.8rem, 5.6vw, 5.8rem);
    line-height: 0.95;
  }

  .intro {
    margin-bottom: 24px;
  }

  .phase {
    padding: 28px 0;
  }

  .p-head {
    margin: 0 0 14px;
    font-family: var(--serif);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    text-transform: uppercase;
    font-size: clamp(2.4rem, 4.6vw, 4.4rem);
    line-height: 0.95;
    letter-spacing: var(--display-ls);
    color: var(--ink);
  }

  .p-lead {
    font-size: clamp(1.25rem, 1.8vw, 1.55rem);
    font-weight: 600;
    line-height: 1.35;
    color: var(--mocha);
    margin-bottom: 16px;
  }

  .p-text {
    font-size: 1.12rem;
    line-height: 1.7;
    color: var(--ink-2);
    max-width: 34em;
  }

  .p-chip {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    font-weight: 700;
    color: var(--ink);
  }

  .p-chip :global(svg) {
    color: var(--mocha);
  }

  .cta {
    margin-top: 24px;
  }

  @media (min-width: 1000px) {
    .story {
      grid-template-columns: 1fr 1fr;
    }
    .progress {
      top: auto;
      bottom: var(--gutter);
    }
    .story .visual {
      position: sticky;
      top: 0;
      height: 100vh;
      max-height: none;
    }
    .phase {
      min-height: 50vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      opacity: 0.18;
      transform: translateY(24px);
      transition:
        opacity 0.7s var(--ease),
        transform 0.7s var(--ease);
    }
    .phase.is-active {
      opacity: 1;
      transform: none;
    }
  }
</style>
