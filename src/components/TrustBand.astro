---
import Icon from './Icon.astro';
import { googleRating } from '../data/reviews';
import { site } from '../data/site';
const rating = googleRating.rating.toFixed(1).replace('.', ',');
const items = [
  { icon: 'star', value: `${rating} Sterne`, text: `aus ${googleRating.count} Google-Bewertungen`, href: site.googleReviewsUrl },
  { icon: 'laser', value: 'Diodenlaser', text: 'medizinisch, präzise und schonend' },
  { icon: 'shield', value: 'V‑NISSG', text: 'geprüfte Sachkunde nach Schweizer Verordnung' },
  { icon: 'wallet', value: 'Vor Ort zahlen', text: 'keine Vorauszahlung, kostenlos absagen bis 24 Std. vorher' },
] as const;
---

<section class="trust bg-lime" aria-label="Darauf kannst du dich verlassen">
  <div class="wrap grid">
    {
      items.map((it, i) => {
        const Tag = 'href' in it ? 'a' : 'div';
        return (
          <Tag class="item reveal" style={`--d:${i * 80}ms`} {...('href' in it ? { href: it.href, target: '_blank', rel: 'noopener' } : {})}>
            <Icon name={it.icon} size={44} stroke={1.15} class="ic" />
            <span class="txt">
              <strong>{it.value}</strong>
              <span>{it.text}</span>
            </span>
          </Tag>
        );
      })
    }
  </div>
</section>

<style>
  .trust {
    padding-block: clamp(36px, 4.5vw, 56px);
  }

  .grid {
    display: grid;
    gap: 24px 32px;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .item {
    display: flex;
    align-items: center;
    gap: 16px;
    text-decoration: none;
  }

  .item :global(.ic) {
    flex: none;
    color: var(--espresso);
    transition: transform 0.5s var(--ease);
  }

  .item:hover :global(.ic) {
    transform: translateY(-3px);
  }

  .txt {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  strong {
    font-size: clamp(1.45rem, 1.9vw, 1.8rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .txt span {
    font-size: 1rem;
    color: var(--ink-2);
  }
</style>
