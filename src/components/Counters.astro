---
interface Props {
  items: { value: number; suffix?: string; label: string }[];
}
const { items } = Astro.props;
---

<section class="counters bg-lime">
  <div class="wrap grid">
    {
      items.map((c) => (
        <div class="c reveal">
          <span class="v serif">
            <span data-count={c.value}>{c.value}</span>
            {c.suffix}
          </span>
          <span class="l">{c.label}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .counters {
    padding-block: clamp(64px, 9vw, 120px);
  }

  .grid {
    display: grid;
    gap: 40px 24px;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .c {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 22px;
    border-top: 1px solid rgba(43, 31, 26, 0.35);
  }

  .v {
    font-size: clamp(3.6rem, 7.5vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .l {
    font-weight: 600;
    max-width: 16em;
  }
</style>
