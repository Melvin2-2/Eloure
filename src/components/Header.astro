---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site } from '../data/site';

interface Props {
  variant: 'full' | 'minimal';
  ctaHref: string;
  ctaLabel: string;
  /** dark: transparent über dunklem Hero (helle Schrift); paper: transparent über hellem Hero (dunkle Schrift); light: feste dunkle Leiste */
  tone?: 'dark' | 'light' | 'paper';
}
const { variant, ctaHref, ctaLabel, tone = 'dark' } = Astro.props;

const nav = [
  { href: '/preise', label: 'Preise' },
  { href: '/laserhaarentfernung', label: 'Behandlung' },
  { href: '/studio', label: 'Studio & Team' },
  { href: '/faq', label: 'FAQ' },
  { href: '/kontakt', label: 'Kontakt' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class:list={['site-header', tone === 'dark' ? 'is-over' : tone === 'paper' ? 'is-paper' : 'is-solid']} data-header>
  <div class="bar">
    <a href="/" class="logo" aria-label={`${site.name} – Startseite`}>
      <Logo />
    </a>

    {
      variant === 'full' && (
        <nav class="nav" aria-label="Hauptnavigation">
          <ul>
            {nav.map((n) => (
              <li>
                <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>
                  {n.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="actions">
      {
        variant === 'full' && (
          <a class="tel hide-s" href={site.phoneHref} aria-label={`Anrufen: ${site.phone}`}>
            <Icon name="phone" size={17} /> <span>{site.phone}</span>
          </a>
        )
      }
      <a class="btn btn-primary btn-sm hide-xs" href={ctaHref}>{ctaLabel}</a>
      {
        variant === 'full' && (
          <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
            <span class="sr-only">Menü öffnen</span>
            <span class="burger" aria-hidden="true" />
          </button>
        )
      }
    </div>
  </div>

  {
    variant === 'full' && (
      <div class="mobile-nav" id="mobile-nav" hidden data-menu>
        <nav aria-label="Mobile Navigation">
          <ul>
            <li><a href="/">Start</a></li>
            {nav.map((n) => (
              <li>
                <a href={n.href}>{n.label}</a>
              </li>
            ))}
          </ul>
          <a class="btn btn-primary btn-block" href={ctaHref}>
            {ctaLabel}
          </a>
          <div class="mobile-contact">
            <a href={site.phoneHref}>
              <Icon name="phone" size={18} /> {site.phone}
            </a>
            <a href={site.whatsappHref} target="_blank" rel="noopener">
              <Icon name="whatsapp" size={18} /> WhatsApp
            </a>
          </div>
        </nav>
      </div>
    )
  }
</header>

<style>
  .site-header {
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    color: var(--cream);
    transition:
      background 0.4s ease,
      box-shadow 0.4s ease,
      transform 0.45s var(--ease);
  }

  .site-header:global(.is-hidden) {
    transform: translateY(-100%);
  }

  .is-over {
    position: fixed;
    top: auto;
  }

  .is-solid {
    position: sticky;
    background: var(--espresso);
  }

  .site-header:global(.is-scrolled) {
    background: rgba(43, 31, 26, 0.88);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }

  .is-over:global(.is-scrolled) {
    position: fixed;
    top: 0;
  }

  .is-paper {
    position: fixed;
    top: auto;
    color: var(--ink);
  }

  .is-paper:global(.is-scrolled),
  .is-paper:global(.menu-open) {
    position: fixed;
    top: 0;
    color: var(--cream);
  }

  .is-paper:global(.menu-open) {
    background: var(--espresso);
  }

  .is-paper:not(:global(.is-scrolled)) .nav a::after {
    background: var(--ink);
  }

  .is-over:not(:global(.is-scrolled)) {
    background: linear-gradient(180deg, rgba(20, 14, 11, 0.45), rgba(20, 14, 11, 0));
  }

  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 28px;
    padding-inline: var(--gutter);
  }

  .logo {
    flex: none;
    display: block;
  }

  .logo :global(svg) {
    height: 34px;
    width: auto;
  }

  .nav {
    margin-left: auto;
  }

  .nav ul {
    list-style: none;
    display: flex;
    gap: 6px;
    margin: 0;
    padding: 0;
  }

  .nav a {
    position: relative;
    display: block;
    padding: 8px 12px;
    text-decoration: none;
    font-size: 0.94rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .nav a::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 2px;
    height: 1px;
    background: var(--lime);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }

  .nav a:hover::after,
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-left: auto;
  }

  .nav + .actions {
    margin-left: 12px;
  }

  .tel {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .btn-sm {
    min-height: 46px;
    padding: 0 20px;
    font-size: 0.85rem;
    --btn-border: var(--lime);
  }

  .menu-btn {
    display: none;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid color-mix(in srgb, currentColor 40%, transparent);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 20px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.3s var(--ease);
  }

  .burger {
    position: relative;
  }

  .burger::before,
  .burger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .burger::before {
    top: -6px;
  }

  .burger::after {
    top: 6px;
  }

  .menu-btn[aria-expanded='true'] .burger {
    background: transparent;
  }

  .menu-btn[aria-expanded='true'] .burger::before {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-btn[aria-expanded='true'] .burger::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  .mobile-nav {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--espresso);
    overflow-y: auto;
    padding: 24px var(--gutter) 48px;
  }

  .mobile-nav ul {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
  }

  .mobile-nav li a {
    display: block;
    padding: 14px 0;
    border-bottom: 1px solid var(--line-light);
    font-family: var(--serif);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    text-transform: uppercase;
    font-size: 2.2rem;
    line-height: 1.1;
    text-decoration: none;
  }

  .mobile-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 28px;
    font-weight: 600;
  }

  .mobile-contact a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  @media (max-width: 1180px) {
    .nav,
    .tel {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
  }

  @media (max-width: 640px) {
    .logo :global(svg) {
      height: 26px;
    }
    .actions {
      gap: 10px;
    }
  }

  @media (max-width: 380px) {
    body[data-variant='full'] .hide-xs {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const header = document.querySelector<HTMLElement>('[data-header]');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
    header?.classList.toggle('menu-open', !open);
    document.body.style.overflow = open ? '' : 'hidden';
  });
</script>
