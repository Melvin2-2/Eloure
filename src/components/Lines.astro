---
// Headline, deren Zeilen nacheinander aus einer Maske laufen (bleibt danach stehen).
interface Props {
  as?: 'h1' | 'h2' | 'p' | 'div';
  lines: string[];
  class?: string;
  delay?: number;
}
const { as: Tag = 'h2', lines, class: cls, delay = 0 } = Astro.props;
---

<Tag class={cls} data-anim="lines" data-delay={delay}>
  {lines.map((l) => <span class="line"><span set:html={l} /></span>)}
  <slot />
</Tag>
