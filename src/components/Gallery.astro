---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Lines from './Lines.astro';
import { site } from '../data/site';
import i1 from '../assets/shoot/liege-fenster.jpg';
import i2 from '../assets/shoot/lounge-tuer.jpg';
import i3 from '../assets/shoot/detail-buch.jpg';
import i4 from '../assets/shoot/tuer-exhale.jpg';
import i5 from '../assets/shoot/detail-objekte.jpg';
import i6 from '../assets/shoot/detail-pflanze.jpg';
import i7 from '../assets/shoot/detail-tuecher.jpg';

interface Props {
  title?: string[];
  text?: string;
}
const { title = ['Ein Ort zum', 'Durchatmen.'], text = 'Hell, ruhig und mit viel Liebe eingerichtet – mitten in Amriswil. Damit du dich vom ersten Moment an wohlfühlst und nicht wie in einer Klinik.' } = Astro.props;
const imgs = [
  { src: i1, alt: 'Laserliege am Fenster', w: 'tall' },
  { src: i2, alt: 'Blick durch die Tür in die Lounge', w: 'tall' },
  { src: i3, alt: 'Bildband im Sonnenlicht', w: 'wide' },
  { src: i4, alt: 'Schriftzug Exhale the bullshit, durch die Tür gesehen', w: 'tall' },
  { src: i5, alt: 'Dekorative Details im Studio', w: 'wide' },
  { src: i6, alt: 'Pflanze im Studio', w: 'tall' },
  { src: i7, alt: 'Frische Tücher für die Behandlung', w: 'tall' },
];
---

<section class="gallery bg-dark" data-rail>
  <div class="wrap head">
    <div>
      <Lines lines={title} />
      <p class="lead reveal">{text}</p>
    </div>
    <div class="ctrl">
      <button type="button" class="nav" data-rail-btn="prev" aria-label="Zurück"><Icon name="arrow" size={20} class="flip" /></button>
      <button type="button" class="nav" data-rail-btn="next" aria-label="Weiter"><Icon name="arrow" size={20} /></button>
    </div>
  </div>
  <div class="track" data-rail-track>
    {
      imgs.map((im) => (
        <figure class:list={['shot', im.w, 'zoom']}>
          <Image src={im.src} alt={im.alt} widths={[600, 1000, 1500]} sizes="(min-width: 900px) 45vw, 85vw" />
        </figure>
      ))
    }
  </div>
  <div class="wrap foot">
    <span><Icon name="pin" size={18} /> {site.address.street}, {site.address.zip} {site.address.city} · {site.parking}</span>
    <a class="text-link" href={site.mapsUrl} target="_blank" rel="noopener">Route planen</a>
  </div>
</section>

<style>
  .gallery {
    padding-block: var(--section);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 48px;
  }

  .head .lead {
    margin: 0;
  }

  .ctrl {
    display: flex;
    gap: 8px;
    flex: none;
  }

  .nav {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border: 1px solid var(--line-light);
    background: transparent;
    color: var(--cream);
    cursor: pointer;
    transition:
      background 0.25s,
      color 0.25s;
  }

  .nav:hover {
    background: var(--lime);
    color: var(--espresso);
    border-color: var(--lime);
  }

  .nav :global(.flip) {
    transform: rotate(180deg);
  }

  @media (max-width: 700px) {
    .ctrl {
      display: none;
    }
  }

  .track {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .shot {
    flex: none;
    margin: 0;
    height: clamp(380px, 62vh, 760px);
    overflow: hidden;
    scroll-snap-align: start;
    background: var(--cocoa);
  }

  .shot.wide {
    aspect-ratio: 1.5;
  }
  .shot.tall {
    aspect-ratio: 0.68;
  }

  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    align-items: center;
    margin-top: 32px;
  }

  .foot span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
</style>
