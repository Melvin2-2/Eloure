---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Lines from './Lines.astro';
import { services, byRegion, chf, duration } from '../data/services';
import { site } from '../data/site';
import imgZone from '../assets/shoot/laser-achsel.jpg';

interface Props {
  code?: string;
  discount?: number;
}
const { code, discount } = Astro.props;
const initial = 'beine-komplett';
const price = (p: number | null) => (p === null ? null : discount ? Math.round((p * (100 - discount)) / 100) : p);
const data = services.map((s) => ({
  id: s.id,
  name: s.name,
  group: s.group,
  price: chf(price(s.price)),
  old: discount && s.price ? chf(s.price) : '',
  dur: duration(s.minutes),
  note: s.note ?? '',
}));
const first = data.find((s) => s.id === initial)!;
const q = code ? `&code=${code}` : '';
---

<section class="zf bg-mocha" id="zonen" data-zf>
  <div class="media-col">
    <div class="img" data-anim="img">
      <Image src={imgZone} alt="Laserbehandlung an der Achsel mit medizinischem Diodenlaser" widths={[600, 1000, 1400]} sizes="(min-width: 1000px) 42vw, 100vw" />
    </div>
    <div class="card glass" aria-live="polite">
      <span class="z-label label">Deine Auswahl</span>
      <span class="z-name serif" data-zf-name>{first.name}</span>
      <span class="z-meta"><Icon name="clock" size={16} /> <span data-zf-dur>{first.dur}</span> pro Sitzung</span>
      <span class="z-note" data-zf-note>{first.note}</span>
      <div class="z-foot">
        <span class="z-price">
          <s data-zf-old>{first.old}</s>
          <span data-zf-price>{first.price}</span>
        </span>
        <a class="btn btn-primary" href={`/termin?behandlung=${initial}${q}`} data-zf-cta>
          <span class="long">Diese Zone buchen</span><span class="short">Buchen</span><span class="arrow"><Icon name="arrow" size={16} /></span>
        </a>
      </div>
    </div>
  </div>

  <div class="content">
    <Lines lines={['Welche Zone', 'darf es sein?']} />
    <p class="lead reveal">
      Tippe auf eine Zone und sieh sofort Preis und Dauer. Über 30 Zonen für Frauen und Männer – bezahlt wird erst vor Ort.
    </p>

    <div class="seg reveal" role="tablist" aria-label="Zonen für">
      <button type="button" role="tab" aria-selected="true" data-zf-group="frauen">Frauen</button>
      <button type="button" role="tab" aria-selected="false" data-zf-group="maenner">Männer</button>
    </div>

    {
      (['frauen', 'maenner'] as const).map((g) => (
        <div class="groups reveal" data-zf-panel={g} hidden={g !== 'frauen'}>
          {byRegion(g).map(([region, list]) => (
            <div class="region">
              <span class="r-label">{region}</span>
              <div class="pills">
                {list.map((s) => (
                  <button type="button" class:list={['pill', { 'is-active': s.id === initial }]} data-zf-id={s.id}>
                    {s.name}
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
      ))
    }
    <p class="trust">
      <span><Icon name="check" size={15} /> Bezahlt wird vor Ort</span>
      <span><Icon name="check" size={15} /> Kostenlos absagen bis {site.cancellationHours} Std. vorher</span>
      <a class="text-link" href="/preise">Alle Preise</a>
    </p>
  </div>
  <script type="application/json" data-zf-data set:html={JSON.stringify(data)} />
</section>

<style>
  .zf {
    display: grid;
    min-height: 100vh;
  }

  @media (min-width: 1000px) {
    .zf {
      grid-template-columns: 0.95fr 1.05fr;
    }
    .media-col {
      position: sticky;
      top: 0;
      height: 100vh;
    }
  }

  .media-col {
    position: relative;
    overflow: hidden;
    min-height: 70vh;
  }

  .img {
    position: absolute;
    inset: 0;
  }

  .img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: clamp(22px, 3vw, 34px);
  }

  .z-label {
    opacity: 0.75;
  }

  .z-name {
    font-size: clamp(2rem, 3.6vw, 3.4rem);
    line-height: 1;
    margin: 4px 0;
  }

  .z-meta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    opacity: 0.85;
  }

  .z-note {
    font-size: 0.92rem;
    opacity: 0.8;
    min-height: 1.4em;
  }

  .z-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 16px;
    padding-top: 20px;
    border-top: 1px solid var(--line-light);
  }

  .z-price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--serif);
    font-size: clamp(2.2rem, 3.6vw, 3.2rem);
    line-height: 1;
  }

  .z-price s {
    font-family: var(--sans);
    font-size: 1rem;
    opacity: 0.6;
  }

  .z-price s:empty {
    display: none;
  }

  .short {
    display: none;
  }

  .content {
    padding: calc(var(--section) * 0.7) var(--gutter);
    max-width: 760px;
  }

  .seg {
    display: inline-flex;
    border: 1px solid var(--line-light);
    margin: 20px 0 36px;
  }

  .seg button {
    border: 0;
    background: transparent;
    padding: 13px 30px;
    cursor: pointer;
    color: rgba(246, 241, 234, 0.7);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .seg button[aria-selected='true'] {
    background: var(--cream);
    color: var(--espresso);
  }

  .region + .region {
    margin-top: 22px;
  }

  .r-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.6;
    margin-bottom: 10px;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill {
    padding: 11px 18px;
    border: 1px solid rgba(246, 241, 234, 0.32);
    background: transparent;
    color: var(--cream);
    font-size: 1rem;
    cursor: pointer;
    transition:
      background 0.25s,
      color 0.25s,
      border-color 0.25s;
  }

  .pill:hover {
    border-color: var(--cream);
  }

  .pill.is-active {
    background: var(--lime);
    border-color: var(--lime);
    color: var(--espresso);
  }

  .trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 24px;
    margin-top: 40px;
    font-size: 0.92rem;
    opacity: 0.9;
  }

  .trust span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .trust :global(svg) {
    color: var(--lime);
  }

  .flash {
    animation: flash 0.5s var(--ease);
  }

  @keyframes flash {
    from {
      opacity: 0.2;
      transform: translateY(8px);
    }
  }

  /* Mobile: Preiskarte klebt über der Zonenliste */
  @media (max-width: 999px) {
    .zf {
      display: flex;
      flex-direction: column;
    }
    .media-col {
      display: contents;
    }
    .img {
      position: relative;
      height: 70vw;
      order: 0;
    }
    .content {
      order: 1;
      display: contents;
    }
    .content > :global(h2),
    .content > .lead,
    .content > .seg,
    .content > .trust {
      margin-inline: var(--gutter);
    }
    .content > :global(h2) {
      order: 1;
      margin-top: 56px;
    }
    .content > .lead {
      order: 2;
    }
    .content > .seg {
      order: 3;
      align-self: flex-start;
      margin-bottom: 18px;
    }
    .card {
      order: 4;
      position: sticky;
      top: calc(var(--header-h) + 6px);
      left: auto;
      right: auto;
      bottom: auto;
      z-index: 5;
      margin: 0 var(--gutter) 22px;
      padding: 14px 16px;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 2px 12px;
      background: rgba(43, 31, 26, 0.85);
    }
    .z-label,
    .z-note {
      display: none;
    }
    .z-name {
      font-size: 1.5rem;
      margin: 0;
    }
    .z-meta {
      grid-row: 2;
      font-size: 0.85rem;
    }
    .z-foot {
      grid-column: 2;
      grid-row: 1 / 3;
      margin: 0;
      padding: 0;
      border: 0;
      flex-direction: column;
      align-items: flex-end;
      gap: 6px;
    }
    .z-price {
      font-size: 1.6rem;
    }
    .z-foot :global(.btn) {
      min-height: 40px;
      padding: 0 14px;
      font-size: 0.72rem;
    }
    .long {
      display: none;
    }
    .short {
      display: inline;
    }
    .groups {
      order: 5;
      margin-inline: var(--gutter);
    }
    .content > .trust {
      order: 6;
      margin-bottom: 64px;
    }
  }

  @media (min-width: 1000px) {
    .zf .media-col {
      position: sticky;
      top: 0;
      height: 100vh;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-zf]').forEach((root) => {
    type Z = { id: string; name: string; group: string; price: string; old: string; dur: string; note: string };
    const data: Z[] = JSON.parse(root.querySelector('[data-zf-data]')!.textContent!);
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const pills = root.querySelectorAll<HTMLButtonElement>('[data-zf-id]');
    const show = (id: string) => {
      const z = data.find((d) => d.id === id);
      if (!z) return;
      pills.forEach((p) => p.classList.toggle('is-active', p.dataset.zfId === id));
      $('[data-zf-name]').textContent = z.name;
      $('[data-zf-dur]').textContent = z.dur;
      $('[data-zf-note]').textContent = z.note;
      $('[data-zf-price]').textContent = z.price;
      $('[data-zf-old]').textContent = z.old;
      const cta = $('[data-zf-cta]') as HTMLAnchorElement;
      cta.href = cta.href.replace(/behandlung=[^&]*/, `behandlung=${z.id}`);
      for (const s of ['[data-zf-name]', '[data-zf-price]']) {
        const el = $(s);
        el.classList.remove('flash');
        void el.offsetWidth;
        el.classList.add('flash');
      }
    };
    pills.forEach((p) => p.addEventListener('click', () => show(p.dataset.zfId!)));
    root.querySelectorAll<HTMLButtonElement>('[data-zf-group]').forEach((b) =>
      b.addEventListener('click', () => {
        const g = b.dataset.zfGroup!;
        root.querySelectorAll<HTMLButtonElement>('[data-zf-group]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
        root.querySelectorAll<HTMLElement>('[data-zf-panel]').forEach((p) => (p.hidden = p.dataset.zfPanel !== g));
        show(g === 'frauen' ? 'beine-komplett' : 'ruecken-inkl-nacken');
      }),
    );
  });
</script>
