---
// Aufgeräumte Zonen-Übersicht: max. 2 Kombis (hervorgehoben) + 4 Topseller.
// Pro Karte nur: Name, Preis, ein Button.
import Icon from './Icon.astro';
import Lines from './Lines.astro';
import { services, chf, discounted, type Group } from '../data/services';

interface Props {
  code?: string;
  discount?: number;
  title?: string[];
}
const { code, discount, title = ['Topseller', '& Kombis.'] } = Astro.props;
const q = code ? `&code=${code}` : '';
const groups: { id: Group; label: string }[] = [
  { id: 'frauen', label: 'Frauen' },
  { id: 'maenner', label: 'Männer' },
];
const pick: Record<Group, { kombi: string[]; top: string[] }> = {
  frauen: { kombi: ['kombi-intim-achseln', 'ganzkoerper'], top: ['achseln', 'bikini-intim', 'unterschenkel', 'beine-komplett'] },
  maenner: { kombi: ['ganzkoerper-1', 'brust-bauch'], top: ['achseln-1', 'ruecken-inkl-nacken', 'beine'] },
};
const svc = (id: string) => services.find((s) => s.id === id)!;
const price = (p: number) => (discount ? discounted(p, discount) : p);
const kombiSub: Record<string, string> = {
  ganzkoerper: '3 Zonen deiner Wahl',
  'ganzkoerper-1': '3 Zonen deiner Wahl',
};
---

<section class="zh bg-mocha" id="zonen" data-zh>
  <div class="wrap">
    <div class="head">
      <Lines lines={title} />
      <div class="seg reveal" role="tablist" aria-label="Zonen für">
        {groups.map((g, i) => <button type="button" role="tab" aria-selected={String(i === 0)} data-zh-tab={g.id}>{g.label}</button>)}
      </div>
    </div>

    {
      groups.map((g, gi) => (
        <div class="panel" data-zh-panel={g.id} hidden={gi !== 0}>
          <div class="row kombi">
            {pick[g.id].kombi.map(svc).map((s) => (
              <a class="card k reveal" href={`/termin?behandlung=${s.id}${q}`}>
                <span class="badge">Kombi</span>
                <span class="name">{s.name}</span>
                {kombiSub[s.id] && <span class="sub">{kombiSub[s.id]}</span>}
                <span class="foot">
                  <span class="price">
                    {discount && <s>{chf(s.price)}</s>}
                    {chf(price(s.price!))}
                  </span>
                  <span class="go">
                    Buchen <Icon name="arrow" size={18} />
                  </span>
                </span>
              </a>
            ))}
          </div>
          <div class="row top">
            {pick[g.id].top.map(svc).map((s) => (
              <a class="card t reveal" href={`/termin?behandlung=${s.id}${q}`}>
                <span class="badge">Topseller</span>
                <span class="name">{s.name}</span>
                <span class="foot">
                  <span class="price">
                    {discount && <s>{chf(s.price)}</s>}
                    {chf(price(s.price!))}
                  </span>
                  <span class="go">
                    Buchen <Icon name="arrow" size={18} />
                  </span>
                </span>
              </a>
            ))}
          </div>
        </div>
      ))
    }

    <div class="more reveal">
      <p>Preise pro Sitzung · bezahlt wird vor Ort · über 30 weitere Zonen</p>
      <a class="btn btn-light" href="/preise">Alle Zonen & Preise<span class="arrow"><Icon name="arrow" size={16} /></span></a>
    </div>
  </div>
</section>

<style>
  .zh {
    padding-block: clamp(88px, 10vw, 136px);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 44px;
  }

  .head :global(h2) {
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 5.6rem);
    line-height: 0.95;
  }

  .seg {
    display: inline-flex;
    border: 1px solid rgba(246, 241, 234, 0.4);
  }

  .seg button {
    border: 0;
    background: transparent;
    padding: 16px 34px;
    cursor: pointer;
    color: rgba(246, 241, 234, 0.8);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .seg button[aria-selected='true'] {
    background: var(--cream);
    color: var(--ink);
  }

  .row {
    display: grid;
    gap: 10px;
  }

  .row + .row {
    margin-top: 10px;
  }

  @media (min-width: 700px) {
    .kombi {
      grid-template-columns: 1fr 1fr;
    }
    .top {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 28px 28px 24px;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.35s var(--ease);
  }

  .card:hover {
    transform: translateY(-4px);
  }

  .k {
    background: var(--lime);
    min-height: 250px;
  }

  .t {
    background: var(--cream);
    min-height: 210px;
  }

  .badge {
    align-self: flex-start;
    margin-bottom: 14px;
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mocha);
  }

  .k .badge {
    color: var(--ink);
  }

  .name {
    font-size: clamp(1.9rem, 2.6vw, 2.6rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  .t .name {
    font-size: clamp(1.6rem, 2vw, 2rem);
  }

  .sub {
    margin-top: 6px;
    font-size: 1.05rem;
    color: var(--ink-2);
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    margin-top: auto;
    padding-top: 22px;
  }

  .price {
    display: flex;
    flex-direction: column;
    white-space: nowrap;
    font-size: clamp(2rem, 2.8vw, 2.7rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .price s {
    font-size: 1rem;
    font-weight: 400;
    opacity: 0.6;
    margin-bottom: 4px;
  }

  .go {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 20px;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--espresso);
    color: var(--cream);
    transition: background 0.3s;
  }

  .t .go {
    background: var(--lime);
    color: var(--ink);
  }

  .card:hover .go {
    background: var(--mocha);
    color: var(--cream);
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px 32px;
    margin-top: 40px;
  }

  .more p {
    margin: 0;
    font-size: 1.1rem;
    color: rgba(246, 241, 234, 0.85);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-zh]').forEach((root) => {
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-zh-tab]');
    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
        root.querySelectorAll<HTMLElement>('[data-zh-panel]').forEach((p) => {
          p.hidden = p.dataset.zhPanel !== t.dataset.zhTab;
          if (!p.hidden) p.querySelectorAll<HTMLElement>('.reveal').forEach((r) => ((r.style.opacity = '1'), (r.style.transform = 'none')));
        });
      }),
    );
  });
</script>
