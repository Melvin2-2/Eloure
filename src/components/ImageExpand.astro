---
// Fixierte Section: Bild öffnet sich beim Scrollen von gerahmt zu randlos,
// grosse Typo liegt darüber, Glas-Karte blendet ein.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  word: string;
  title: string;
  text: string;
  ctaHref?: string;
  ctaLabel?: string;
}
const { image, alt, word, title, text, ctaHref, ctaLabel } = Astro.props;
---

<section class="expand bg-dark" data-expand>
  <div class="frame" data-expand-frame>
    <Image src={image} alt={alt} widths={[900, 1400, 2000, 2400]} sizes="100vw" />
    <div class="shade"></div>
  </div>
  <p class="word serif" data-expand-text aria-hidden="true">{word}</p>
  <div class="card glass" data-expand-text>
    <h2>{title}</h2>
    <p>{text}</p>
    {
      ctaHref && (
        <a class="btn btn-primary" href={ctaHref}>
          {ctaLabel}
          <span class="arrow">
            <Icon name="arrow" size={16} />
          </span>
        </a>
      )
    }
  </div>
</section>

<style>
  .expand {
    position: relative;
    height: 100vh;
    min-height: 640px;
    overflow: hidden;
  }

  .frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 14, 11, 0.15), rgba(20, 14, 11, 0.55));
  }

  .word {
    position: absolute;
    left: 50%;
    top: 46%;
    transform: translate(-50%, -50%);
    margin: 0;
    font-size: clamp(5rem, 22vw, 22rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: var(--cream);
    white-space: nowrap;
    pointer-events: none;
    mix-blend-mode: overlay;
    opacity: 0.95;
  }

  .card {
    position: absolute;
    right: var(--gutter);
    bottom: var(--gutter);
    max-width: 460px;
    padding: clamp(24px, 3vw, 40px);
  }

  .card h2 {
    font-size: clamp(2rem, 3.4vw, 3rem);
  }

  .card p {
    color: rgba(246, 241, 234, 0.85);
    margin-bottom: 26px;
  }

  @media (max-width: 899px) {
    .expand {
      height: auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }
    .frame {
      position: relative;
      height: 78vw;
    }
    .word {
      top: 39vw;
    }
    .card {
      position: relative;
      right: auto;
      bottom: auto;
      max-width: none;
      margin: -60px var(--gutter) var(--gutter);
    }
  }
</style>
