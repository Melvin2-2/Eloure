---
// Stimmen & Fragen: ein grosses Zitat sofort sichtbar, weitere per Thema wählbar,
// darunter nur die vier wichtigsten Fragen (zugeklappt). Details auf /faq.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Lines from './Lines.astro';
import { site } from '../data/site';
import { googleRating, pickReview } from '../data/reviews';
import { shortFaqs } from '../data/faq';
import img from '../assets/shoot/beratung-kundin.jpg';

const quotes = [
  { label: 'Nervosität', r: pickReview('Cindy A.') },
  { label: 'Ergebnis', r: pickReview('Julia F.') },
  { label: 'Beratung', r: pickReview('Dina G.') },
  { label: 'Wohlfühlen', r: pickReview('Natalie B.') },
];
const rating = googleRating.rating.toFixed(1).replace('.', ',');
---

<section class="vf bg-lime" data-voices>
  <div class="pic" data-anim="img">
    <div class="flip">
      <Image src={img} alt="Kundin lacht im Beratungsgespräch im Eloure Studio" widths={[700, 1100, 1600]} sizes="(min-width: 1000px) 40vw, 100vw" />
    </div>
    <a class="score glass" href={site.googleReviewsUrl} target="_blank" rel="noopener" aria-label={`${rating} von 5 Sternen aus ${googleRating.count} Google-Bewertungen`}>
      <span class="num">{rating}</span>
      <span class="meta">
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span>{googleRating.count} Google-Bewertungen</span>
      </span>
    </a>
  </div>

  <div class="content">
    <Lines lines={['Unsicher?', 'Ganz normal.']} class="ol vf-title" />

    <div class="quotes reveal" aria-live="polite">
      {
        quotes.map((q, i) => (
          <figure class:list={['q', { 'is-active': i === 0 }]} data-q aria-hidden={i === 0 ? 'false' : 'true'}>
            <blockquote>«{q.r.short}»</blockquote>
            <figcaption>
              <span class="stars" aria-hidden="true">★★★★★</span> {q.r.name} · Google
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="topics reveal" role="tablist" aria-label="Stimmen nach Thema">
      {
        quotes.map((q, i) => (
          <button type="button" role="tab" aria-selected={String(i === 0)} data-q-tab={i}>
            {q.label}
          </button>
        ))
      }
    </div>

    <div class="faq reveal">
      {
        shortFaqs.map((f) => (
          <details>
            <summary>
              {f.q}
              <Icon name="plus" size={18} />
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>

    <div class="btn-row reveal">
      <a class="btn btn-dark" href="/termin?behandlung=beratungsgespraech">Kostenlos beraten lassen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
      <a class="text-link" href="/faq">Alle Fragen</a>
    </div>
  </div>
</section>

<style>
  .vf {
    display: grid;
  }

  .pic {
    position: relative;
    overflow: hidden;
    min-height: 105vw;
  }

  .flip {
    position: absolute;
    inset: 0;
  }

  .pic :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 35% 22%;
  }

  @media (min-width: 1000px) {
    .vf {
      grid-template-columns: 0.8fr 1.2fr;
      min-height: 100vh;
    }
    .vf .content {
      justify-content: flex-start;
      padding-top: clamp(48px, 5vw, 80px);
    }
    .vf .pic {
      position: sticky;
      top: 0;
      align-self: start;
      height: 100vh;
      min-height: 0;
    }
  }

  .score {
    position: absolute;
    z-index: 2;
    left: var(--gutter);
    top: var(--gutter);
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 14px 20px;
    text-decoration: none;
    color: var(--cream);
    --head: currentColor;
    background: rgba(27, 30, 42, 0.55);
  }

  @media (min-width: 1000px) {
    .score {
      top: auto;
      bottom: var(--gutter);
    }
  }

  .num {
    font-family: var(--serif);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: 2.8rem;
    line-height: 0.9;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.95rem;
  }

  .score .stars {
    color: var(--lime);
    letter-spacing: 3px;
  }

  .content {
    padding: var(--section) var(--gutter);
    max-width: 880px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .content :global(.vf-title) {
    font-size: clamp(2.8rem, 6vw, 6.4rem);
    line-height: 0.95;
    margin-bottom: clamp(28px, 3vw, 44px);
  }

  .quotes {
    display: grid;
  }

  .q {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px);
    transition:
      opacity 0.55s var(--ease),
      transform 0.55s var(--ease),
      visibility 0.55s;
  }

  .q.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  blockquote {
    margin: 0 0 16px;
    font-size: clamp(1.55rem, 2.5vw, 2.4rem);
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  figcaption {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  figcaption .stars {
    color: var(--espresso);
    letter-spacing: 2px;
    margin-right: 6px;
  }

  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 28px 0 44px;
  }

  .topics button {
    padding: 10px 16px;
    border: 1px solid rgba(43, 47, 64, 0.35);
    background: transparent;
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s;
  }

  .topics button:hover {
    border-color: var(--espresso);
  }

  .topics button[aria-selected='true'] {
    background: var(--espresso);
    border-color: var(--espresso);
    color: var(--lime);
  }

  .faq {
    border-top: 1px solid rgba(43, 47, 64, 0.25);
    margin-bottom: 36px;
    interpolate-size: allow-keywords;
  }

  /* sanftes Auf- und Zuklappen (wo der Browser es unterstützt) */
  .faq details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.45s var(--ease),
      content-visibility 0.45s allow-discrete;
  }

  .faq details[open]::details-content {
    block-size: auto;
  }

  .faq details {
    border-bottom: 1px solid rgba(43, 47, 64, 0.25);
  }

  .faq summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 16px 0;
    cursor: pointer;
    font-weight: 700;
    font-size: 1.08rem;
    color: var(--ink);
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary :global(svg) {
    flex: none;
    transition: transform 0.3s var(--ease);
  }

  .faq details[open] summary :global(svg) {
    transform: rotate(45deg);
  }

  .faq p {
    margin: 0 0 18px;
    color: var(--ink-2);
    max-width: 38em;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-voices]').forEach((root) => {
    const qs = [...root.querySelectorAll<HTMLElement>('[data-q]')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-q-tab]')];
    let i = 0;
    let timer: number | undefined;
    const show = (n: number) => {
      i = (n + qs.length) % qs.length;
      qs.forEach((q, j) => {
        q.classList.toggle('is-active', j === i);
        q.setAttribute('aria-hidden', String(j !== i));
      });
      tabs.forEach((t, j) => t.setAttribute('aria-selected', String(j === i)));
    };
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stop = () => window.clearInterval(timer);
    const auto = () => {
      if (reduce) return;
      stop();
      timer = window.setInterval(() => show(i + 1), 6500);
    };
    tabs.forEach((t, j) =>
      t.addEventListener('click', () => {
        stop();
        show(j);
      }),
    );
    new IntersectionObserver((e) => (e[0].isIntersecting ? auto() : stop())).observe(root);
  });
</script>
