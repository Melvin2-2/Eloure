---
// Kombi aus Kundenstimmen und den wichtigsten Fragen – bewusst kurz.
// Die ausführlichen Antworten stehen auf /faq.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Lines from './Lines.astro';
import { site } from '../data/site';
import { googleRating, pickReview } from '../data/reviews';
import { shortFaqs } from '../data/faq';
import img from '../assets/shoot/beratung-kundin.jpg';


const quotes = ['Cindy A.', 'Julia F.', 'Dina G.'].map(pickReview);
const rating = googleRating.rating.toFixed(1).replace('.', ',');
---

<section class="vf bg-dark">
  <div class="pic ol-shade" data-anim="img">
    <Image src={img} alt="Kundin lacht im Beratungsgespräch im Eloure Studio" widths={[700, 1100, 1600]} sizes="(min-width: 1000px) 42vw, 100vw" />
    <a class="score glass" href={site.googleReviewsUrl} target="_blank" rel="noopener" aria-label={`${rating} von 5 Sternen aus ${googleRating.count} Google-Bewertungen`}>
      <span class="num">{rating}</span>
      <span class="meta">
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span>{googleRating.count} Google-Bewertungen</span>
      </span>
    </a>
  </div>

  <div class="content">
    <Lines lines={['Unsicher?', 'Ganz normal.']} class="ol vf-title" />
    <p class="lead reveal">Das sagen Kundinnen nach dem ersten Mal – und das fragen uns fast alle vorher.</p>

    <ul class="quotes">
      {
        quotes.map((r, i) => (
          <li class="reveal" style={`--d:${i * 80}ms`}>
            <blockquote>«{r.short}»</blockquote>
            <span class="who">{r.name} · Google</span>
          </li>
        ))
      }
    </ul>

    <dl class="faq">
      {
        shortFaqs.map((f) => (
          <div class="reveal">
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))
      }
    </dl>

    <div class="btn-row reveal">
      <a class="btn btn-primary" href="/termin?behandlung=beratungsgespraech">Kostenlos beraten lassen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
      <a class="text-link" href="/faq">Alle Fragen</a>
      <a class="text-link" href={site.googleReviewsUrl} target="_blank" rel="noopener">Alle Bewertungen</a>
    </div>
  </div>
</section>

<style>
  .vf {
    display: grid;
  }

  .pic {
    position: relative;
    overflow: hidden;
    min-height: 112vw;
  }

  .pic :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
  }

  @media (min-width: 1000px) {
    .vf {
      grid-template-columns: 0.85fr 1.15fr;
    }
    .vf .pic {
      position: sticky;
      top: 0;
      height: 100vh;
      min-height: 0;
    }
  }

  .score {
    position: absolute;
    z-index: 2;
    left: var(--gutter);
    top: var(--gutter);
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 14px 20px;
    text-decoration: none;
    color: var(--cream);
  }

  @media (min-width: 1000px) {
    .score {
      top: auto;
      bottom: var(--gutter);
    }
  }

  .num {
    font-family: var(--serif);
    font-weight: var(--display-weight);
    font-stretch: 75%;
    font-size: 3rem;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.95rem;
  }

  .stars {
    color: var(--lime);
    letter-spacing: 3px;
  }

  .content {
    padding: var(--section) var(--gutter);
    max-width: 860px;
  }

  .content :global(.vf-title) {
    --ol-off: var(--cream);
    font-size: clamp(3.2rem, 6.6vw, 6.8rem);
    line-height: 0.95;
  }

  .quotes {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line-light);
  }

  .quotes li {
    padding: 22px 0;
    border-bottom: 1px solid var(--line-light);
  }

  blockquote {
    margin: 0 0 8px;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.32;
    color: var(--cream);
  }

  .who {
    font-size: 0.92rem;
    color: rgba(246, 241, 234, 0.65);
  }

  .faq {
    margin: 48px 0 44px;
    display: grid;
    gap: 28px 40px;
  }

  @media (min-width: 700px) {
    .faq {
      grid-template-columns: 1fr 1fr;
    }
  }

  dt {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--lime);
    margin-bottom: 6px;
  }

  dd {
    margin: 0;
    color: rgba(246, 241, 234, 0.82);
    line-height: 1.55;
  }

  .btn-row .text-link {
    color: var(--cream);
  }
</style>
