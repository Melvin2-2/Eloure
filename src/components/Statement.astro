---
import Icon from './Icon.astro';
interface Props {
  text: string;
  ctaHref?: string;
  ctaLabel?: string;
  linkHref?: string;
  linkLabel?: string;
}
const { text, ctaHref, ctaLabel, linkHref, linkLabel } = Astro.props;
---

<section class="section statement">
  <div class="wrap">
    <p class="big" data-words>{text}</p>
    {
      ctaHref && (
        <div class="btn-row reveal">
          <a class="btn btn-primary" href={ctaHref}>
            {ctaLabel}
            <span class="arrow">
              <Icon name="arrow" size={18} />
            </span>
          </a>
          {linkHref && (
            <a class="text-link" href={linkHref}>
              {linkLabel}
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .big {
    font-size: clamp(1.9rem, 4.4vw, 3.9rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 500;
    max-width: 22em;
    margin-bottom: 48px;
    text-wrap: balance;
  }

  .big :global(.w) {
    opacity: 0.18;
    transition: opacity 0.4s ease;
  }

  .big :global(.w.on) {
    opacity: 1;
  }
</style>
