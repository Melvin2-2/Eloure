---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Seite nicht gefunden | Eloure The Studio" description="Diese Seite gibt es leider nicht." noindex>
  <section class="section">
    <div class="wrap wrap-narrow" style="text-align:center">
      <h1>Hier ist leider nichts.</h1>
      <p class="lead" style="margin-inline:auto">Die Seite wurde verschoben oder existiert nicht mehr. Aber keine Sorge – zu deinem Termin geht’s hier entlang.</p>
      <div class="btn-row" style="justify-content:center;margin-top:28px">
        <a class="btn btn-primary" href="/termin">Termin buchen<span class="arrow"><Icon name="arrow" size={15} /></span></a>
        <a class="btn btn-ghost" href="/">Zur Startseite</a>
      </div>
    </div>
  </section>
</Base>
