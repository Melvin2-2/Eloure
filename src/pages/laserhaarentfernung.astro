---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import StoryPath from '../components/StoryPath.astro';
import { Image } from 'astro:assets';
import LoopVideo from '../components/LoopVideo.astro';
import Lines from '../components/Lines.astro';
import imgHero from '../assets/shoot/geraet.jpg';
import CtaFinal from '../components/CtaFinal.astro';
import Icon from '../components/Icon.astro';
---

<Base
  title="Wie funktioniert Laserhaarentfernung? | Eloure The Studio Amriswil"
  description="Wie Laserhaarentfernung wirkt, wie viele Sitzungen du brauchst, für wen sie geeignet ist und wie du dich optimal vorbereitest – ehrlich erklärt von Eloure in Amriswil."
>
  <PageHero
    variant="shape"
    title={['So wirkt', 'der Laser.']}
    sub="Ehrlich erklärt."
    image={imgHero}
    alt="Behandlerin am medizinischen Diodenlaser"
    lead="Wer versteht, was passiert, fühlt sich sicherer. Darum erklären wir dir hier alles Wichtige – ohne Fachchinesisch und ohne leere Versprechen."
  >
    <div class="btn-row">
      <a class="btn btn-primary" href="/termin">Termin buchen<span class="arrow"><Icon name="arrow" size={15} /></span></a>
      <a class="btn btn-ghost" href="/termin?behandlung=beratungsgespraech">Kostenlos beraten lassen</a>
    </div>
  </PageHero>

  <!-- Wirkung -->
  <section class="wirk bg-mist">
    <div class="w-content">
      <Lines lines={['Licht, das die', 'Haarwurzel trifft.']} class="w-title" />
      <p class="lead reveal">
        Unser medizinischer Diodenlaser sendet gebündeltes Licht, das vom Farbstoff im Haar – dem Melanin – aufgenommen wird.
      </p>
      <p class="reveal">
        Die Energie wird in Wärme umgewandelt und zerstört gezielt die Haarwurzel, ohne die umliegende Haut stark zu belasten.
        So wird das Nachwachsen gehemmt oder gestoppt. Weil der Laser so präzise arbeitet, ist die Behandlung schonender als
        Wachsen oder Epilieren.
      </p>
      <p class="reveal">
        <strong>Laser statt IPL:</strong> Ein Laser arbeitet mit einem fokussierten Lichtstrahl in einer bestimmten Wellenlänge
        und trifft die Haarwurzel sehr gezielt. IPL nutzt ein breites Lichtspektrum, das weniger zielgerichtet und oft weniger
        effektiv ist. Wir arbeiten ausschliesslich mit einem medizinischen Diodenlaser.
      </p>
      <p class="muted small reveal">Fachbegriff: selektive Photothermolyse.</p>
    </div>
    <div class="w-img" data-anim="img">
      <LoopVideo name="laser-knie" label="Laser-Handstück mit Licht auf der Haut am Knie" pos="center 60%" />
    </div>
  </section>

  <!-- Sitzungen: Wachstumsphasen -->
  <section class="cycle">
    <div class="cy-head">
      <h2 class="reveal">Warum mehrere<br />Sitzungen?</h2>
      <p class="reveal">Deine Haare wachsen nicht alle gleichzeitig. Wirksam behandeln lässt sich nur ein Haar, das gerade aktiv wächst.</p>
    </div>

    <ol class="cy-phases">
      <li class="reveal is-active">
        <span class="cy-track" style="--w:100%"></span>
        <h3>Wachstumsphase</h3>
        <p>Das Haar wächst aktiv und enthält am meisten Melanin – hier wirkt der Laser.</p>
      </li>
      <li class="reveal">
        <span class="cy-track" style="--w:50%"></span>
        <h3>Übergangsphase</h3>
        <p>Das Haar löst sich von der Wurzel und reagiert kaum noch auf den Laser.</p>
      </li>
      <li class="reveal">
        <span class="cy-track" style="--w:18%"></span>
        <h3>Ruhephase</h3>
        <p>Die Wurzel ruht. Diese Haare erreichen wir in einer späteren Sitzung.</p>
      </li>
    </ol>

    <dl class="cy-facts reveal">
      <div>
        <dt>Individuell</dt>
        <dd>Anzahl Sitzungen – je nach Zone, Haardichte, Hauttyp und Hormonen.</dd>
      </div>
      <div>
        <dt>4–8 Wochen</dt>
        <dd>Abstand am Anfang, später bis zu 12 Wochen.</dd>
      </div>
      <div>
        <dt>1–3 Wochen</dt>
        <dd>bis die behandelten Haare ausfallen.</dd>
      </div>
    </dl>
    <p class="cy-note reveal">Keine Standard-Versprechen wie «8 Behandlungen für alle» – dein Plan richtet sich nach deinem Körper.</p>
  </section>

  <!-- Eignung -->
  <section class="section bg-sand">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>Ist das etwas für mich?</h2>
        <p class="lead">Das klären wir immer persönlich mit dir. Als erste Orientierung:</p>
      </div>
      <div class="fit">
        <div class="fit-col reveal">
          <h3><span class="badge good">Sehr gut geeignet</span></h3>
          <ul class="check-list">
            <li>Dunklere Haare auf hellerer bis mittlerer Haut</li>
            <li>Frauen und Männer, fast alle Körperzonen</li>
            <li>Wenn du Rasieren, Wachsen oder Epilieren satt hast</li>
          </ul>
        </div>
        <div class="fit-col reveal">
          <h3><span class="badge mid">Eingeschränkt</span></h3>
          <ul>
            <li><strong>Sehr helle, graue oder rote Haare</strong> enthalten wenig Melanin – der Laser wirkt dort schwächer.</li>
            <li><strong>Sehr dunkle Haut:</strong> Wir machen vorher einen Teststreifen an einer kleinen Stelle.</li>
          </ul>
        </div>
        <div class="fit-col reveal">
          <h3><span class="badge no">Im Moment nicht möglich</span></h3>
          <ul>
            <li>Schwangerschaft und Stillzeit</li>
            <li>Frische Bräune oder sonnengeschädigte Haut</li>
            <li>Aktive Hauterkrankungen (z. B. Ekzeme, Psoriasis, Akne) in der Zone</li>
            <li>Lichtsensibilisierende Medikamente (z. B. bestimmte Antibiotika, Isotretinoin)</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Ablauf -->
  <StoryPath title={['Dein Ablauf', 'bei uns.']} />

  <!-- Vorbereitung -->
  <section class="section bg-mist" id="vorbereitung">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>Gut vorbereitet in 2 Minuten</h2>
        <p class="lead">Mit diesen Tipps holst du das Beste aus jeder Sitzung heraus.</p>
      </div>
      <div class="prep">
        <div class="prep-card reveal">
          <h3>Vor der Behandlung</h3>
          <ul class="check-list">
            <li><span><strong>24–48 Std. vorher rasieren</strong> – leichte Stoppeln sollen noch sichtbar sein</span></li>
            <li><span><strong>4 Wochen vorher</strong> nicht mehr wachsen, zupfen oder epilieren</span></li>
            <li><span><strong>14 Tage vorher</strong> keine direkte Sonne und keine frische Bräune</span></li>
            <li><span>In den Wochen davor <strong>keinen Selbstbräuner</strong></span></li>
            <li><span><strong>10 Tage vorher</strong> keine Säurepeelings oder Retinoide auf der Zone</span></li>
            <li><span>Medikamente? <strong>Sag uns vorher Bescheid</strong></span></li>
            <li><span>Genug trinken – das hilft deiner Haut mit der Wärme</span></li>
          </ul>
        </div>
        <div class="prep-card dark reveal">
          <h3>Nach der Behandlung</h3>
          <ul class="check-list">
            <li><span><strong>Kühlen</strong> reduziert Rötungen</span></li>
            <li><span>Eine <strong>sanfte Feuchtigkeitscreme</strong> beruhigt die Haut</span></li>
            <li><span><strong>2 Wochen</strong> keine direkte Sonne – sonst LSF 50</span></li>
            <li><span><strong>2 Tage</strong> kein Chlor- oder Salzwasser, kein starkes Schwitzen</span></li>
            <li><span>Zwischen den Sitzungen nur <strong>rasieren</strong> – nicht wachsen oder zupfen</span></li>
          </ul>
          <p class="tip">
            <strong>Tipp fürs Gesicht:</strong> Nimm einen Rasierer mit nur einer Klinge und rasiere in Wuchsrichtung.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaFinal />
</Base>

<style>
  .wirk {
    display: grid;
  }

  @media (min-width: 1000px) {
    .wirk {
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
    }
  }

  .w-content {
    position: relative;
    z-index: 2;
    padding: var(--section) var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 780px;
  }

  @media (min-width: 1000px) {
    .w-content :global(.w-title) {
      width: max-content;
    }
  }

  .w-content p:not(.lead) {
    color: var(--ink-body);
  }

  .w-img {
    position: relative;
    overflow: hidden;
    min-height: 100vw;
  }

  @media (min-width: 1000px) {
    .w-img {
      min-height: 0;
    }
  }

  .w-img :global(img),
  .w-img :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ipl {
    padding-block: var(--section);
  }

  .ipl-grid {
    display: grid;
    gap: 24px 80px;
  }

  @media (min-width: 960px) {
    .ipl-grid {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }

  .ipl .lead {
    color: var(--espresso);
  }

  .ipl .btn-row {
    margin-top: 28px;
  }

  /* Wachstumsphasen */
  .cycle {
    padding-block: clamp(130px, 13vw, 200px);
  }

  .cy-head {
    max-width: 860px;
    margin: 0 auto clamp(64px, 7vw, 100px);
    padding-inline: var(--gutter);
    text-align: center;
  }

  .cy-head h2 {
    margin: 0 0 0.45em;
    font-weight: 200;
    font-size: clamp(2.8rem, 5.6vw, 6rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .cy-head p {
    max-width: 32em;
    margin: 0 auto;
    color: var(--ink-2);
  }

  .cy-phases {
    list-style: none;
    display: grid;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--gutter);
    border-top: 1px solid var(--line-strong);
  }

  .cy-phases li {
    padding: 36px clamp(0px, 2vw, 32px) 36px;
  }

  .cy-track {
    position: relative;
    display: block;
    height: 2px;
    margin-bottom: 30px;
    background: var(--line-strong);
  }

  .cy-track::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--w);
    background: var(--ink-2);
  }

  .is-active .cy-track::after {
    background: var(--cta);
  }

  .cy-phases h3 {
    margin: 0 0 12px;
    font-weight: 300;
    font-size: clamp(1.15rem, 1.5vw, 1.4rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .is-active h3 {
    color: var(--cta);
  }

  .cy-phases p {
    margin: 0;
    max-width: 22em;
    color: var(--ink-2);
  }

  @media (min-width: 900px) {
    .cy-phases {
      grid-template-columns: repeat(3, 1fr);
    }
    .cy-phases li + li {
      border-left: 1px solid var(--line-strong);
    }
    .cy-phases li:first-child {
      padding-left: 0;
    }
  }

  @media (max-width: 899px) {
    .cy-phases li + li {
      border-top: 1px solid var(--line-strong);
    }
  }

  .cy-facts {
    display: grid;
    max-width: 1240px;
    margin: clamp(56px, 6vw, 88px) auto 0;
    padding: 0 var(--gutter);
    gap: 28px 48px;
  }

  .cy-facts div {
    padding-top: 22px;
    border-top: 1px solid var(--line-strong);
  }

  .cy-facts dt {
    margin-bottom: 8px;
    font-weight: 200;
    font-size: clamp(1.8rem, 2.8vw, 2.6rem);
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--ink);
  }

  .cy-facts dd {
    margin: 0;
    color: var(--ink-2);
  }

  @media (min-width: 900px) {
    .cy-facts {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .cy-note {
    max-width: 1240px;
    margin: 48px auto 0;
    padding: 0 var(--gutter);
    font-size: 1rem;
    color: var(--ink-2);
  }

  .fit {
    display: grid;
    gap: 12px;
  }

  @media (min-width: 900px) {
    .fit {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .fit-col {
    padding: 28px;
    border-radius: var(--radius);
    background: var(--paper);
  }

  .fit-col ul:not(.check-list) {
    padding-left: 1.1em;
    margin: 0;
    display: grid;
    gap: 10px;
    color: var(--ink-2);
  }

  .badge {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.94rem;
  }

  .badge.good {
    background: var(--linen);
  }

  .badge.mid {
    background: var(--blush);
  }

  .badge.no {
    background: var(--stone);
  }

  .prep {
    display: grid;
    gap: 12px;
  }

  @media (min-width: 900px) {
    .prep {
      grid-template-columns: 1fr 1fr;
    }
  }

  .prep-card {
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--radius);
    background: var(--bg);
  }

  .prep-card h3 {
    font-family: var(--sans);
    margin-bottom: 20px;
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .prep-card.dark {
    background: var(--ink);
    color: var(--paper);
    --head: currentColor;
  }

  .tip {
    margin-top: 24px;
    padding-top: 20px;
    color: rgba(250, 251, 252, 0.8);
    font-size: 0.95rem;
  }

</style>
