---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import imgHero from '../assets/shoot/beratung-haende.jpg';
import FaqList from '../components/FaqList.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Icon from '../components/Icon.astro';
import { faqGroups, allFaqs } from '../data/faq';
import { site } from '../data/site';

const slug = (t: string) =>
  t.toLowerCase().replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/&/g, 'und').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<Base
  title="Häufige Fragen zur Laserhaarentfernung | Eloure The Studio"
  description="Tut Laserhaarentfernung weh? Wie viele Sitzungen brauche ich? Was muss ich vorher beachten? Alle Antworten von Eloure The Studio in Amriswil."
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: allFaqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() },
      })),
    },
  ]}
>
  <PageHero
    title={['Deine Fragen.', 'Ehrlich beantwortet.']}
    sub="Keine Frage ist zu klein."
    image={imgHero}
    alt="Beratungsgespräch mit Tablet in der Studio-Lounge"
    position="center 45%"
    lead="Es gibt keine dummen Fragen – schon gar nicht vor einer Behandlung, die so persönlich ist. Hier findest du alles, was uns am häufigsten gefragt wird."
  />

  <section class="section bg-paper">
    <div class="wrap layout">
      <nav class="toc" aria-label="Themen">
        <ul>
          {faqGroups.map((g) => <li><a href={`#${slug(g.title)}`} data-toc={slug(g.title)}>{g.title}</a></li>)}
        </ul>
        <div class="toc-help">
          <p><strong>Nicht fündig geworden?</strong> Schreib uns – wir antworten persönlich.</p>
          <a class="btn btn-ghost btn-block" href={site.whatsappHref} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> WhatsApp</a>
          <a class="btn btn-ghost btn-block" href={site.phoneHref}><Icon name="phone" size={18} /> {site.phone}</a>
        </div>
      </nav>

      <div class="groups">
        {
          faqGroups.map((g) => (
            <section id={slug(g.title)} class="group" data-group>
              <header class="g-head">
                <h2>{g.title}</h2>
                {g.intro && <p>{g.intro}</p>}
              </header>
              <FaqList items={g.items} />
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <CtaFinal title="Alles klar? Dann bis bald." />
</Base>

<script>
  // Aktives Thema in der Navigation hervorheben
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc!, a]));
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a, id) => a.classList.toggle('is-active', id === e.target.id));
      }
    },
    { rootMargin: '-35% 0px -60% 0px' },
  );
  document.querySelectorAll('[data-group]').forEach((g) => io.observe(g));
</script>

<style>
  .layout {
    display: grid;
    gap: 40px 72px;
  }

  @media (min-width: 960px) {
    .layout {
      grid-template-columns: 280px 1fr;
    }
    .toc {
      position: sticky;
      top: calc(var(--header-h) + 32px);
      align-self: start;
    }
  }

  .toc ul {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .toc ul a {
    display: block;
    padding: 10px 14px;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-2);
    border: 1px solid var(--line-strong);
    transition:
      color 0.25s,
      background 0.25s,
      border-color 0.25s;
  }

  .toc ul a:hover,
  .toc ul a.is-active {
    color: #fff;
    background: var(--cta);
    border-color: var(--cta);
  }

  @media (min-width: 960px) {
    .toc ul {
      flex-direction: column;
      gap: 0;
      border-left: 1px solid var(--line-strong);
    }
    .toc ul a {
      padding: 12px 0 12px 18px;
      border: 0;
      border-left: 2px solid transparent;
      margin-left: -1px;
    }
    .toc ul a:hover,
    .toc ul a.is-active {
      color: var(--cta);
      background: transparent;
      border-left-color: var(--cta);
    }
  }

  .toc-help {
    display: none;
    padding: 22px;
    border-radius: var(--radius);
    background: var(--paper);
    border: 1px solid var(--line);
  }

  .toc-help p {
    font-size: 0.93rem;
  }

  .toc-help .btn {
    margin-top: 8px;
    min-height: 46px;
  }

  @media (min-width: 960px) {
    .toc-help {
      display: block;
    }
  }

  /* Gruppen: farbiger Kopf, darunter die Fragen als Linien */
  .group {
    scroll-margin-top: 32px;
    background: rgba(255, 255, 255, 0.4);
  }

  .group + .group {
    margin-top: 40px;
  }

  .g-head {
    padding: clamp(24px, 3vw, 36px) clamp(22px, 3vw, 40px);
    background: var(--frost);
    --ink-2: #33363a;
  }

  .group:nth-child(even) .g-head {
    background: var(--veil);
  }

  .g-head h2 {
    margin: 0;
    font-weight: 200;
    font-size: clamp(1.9rem, 3.2vw, 2.8rem);
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--ink);
  }

  .g-head p {
    margin: 10px 0 0;
    max-width: 34em;
    color: var(--ink-2);
  }

  .group :global(.faq) {
    padding: 4px clamp(22px, 3vw, 40px) 18px;
    border-top: 0;
  }

  .group :global(summary) {
    font-weight: 400;
    transition: color 0.25s;
  }

  .group :global(summary:hover),
  .group :global(details[open] > summary) {
    color: var(--cta);
  }

  .group :global(details[open] .pm) {
    background: var(--cta);
    border-color: var(--cta);
    color: #fff;
  }

  .group :global(details[open] .answer) {
    padding-left: 18px;
    border-left: 2px solid var(--cta);
  }
</style></style>
