---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Marquee from '../components/Marquee.astro';
import Statement from '../components/Statement.astro';
import ZoneFinder from '../components/ZoneFinder.astro';
import Counters from '../components/Counters.astro';
import StickySteps from '../components/StickySteps.astro';
import FaqList from '../components/FaqList.astro';
import Gallery from '../components/Gallery.astro';
import Reviews from '../components/Reviews.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { site } from '../data/site';
import { pickFaqs, topFaqIds } from '../data/faq';

import imgHero from '../assets/img/consultation.jpg';
import imgDevice from '../assets/img/team-device.jpg';
import imgDuo from '../assets/img/team-duo.jpg';
import imgRoom from '../assets/img/treatment-room.jpg';

const faqs = pickFaqs(topFaqIds);
const zones = ['Achseln', 'Bikini / Intim', 'Beine', 'Gesicht', 'Oberlippe', 'Rücken', 'Brust & Bauch', 'Arme', 'Nacken', 'Ganzkörper'];
---

<Base
  title="Laserhaarentfernung in Amriswil | Eloure The Studio"
  description="Laserhaarentfernung in Amriswil mit medizinischem Diodenlaser – persönlich betreut von Caro & Sarah. Transparente Preise ab CHF 29, bezahlt wird erst vor Ort. Jetzt Termin buchen."
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() },
      })),
    },
  ]}
>
  <!-- 1 · Hero: in 2 Sekunden klar, was, wo, für wen -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1 class="display reveal">Laserhaar&shy;entfernung, die sich gut anfühlt.</h1>
        <p class="lead reveal" style="--d:100ms">
          Dauerhaft glatte Haut mit medizinischem Diodenlaser – persönlich betreut von Caro & Sarah in Amriswil.
        </p>
        <div class="btn-row reveal" style="--d:180ms">
          <a class="btn btn-primary" href="/termin">Termin buchen<span class="arrow"><Icon name="arrow" size={18} /></span></a>
          <a class="btn btn-ghost" href="#zonen">Preise ansehen</a>
        </div>
        <ul class="trust reveal" style="--d:260ms">
          <li><strong>ab CHF 29</strong><span>pro Zone</span></li>
          <li><strong>Vor Ort</strong><span>bezahlen</span></li>
          <li><strong>V‑NISSG</strong><span>zertifiziert</span></li>
          <li>
            <a href={site.googleReviewsUrl} target="_blank" rel="noopener"><strong>★★★★★</strong><span>Google-Bewertungen</span></a>
          </li>
        </ul>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-img">
        <Image
          src={imgHero}
          alt="Persönliches Beratungsgespräch in der hellen Lounge des Eloure Studios"
          widths={[600, 900, 1300, 1800]}
          sizes="(min-width: 960px) 48vw, 100vw"
          loading="eager"
          fetchpriority="high"
          data-parallax="0.05"
        />
      </div>
      <div class="hero-video">
        <video autoplay muted loop playsinline preload="metadata" poster="/videos/behandlung-gel.jpg" aria-label="Ausschnitt einer Laserbehandlung im Studio">
          <source src="/videos/behandlung-gel.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="hero-tag"><span class="dot"></span> Bahnhofstrasse 20, Amriswil</div>
    </div>
  </section>

  <Marquee items={zones} />

  <!-- 2 · Haltung: wer wir sind, in einem Satz -->
  <Statement
    text="Wir sind kein Beauty-Allrounder. Wir machen nur eines: Laserhaarentfernung – mit medizinischem Diodenlaser, ehrlicher Beratung und so viel Zeit, wie du brauchst."
    ctaHref="#zonen"
    ctaLabel="Zone & Preis finden"
    linkHref="/studio"
    linkLabel="Wer wir sind"
  />

  <!-- 3 · Nutzen: Problem → Lösung -->
  <section class="section-tight benefits">
    <div class="wrap b-grid">
      <div class="b-img reveal-img">
        <Image src={imgDevice} alt="Behandlerin am medizinischen Diodenlaser" widths={[500, 800, 1100]} sizes="(min-width: 960px) 40vw, 100vw" data-parallax="0.05" />
      </div>
      <div class="b-content">
        <h2 class="reveal">Schluss mit Rasieren, Pickeln und eingewachsenen Haaren.</h2>
        <p class="lead reveal">
          Der Laser trifft gezielt die Haarwurzel. So reduzierst du deinen Haarwuchs langfristig – schonender für die Haut und
          mit deutlich weniger Aufwand.
        </p>
        <div class="b-cards">
          <div class="b-card reveal"><Icon name="leaf" size={26} /><h3>Langfristig glatt</h3><p>Weniger Haare, Sitzung für Sitzung – statt jeden zweiten Tag rasieren.</p></div>
          <div class="b-card reveal" style="--d:80ms"><Icon name="heart" size={26} /><h3>Schonend zur Haut</h3><p>Kein Ziehen, kein Reissen. Weniger Rötungen und eingewachsene Haare.</p></div>
          <div class="b-card reveal" style="--d:160ms"><Icon name="shield" size={26} /><h3>Sicher & zertifiziert</h3><p>Medizinischer Diodenlaser, Sachkunde nach V‑NISSG, 5 Jahre Erfahrung.</p></div>
          <div class="b-card reveal" style="--d:240ms"><Icon name="chat" size={26} /><h3>Ehrlich beraten</h3><p>Keine Standard-Versprechen. Wir sagen dir, was bei dir realistisch ist.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · Interaktiv: Zone wählen → Preis → buchen -->
  <ZoneFinder />

  <!-- 5 · Vertrauen in Zahlen -->
  <Counters
    items={[
      { value: 5, label: 'Jahre Erfahrung in der Laserhaarentfernung' },
      { value: 3, label: 'Jahre im eigenen Studio in Amriswil' },
      { value: 30, suffix: '+', label: 'Zonen für Frauen und Männer' },
      { value: 100, suffix: ' %', label: 'Fokus auf Laser – nichts anderes' },
    ]}
  />

  <!-- 6 · Ablauf mit mitlaufendem Bild -->
  <StickySteps />

  <!-- 7 · Ängste abbauen -->
  <section class="section fears bg-linen">
    <div class="wrap f-grid">
      <div class="f-side">
        <div class="f-img reveal-img">
          <Image src={imgRoom} alt="Ruhiger Behandlungsraum mit Laserliege" widths={[480, 760, 1000]} sizes="(min-width: 960px) 36vw, 100vw" />
        </div>
      </div>
      <div>
        <h2 class="reveal">Unsicher? Das sind fast alle beim ersten Mal.</h2>
        <p class="lead reveal">Hier die ehrlichen Antworten auf die Fragen, die uns am häufigsten gestellt werden.</p>
        <div class="reveal"><FaqList items={faqs} open="schmerz" /></div>
        <div class="f-cta reveal">
          <a class="btn btn-primary" href="/termin?behandlung=beratungsgespraech">Kostenlos beraten lassen<span class="arrow"><Icon name="arrow" size={18} /></span></a>
          <a class="btn btn-ghost" href={site.whatsappHref} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> Frage per WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 8 · Menschen: grossflächig -->
  <section class="team">
    <div class="team-img">
      <Image src={imgDuo} alt="Caro und Sarah, das Team von Eloure The Studio" widths={[800, 1300, 2000]} sizes="100vw" data-parallax="0.06" />
    </div>
    <div class="wrap team-inner">
      <div class="team-card reveal">
        <h2>Hey, wir sind Caro & Sarah.</h2>
        <p>
          Caro hat Eloure gegründet, Sarah ist an ihrer Seite. Wir wissen, dass sich eine Behandlung am Anfang ungewohnt anfühlen
          kann. Darum nehmen wir uns Zeit, erklären alles in Ruhe und sind auch zwischen den Terminen für dich da.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/termin">Termin bei uns buchen<span class="arrow"><Icon name="arrow" size={18} /></span></a>
          <a class="text-link" href="/studio">Mehr über uns</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 9 · Ort -->
  <Gallery />

  <!-- 10 · Social Proof -->
  <Reviews />

  <!-- 11 · Abschluss -->
  <CtaFinal />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: min(90vh, 900px);
    display: flex;
    align-items: center;
    padding-block: clamp(32px, 6vw, 80px);
  }

  .hero-grid {
    display: grid;
  }

  .hero-text {
    position: relative;
    z-index: 2;
  }

  .hero-text .lead {
    max-width: 30em;
  }

  .hero-text .btn-row {
    margin-top: 36px;
  }

  .trust {
    list-style: none;
    margin: 48px 0 0;
    padding: 24px 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: start;
    gap: 16px 36px;
  }

  .trust li,
  .trust a {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    text-decoration: none;
  }

  .trust strong {
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .trust span {
    font-size: 0.88rem;
    color: var(--muted);
  }

  .trust a:hover span {
    text-decoration: underline;
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
    }
    .hero-text {
      padding-right: 40px;
    }
    .hero-visual {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 48%;
    }
    .hero-img {
      position: absolute;
      inset: 0;
      border-bottom-left-radius: 40px;
      overflow: hidden;
    }
  }

  .hero-img {
    background: var(--stone);
  }

  .hero-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.12);
  }

  .hero-video {
    position: absolute;
    left: -64px;
    bottom: 64px;
    width: clamp(150px, 13vw, 210px);
    aspect-ratio: 9 / 16;
    border-radius: var(--radius);
    overflow: hidden;
    border: 6px solid var(--bg);
    box-shadow: var(--shadow-l);
    z-index: 3;
  }

  .hero-video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-tag {
    position: absolute;
    right: var(--gutter);
    top: 24px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-radius: 999px;
    background: rgba(251, 248, 244, 0.9);
    backdrop-filter: blur(8px);
    font-size: 0.9rem;
    font-weight: 500;
    z-index: 3;
  }

  @media (max-width: 959px) {
    .hero {
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      padding-bottom: 0;
    }
    .trust {
      grid-template-columns: repeat(2, auto);
    }
    .hero-visual {
      position: relative;
      margin-top: 40px;
      height: 112vw;
      max-height: 620px;
    }
    .hero-img {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }
    .hero-video {
      left: var(--gutter);
      bottom: -40px;
      width: 120px;
    }
  }

  /* Nutzen */
  .benefits {
    padding-top: 0;
  }

  .b-grid {
    display: grid;
    gap: 48px clamp(40px, 6vw, 96px);
  }

  @media (min-width: 960px) {
    .b-grid {
      grid-template-columns: 0.85fr 1.15fr;
      align-items: center;
    }
  }

  .b-img {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--stone);
  }

  .b-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.12);
  }

  .b-cards {
    display: grid;
    gap: 12px;
    margin-top: 36px;
  }

  @media (min-width: 640px) {
    .b-cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  .b-card {
    padding: 26px;
    border-radius: var(--radius);
    background: var(--paper);
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s;
  }

  .b-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .b-card :global(svg) {
    color: var(--accent);
    margin-bottom: 22px;
  }

  .b-card p {
    color: var(--ink-2);
    font-size: 0.98rem;
  }

  /* Ängste */
  .f-grid {
    display: grid;
    gap: 48px clamp(40px, 6vw, 96px);
  }

  @media (min-width: 960px) {
    .f-grid {
      grid-template-columns: 0.8fr 1.2fr;
    }
    .f-side {
      position: sticky;
      top: calc(var(--header-h) + 32px);
      align-self: start;
    }
  }

  .f-img {
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--stone);
  }

  .f-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 959px) {
    .f-side {
      display: none;
    }
  }

  .f-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  /* Team */
  .team {
    position: relative;
    min-height: min(92vh, 860px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--stone);
  }

  .team-img {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .team-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    transform: scale(1.12);
  }

  .team-inner {
    position: relative;
    padding-block: clamp(32px, 6vw, 72px);
  }

  .team-card {
    max-width: 560px;
    padding: clamp(26px, 4vw, 44px);
    border-radius: var(--radius-l);
    background: rgba(251, 248, 244, 0.92);
    backdrop-filter: blur(10px);
  }

  .team-card h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  .team-card p {
    color: var(--ink-2);
    margin-bottom: 26px;
  }

  @media (max-width: 700px) {
    .team {
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
    }
    .team-img {
      position: relative;
      height: 72vw;
    }
    .team-inner {
      padding-top: 0;
      margin-top: -48px;
    }
  }
</style>
