---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Lines from '../components/Lines.astro';
import TrustBand from '../components/TrustBand.astro';
import ZoneHighlights from '../components/ZoneHighlights.astro';
import StoryPath from '../components/StoryPath.astro';
import StudioCalm from '../components/StudioCalm.astro';
import VoicesFaq from '../components/VoicesFaq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { site } from '../data/site';
import { shortFaqs } from '../data/faq';
import { googleRating } from '../data/reviews';

import imgRoom from '../assets/shoot/raum-hoch.jpg';
import imgCaro from '../assets/shoot/caro-stehend.jpg';

const rating = googleRating.rating.toFixed(1).replace('.', ',');
---

<Base
  title="Laserhaarentfernung in Amriswil | Eloure The Studio"
  description="Dauerhaft glatte Haut in Amriswil: Laserhaarentfernung mit medizinischem Diodenlaser, persönlich betreut von Gründerin Caro. Ø 5,0 aus 126 Google-Bewertungen. Preise ab CHF 29, bezahlt wird erst vor Ort."
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: shortFaqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ]}
>
  <!-- 1 · HERO – Vollbild-Video, klares Versprechen, zwei Wege, Beweis -->
  <section class="hero bg-dark">
    <video class="hero-video" autoplay muted loop playsinline preload="auto" poster="/video/studio-2026.jpg" aria-label="Laserbehandlung im Eloure Studio in Amriswil">
      <source src="/video/studio-2026.mp4" type="video/mp4" />
    </video>
    <div class="hero-shade"></div>

    <div class="wrap hero-inner">
      <Lines as="h1" class="display hero-title" lines={['Dauerhaft glatte Haut.', 'In Amriswil.']} />
      <p class="hero-sub" data-anim="up">Laserhaarentfernung mit medizinischem Diodenlaser</p>
      <p class="lead" data-anim="up">
        Ehrlich beraten, sanft behandelt und persönlich begleitet – von Caro, Gründerin von Eloure.
      </p>
      <div class="btn-row" data-anim="up">
        <a class="btn btn-primary" href="/termin">Termin buchen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
        <a class="btn btn-ghost" href="#zonen">Zonen & Preise</a>
      </div>
      <a class="hero-rating" href={site.googleReviewsUrl} target="_blank" rel="noopener" data-anim="up">
        <span class="stars">★★★★★</span>
        <span><b>{rating}</b> aus {googleRating.count} Google-Bewertungen</span>
      </a>
    </div>
  </section>

  <!-- 3 · EINSTIEG: worum es bei Eloure geht -->
  <section class="intro bg-dark">
    <div class="in-stage">
      <figure class="in-big" data-anim="img">
        <Image src={imgRoom} alt="Heller Behandlungsraum im Eloure Studio mit Lichtskulptur und Diodenlaser" widths={[700, 1100, 1600]} sizes="(min-width: 1000px) 44vw, 100vw" />
      </figure>
      <figure class="in-small" data-drift-y="-10">
        <Image src={imgCaro} alt="Caro, Gründerin von Eloure, im Studio" widths={[400, 700]} sizes="(min-width: 1000px) 17vw, 40vw" />
      </figure>
      <Lines lines={['Wo Schönheit', 'und Ästhetik', 'zuhause sind']} class="in-title" />
    </div>
    <div class="in-foot">
      <p class="in-lead reveal">
        Eloure ist dein Studio für dauerhafte Haarentfernung mit medizinischem Diodenlaser – mitten in Amriswil. Gründerin Caro
        und ihr Team nehmen sich Zeit für dich: ehrlich beraten, sanft behandelt, persönlich begleitet. An einem Ort, an dem du dich
        vom ersten Moment an wohlfühlst.
      </p>
      <div class="btn-row reveal">
        <a class="btn btn-primary" href="/termin">Termin buchen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
        <a class="text-link" href="/studio">Das Studio kennenlernen</a>
      </div>
    </div>
  </section>

  <!-- 4 · ENTSCHEIDUNG -->
  <ZoneHighlights />

  <!-- 4b · SOFORT-BEWEIS -->
  <TrustBand />

  <!-- 5 · ABLAUF ALS SCROLL-STORY -->
  <StoryPath />

  <!-- 6 · RUHEPUNKT: Studio-Impression -->
  <StudioCalm />

  <!-- 7 · STIMMEN & FRAGEN -->
  <VoicesFaq />

  <!-- 8 · ABSCHLUSS -->
  <CtaFinal />
</Base>

<style>
  /* ——— Hero ——— */
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% center;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(36, 25, 19, 0.88) 0%, rgba(36, 25, 19, 0.45) 45%, rgba(36, 25, 19, 0.2) 75%),
      linear-gradient(90deg, rgba(36, 25, 19, 0.55) 0%, rgba(36, 25, 19, 0) 60%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    padding-top: 80px;
    padding-bottom: clamp(48px, 7vw, 96px);
  }

  .hero-inner :global(.hero-title) {
    font-size: clamp(2.5rem, 6.6vw, 6.8rem);
    line-height: 0.93;
    margin-bottom: 22px;
    color: var(--cream);
  }

  .hero-sub {
    margin: 0 0 14px;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lime);
  }

  .hero-inner .lead {
    max-width: 32em;
    margin-bottom: 34px;
    color: rgba(246, 241, 234, 0.9);
  }

  .hero-rating {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
    padding: 12px 18px;
    background: rgba(246, 241, 234, 0.12);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(246, 241, 234, 0.25);
    color: var(--cream);
    text-decoration: none;
    font-size: 1.02rem;
  }

  .stars {
    color: var(--lime);
    letter-spacing: 3px;
  }

  /* ——— Einstieg ——— */
  .intro {
    padding: var(--section) var(--gutter) clamp(72px, 9vw, 140px);
    overflow: hidden;
  }

  .in-stage {
    position: relative;
  }

  .in-stage :global(.in-title) {
    position: relative;
    z-index: 3;
    margin: 0;
    font-size: clamp(2.7rem, 12vw, 9.6rem);
    line-height: 0.92;
    color: var(--cream);
  }

  .in-big,
  .in-small {
    margin: 0;
    overflow: hidden;
  }

  .in-big :global(img),
  .in-small :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .in-big :global(img) {
    filter: brightness(0.82);
  }

  .in-big {
    position: relative;
    aspect-ratio: 4 / 5;
    margin-top: -0.5em;
  }

  .in-small {
    position: relative;
    z-index: 4;
    width: 40vw;
    aspect-ratio: 3 / 4;
    margin: -24vw 0 0 auto;
    outline: 10px solid var(--espresso);
  }

  .in-foot {
    display: grid;
    gap: 28px 64px;
    margin-top: clamp(40px, 5vw, 72px);
  }

  .in-lead {
    margin: 0;
    max-width: 36em;
    font-size: clamp(1.15rem, 1.5vw, 1.4rem);
    line-height: 1.55;
    color: rgba(246, 241, 234, 0.88);
  }

  .in-foot .text-link {
    color: var(--lime);
  }

  /* Mobile: Headline zuerst, Bild darunter mit überlappender letzter Zeile */
  @media (max-width: 999px) {
    .in-stage {
      display: flex;
      flex-direction: column;
    }
    .in-stage :global(.in-title) {
      order: -1;
    }
    .in-big {
      margin-top: -1.6rem;
    }
  }

  @media (min-width: 1000px) {
    .in-stage {
      min-height: min(88vh, 900px);
      padding-top: clamp(24px, 4vh, 56px);
    }
    .in-stage :global(.in-title) {
      font-size: clamp(3.2rem, 7.6vw, 9.4rem);
    }
    .in-stage :global(.in-title .line:nth-child(2)) {
      padding-left: 9vw;
    }
    .in-stage :global(.in-title .line:nth-child(3)) {
      padding-left: 4vw;
    }
    .in-big {
      position: absolute;
      top: 0;
      right: 0;
      width: 40vw;
      height: 100%;
      aspect-ratio: auto;
      margin: 0;
    }
    .in-small {
      position: absolute;
      left: 30vw;
      bottom: -4vh;
      width: 15vw;
      margin: 0;
    }
    .in-foot {
      max-width: min(52vw, 760px);
      margin-top: clamp(48px, 6vw, 88px);
    }
  }
</style>
