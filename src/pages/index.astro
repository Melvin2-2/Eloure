---
// Startseite – ruhig, hell, klinisch-hochwertig.
// Feine Schrift (Source Sans 3 Light, Grossbuchstaben), warmes Off-White,
// Deep Indigo für Schrift, Salvia Blue als leiser Akzent, das Eloure-Signet als Trenner.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Signet from '../components/Signet.astro';
import StudioCalm from '../components/StudioCalm.astro';
import { services, chf, duration, type Group } from '../data/services';

import imgGel from '../assets/shoot/gel-achsel.jpg';
import imgRelief from '../assets/shoot/detail-relief.jpg';
import imgStep1 from '../assets/shoot/beratung-haende.jpg';
import imgStep2 from '../assets/shoot/detail-tuecher.jpg';
import imgStep3 from '../assets/shoot/laser-achsel.jpg';
import imgStep4 from '../assets/shoot/caro-beratung-2.jpg';
import imgCaro from '../assets/shoot/caro-laechelt.jpg';
import imgCaroSw from '../assets/shoot/caro-sw.jpg';

const steps = [
  { img: imgStep1, title: 'Beratung', alt: 'Hände mit Tablet beim Beratungsgespräch', pos: 'center 40%', text: 'Wir lernen dich, deine Haut und deine Wünsche kennen – ehrlich und ohne Zeitdruck.' },
  { img: imgStep2, title: 'Vorbereitung', alt: 'Frische, gefaltete Handtücher im Studio', pos: 'center 60%', text: 'Saubere Liege, frische Tücher, kühlendes Gel. Wir erklären jeden Schritt, bevor er passiert.' },
  { img: imgStep3, title: 'Behandlung', alt: 'Laserhaarentfernung an der Achsel mit Schutzbrille', pos: 'center 30%', text: 'Medizinischer Diodenlaser, sanft gekühlt. Kleine Zonen dauern oft nur 15 Minuten.' },
  { img: imgStep4, title: 'Begleitung', alt: 'Caro im Gespräch mit einer Kundin', pos: 'center 30%', text: 'Wir planen deine Folgetermine passend zum Haarzyklus und bleiben per WhatsApp erreichbar.' },
];

const pick: Record<Group, string[]> = {
  frauen: ['achseln', 'bikini-intim', 'kombi-intim-achseln', 'unterschenkel', 'beine-komplett', 'ganzkoerper'],
  maenner: ['achseln-1', 'brust-bauch', 'ruecken-inkl-nacken', 'beine', 'ganzkoerper-1'],
};
const list = (g: Group) => pick[g].map((id) => services.find((s) => s.id === id)).filter((s) => !!s);
const groups: { id: Group; label: string }[] = [
  { id: 'frauen', label: 'Frauen' },
  { id: 'maenner', label: 'Männer' },
];
---

<Base
  title="Laserhaarentfernung in Amriswil | Eloure The Studio"
  description="Dauerhaft glatte Haut in Amriswil: Laserhaarentfernung mit medizinischem Diodenlaser, persönlich betreut von Gründerin Caro. Ø 5,0 aus 126 Google-Bewertungen. Preise ab CHF 29, bezahlt wird erst vor Ort."
  headerTone="calm"
  theme="calm"
  announce={false}
>
  <!-- 1 · Start: ruhiges Video, ein Satz, ein Weg -->
  <section class="c-hero">
    <video class="c-hero-video" autoplay muted loop playsinline preload="auto" poster="/video/studio-2026.jpg" aria-label="Einblick in das Eloure Studio in Amriswil">
      <source src="/video/studio-2026.mp4" type="video/mp4" />
    </video>
    <div class="c-hero-shade"></div>
    <div class="c-hero-inner">
      <h1 class="c-ttl c-hero-title" data-anim="up">Laserhaarentfernung<br />in Amriswil</h1>
      <p class="c-hero-text" data-anim="up">Medizinischer Diodenlaser · persönlich begleitet von Caro</p>
      <a class="c-btn c-btn-light" href="/termin" data-anim="up">Termin buchen</a>
    </div>
  </section>

  <!-- 2 · Haltung -->
  <section class="c-intro">
    <div class="c-narrow">
      <h2 class="c-ttl reveal">Ein Studio. Eine Sache.</h2>
      <p class="reveal">
        Eloure ist auf Laserhaarentfernung spezialisiert – und auf nichts anderes. Jede Behandlung beginnt mit einem ehrlichen
        Gespräch und einem Plan, der zu deiner Haut passt.
      </p>
      <p class="reveal">Helle Räume, medizinische Technik, viel Ruhe. Bezahlt wird erst vor Ort.</p>
    </div>
    <div class="c-divider" aria-hidden="true"><span></span><Signet class="c-signet" /><span></span></div>
  </section>

  <!-- 3 · Grosses Wort über Bild und Textur -->
  <section class="c-word" aria-label="Glatte Haut">
    <div class="c-texture" aria-hidden="true">
      <Image src={imgRelief} alt="" widths={[1200, 2000]} sizes="100vw" />
    </div>
    <p class="c-word-text" aria-hidden="true">Glatte Haut</p>
    <figure class="c-word-img" data-anim="img">
      <Image src={imgGel} alt="Kühlendes Gel wird vor der Laserbehandlung auf die Achsel aufgetragen" widths={[700, 1100, 1500]} sizes="(min-width: 900px) 40vw, 80vw" />
      <p class="c-word-text c-word-text-in" aria-hidden="true">Glatte Haut</p>
    </figure>
    <p class="c-word-note reveal">Für Frauen und Männer · über 30 Zonen · einzeln oder als Kombi</p>
  </section>

  <!-- 4 · Ablauf in vier Bildern -->
  <section class="c-steps">
    <div class="c-wrap c-steps-head">
      <h2 class="c-ttl reveal">In vier ruhigen<br />Schritten</h2>
      <p class="reveal">Von der ersten Frage bis zum Ergebnis – du weisst immer, was als Nächstes passiert.</p>
    </div>
    <ol class="c-steps-row">
      {
        steps.map((s, i) => (
          <li class="c-step reveal" style={`--d:${i * 90}ms`}>
            <figure class="c-step-img">
              <Image src={s.img} alt={s.alt} widths={[500, 800, 1100]} sizes="(min-width: 900px) 25vw, 50vw" style={`object-position:${s.pos}`} />
              <span class="c-step-title">{s.title}</span>
            </figure>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
    <div class="c-divider" aria-hidden="true"><span></span><Signet class="c-signet" /><span></span></div>
  </section>

  <!-- 5 · Beliebte Zonen als ruhige Liste -->
  <section class="c-prices" id="zonen" data-c-prices>
    <div class="c-wrap c-prices-grid">
      <div class="c-prices-intro">
        <h2 class="c-ttl reveal">Beliebte Zonen</h2>
        <p class="reveal">Preise pro Sitzung. Bezahlt wird erst vor Ort, absagen kannst du kostenlos bis 24 Stunden vorher.</p>
        <div class="c-tabs reveal" role="tablist" aria-label="Zonen für">
          {
            groups.map((g, i) => (
              <button type="button" role="tab" aria-selected={String(i === 0)} data-c-tab={g.id}>
                {g.label}
              </button>
            ))
          }
        </div>
        <a class="c-link reveal" href="/preise">Alle Zonen & Preise</a>
      </div>
      <div class="c-lists">
        {
          groups.map((g, i) => (
            <ul class="c-list" data-c-list={g.id} hidden={i !== 0}>
              {list(g.id).map((s) => (
                <li>
                  <a href={`/termin?behandlung=${s!.id}&gruppe=${g.id}`}>
                    <span class="c-l-name">{s!.name}</span>
                    <span class="c-l-dur">{duration(s!.minutes)}</span>
                    <span class="c-l-price">{chf(s!.price)}</span>
                    <span class="c-l-go">
                      Buchen <Icon name="arrow" size={14} />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6 · Ruhepunkt (bleibt wie er ist) -->
  <StudioCalm />

  <!-- 7 · Über Caro -->
  <section class="c-about">
    <div class="c-wrap c-about-grid">
      <div class="c-about-media">
        <figure class="c-about-big" data-anim="img">
          <Image src={imgCaro} alt="Caro, Gründerin von Eloure" widths={[600, 900, 1300]} sizes="(min-width: 900px) 34vw, 80vw" />
        </figure>
        <figure class="c-about-small" data-drift-y="-8">
          <Image src={imgCaroSw} alt="Caro im Studio, schwarz-weiss" widths={[300, 500]} sizes="(min-width: 900px) 14vw, 36vw" />
        </figure>
      </div>
      <div class="c-about-text">
        <h2 class="c-ttl c-about-title reveal">Hallo,<br />ich bin Caro</h2>
        <p class="reveal">
          Ich habe Eloure gegründet, weil ich mir ein Studio gewünscht habe, in dem man sich wohlfühlt – nicht wie in einer Klinik,
          aber mit genau dieser Sorgfalt.
        </p>
        <p class="reveal">
          Von der ersten Frage bis zum Ergebnis bin ich deine Ansprechpartnerin. Ich nehme mir Zeit, sage dir ehrlich, was
          realistisch ist, und passe jede Behandlung an dich an.
        </p>
        <ul class="c-facts reveal">
          <li>Gründerin & Inhaberin</li>
          <li>Fünf Jahre Erfahrung in der Laserhaarentfernung</li>
          <li>Eigenes Studio in Amriswil</li>
        </ul>
        <a class="c-link reveal" href="/studio">Studio & Team kennenlernen</a>
      </div>
    </div>
  </section>

  <!-- 8 · Abschluss -->
  <section class="c-end">
    <div class="c-texture" aria-hidden="true">
      <Image src={imgRelief} alt="" widths={[1200, 2000]} sizes="100vw" />
    </div>
    <div class="c-narrow c-end-inner">
      <Signet class="c-signet c-signet-end" />
      <h2 class="c-ttl reveal">Bereit für<br />glatte Haut?</h2>
      <p class="reveal">Buche deinen Termin direkt online – oder komm zuerst zu einem kostenlosen Beratungsgespräch.</p>
      <div class="c-end-btns reveal">
        <a class="c-btn c-btn-dark" href="/termin">Termin buchen</a>
        <a class="c-btn c-btn-line" href="/termin?behandlung=beratungsgespraech">Kostenlos beraten lassen</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-c-prices]');
  root?.querySelectorAll<HTMLButtonElement>('[data-c-tab]').forEach((btn) => {
    btn.addEventListener('click', () => {
      root.querySelectorAll<HTMLButtonElement>('[data-c-tab]').forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
      root.querySelectorAll<HTMLElement>('[data-c-list]').forEach((l) => (l.hidden = l.dataset.cList !== btn.dataset.cTab));
    });
  });
</script>

<style>
  /* ——— Grundlagen dieser Seite ——— */
  .c-ttl {
    font-family: var(--sans);
    font-weight: 300;
    font-stretch: 100%;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.08;
    font-size: clamp(2rem, 3.6vw, 3.4rem);
    color: var(--head);
    margin: 0 0 0.6em;
    text-wrap: balance;
  }

  p {
    font-weight: 300;
    font-size: clamp(1.02rem, 1.15vw, 1.15rem);
    line-height: 1.75;
    color: var(--ink-body);
  }

  .c-wrap {
    width: 100%;
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .c-narrow {
    max-width: 640px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    text-align: center;
  }

  .c-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 30px;
    font-size: 0.82rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid;
    transition:
      background 0.35s ease,
      color 0.35s ease,
      border-color 0.35s ease;
  }

  .c-btn-light {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.8);
  }

  .c-btn-light:hover {
    background: #fff;
    color: var(--indigo);
  }

  .c-btn-dark {
    background: var(--indigo);
    border-color: var(--indigo);
    color: #fff;
  }

  .c-btn-dark:hover {
    background: var(--indigo-soft);
    border-color: var(--indigo-soft);
  }

  .c-btn-line {
    color: var(--indigo);
    border-color: var(--line-strong);
  }

  .c-btn-line:hover {
    border-color: var(--indigo);
  }

  .c-link {
    display: inline-block;
    font-size: 0.82rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.3s ease;
  }

  .c-link:hover {
    border-color: var(--ink);
  }

  /* Signet als Trenner: feine Linie · Signet · feine Linie */
  .c-divider {
    display: flex;
    align-items: center;
    gap: 22px;
    max-width: 520px;
    margin: clamp(72px, 9vw, 128px) auto 0;
    padding-inline: var(--gutter);
    color: var(--salvia-deep);
  }

  .c-divider span {
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .c-divider :global(.c-signet) {
    width: 64px;
    height: auto;
    flex: none;
  }

  /* Texturen aus eigenen Detailfotos */
  .c-texture {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .c-texture :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.22;
    filter: grayscale(1) contrast(0.9);
    mix-blend-mode: multiply;
  }

  /* ——— 1 · Start ——— */
  .c-hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    display: grid;
    place-items: center;
    overflow: hidden;
    color: #fff;
    --head: currentColor;
  }

  .c-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .c-hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17, 19, 28, 0.36) 0%, rgba(17, 19, 28, 0.3) 45%, rgba(17, 19, 28, 0.46) 100%);
  }

  .c-hero-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: var(--header-h) var(--gutter) 0;
  }

  .c-hero-title {
    font-weight: 200;
    font-size: clamp(2.3rem, 5.6vw, 5.4rem);
    letter-spacing: 0.08em;
    line-height: 1.05;
    margin-bottom: 0.45em;
  }

  .c-hero-text {
    color: rgba(255, 255, 255, 0.88);
    font-size: clamp(0.98rem, 1.2vw, 1.12rem);
    letter-spacing: 0.04em;
    margin: 0 0 36px;
  }

  /* ——— 2 · Haltung ——— */
  .c-intro {
    padding-block: clamp(110px, 14vw, 200px) clamp(90px, 10vw, 140px);
  }

  .c-intro .c-ttl {
    margin-bottom: 1em;
  }

  .c-intro p + p {
    margin-top: 1.2em;
  }

  /* ——— 3 · Grosses Wort ——— */
  .c-word {
    position: relative;
    height: clamp(560px, 62vw, 860px);
    overflow: hidden;
    background: #f3f1ea;
  }

  .c-word-img {
    position: absolute;
    left: 30%;
    width: 40%;
    top: 9%;
    bottom: 9%;
    margin: 0;
    overflow: hidden;
    z-index: 2;
  }

  .c-word-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }

  /* Das Wort liegt zweimal deckungsgleich: in Indigo auf der Fläche, in Weiss im Bild */
  .c-word-text {
    position: absolute;
    left: 0;
    width: 100%;
    top: 50%;
    transform: translateY(-50%);
    margin: 0;
    z-index: 1;
    text-align: center;
    white-space: nowrap;
    font-weight: 200;
    font-size: clamp(3.2rem, 12.4vw, 13rem);
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--indigo);
    pointer-events: none;
  }

  .c-word-text-in {
    left: -75%;
    width: 250%;
    z-index: 3;
    color: #fff;
  }

  .c-word-note {
    position: absolute;
    z-index: 3;
    right: var(--gutter);
    bottom: clamp(24px, 4vw, 48px);
    max-width: 260px;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    text-align: right;
    color: var(--ink-2);
  }

  /* ——— 4 · Ablauf ——— */
  .c-steps {
    padding-block: clamp(110px, 13vw, 190px) clamp(90px, 10vw, 140px);
  }

  .c-steps-head {
    display: grid;
    gap: 16px 64px;
    align-items: end;
    margin-bottom: clamp(48px, 6vw, 80px);
  }

  .c-steps-head .c-ttl {
    margin: 0;
  }

  .c-steps-head p {
    max-width: 30em;
    margin: 0;
  }

  .c-steps-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border-block: 1px solid var(--line);
  }

  .c-step {
    background: var(--bg);
    padding-bottom: 28px;
  }

  .c-step-img {
    position: relative;
    margin: 0;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .c-step-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }

  .c-step:hover .c-step-img :global(img) {
    transform: scale(1.035);
  }

  .c-step-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17, 19, 28, 0) 50%, rgba(17, 19, 28, 0.38) 100%);
  }

  .c-step-title {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 22px;
    text-align: center;
    color: #fff;
    font-weight: 300;
    font-size: clamp(0.95rem, 1.3vw, 1.2rem);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .c-step p {
    margin: 22px auto 0;
    max-width: 22em;
    padding-inline: 18px;
    text-align: center;
    font-size: 0.98rem;
    line-height: 1.65;
  }

  /* ——— 5 · Beliebte Zonen ——— */
  .c-prices {
    padding-block: clamp(100px, 12vw, 170px);
    background: #f3f1ea;
  }

  .c-prices-grid {
    display: grid;
    gap: 48px clamp(48px, 8vw, 140px);
  }

  .c-prices-intro p {
    max-width: 26em;
  }

  .c-tabs {
    display: flex;
    gap: 28px;
    margin: 32px 0 40px;
  }

  .c-tabs button {
    border: 0;
    background: none;
    padding: 0 0 6px;
    font-size: 0.82rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid transparent;
    cursor: pointer;
  }

  .c-tabs button[aria-selected='true'] {
    color: var(--ink);
    border-color: var(--ink);
  }

  .c-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }

  .c-list li {
    border-bottom: 1px solid var(--line);
  }

  .c-list a {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: baseline;
    gap: 8px 28px;
    padding: 22px 0;
    text-decoration: none;
    color: var(--ink);
  }

  .c-l-name {
    font-weight: 300;
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .c-l-dur {
    font-size: 0.92rem;
    color: var(--muted);
  }

  .c-l-price {
    font-weight: 400;
    font-size: 1.05rem;
    min-width: 5.5em;
    text-align: right;
  }

  .c-l-go {
    display: none;
    align-items: center;
    gap: 8px;
    font-size: 0.76rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--salvia-ink);
  }

  .c-list a:hover .c-l-name {
    color: var(--salvia-ink);
  }

  /* ——— 7 · Über Caro ——— */
  .c-about {
    padding-block: clamp(110px, 13vw, 190px);
  }

  .c-about-grid {
    display: grid;
    gap: 56px;
    align-items: center;
  }

  .c-about-media {
    position: relative;
    padding-right: 18%;
  }

  .c-about-big {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .c-about-big :global(img),
  .c-about-small :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .c-about-small {
    position: absolute;
    right: 0;
    bottom: -8%;
    width: 38%;
    aspect-ratio: 3 / 4;
    margin: 0;
    overflow: hidden;
    outline: 10px solid var(--bg);
  }

  .c-about-text {
    max-width: 520px;
  }

  .c-about-text p + p {
    margin-top: 1.1em;
  }

  .c-facts {
    list-style: none;
    margin: 36px 0 40px;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }

  .c-facts li {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* ——— 8 · Abschluss ——— */
  .c-end {
    position: relative;
    padding-block: clamp(110px, 13vw, 180px);
    background: #f3f1ea;
    overflow: hidden;
  }

  .c-end-inner {
    position: relative;
    z-index: 2;
  }

  .c-end :global(.c-signet-end) {
    display: block;
    width: 64px;
    margin: 0 auto 36px;
    color: var(--salvia-deep);
  }

  .c-end-btns {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 40px;
  }

