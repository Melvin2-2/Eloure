---
// Startseite – ruhig, grossformatig, klar.
// Regeln: Überschriften immer in Grossbuchstaben, fein (Source Sans 3, Myriad-ähnlich), keine Kursiven,
// keine Zahlen/Überüberschriften – pro Block genau eine Überschrift und ein Text.
// Farben: Creme · Salvia Soft · Salvia Blue · Deep Indigo, Buttons in warmem Sand (CTA).
// Farbfolge: Bild → Creme → Creme → Salvia Soft → Creme → Salvia → Bilder → Ruhepunkt → Creme → Salvia Soft → Salvia → Indigo
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import StudioCalm from '../components/StudioCalm.astro';
import { services, chf, type Group } from '../data/services';
import { googleRating, pickReview } from '../data/reviews';

import imgHero from '../assets/shoot/relief-sessel.jpg';
import imgLeaf from '../assets/shoot/detail-pflanze.jpg';
import imgHands from '../assets/shoot/beratung-haende.jpg';
import imgBehandlung from '../assets/shoot/laser-achsel.jpg';
import imgBegleitung from '../assets/shoot/caro-beratung-2.jpg';
import imgExhale from '../assets/shoot/raum-exhale.jpg';
import imgExhaleRoom from '../assets/shoot/sessel.jpg';
import imgLounge from '../assets/shoot/lounge.jpg';
import imgLiege from '../assets/shoot/liege-fenster.jpg';
import imgGeraet from '../assets/shoot/geraet.jpg';
import imgObjekte from '../assets/shoot/detail-objekte.jpg';
import imgCaroSw from '../assets/shoot/caro-sw.jpg';
import imgCaro from '../assets/shoot/caro-laechelt.jpg';

const rating = googleRating.rating.toFixed(1).replace('.', ',');

// Drei Bilder vor grosser Hintergrundschrift
const explore = [
  { img: imgHands, title: 'Beratung', alt: 'Hände mit Tablet beim Beratungsgespräch', pos: 'center 40%' },
  { img: imgBehandlung, title: 'Behandlung', alt: 'Laserhaarentfernung an der Achsel', pos: 'center 35%' },
  { img: imgBegleitung, title: 'Begleitung', alt: 'Caro im Gespräch mit einer Kundin', pos: 'center 30%' },
];

// Preise: drei Spalten nebeneinander, breit mit Linien
const priceCols: Record<Group, { title: string; ids: string[] }[]> = {
  frauen: [
    { title: 'Oberkörper', ids: ['oberlippe', 'achseln', 'arme-1'] },
    { title: 'Intim & Beine', ids: ['bikini-intim', 'unterschenkel', 'beine-komplett'] },
    { title: 'Kombis', ids: ['kombi-intim-achseln', 'ganzkoerper'] },
  ],
  maenner: [
    { title: 'Oberkörper', ids: ['achseln-1', 'brust', 'ruecken-inkl-nacken'] },
    { title: 'Arme & Beine', ids: ['arme-komplett', 'beine'] },
    { title: 'Kombis', ids: ['brust-bauch', 'ganzkoerper-1'] },
  ],
};
const svc = (id: string) => services.find((s) => s.id === id);
const groups: { id: Group; label: string }[] = [
  { id: 'frauen', label: 'Frauen' },
  { id: 'maenner', label: 'Männer' },
];

const rooms = [
  { img: imgLounge, title: 'Lounge', alt: 'Lounge mit weissen Sesseln' },
  { img: imgLiege, title: 'Behandlungsraum', alt: 'Behandlungsliege am Fenster' },
  { img: imgGeraet, title: 'Technik', alt: 'Medizinischer Diodenlaser' },
  { img: imgObjekte, title: 'Details', alt: 'Dekorative Objekte im Studio' },
];

const voices = ['Julia F.', 'Dina G.', 'Cindy A.', 'Gökce', 'Natalie B.', 'Amy H.'].map(pickReview).filter(Boolean);

// Grosses Signet als eng gesetzte, sehr transparente Linie / einzelnes grosses Signet
const signetPaths = [
  'M165.63 2.986c10.504 0 25.65 8.292 25.871 35.711h9.398C200.899 6.634 178.787 0 165.519 0c-13.156 0-35.27 6.634-35.27 38.698h9.397c.222-27.42 15.37-35.712 25.984-35.712zM220.729 0h9.397v38.698h-9.397zM136.703 77.394c13.269 0 35.38-6.632 35.38-38.696h-9.397c-.221 27.419-15.367 35.712-25.872 35.712-10.613 0-25.762-8.293-25.982-35.712h-9.398c-.001 32.064 22.113 38.696 35.269 38.696z',
  'M224.118 77.394c22.887 0 26.093-23.771 26.203-36.816v-1.88h-2.984v1.88c-.221 27.308-12.716 33.833-23.219 33.833-10.505 0-22.998-6.524-23.219-33.833v-2.383l-9.398.503v1.991c0 31.841 19.459 36.705 32.617 36.705z',
];
const signetSvg = (vb: string) =>
  `url("data:image/svg+xml,${encodeURIComponent(
    `<svg xmlns='http://www.w3.org/2000/svg' viewBox='${vb}'><g fill='#2b2f40'>${signetPaths.map((d) => `<path d='${d}'/>`).join('')}</g></svg>`,
  )}")`;
const signetRow = signetSvg('96 -2 160 82');
const signetOne = signetSvg('100 0 151 78');
---

<Base
  title="Laserhaarentfernung in Amriswil | Eloure The Studio"
  description="Dauerhaft glatte Haut in Amriswil: Laserhaarentfernung mit medizinischem Diodenlaser, persönlich betreut von Gründerin Caro. Ø 5,0 aus 126 Google-Bewertungen. Preise ab CHF 29, bezahlt wird erst vor Ort."
  headerTone="calm"
  theme="calm"
  announce={false}
>
  <!-- 1 · Startbild (Whole Body Beauty): Vollbild, Text mittig, Schleier -->
  <section class="c-hero">
    <div class="c-hero-img">
      <Image src={imgHero} alt="Helle Lounge mit Reliefwand und weissem Sessel" widths={[1200, 1800, 2400]} sizes="100vw" loading="eager" />
    </div>
    <div class="c-hero-text">
      <h1 class="c-ttl c-hero-title" data-anim="up">Laserhaarentfernung<br />in Amriswil</h1>
      <p class="c-hero-sub" data-anim="up">Medizinischer Diodenlaser, persönlich begleitet.</p>
      <a class="c-btn c-btn-cta" href="/termin" data-anim="up">Termin buchen</a>
    </div>
  </section>

  <!-- 2 · Haltung -->
  <section class="c-intro">
    <div class="c-narrow">
      <h2 class="c-ttl reveal">Ein Studio.<br />Eine Sache.</h2>
      <p class="reveal">Laserhaarentfernung mit medizinischem Diodenlaser – und sonst nichts.</p>
    </div>
  </section>

  <!-- 3 · Text + Bildfläche (Salvia „True Wellness“) -->
  <section class="c-tw on-veil">
    <div class="c-tw-text">
      <h2 class="c-ttl reveal">Erst reden.<br />Dann lasern.</h2>
      <p class="reveal">Wir sagen dir ehrlich, was bei dir realistisch ist – und planen deine Behandlung danach.</p>
      <figure class="c-tw-small" data-slide="left">
        <Image src={imgHands} alt="" widths={[300, 500]} sizes="14vw" />
      </figure>
    </div>
    <figure class="c-tw-img">
      <Image src={imgLeaf} alt="Grünes Blatt im Studio" widths={[800, 1200, 1600]} sizes="(min-width: 900px) 50vw, 100vw" />
    </figure>
  </section>

  <!-- Signet-Linie über die Section-Grenze -->
  <div class="c-band" aria-hidden="true" style={`--signet:${signetRow}`}><div class="c-band-strip"></div></div>

  <!-- 4 · Drei Bilder vor grosser Hintergrundschrift -->
  <section class="c-explore on-frost" aria-label="Ablauf">
    <div class="c-explore-row">
      {
        explore.map((e) => (
          <figure class="c-explore-card" data-anim="soft">
            <Image src={e.img} alt={e.alt} widths={[500, 800]} sizes="(min-width: 900px) 24vw, 80vw" style={`object-position:${e.pos}`} />
            <figcaption>{e.title}</figcaption>
          </figure>
        ))
      }
    </div>
    <div class="c-explore-cta reveal">
      <a class="c-btn c-btn-cta" href="/laserhaarentfernung">So läuft es ab</a>
    </div>
  </section>

  <!-- 5 · Preise: drei Spalten, breit mit Linien -->
  <section class="c-prices" id="zonen" data-c-prices>
    <div class="c-prices-head c-wrap">
      <h2 class="c-ttl reveal">Preise</h2>
      <div class="c-tabs reveal" role="tablist" aria-label="Preise für">
        {
          groups.map((g, i) => (
            <button type="button" role="tab" aria-selected={String(i === 0)} data-c-tab={g.id}>
              {g.label}
            </button>
          ))
        }
      </div>
    </div>
    {
      groups.map((g, gi) => (
        <div class="c-pcols" data-c-list={g.id} hidden={gi !== 0}>
          {priceCols[g.id].map((col) => (
            <div class="c-pcol">
              <h3>{col.title}</h3>
              <ul>
                {col.ids.map((id) => {
                  const s = svc(id);
                  return (
                    s && (
                      <li>
                        <a href={`/termin?behandlung=${s.id}&gruppe=${g.id}`}>
                          <span>{s.name}</span>
                          <span>{chf(s.price)}</span>
                        </a>
                      </li>
                    )
                  );
                })}
              </ul>
            </div>
          ))}
        </div>
      ))
    }
    <div class="c-prices-all c-wrap reveal">
      <a class="c-btn c-btn-cta" href="/termin">Termin buchen</a>
      <a class="c-link" href="/preise">Alle Preise</a>
    </div>
  </section>

  <!-- 6 · Grossformat: Exhale -->
  <section class="c-big on-veil">
    <figure class="c-big-img" data-anim="soft">
      <Image src={imgExhale} alt="Heller Raum mit weissem Sessel und Kunstwerk an der Wand" widths={[800, 1200, 1800]} sizes="(min-width: 900px) 55vw, 100vw" />
    </figure>
    <div class="c-big-text">
      <h2 class="c-ttl reveal">Einmal tief<br />durchatmen.</h2>
      <p class="reveal">Nervös vor dem ersten Termin? Ganz normal. Wir nehmen uns Zeit, bis du dich wohlfühlst.</p>
      <figure class="c-big-small" data-slide="right">
        <Image src={imgExhaleRoom} alt="" widths={[400, 700]} sizes="18vw" />
      </figure>
    </div>
  </section>

  <!-- 7 · Vier Bildspalten: Studio -->
  <section class="c-cols" aria-label="Studio">
    {
      rooms.map((r) => (
        <a class="c-col" href="/studio" data-anim="soft">
          <Image src={r.img} alt={r.alt} widths={[500, 800, 1100]} sizes="(min-width: 900px) 25vw, 50vw" />
          <span class="c-col-cap">{r.title}</span>
        </a>
      ))
    }
  </section>

  <!-- 8 · Ruhepunkt -->
  <StudioCalm />

  <!-- 9 · Caro: Bild + eine Überschrift, ein Text -->
  <section class="c-tw c-tw-rev">
    <figure class="c-tw-img">
      <Image src={imgCaroSw} alt="Caro, Gründerin von Eloure" widths={[800, 1200, 1600]} sizes="(min-width: 900px) 50vw, 100vw" />
    </figure>
    <div class="c-tw-text">
      <h2 class="c-ttl reveal">Persönlich<br />begleitet.</h2>
      <p class="reveal">Caro hat Eloure gegründet und ist deine Ansprechpartnerin – von der ersten Frage bis zum Ergebnis.</p>
      <figure class="c-tw-small" data-slide="right">
        <Image src={imgCaro} alt="" widths={[300, 500]} sizes="14vw" />
      </figure>
    </div>
  </section>

  <!-- 10 · Kundenstimmen -->
  <section class="c-voices" data-c-voices aria-label="Kundenstimmen">
    <div class="c-voices-inner">
      <button type="button" class="c-arrow c-arrow-l" aria-label="Vorherige Stimme" data-c-prev><span></span></button>
      <div class="c-voices-body reveal">
        <p class="c-voices-stars" aria-label={`${rating} von 5 Sternen`}>★★★★★</p>
        <div class="c-voices-quotes">
          {
            voices.map((v, i) => (
              <figure class="c-quote" data-c-quote hidden={i !== 0}>
                <blockquote>«{v!.short ?? v!.text}»</blockquote>
                <figcaption>{v!.name}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
      <button type="button" class="c-arrow c-arrow-r" aria-label="Nächste Stimme" data-c-next><span></span></button>
    </div>
  </section>

  <!-- 11 · Abschluss -->
  <section class="c-end on-frost" style={`--signet:${signetOne}`}>
    <div class="c-end-signet" aria-hidden="true"></div>
    <div class="c-narrow c-end-inner">
      <h2 class="c-ttl reveal">Bereit für<br />glatte Haut?</h2>
      <div class="c-end-btns reveal">
        <a class="c-btn c-btn-cta" href="/termin">Termin buchen</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Frauen / Männer
  const prices = document.querySelector<HTMLElement>('[data-c-prices]');
  prices?.querySelectorAll<HTMLButtonElement>('[data-c-tab]').forEach((btn) => {
    btn.addEventListener('click', () => {
      prices.querySelectorAll<HTMLButtonElement>('[data-c-tab]').forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
      prices.querySelectorAll<HTMLElement>('[data-c-list]').forEach((l) => (l.hidden = l.dataset.cList !== btn.dataset.cTab));
    });
  });

  // Kundenstimmen
  const voices = document.querySelector<HTMLElement>('[data-c-voices]');
  if (voices) {
    const quotes = [...voices.querySelectorAll<HTMLElement>('[data-c-quote]')];
    let i = 0;
    const show = (n: number) => {
      i = (n + quotes.length) % quotes.length;
      quotes.forEach((q, k) => {
        q.hidden = k !== i;
        if (k === i) q.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 700, easing: 'ease-out' });
      });
    };
    voices.querySelector('[data-c-prev]')?.addEventListener('click', () => show(i - 1));
    voices.querySelector('[data-c-next]')?.addEventListener('click', () => show(i + 1));
  }
</script>

<style>
  /* ——— Grundlagen ——— */
  .c-ttl {
    font-family: var(--sans);
    font-weight: 200;
    font-style: normal;
    font-stretch: 100%;
    text-transform: uppercase;
    letter-spacing: 0.005em;
    line-height: 1;
    font-size: clamp(3rem, 6.8vw, 7.4rem);
    color: var(--head);
    margin: 0 0 0.5em;
    text-wrap: balance;
    hyphens: manual;
    overflow-wrap: normal;
  }

  .c-big-text .c-ttl,
  .c-tw-text .c-ttl {
    font-size: clamp(2.8rem, 5.2vw, 6rem);
  }

  p {
    font-weight: 350;
    font-size: clamp(1.12rem, 1.3vw, 1.3rem);
    line-height: 1.7;
    color: var(--ink-body);
  }

  .c-wrap {
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .c-narrow {
    position: relative;
    z-index: 2;
    max-width: 860px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    text-align: center;
  }

  .on-frost {
    background: var(--frost);
    --ink: #33363a;
    --ink-body: #3a3d41;
    --ink-2: #44474b;
    --muted: #44474b;
    --line: rgba(51, 54, 58, 0.22);
    --line-strong: rgba(51, 54, 58, 0.42);
  }

  .on-veil {
    background: var(--veil);
  }

  /* Buttons: warmer Sand als Call-to-Action-Farbe */
  .c-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 58px;
    padding: 0 40px;
    font-size: 0.88rem;
    font-weight: 450;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid;
    transition:
      background 0.4s ease,
      border-color 0.4s ease;
  }

  .c-btn-cta {
    background: var(--cta);
    border-color: var(--cta);
    color: #fff;
  }

  .c-btn-cta:hover {
    background: var(--cta-hover);
    border-color: var(--cta-hover);
  }

  .c-link {
    display: inline-block;
    font-size: 0.86rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.3s ease;
  }

  .c-link:hover {
    border-color: currentColor;
  }

  /* ——— 1 · Startbild ——— */
  .c-hero {
    position: relative;
    height: 100svh;
    min-height: 680px;
    max-height: 1100px;
    overflow: hidden;
    background: #6f7484;
  }

  .c-hero-img {
    position: absolute;
    inset: 0;
  }

  .c-hero-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 78%;
    filter: contrast(0.86) saturate(0.8);
  }

  .c-hero-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(17, 19, 28, 0.35) 0%, rgba(17, 19, 28, 0.18) 35%, rgba(17, 19, 28, 0.18) 65%, rgba(17, 19, 28, 0.4) 100%),
      rgba(78, 92, 102, 0.34);
  }

  .c-hero-text {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    padding: 120px var(--gutter) 0;
    text-align: center;
    color: #fff;
    --head: #fff;
  }

  .c-hero-title {
    font-size: clamp(2.8rem, 6.6vw, 7.2rem);
    letter-spacing: 0.01em;
    margin-bottom: 0.35em;
  }

  .c-hero-sub {
    margin: 0 0 44px;
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(1.05rem, 1.25vw, 1.2rem);
    letter-spacing: 0.04em;
  }

  /* ——— 2 · Haltung ——— */
  .c-intro {
    padding-block: clamp(150px, 16vw, 240px) clamp(110px, 11vw, 160px);
  }

  .c-intro p {
    margin: 0;
  }

  /* ——— 3 / 9 · Text + Bildfläche ——— */
  .c-tw {
    display: grid;
    min-height: clamp(600px, 62vw, 880px);
  }

  .c-tw-text {
    position: relative;
    display: grid;
    align-content: center;
    padding: clamp(90px, 9vw, 140px) clamp(28px, 7vw, 120px) clamp(200px, 17vw, 260px);
  }

  .c-tw-text p {
    max-width: 26em;
    margin: 0;
  }

  .c-tw-img {
    position: relative;
    margin: 0;
    min-height: 540px;
    overflow: hidden;
  }

  .c-tw-img :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .c-tw-small {
    position: absolute;
    left: 0;
    bottom: clamp(48px, 6vw, 90px);
    width: clamp(130px, 15vw, 230px);
    aspect-ratio: 4 / 3;
    margin: 0;
    overflow: hidden;
  }

  .c-tw-rev .c-tw-small {
    left: auto;
    right: 0;
  }

  .c-tw-small :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Signet-Linie: gross, eng gesetzt, sehr transparent */
  .c-band {
    position: relative;
    z-index: 6;
    height: 0;
    pointer-events: none;
  }

  .c-band-strip {
    position: absolute;
    left: 0;
    right: 0;
    top: clamp(-80px, -5.5vw, -40px);
    height: clamp(80px, 11vw, 160px);
    background-image: var(--signet);
    background-repeat: repeat-x;
    background-size: auto 100%;
    background-position: 30% 0;
    opacity: 0.07;
  }

  /* ——— 4 · Drei Bilder vor grosser Schrift ——— */
  .c-explore {
    position: relative;
    overflow: hidden;
    padding-block: clamp(130px, 13vw, 190px) clamp(110px, 11vw, 160px);
  }

  .c-explore-row {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(16px, 2vw, 32px);
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .c-explore-card {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .c-explore-card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .c-explore-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(27, 30, 42, 0.18);
  }

  .c-explore-card figcaption {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    font-weight: 400;
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .c-explore-cta {
    position: relative;
    z-index: 1;
    margin-top: clamp(44px, 5vw, 64px);
    text-align: center;
  }

  /* ——— 5 · Preise ——— */
  .c-prices {
    padding-block: clamp(130px, 13vw, 190px) clamp(110px, 11vw, 160px);
  }

  .c-prices-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 40px;
    margin-bottom: clamp(40px, 5vw, 70px);
  }

  .c-prices-head .c-ttl {
    margin: 0;
  }

  .c-tabs {
    display: flex;
    gap: 32px;
  }

  .c-tabs button {
    border: 0;
    background: none;
    padding: 0 0 6px;
    font-size: 0.86rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid transparent;
    cursor: pointer;
  }

  .c-tabs button[aria-selected='true'] {
    color: var(--ink);
    border-color: var(--ink);
  }

  .c-pcols {
    display: grid;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .c-pcols[hidden] {
    display: none;
  }

  .c-pcol {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--line);
  }

  .c-pcol h3 {
    margin: 0;
    padding: clamp(36px, 4vw, 56px) clamp(24px, 3vw, 48px) clamp(24px, 3vw, 36px);
