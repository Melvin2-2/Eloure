---
// Startseite – reduziert, fast kahl.
// Grossbuchstaben, keine Kursiven, Salvia Blue / Creme / Deep Indigo, grosse Signets.
// Drei Elemente 1:1 aus den Vorlagen (Nerea):
//   1. breites Startbild mit Schrift und Link unten links
//   2. Kachelraster mit feinen Linien (eine Kachel als Bild)
//   3. Text links, breites Bild rechts
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import StudioCalm from '../components/StudioCalm.astro';
import { services, chf, type Group } from '../data/services';
import { googleRating, pickReview } from '../data/reviews';
import { site } from '../data/site';

import imgHero from '../assets/shoot/laser-achsel-quer.jpg';
import imgTuecher from '../assets/shoot/detail-tuecher.jpg';
import imgRaum from '../assets/shoot/raum-weit.jpg';
import imgStep1 from '../assets/shoot/beratung-haende.jpg';
import imgStep2 from '../assets/shoot/detail-pflanze.jpg';
import imgStep3 from '../assets/shoot/kundin-brille.jpg';
import imgStep4 from '../assets/shoot/caro-beratung-2.jpg';

const rating = googleRating.rating.toFixed(1).replace('.', ',');

const steps = [
  { img: imgStep1, title: 'Beratung', alt: 'Hände mit Tablet beim Beratungsgespräch', pos: 'center 40%' },
  { img: imgStep2, title: 'Vorbereitung', alt: 'Grüne Pflanze im Studio', pos: 'center 50%' },
  { img: imgStep3, title: 'Behandlung', alt: 'Kundin mit Schutzbrille bei der Behandlung', pos: 'center 30%' },
  { img: imgStep4, title: 'Begleitung', alt: 'Caro im Gespräch mit einer Kundin', pos: 'center 30%' },
];

const pick: Record<Group, string[]> = {
  frauen: ['achseln', 'bikini-intim', 'kombi-intim-achseln', 'unterschenkel', 'beine-komplett', 'ganzkoerper'],
  maenner: ['achseln-1', 'brust-bauch', 'ruecken-inkl-nacken', 'beine', 'ganzkoerper-1', 'oberarme'],
};
const list = (g: Group) =>
  pick[g]
    .map((id) => services.find((s) => s.id === id))
    .filter((s) => !!s)
    .slice(0, 6);
const groups: { id: Group; label: string }[] = [
  { id: 'frauen', label: 'Frauen' },
  { id: 'maenner', label: 'Männer' },
];

const voices = ['Julia F.', 'Dina G.', 'Cindy A.', 'Gökce', 'Natalie B.', 'Amy H.'].map(pickReview).filter(Boolean);

// Grosses Signet als eng gesetzte, sehr transparente Linie (Deep Indigo)
const signetPaths = [
  'M165.63 2.986c10.504 0 25.65 8.292 25.871 35.711h9.398C200.899 6.634 178.787 0 165.519 0c-13.156 0-35.27 6.634-35.27 38.698h9.397c.222-27.42 15.37-35.712 25.984-35.712zM220.729 0h9.397v38.698h-9.397zM136.703 77.394c13.269 0 35.38-6.632 35.38-38.696h-9.397c-.221 27.419-15.367 35.712-25.872 35.712-10.613 0-25.762-8.293-25.982-35.712h-9.398c-.001 32.064 22.113 38.696 35.269 38.696z',
  'M224.118 77.394c22.887 0 26.093-23.771 26.203-36.816v-1.88h-2.984v1.88c-.221 27.308-12.716 33.833-23.219 33.833-10.505 0-22.998-6.524-23.219-33.833v-2.383l-9.398.503v1.991c0 31.841 19.459 36.705 32.617 36.705z',
];
const signetSvg = (vb: string) =>
  `url("data:image/svg+xml,${encodeURIComponent(
    `<svg xmlns='http://www.w3.org/2000/svg' viewBox='${vb}'><g fill='#2b2f40'>${signetPaths.map((d) => `<path d='${d}'/>`).join('')}</g></svg>`,
  )}")`;
const signetRow = signetSvg('96 -2 160 82');
const signetOne = signetSvg('100 0 151 78');
---

<Base
  title="Laserhaarentfernung in Amriswil | Eloure The Studio"
  description="Dauerhaft glatte Haut in Amriswil: Laserhaarentfernung mit medizinischem Diodenlaser, persönlich betreut von Gründerin Caro. Ø 5,0 aus 126 Google-Bewertungen. Preise ab CHF 29, bezahlt wird erst vor Ort."
  headerTone="calm"
  theme="calm"
  announce={false}
>
  <!-- 1 · Breites Startbild, Schrift unten links (Nerea) -->
  <section class="c-hero">
    <div class="c-hero-img" data-anim="soft">
      <Image src={imgHero} alt="Laserhaarentfernung an der Achsel – Kundin mit Schutzbrille" widths={[1200, 1800, 2400]} sizes="100vw" loading="eager" />
    </div>
    <div class="c-hero-text" data-slide="left">
      <h1 class="c-ttl c-hero-title">Laserhaarentfernung<br />in Amriswil</h1>
      <a class="c-link c-link-light" href="/termin">Termin buchen</a>
    </div>
  </section>

  <!-- 2 · Haltung -->
  <section class="c-intro">
    <div class="c-narrow">
      <h2 class="c-ttl reveal">Ein Studio.<br />Eine Sache.</h2>
      <p class="reveal">Laserhaarentfernung mit medizinischem Diodenlaser – und sonst nichts.</p>
    </div>
  </section>

  <!-- 3 · Kachelraster (Nerea) -->
  <section class="c-grid-sec" id="zonen" data-c-prices>
    <div class="c-tabs c-wrap reveal" role="tablist" aria-label="Zonen für">
      {
        groups.map((g, i) => (
          <button type="button" role="tab" aria-selected={String(i === 0)} data-c-tab={g.id}>
            {g.label}
          </button>
        ))
      }
    </div>
    {
      groups.map((g, gi) => (
        <ul class="c-grid" data-c-list={g.id} hidden={gi !== 0}>
          {list(g.id).map((s, i) => (
            <>
              {i === 2 && (
                <li class="c-cell c-cell-img" aria-hidden="true">
                  <Image src={imgTuecher} alt="" widths={[400, 700]} sizes="(min-width: 900px) 25vw, 50vw" />
                </li>
              )}
              <li class="c-cell">
                <a href={`/termin?behandlung=${s!.id}&gruppe=${g.id}`}>
                  <span class="c-cell-name">{s!.name}</span>
                  <span class="c-cell-price">{chf(s!.price)}</span>
                </a>
              </li>
            </>
          ))}
          <li class="c-cell c-cell-all">
            <a href="/preise">
              <span class="c-cell-name">Alle Zonen</span>
              <span class="c-cell-price">ab CHF 29</span>
            </a>
          </li>
        </ul>
      ))
    }
  </section>

  <!-- 4 · Text links, Bild rechts (Nerea) -->
  <section class="c-split">
    <div class="c-wrap c-split-grid">
      <div class="c-split-text">
        <h2 class="c-ttl reveal">Kein Klinikgefühl.<br />Nur Ruhe.</h2>
        <a class="c-link reveal" href="/studio">Das Studio</a>
      </div>
      <figure class="c-split-img" data-slide="right">
        <Image src={imgRaum} alt="Heller Behandlungsraum mit Liege und Laser" widths={[700, 1100, 1600]} sizes="(min-width: 900px) 50vw, 100vw" />
      </figure>
    </div>
  </section>

  <!-- Signet-Linie über die Section-Grenze -->
  <div class="c-band" aria-hidden="true" style={`--signet:${signetRow}`}><div class="c-band-strip"></div></div>

  <!-- 5 · Ablauf in vier Bildern -->
  <section class="c-steps on-salvia">
    <ol class="c-steps-row">
      {
        steps.map((s, i) => (
          <li class="c-step" data-anim="soft">
            <figure class="c-step-img">
              <Image src={s.img} alt={s.alt} widths={[500, 800, 1100]} sizes="(min-width: 900px) 25vw, 50vw" style={`object-position:${s.pos}`} />
            </figure>
            <h3 class="c-step-title">
              <small>0{i + 1}</small> {s.title}
            </h3>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 6 · Ruhepunkt -->
  <StudioCalm />

  <!-- 7 · Kundenstimmen -->
  <section class="c-voices" data-c-voices aria-label="Kundenstimmen">
    <div class="c-voices-inner">
      <button type="button" class="c-arrow c-arrow-l" aria-label="Vorherige Stimme" data-c-prev><span></span></button>
      <div class="c-voices-body reveal">
        <p class="c-voices-stars" aria-label={`${rating} von 5 Sternen`}>★★★★★</p>
        <div class="c-voices-quotes">
          {
            voices.map((v, i) => (
              <figure class="c-quote" data-c-quote hidden={i !== 0}>
                <blockquote>«{v!.short ?? v!.text}»</blockquote>
                <figcaption>{v!.name}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
      <button type="button" class="c-arrow c-arrow-r" aria-label="Nächste Stimme" data-c-next><span></span></button>
    </div>
  </section>

  <!-- 8 · Abschluss -->
  <section class="c-end on-salvia" style={`--signet:${signetOne}`}>
    <div class="c-end-signet" aria-hidden="true"></div>
    <div class="c-narrow c-end-inner">
      <h2 class="c-ttl reveal">Bereit für<br />glatte Haut?</h2>
      <div class="c-end-btns reveal">
        <a class="c-btn c-btn-dark" href="/termin">Termin buchen</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Frauen / Männer
  const prices = document.querySelector<HTMLElement>('[data-c-prices]');
  prices?.querySelectorAll<HTMLButtonElement>('[data-c-tab]').forEach((btn) => {
    btn.addEventListener('click', () => {
      prices.querySelectorAll<HTMLButtonElement>('[data-c-tab]').forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
      prices.querySelectorAll<HTMLElement>('[data-c-list]').forEach((l) => (l.hidden = l.dataset.cList !== btn.dataset.cTab));
    });
  });

  // Kundenstimmen
  const voices = document.querySelector<HTMLElement>('[data-c-voices]');
  if (voices) {
    const quotes = [...voices.querySelectorAll<HTMLElement>('[data-c-quote]')];
    let i = 0;
    const show = (n: number) => {
      i = (n + quotes.length) % quotes.length;
      quotes.forEach((q, k) => {
        q.hidden = k !== i;
        if (k === i) q.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 700, easing: 'ease-out' });
      });
    };
    voices.querySelector('[data-c-prev]')?.addEventListener('click', () => show(i - 1));
    voices.querySelector('[data-c-next]')?.addEventListener('click', () => show(i + 1));
  }
</script>

<style>
  /* ——— Grundlagen: immer Grossbuchstaben, fein, keine Kursiven ——— */
  .c-ttl {
    font-family: var(--sans);
    font-weight: 300;
    font-style: normal;
    font-stretch: 100%;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.06;
    font-size: clamp(2.5rem, 4.6vw, 4.6rem);
    color: var(--head);
    margin: 0 0 0.55em;
    text-wrap: balance;
  }

  p {
    font-weight: 350;
    font-size: clamp(1.12rem, 1.3vw, 1.3rem);
    line-height: 1.7;
    color: var(--ink-body);
  }

  .c-wrap {
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .c-narrow {
    position: relative;
    z-index: 2;
    max-width: 760px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    text-align: center;
  }

  .on-salvia {
    background: var(--salvia);
    --ink-body: var(--indigo);
    --ink-2: var(--indigo-soft);
    --muted: var(--indigo-soft);
    --line: rgba(43, 47, 64, 0.22);
    --line-strong: rgba(43, 47, 64, 0.45);
  }

  .c-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 36px;
    font-size: 0.88rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid;
    transition:
      background 0.4s ease,
      border-color 0.4s ease;
  }

  .c-btn-dark {
    background: var(--indigo);
    border-color: var(--indigo);
    color: #fff;
  }

  .c-btn-dark:hover {
    background: var(--indigo-soft);
    border-color: var(--indigo-soft);
  }

  .c-link {
    display: inline-block;
    font-size: 0.86rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.3s ease;
  }

  .c-link:hover {
    border-color: currentColor;
  }

  .c-link-light {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.6);
  }

  /* ——— 1 · Breites Startbild (Nerea) ——— */
  .c-hero {
    position: relative;
    overflow-x: clip;
    height: 100svh;
    min-height: 680px;
    max-height: 1100px;
    overflow: hidden;
    background: #d9d2c6;
  }

  .c-hero-img {
    position: absolute;
    inset: 0;
  }

  .c-hero-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 40%;
  }

  .c-hero-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(17, 19, 28, 0.3) 0%, rgba(17, 19, 28, 0) 22%),
      linear-gradient(20deg, rgba(17, 19, 28, 0.45) 0%, rgba(17, 19, 28, 0) 55%);
  }

  .c-hero-text {
    position: absolute;
    z-index: 2;
    left: var(--gutter);
    bottom: clamp(48px, 9vh, 110px);
    color: #fff;
    --head: #fff;
  }

  .c-hero-title {
    font-size: clamp(2.4rem, 4.6vw, 4.8rem);
    margin-bottom: 0.7em;
  }

  /* ——— 2 · Haltung ——— */
  .c-intro {
    padding-block: clamp(140px, 15vw, 220px);
  }

  .c-intro p {
    margin: 0;
  }

  /* ——— 3 · Kachelraster (Nerea) ——— */
  .c-tabs {
    display: flex;
    justify-content: flex-end;
    gap: 32px;
    margin-bottom: 20px;
  }

  .c-tabs button {
    border: 0;
    background: none;
    padding: 0 0 6px;
    font-size: 0.86rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid transparent;
    cursor: pointer;
  }

  .c-tabs button[aria-selected='true'] {
    color: var(--ink);
    border-color: var(--ink);
  }

  .c-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .c-grid[hidden] {
    display: none;
  }

  .c-cell {
    position: relative;
    aspect-ratio: 1 / 1;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .c-cell a {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    padding: clamp(20px, 2.4vw, 36px);
    text-align: center;
    text-decoration: none;
    color: var(--ink);
    transition: background 0.5s ease;
  }

  .c-cell a:hover {
    background: var(--salvia-soft);
  }

  .c-cell-name {
    font-weight: 400;
    font-size: clamp(0.86rem, 1vw, 0.98rem);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .c-cell-price {
    text-transform: uppercase;
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    color: var(--ink-2);
  }

  .c-cell-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .c-cell-all a {
    background: var(--salvia);
    --ink-2: var(--indigo);
  }

  .c-cell-all a:hover {
    background: var(--salvia-deep);
  }

  /* ——— 4 · Text links, Bild rechts (Nerea) ——— */
  .c-split {
    padding-block: clamp(140px, 15vw, 220px) clamp(160px, 16vw, 240px);
    overflow-x: clip;
  }

  .c-split-grid {
    display: grid;
    gap: 48px clamp(48px, 7vw, 120px);
    align-items: center;
  }

  .c-split-img {
    margin: 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .c-split-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Signet-Linie: gross, eng gesetzt, sehr transparent */
  .c-band {
    position: relative;
    z-index: 6;
    height: 0;
    pointer-events: none;
  }

  .c-band-strip {
    position: absolute;
    left: 0;
    right: 0;
    top: clamp(-80px, -5.5vw, -40px);
    height: clamp(80px, 11vw, 160px);
    background-image: var(--signet);
    background-repeat: repeat-x;
    background-size: auto 100%;
    background-position: 30% 0;
    opacity: 0.07;
  }

  /* ——— 5 · Ablauf ——— */
  .c-steps {
    padding-block: clamp(140px, 14vw, 200px);
  }

  .c-steps-row {
    list-style: none;
    margin: 0 auto;
    padding: 0 var(--gutter);
    max-width: 1520px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(14px, 1.6vw, 24px);
  }

  .c-step-img {
    margin: 0;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .c-step-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .c-step-title {
    margin: 22px 0 0;
    font-family: var(--sans);
    font-weight: 400;
    font-size: clamp(0.92rem, 1.1vw, 1.05rem);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .c-step-title small {
    font-size: 0.85em;
    margin-right: 8px;
    color: var(--ink-2);
  }

  /* ——— 7 · Kundenstimmen ——— */
  .c-voices {
    padding-block: clamp(140px, 14vw, 210px);
  }

  .c-voices-inner {
    max-width: 1360px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(16px, 4vw, 64px);
  }

  .c-voices-body {
    max-width: 820px;
    margin-inline: auto;
    text-align: center;
  }

  .c-voices-stars {
    margin: 0 0 34px;
    font-size: clamp(1.3rem, 1.8vw, 1.7rem);
    letter-spacing: 0.4em;
    color: var(--salvia-ink);
  }

  .c-voices-quotes {
    min-height: 8em;
    display: grid;
    align-items: center;
  }

  .c-quote {
    margin: 0;
  }

  .c-quote blockquote {
    margin: 0 0 26px;
    font-weight: 350;
    font-style: normal;
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    line-height: 1.45;
    color: var(--ink);
    text-wrap: balance;
  }

  .c-quote figcaption {
    font-size: 0.86rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .c-arrow {
    position: relative;
    width: clamp(44px, 5vw, 72px);
    height: 44px;
    border: 0;
    background: none;
    cursor: pointer;
    color: var(--ink);
  }

  .c-arrow span,
  .c-arrow span::before {
    position: absolute;
    display: block;
  }

  .c-arrow span {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s var(--ease);
  }

  .c-arrow span::before {
    content: '';
    top: 0;
    width: 10px;
    height: 10px;
    border-top: 1px solid currentColor;
  }

  .c-arrow-l span::before {
    left: 0;
    border-left: 1px solid currentColor;
    transform: rotate(-45deg);
    transform-origin: 0 0;
  }

  .c-arrow-r span::before {
    right: 0;
    border-right: 1px solid currentColor;
    transform: rotate(45deg);
    transform-origin: 100% 0;
  }

  .c-arrow-l:hover span {
    transform: translateX(-4px);
  }

  .c-arrow-r:hover span {
    transform: translateX(4px);
  }

  /* ——— 8 · Abschluss ——— */
  .c-end {
    position: relative;
    padding-block: clamp(150px, 15vw, 220px);
    overflow: hidden;
  }

  .c-end-signet {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 50%;
    width: min(64vw, 820px);
    aspect-ratio: 151 / 78;
    transform: translate(-50%, -50%);
    background-image: var(--signet);
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;
    opacity: 0.08;
  }

  .c-end-btns {
    margin-top: 44px;
  }

  /* ——— Breakpoints ——— */
  @media (min-width: 900px) {
    .c-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .c-cell:nth-child(4n) {
      border-right: 0;
    }
    .c-split-grid {
      grid-template-columns: 0.8fr 1.2fr;
    }
    .c-steps-row {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 899px) {
    .c-cell:nth-child(2n) {
      border-right: 0;
    }
    .c-hero-img :global(img) {
      object-position: 70% 40%;
    }
    .c-band-strip {
      height: 70px;
      top: -35px;
    }
    .c-voices-inner {
      grid-template-columns: 1fr 1fr;
    }
    .c-voices-body {
      grid-column: 1 / -1;
      grid-row: 1;
    }
    .c-arrow-l {
      justify-self: end;
    }
    .c-arrow-r {
      justify-self: start;
    }
  }
</style>
