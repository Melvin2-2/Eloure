---
// Startseite – kantig, ruhig, hochwertig.
// Aufbau nach Moodboard (Nerea, Blue Mind, evnia, Speechless, Salvia):
// breites Startbild mit Glas-Karte, Signet-Musterband, Raster mit feinen Linien (Kacheln),
// feine Typografie mit kursiven Akzenten, Salvia Blue / Creme / Deep Indigo,
// rechteckige Buttons, Frosted-Glass-Elemente auf Bildern, sanfte Einblendungen.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import StudioCalm from '../components/StudioCalm.astro';
import { services, chf, duration, type Group } from '../data/services';
import { googleRating, pickReview } from '../data/reviews';
import { site } from '../data/site';

import imgHero from '../assets/shoot/laser-achsel-quer.jpg';
import imgTuecher from '../assets/shoot/detail-tuecher.jpg';
import imgRaum from '../assets/shoot/raum-weit.jpg';
import imgAdieu from '../assets/shoot/relief-sessel.jpg';
import imgStep1 from '../assets/shoot/beratung-haende.jpg';
import imgStep2 from '../assets/shoot/gel-achsel.jpg';
import imgStep3 from '../assets/shoot/kundin-brille.jpg';
import imgStep4 from '../assets/shoot/caro-beratung-2.jpg';

const rating = googleRating.rating.toFixed(1).replace('.', ',');

const chapters = [
  { img: imgStep1, title: 'Reden', alt: 'Hände mit Tablet beim Beratungsgespräch', pos: 'center 40%', text: 'Erst Fragen, dann Laser. Ehrlich und ohne Zeitdruck.' },
  { img: imgStep2, title: 'Vorbereiten', alt: 'Kühlendes Gel wird auf die Achsel aufgetragen', pos: 'center 50%', text: 'Frische Tücher, kühles Gel, jeder Schritt erklärt.' },
  { img: imgStep3, title: 'Lasern', alt: 'Kundin mit Schutzbrille bei der Behandlung', pos: 'center 30%', text: 'Medizinischer Diodenlaser. Kurz, sanft gekühlt.' },
  { img: imgStep4, title: 'Dranbleiben', alt: 'Caro im Gespräch mit einer Kundin', pos: 'center 30%', text: 'Folgetermine im Takt deines Haarzyklus.' },
];

const pick: Record<Group, string[]> = {
  frauen: ['achseln', 'bikini-intim', 'kombi-intim-achseln', 'unterschenkel', 'beine-komplett', 'ganzkoerper'],
  maenner: ['achseln-1', 'brust-bauch', 'ruecken-inkl-nacken', 'beine', 'ganzkoerper-1', 'oberarme'],
};
const list = (g: Group) =>
  pick[g]
    .map((id) => services.find((s) => s.id === id))
    .filter((s) => !!s)
    .slice(0, 6);
const groups: { id: Group; label: string }[] = [
  { id: 'frauen', label: 'Frauen' },
  { id: 'maenner', label: 'Männer' },
];

const voices = ['Julia F.', 'Dina G.', 'Cindy A.', 'Gökce', 'Natalie B.', 'Amy H.'].map(pickReview).filter(Boolean);

// Signet als Muster (Salvia Blue)
const signetPaths = [
  'M165.63 2.986c10.504 0 25.65 8.292 25.871 35.711h9.398C200.899 6.634 178.787 0 165.519 0c-13.156 0-35.27 6.634-35.27 38.698h9.397c.222-27.42 15.37-35.712 25.984-35.712zM220.729 0h9.397v38.698h-9.397zM136.703 77.394c13.269 0 35.38-6.632 35.38-38.696h-9.397c-.221 27.419-15.367 35.712-25.872 35.712-10.613 0-25.762-8.293-25.982-35.712h-9.398c-.001 32.064 22.113 38.696 35.269 38.696z',
  'M224.118 77.394c22.887 0 26.093-23.771 26.203-36.816v-1.88h-2.984v1.88c-.221 27.308-12.716 33.833-23.219 33.833-10.505 0-22.998-6.524-23.219-33.833v-2.383l-9.398.503v1.991c0 31.841 19.459 36.705 32.617 36.705z',
];
const signetSvg = (vb: string, fill: string) =>
  `url("data:image/svg+xml,${encodeURIComponent(
    `<svg xmlns='http://www.w3.org/2000/svg' viewBox='${vb}'><g fill='${fill}'>${signetPaths.map((d) => `<path d='${d}'/>`).join('')}</g></svg>`,
  )}")`;
const signetPattern = signetSvg('92 -8 168 94', '#9baec9');
const signetBig = signetSvg('96 -2 160 82', '#2b2f40');
const signetOne = signetSvg('100 0 151 78', '#2b2f40');
---

<Base
  title="Laserhaarentfernung in Amriswil | Eloure The Studio"
  description="Dauerhaft glatte Haut in Amriswil: Laserhaarentfernung mit medizinischem Diodenlaser, persönlich betreut von Gründerin Caro. Ø 5,0 aus 126 Google-Bewertungen. Preise ab CHF 29, bezahlt wird erst vor Ort."
  headerTone="calm"
  theme="calm"
  announce={false}
>
  <!-- 1 · Start: breites Bild, Glas-Karte unten links -->
  <section class="c-hero">
    <div class="c-hero-img" data-anim="soft">
      <Image src={imgHero} alt="Laserhaarentfernung an der Achsel – Kundin mit Schutzbrille" widths={[1200, 1800, 2400]} sizes="100vw" loading="eager" />
    </div>
    <div class="c-glass c-hero-card" data-slide="left">
      <h1 class="c-kicker">Laserhaarentfernung · Amriswil</h1>
      <p class="c-hero-claim">Glatt.<br /><em>Ganz ohne Rasierer.</em></p>
      <a class="c-link c-link-light" href="/termin">Ersten Termin buchen</a>
    </div>
  </section>

  <!-- Signet-Musterband (wie bei Nerea) -->
  <div class="c-pattern" aria-hidden="true" style={`--signet:${signetPattern}`}></div>

  <!-- 2 · Haltung -->
  <section class="c-intro">
    <div class="c-narrow">
      <h2 class="c-display reveal">Weniger Haare.<br /><em>Mehr du.</em></h2>
      <p class="reveal">
        Kein Beauty-Allerlei. Eloure macht genau eine Sache: Laserhaarentfernung – mit medizinischem Diodenlaser, ehrlicher
        Beratung und viel Ruhe.
      </p>
    </div>
  </section>

  <!-- 3 · Beliebte Zonen als Kachelraster -->
  <section class="c-grid-sec" id="zonen" data-c-prices>
    <div class="c-grid-head c-wrap">
      <h2 class="c-display c-display-s reveal">Beliebte <em>Zonen</em></h2>
      <div class="c-tabs reveal" role="tablist" aria-label="Zonen für">
        {
          groups.map((g, i) => (
            <button type="button" role="tab" aria-selected={String(i === 0)} data-c-tab={g.id}>
              {g.label}
            </button>
          ))
        }
      </div>
    </div>
    {
      groups.map((g, gi) => (
        <ul class="c-grid" data-c-list={g.id} hidden={gi !== 0}>
          {list(g.id).map((s, i) => (
            <>
              {i === 2 && (
                <li class="c-cell c-cell-img" aria-hidden="true">
                  <Image src={imgTuecher} alt="" widths={[400, 700]} sizes="(min-width: 900px) 25vw, 50vw" />
                </li>
              )}
              <li class="c-cell">
                <a href={`/termin?behandlung=${s!.id}&gruppe=${g.id}`}>
                  <span class="c-cell-name">{s!.name}</span>
                  <span class="c-cell-meta">
                    <span>{chf(s!.price)}</span>
                    <span>{duration(s!.minutes)}</span>
                  </span>
                  <span class="c-cell-go">
                    Buchen <Icon name="arrow" size={14} />
                  </span>
                </a>
              </li>
            </>
          ))}
          <li class="c-cell c-cell-all">
            <a href="/preise">
              <span class="c-cell-name">Über 30 Zonen</span>
              <span class="c-cell-meta">
                <span>ab CHF 29</span>
              </span>
              <span class="c-cell-go">
                Alle Preise <Icon name="arrow" size={14} />
              </span>
            </a>
          </li>
        </ul>
      ))
    }
  </section>

  <!-- 4 · Split: Text links, Bild rechts mit Glas-Hinweis -->
  <section class="c-split">
    <div class="c-wrap c-split-grid">
      <div class="c-split-text">
        <h2 class="c-display c-display-m reveal">
          Ein Raum, der sich nicht nach <em>Klinik</em> anfühlt – aber genauso <em>sauber</em> ist.
        </h2>
        <a class="c-link reveal" href="/studio">Das Studio ansehen</a>
      </div>
      <figure class="c-split-img" data-slide="right">
        <Image src={imgRaum} alt="Heller Behandlungsraum mit Liege und Laser" widths={[700, 1100, 1600]} sizes="(min-width: 900px) 46vw, 100vw" />
        <figcaption class="c-glass c-tag">Geprüfte Sachkunde nach V-NISSG</figcaption>
      </figure>
    </div>
  </section>

  <!-- Signet-Linie über die Section-Grenze -->
  <div class="c-band" aria-hidden="true" style={`--signet:${signetBig}`}><div class="c-band-strip"></div></div>

  <!-- 5 · Adieu, Rasierer -->
  <section class="c-word on-salvia" aria-label="Adieu, Rasierer">
    <figure class="c-word-img" data-anim="soft">
      <Image src={imgAdieu} alt="Helle Lounge mit weissem Sessel und Reliefwand" widths={[700, 1100, 1500]} sizes="(min-width: 900px) 38vw, 80vw" style="object-position:center 30%" />
      <figcaption class="c-glass c-word-card">Für Frauen und Männer.<br />Einzeln oder als Kombi.</figcaption>
    </figure>
    <p class="c-word-text" aria-hidden="true" data-anim="up"><span>Adieu,</span><em>Rasierer.</em></p>
  </section>

  <!-- 6 · Vier Kapitel -->
  <section class="c-chapters">
    <div class="c-wrap c-chapters-head">
      <h2 class="c-display c-display-s reveal">Vier Kapitel <em>bis glatt.</em></h2>
    </div>
    <ol class="c-chapter-row">
      {
        chapters.map((c, i) => (
          <li class="c-chapter" data-anim="soft">
            <span class="c-chip">Kapitel 0{i + 1}</span>
            <figure>
              <Image src={c.img} alt={c.alt} widths={[500, 800, 1100]} sizes="(min-width: 900px) 25vw, 50vw" style={`object-position:${c.pos}`} />
            </figure>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 7 · Ruhepunkt -->
  <StudioCalm />

  <!-- 8 · Kundenstimmen -->
  <section class="c-voices" data-c-voices aria-label="Kundenstimmen">
    <div class="c-voices-inner">
      <button type="button" class="c-arrow c-arrow-l" aria-label="Vorherige Stimme" data-c-prev><span></span></button>
      <div class="c-voices-body reveal">
        <p class="c-voices-stars" aria-label={`${rating} von 5 Sternen`}>★★★★★</p>
        <div class="c-voices-quotes">
          {
            voices.map((v, i) => (
              <figure class="c-quote" data-c-quote hidden={i !== 0}>
                <blockquote>«{v!.short ?? v!.text}»</blockquote>
                <figcaption>— {v!.name} —</figcaption>
              </figure>
            ))
          }
        </div>
        <a class="c-link" href={site.googleReviewsUrl} target="_blank" rel="noopener">{rating} · {googleRating.count} Google-Bewertungen</a>
      </div>
      <button type="button" class="c-arrow c-arrow-r" aria-label="Nächste Stimme" data-c-next><span></span></button>
    </div>
  </section>

  <!-- 9 · Abschluss -->
  <section class="c-end on-salvia" style={`--signet:${signetOne}`}>
    <div class="c-end-signet" aria-hidden="true"></div>
    <div class="c-narrow c-end-inner">
      <h2 class="c-display reveal">Bereit, den Rasierer<br /><em>abzugeben?</em></h2>
      <div class="c-end-btns reveal">
        <a class="c-btn c-btn-dark" href="/termin">Termin buchen</a>
        <a class="c-btn c-btn-line" href="/termin?behandlung=beratungsgespraech">Kostenlos beraten lassen</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Frauen / Männer
  const prices = document.querySelector<HTMLElement>('[data-c-prices]');
  prices?.querySelectorAll<HTMLButtonElement>('[data-c-tab]').forEach((btn) => {
    btn.addEventListener('click', () => {
      prices.querySelectorAll<HTMLButtonElement>('[data-c-tab]').forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
      prices.querySelectorAll<HTMLElement>('[data-c-list]').forEach((l) => (l.hidden = l.dataset.cList !== btn.dataset.cTab));
    });
  });

  // Kundenstimmen
  const voices = document.querySelector<HTMLElement>('[data-c-voices]');
  if (voices) {
    const quotes = [...voices.querySelectorAll<HTMLElement>('[data-c-quote]')];
    let i = 0;
    const show = (n: number) => {
      i = (n + quotes.length) % quotes.length;
      quotes.forEach((q, k) => {
        q.hidden = k !== i;
        if (k === i) q.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 700, easing: 'ease-out' });
      });
    };
    voices.querySelector('[data-c-prev]')?.addEventListener('click', () => show(i - 1));
    voices.querySelector('[data-c-next]')?.addEventListener('click', () => show(i + 1));
  }
</script>

<style>
  /* ——— Typografie: fein, gemischt mit kursiven Akzenten ——— */
  .c-display {
    font-family: var(--sans);
    font-weight: 250;
    font-stretch: 100%;
    text-transform: none;
    letter-spacing: -0.01em;
    line-height: 1.08;
    font-size: clamp(2.6rem, 5vw, 5rem);
    color: var(--head);
    margin: 0 0 0.6em;
    text-wrap: balance;
  }

  .c-display em,
  .c-hero-claim em,
  .c-word-text em {
    font-style: italic;
    font-weight: 250;
  }

  .c-display-s {
    font-size: clamp(2.2rem, 3.6vw, 3.6rem);
  }

  .c-display-m {
    font-size: clamp(2rem, 3.2vw, 3.2rem);
    line-height: 1.18;
  }

  .c-kicker {
    margin: 0 0 18px;
    hyphens: none;
    font-family: var(--sans);
    font-weight: 400;
    font-size: 0.82rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  p {
    font-weight: 350;
    font-size: clamp(1.12rem, 1.3vw, 1.3rem);
    line-height: 1.7;
    color: var(--ink-body);
  }

  .c-wrap {
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .c-narrow {
    position: relative;
    z-index: 2;
    max-width: 780px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    text-align: center;
  }

  .on-salvia {
    background: var(--salvia);
    --ink-body: var(--indigo);
    --ink-2: var(--indigo-soft);
    --muted: var(--indigo-soft);
    --line: rgba(43, 47, 64, 0.22);
    --line-strong: rgba(43, 47, 64, 0.45);
  }

  /* Rechteckige Buttons */
  .c-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 36px;
    font-size: 0.88rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid;
    transition:
      background 0.4s ease,
      color 0.4s ease,
      border-color 0.4s ease;
  }

  .c-btn-dark {
    background: var(--indigo);
    border-color: var(--indigo);
    color: #fff;
  }

  .c-btn-dark:hover {
    background: var(--indigo-soft);
    border-color: var(--indigo-soft);
  }

  .c-btn-line {
    color: var(--indigo);
    border-color: var(--indigo);
  }

  .c-btn-line:hover {
    background: var(--indigo);
    color: #fff;
  }

  .c-link {
    display: inline-block;
    font-size: 0.86rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.3s ease;
  }

  .c-link:hover {
    border-color: currentColor;
  }

  .c-link-light {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.55);
  }

  /* Frosted Glass wie im Ruhepunkt – leicht getönt, feine weisse Kante */
  .c-glass {
    background: rgba(28, 30, 42, 0.16);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    backdrop-filter: blur(14px) saturate(1.1);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: #fff;
    --head: #fff;
  }

  /* ——— 1 · Start ——— */
  .c-hero {
    position: relative;
    height: 100svh;
    min-height: 680px;
    max-height: 1100px;
    overflow: hidden;
    background: #d9d2c6;
  }

  .c-hero-img {
    position: absolute;
    inset: 0;
  }

  .c-hero-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 40%;
  }

  .c-hero-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(17, 19, 28, 0.32) 0%, rgba(17, 19, 28, 0) 22%),
      linear-gradient(20deg, rgba(17, 19, 28, 0.35) 0%, rgba(17, 19, 28, 0) 50%);
  }

  .c-hero-card {
    position: absolute;
    z-index: 2;
    left: var(--gutter);
    bottom: var(--gutter);
    width: min(520px, calc(100% - 2 * var(--gutter)));
    padding: clamp(28px, 3vw, 44px);
  }

  .c-hero-claim {
    margin: 0 0 28px;
    font-weight: 250;
    font-size: clamp(2.6rem, 4.6vw, 4.6rem);
    line-height: 1.04;
    letter-spacing: -0.01em;
    color: #fff;
  }

  /* ——— Signet-Musterband ——— */
  .c-pattern {
    height: clamp(44px, 4.4vw, 64px);
    border-block: 1px solid var(--line);
    background-image: var(--signet);
    background-repeat: repeat-x;
    background-size: auto 62%;
    background-position: center;
    opacity: 0.9;
  }

  /* ——— 2 · Haltung ——— */
  .c-intro {
    padding-block: clamp(130px, 14vw, 210px);
  }

  .c-intro p {
    max-width: 34em;
    margin-inline: auto;
  }

  /* ——— 3 · Kachelraster ——— */
  .c-grid-sec {
    padding-top: clamp(40px, 5vw, 80px);
    border-top: 1px solid var(--line);
  }

  .c-grid-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px 40px;
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .c-grid-head .c-display {
    margin: 0;
  }

  .c-tabs {
    display: flex;
    gap: 32px;
  }

  .c-tabs button {
    border: 0;
    background: none;
    padding: 0 0 6px;
    font-size: 0.86rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid transparent;
    cursor: pointer;
  }

  .c-tabs button[aria-selected='true'] {
    color: var(--ink);
    border-color: var(--ink);
  }

  .c-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .c-grid[hidden] {
    display: none;
  }

  .c-cell {
    position: relative;
    aspect-ratio: 1 / 1;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .c-cell a {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(20px, 2.2vw, 34px);
    text-decoration: none;
    color: var(--ink);
    transition: background 0.5s ease;
  }

  .c-cell a:hover {
    background: var(--salvia-soft);
  }

  .c-cell-name {
    font-weight: 250;
    font-size: clamp(1.4rem, 2.2vw, 2.2rem);
    line-height: 1.12;
  }

  .c-cell-meta {
    display: grid;
    gap: 4px;
    font-size: 0.86rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .c-cell-meta span:first-child {
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    color: var(--ink);
  }

  .c-cell-go {
    position: absolute;
    right: clamp(20px, 2.2vw, 34px);
    bottom: clamp(20px, 2.2vw, 34px);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--indigo);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.4s ease,
      transform 0.4s var(--ease);
  }

  .c-cell a:hover .c-cell-go,
  .c-cell a:focus-visible .c-cell-go {
    opacity: 1;
    transform: none;
  }

  .c-cell-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .c-cell-all a {
    background: var(--salvia);
  }

  .c-cell-all a:hover {
    background: var(--salvia-deep);
  }

  .c-cell-all .c-cell-go {
    opacity: 1;
    transform: none;
  }

  /* ——— 4 · Split ——— */
  .c-split {
    padding-block: clamp(130px, 14vw, 210px);
  }

  .c-split-grid {
    display: grid;
    gap: 48px clamp(48px, 7vw, 120px);
    align-items: center;
  }

  .c-split-text .c-display {
    margin-bottom: 1em;
  }

  .c-split-img {
    position: relative;
    margin: 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .c-split-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .c-tag {
    position: absolute;
    left: 20px;
    bottom: 20px;
    padding: 12px 18px;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* Signet-Linie über die Grenze */
  .c-band {
    position: relative;
    z-index: 6;
    height: 0;
    pointer-events: none;
