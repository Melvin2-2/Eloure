---
// Startseite – ruhig, grossformatig, klar.
// Regeln: Überschriften immer in Grossbuchstaben, fein (Source Sans 3, Myriad-ähnlich), keine Kursiven,
// keine Zahlen/Überüberschriften – pro Block genau eine Überschrift und ein Text.
// Farbfolge: Bild → Creme → Veil → Creme (USP + Signet) → Frost (Ablauf) → Creme (Bestseller) → Bilder (Studio)
// → Veil (Stimmen) → Creme (Exhale) → Ruhepunkt → Veil (Team) → Creme (FAQ) → Texturbild (Abschluss)
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import StudioCalm from '../components/StudioCalm.astro';
import UspLines from '../components/UspLines.astro';
import LoopVideo from '../components/LoopVideo.astro';
import { services, chf, type Group } from '../data/services';
import { googleRating, pickReview } from '../data/reviews';
import { signetRow, signetOne } from '../lib/signet';

import imgHero from '../assets/shoot/relief-sessel.jpg';
import imgLeaf from '../assets/shoot/detail-pflanze.jpg';
import imgTalk from '../assets/shoot/cd-beratung-lounge.jpg';
import imgHands from '../assets/shoot/beratung-haende.jpg';
import imgGel from '../assets/shoot/gel-achsel.jpg';
import imgBehandlung from '../assets/shoot/laser-achsel.jpg';
import imgDisplay from '../assets/shoot/display.jpg';
import imgExhale from '../assets/shoot/raum-exhale.jpg';
import imgPflanze from '../assets/shoot/pflanze.jpg';
import imgLounge from '../assets/shoot/lounge.jpg';
import imgLiege from '../assets/shoot/liege-fenster.jpg';
import imgGeraet from '../assets/shoot/geraet.jpg';
import imgObjekte from '../assets/shoot/detail-objekte.jpg';
import imgCaroSw from '../assets/shoot/caro-sw.jpg';
import imgTulpen from '../assets/shoot/detail-tulpen.jpg';
import imgBuch from '../assets/shoot/detail-buch.jpg';
import imgLiegeLicht from '../assets/shoot/liege-licht.jpg';
import imgKnoechel from '../assets/shoot/cd-knoechel.jpg';
import imgRaumHoch from '../assets/shoot/raum-hoch.jpg';
import imgRelief from '../assets/shoot/detail-relief.jpg';

const rating = googleRating.rating.toFixed(1).replace('.', ',');

// Ablauf (nach Vorlage „Values“): vier Bilder, darunter Titel + eine Zeile
const steps = [
  { img: imgHands, title: 'Beratung', text: 'Wir schauen Haut und Haare an und sagen ehrlich, was realistisch ist.', alt: 'Hände mit Tablet beim Beratungsgespräch', pos: 'center 40%' },
  { img: imgGel, title: 'Vorbereitung', text: 'Kühlgel auftragen, Schutzbrille auf – jeder Schritt wird erklärt.', alt: 'Kühlgel wird auf die Achsel aufgetragen', pos: 'center 50%' },
  { img: imgBehandlung, title: 'Behandlung', text: 'Du gibst das Tempo vor. Pausen sind jederzeit okay.', alt: 'Laserhaarentfernung an der Achsel', pos: 'center 35%' },
  { img: imgDisplay, title: 'Dranbleiben', text: 'Folgetermine nach deinem Haarzyklus, Einstellungen laufend angepasst.', alt: 'Einstellungen am Display des Diodenlasers', pos: 'center 40%' },
];

// Bestseller als breite Linienliste (Frauen | Männer nebeneinander)
const best: Record<Group, string[]> = {
  frauen: ['achseln', 'bikini-intim', 'kombi-intim-achseln', 'beine-komplett'],
  maenner: ['achseln-1', 'brust-bauch', 'ruecken-inkl-nacken', 'beine'],
};
const groups: { id: Group; label: string }[] = [
  { id: 'frauen', label: 'Frauen' },
  { id: 'maenner', label: 'Männer' },
];
const svc = (id: string) => services.find((s) => s.id === id);

// Studio in vier Bildern – mit Inhalt statt nur Raumnamen
const rooms = [
  { img: imgLounge, title: 'Studio', text: 'Hier beginnt jeder Termin – mit einem Gespräch, nicht mit dem Laser.', alt: 'Lounge mit weissen Sesseln' },
  { img: imgLiege, title: 'Behandlungsraum', text: 'Geschlossen, hell und diskret. Nur du und deine Behandlerin.', alt: 'Behandlungsliege am Fenster' },
  { img: imgGeraet, title: 'Diodenlaser', text: 'Medizinischer Laser statt IPL – gezielt auf die Haarwurzel.', alt: 'Medizinischer Diodenlaser' },
  { img: imgObjekte, title: 'Ruhe', text: 'Kein Zeitdruck, keine Hektik. Jede Frage ist willkommen.', alt: 'Dekorative Objekte im Studio' },
];

const faqs = [
  { title: 'Tut das weh?', text: 'Meist ein kurzes, warmes Pieksen. Du gibst das Tempo vor, Pausen sind jederzeit okay.' },
  { title: 'Wie viele Sitzungen brauche ich?', text: 'Das ist individuell. Wir schätzen es ehrlich ein und passen den Plan von Mal zu Mal an.' },
  { title: 'Wann fallen die Haare aus?', text: 'Meist innerhalb von 1 bis 3 Wochen nach der Sitzung.' },
  { title: 'Wann muss ich rasieren?', text: '24 bis 48 Stunden vor dem Termin – leichte Stoppeln dürfen noch sichtbar sein.' },
  { title: 'Intimbereich – ist das unangenehm?', text: 'Ganz normal, dass du daran denkst. Geschlossener Raum, ruhig und diskret, jeder Schritt wird erklärt.' },
  { title: 'Wann bezahle ich?', text: 'Erst vor Ort nach dem Termin – bar, TWINT oder Karte.' },
];

const voices = ['Julia F.', 'Dina G.', 'Cindy A.', 'Gökce', 'Natalie B.', 'Amy H.'].map(pickReview).filter(Boolean);
---

<Base
  title="Laserhaarentfernung in Amriswil | Eloure The Studio"
  description="Dauerhaft glatte Haut in Amriswil: Laserhaarentfernung mit medizinischem Diodenlaser, persönlich betreut von Caro & Sarah. Ø 5,0 aus 126 Google-Bewertungen. Preise ab CHF 29, bezahlt wird erst vor Ort."
  headerTone="calm"
  theme="calm"
  announce={false}
>
  <!-- 1 · Startbild -->
  <section class="c-hero">
    <div class="c-hero-img">
      <Image src={imgHero} alt="Helle Lounge mit Reliefwand und weissem Sessel" widths={[1200, 1800, 2400]} sizes="100vw" loading="eager" />
    </div>
    <div class="c-hero-text">
      <h1 class="c-ttl c-hero-title" data-anim="up">Laserhaarentfernung<br />in Amriswil</h1>
      <p class="c-hero-sub" data-anim="up">Medizinischer Diodenlaser, persönlich begleitet.</p>
      <a class="c-btn c-btn-cta" href="/termin" data-anim="up">Termin buchen</a>
    </div>
  </section>

  <!-- 2 · Haltung -->
  <section class="c-intro">
    <div class="c-narrow">
      <h2 class="c-ttl reveal">Ein Studio.<br />Eine Sache.</h2>
      <p class="reveal">Laserhaarentfernung mit medizinischem Diodenlaser – und sonst nichts.</p>
    </div>
  </section>

  <!-- 3 · Text + Bildfläche -->
  <section class="c-tw on-veil">
    <div class="c-tw-text">
      <h2 class="c-ttl reveal">Erst reden.<br />Dann lasern.</h2>
      <p class="reveal">Wir sagen dir ehrlich, was bei dir realistisch ist – und planen deine Behandlung danach.</p>
      <figure class="c-tw-small" data-slide="left">
        <Image src={imgTalk} alt="" widths={[300, 500]} sizes="14vw" style="object-position:center 30%" />
      </figure>
    </div>
    <figure class="c-tw-img">
      <Image src={imgLeaf} alt="Grünes Blatt im Studio" widths={[800, 1200, 1600]} sizes="(min-width: 900px) 50vw, 100vw" />
    </figure>
  </section>

  <!-- 4 · USPs als Linienliste -->
  <UspLines imgA={imgBuch} imgB={imgLiegeLicht} />

  <!-- Signet-Linie: eigenständig im Weissraum -->
  <div class="c-band" aria-hidden="true" style={`--signet:${signetRow}`}><div class="c-band-strip"></div></div>

  <!-- 5 · Ablauf (Vorlage „Values“) -->
  <section class="c-steps on-frost" aria-labelledby="ablauf-titel">
    <div class="c-narrow c-steps-head">
      <h2 class="c-ttl reveal" id="ablauf-titel">So läuft es ab.</h2>
    </div>
    <ol class="c-steps-row">
      {
        steps.map((st) => (
          <li class="c-step" data-anim="soft">
            <figure>
              <Image src={st.img} alt={st.alt} widths={[400, 700, 900]} sizes="(min-width: 900px) 25vw, 50vw" style={`object-position:${st.pos}`} />
            </figure>
            <div class="c-step-text">
              <h3>{st.title}</h3>
              <p>{st.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="c-steps-more reveal">
      <a class="c-link" href="/laserhaarentfernung">Mehr zur Behandlung</a>
    </div>
  </section>

  <!-- 6 · Bestseller: breite Linien, Frauen und Männer nebeneinander -->
  <section class="c-prices" id="zonen">
    <div class="c-narrow">
      <h2 class="c-ttl reveal">Bestseller</h2>
    </div>
    <div class="c-wrap c-lines">
      {
        groups.map((g) => (
          <div class="c-lines-col reveal">
            <h3>{g.label}</h3>
            <ul>
              {best[g.id].map((id) => {
                const s = svc(id);
                return (
                  s && (
                    <li>
                      <a href={`/termin?behandlung=${s.id}&gruppe=${g.id}`}>
                        <span class="c-line-name">{s.name}</span>
                        <span class="c-line-min">{s.minutes} Min.</span>
                        <span class="c-line-price">{chf(s.price)}</span>
                      </a>
                    </li>
                  )
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="c-prices-all c-wrap reveal">
      <a class="c-btn c-btn-cta" href="/termin">Termin buchen</a>
      <a class="c-link" href="/preise">Alle Preise</a>
    </div>
  </section>

  <!-- 7 · Studio in vier Bildern (davor und danach nur Text) -->
  <section class="c-cols" aria-label="Studio">
    {
      rooms.map((r) => (
        <a class="c-col" href="/studio" data-anim="soft">
          <Image src={r.img} alt={r.alt} widths={[500, 800, 1100]} sizes="(min-width: 900px) 25vw, 50vw" />
          <span class="c-col-cap">
            <strong>{r.title}</strong>
            <span>{r.text}</span>
          </span>
        </a>
      ))
    }
  </section>

  <!-- 8 · Kundenstimmen -->
  <section class="c-voices on-veil" data-c-voices aria-label="Kundenstimmen">
    <div class="c-voices-inner">
      <button type="button" class="c-arrow c-arrow-l" aria-label="Vorherige Stimme" data-c-prev><span></span></button>
      <div class="c-voices-body reveal">
        <p class="c-voices-stars" aria-label={`${rating} von 5 Sternen`}>★★★★★</p>
        <div class="c-voices-quotes">
          {
            voices.map((v, i) => (
              <figure class="c-quote" data-c-quote hidden={i !== 0}>
                <blockquote>«{v!.short ?? v!.text}»</blockquote>
                <figcaption>{v!.name}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
      <button type="button" class="c-arrow c-arrow-r" aria-label="Nächste Stimme" data-c-next><span></span></button>
    </div>
  </section>

  <!-- 9 · Video für sich: grosses Close-up mit Rahmen, daneben eine Überschrift und ein Text -->
  <section class="c-film on-frost" aria-labelledby="film-titel">
    <div class="c-film-grid">
      <div class="c-film-text">
        <h2 class="c-ttl reveal" id="film-titel">Licht, das die<br />Haarwurzel trifft.</h2>
        <p class="reveal">Unser medizinischer Diodenlaser sendet gebündeltes Licht, das vom Farbstoff im Haar aufgenommen wird – gezielt und schonend.</p>
        <p class="c-film-link reveal"><a class="c-link" href="/laserhaarentfernung">Zur Behandlung</a></p>
      </div>
      <figure class="c-film-media" data-anim="soft">
        <div class="c-film-frame">
          <LoopVideo name="laser-licht-gross" label="Close-up: Laser-Handstück mit Licht auf der Haut am Bein" pos="center 55%" />
          <button type="button" class="c-film-toggle" data-film-toggle aria-label="Video anhalten"><span aria-hidden="true"></span></button>
        </div>
        <figcaption>Medizinischer Diodenlaser</figcaption>
      </figure>
    </div>
  </section>

  <!-- 10 · Grossformat: Exhale -->
  <section class="c-big">
    <figure class="c-big-img" data-anim="soft">
      <Image src={imgExhale} alt="Heller Raum mit weissem Sessel und Kunstwerk an der Wand" widths={[800, 1200, 1800]} sizes="(min-width: 900px) 55vw, 100vw" />
    </figure>
    <div class="c-big-text">
      <h2 class="c-ttl reveal">Einmal tief<br />durchatmen.</h2>
      <p class="reveal">Nervös vor dem ersten Termin? Ganz normal. Wir nehmen uns Zeit, bis du dich wohlfühlst.</p>
      <figure class="c-big-small" data-slide="right">
        <Image src={imgPflanze} alt="" widths={[400, 700]} sizes="18vw" />
      </figure>
    </div>
  </section>

  <!-- 10 · Ruhepunkt -->
  <StudioCalm />

  <!-- 11 · Team -->
  <section class="c-tw c-tw-rev on-veil">
    <figure class="c-tw-img">
      <Image src={imgCaroSw} alt="Caro, Gründerin von Eloure" widths={[800, 1200, 1600]} sizes="(min-width: 900px) 50vw, 100vw" style="object-position:center 25%" />
    </figure>
    <div class="c-tw-text">
      <h2 class="c-ttl reveal">Persönlich<br />begleitet.</h2>
      <p class="reveal">Caro und Sarah sind deine Ansprechpartnerinnen – von der ersten Frage bis zum Ergebnis.</p>
      <p class="c-tw-link reveal"><a class="c-link" href="/studio#team">Das Team kennenlernen</a></p>
      <figure class="c-tw-small" data-slide="right">
        <Image src={imgTulpen} alt="" widths={[300, 500]} sizes="14vw" />
      </figure>
    </div>
  </section>

  <!-- 12 · FAQ als Linienliste -->
  <UspLines id="fragen" title="Gut zu wissen." items={faqs} imgA={imgKnoechel} imgB={imgRaumHoch} more={{ href: '/faq', label: 'Alle Fragen' }} />

  <!-- 13 · Abschluss: Texturfoto, Glas-Button -->
  <section class="c-end" style={`--signet:${signetOne}`}>
    <div class="c-end-img" aria-hidden="true">
      <Image src={imgRelief} alt="" widths={[1000, 1600, 2200]} sizes="100vw" />
    </div>
    <div class="c-end-signet" aria-hidden="true"></div>
    <div class="c-narrow c-end-inner">
      <h2 class="c-ttl reveal">Bereit für<br />glatte Haut?</h2>
      <div class="c-end-btns reveal">
        <a class="c-btn c-btn-glass" href="/termin">Termin buchen</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Video anhalten / abspielen
  document.querySelectorAll<HTMLButtonElement>('[data-film-toggle]').forEach((btn) => {
    const v = btn.parentElement?.querySelector('video');
    if (!v) return;
    const sync = () => {
      btn.classList.toggle('is-paused', v.paused);
      btn.setAttribute('aria-label', v.paused ? 'Video abspielen' : 'Video anhalten');
    };
    v.addEventListener('play', sync);
    v.addEventListener('pause', sync);
    btn.addEventListener('click', () => {
      if (v.paused) {
        delete v.dataset.held;
        v.play().catch(() => {});
      } else {
        v.dataset.held = '1';
        v.pause();
      }
    });
    sync();
  });

  // Kundenstimmen
  const voices = document.querySelector<HTMLElement>('[data-c-voices]');
  if (voices) {
    const quotes = [...voices.querySelectorAll<HTMLElement>('[data-c-quote]')];
    let i = 0;
    const show = (n: number) => {
      i = (n + quotes.length) % quotes.length;
      quotes.forEach((q, k) => {
        q.hidden = k !== i;
        if (k === i) q.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 700, easing: 'ease-out' });
      });
    };
    // läuft von alleine weiter; pausiert bei Maus/Fokus, ausserhalb des Bildschirms und bei „Bewegung reduzieren“
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer: number | undefined;
    let visible = false;
    let hold = false;
    const stop = () => window.clearInterval(timer);
    const start = () => {
      stop();
      if (!still && visible && !hold) timer = window.setInterval(() => show(i + 1), 6500);
    };
    voices.querySelector('[data-c-prev]')?.addEventListener('click', () => (show(i - 1), start()));
    voices.querySelector('[data-c-next]')?.addEventListener('click', () => (show(i + 1), start()));
    voices.addEventListener('mouseenter', () => ((hold = true), stop()));
    voices.addEventListener('mouseleave', () => ((hold = false), start()));
    voices.addEventListener('focusin', () => ((hold = true), stop()));
    voices.addEventListener('focusout', () => ((hold = false), start()));
    new IntersectionObserver(([e]) => ((visible = e.isIntersecting), start())).observe(voices);
  }
</script>

<style>
  /* ——— Grundlagen ——— */
  .c-ttl {
    font-family: var(--sans);
    font-weight: 200;
    font-style: normal;
    font-stretch: 100%;
    text-transform: uppercase;
    letter-spacing: 0.005em;
    line-height: 1;
    font-size: clamp(3rem, 6.8vw, 7.4rem);
    color: var(--head);
    margin: 0 0 0.5em;
    text-wrap: balance;
    hyphens: manual;
    overflow-wrap: normal;
  }

  .c-big-text .c-ttl,
  .c-tw-text .c-ttl {
    font-size: clamp(2.8rem, 5.2vw, 6rem);
  }

  p {
    font-weight: 350;
    font-size: clamp(1.12rem, 1.3vw, 1.3rem);
    line-height: 1.7;
    color: var(--ink-body);
  }

  .c-wrap {
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .c-narrow {
    position: relative;
    z-index: 2;
    max-width: 860px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    text-align: center;
  }

  .on-frost {
    background: var(--frost);
    --ink: #33363a;
    --ink-body: #3a3d41;
    --ink-2: #44474b;
    --muted: #44474b;
    --line: rgba(51, 54, 58, 0.22);
    --line-strong: rgba(51, 54, 58, 0.42);
  }

  .on-veil {
    background: var(--veil);
  }

  /* Buttons: warmer Sand als Call-to-Action-Farbe */
  .c-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 58px;
    padding: 0 40px;
    font-size: 0.88rem;
    font-weight: 450;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid;
    transition:
      background 0.4s ease,
      border-color 0.4s ease;
  }

  .c-btn-cta {
    background: var(--cta);
    border-color: var(--cta);
    color: #fff;
  }

  .c-btn-cta:hover {
    background: var(--cta-hover);
    border-color: var(--cta-hover);
  }

  .c-link {
    display: inline-block;
    font-size: 0.86rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.3s ease;
  }

  .c-link:hover {
    border-color: currentColor;
  }

  /* ——— 1 · Startbild ——— */
  .c-hero {
    position: relative;
    height: 100svh;
    min-height: 680px;
    max-height: 1100px;
    overflow: hidden;
    background: #6f7484;
  }

  .c-hero-img {
    position: absolute;
    inset: 0;
  }

  .c-hero-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 78%;
    filter: contrast(0.86) saturate(0.8);
  }

  .c-hero-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(17, 19, 28, 0.35) 0%, rgba(17, 19, 28, 0.18) 35%, rgba(17, 19, 28, 0.18) 65%, rgba(17, 19, 28, 0.4) 100%),
      rgba(78, 92, 102, 0.34);
  }

  .c-hero-text {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    padding: 120px var(--gutter) 0;
    text-align: center;
    color: #fff;
    --head: #fff;
  }

  .c-hero-title {
    font-size: clamp(2.8rem, 6.6vw, 7.2rem);
    letter-spacing: 0.01em;
    margin-bottom: 0.35em;
  }

  .c-hero-sub {
    margin: 0 0 44px;
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(1.05rem, 1.25vw, 1.2rem);
    letter-spacing: 0.04em;
  }

  /* ——— 2 · Haltung ——— */
  .c-intro {
    padding-block: clamp(150px, 16vw, 240px) clamp(110px, 11vw, 160px);
  }

  .c-intro p {
    margin: 0;
  }

  /* ——— 3 / 9 · Text + Bildfläche ——— */
  .c-tw {
    display: grid;
    min-height: clamp(600px, 62vw, 880px);
  }

  .c-tw-text {
    position: relative;
    display: grid;
    align-content: center;
    padding: clamp(90px, 9vw, 140px) clamp(28px, 7vw, 120px) clamp(200px, 17vw, 260px);
  }

  .c-tw-text p {
    max-width: 26em;
    margin: 0;
  }

  .c-tw-text .c-tw-link {
    margin-top: 34px;
  }

  .c-tw-img {
    position: relative;
    margin: 0;
    min-height: 540px;
    overflow: hidden;
  }

  .c-tw-img :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .c-tw-small {
    position: absolute;
    left: 0;
    bottom: clamp(48px, 6vw, 90px);
    width: clamp(130px, 15vw, 230px);
    aspect-ratio: 4 / 3;
    margin: 0;
    overflow: hidden;
  }

  .c-tw-rev .c-tw-small {
    left: auto;
    right: 0;
  }

  .c-tw-small :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Signet-Linie: eigenständig im Weissraum, kräftiger */
  .c-band {
    padding-block: clamp(40px, 5vw, 80px) clamp(150px, 15vw, 230px);
    overflow: hidden;
    pointer-events: none;
  }

  .c-band-strip {
    height: clamp(110px, 13vw, 200px);
    background-image: var(--signet);
    background-repeat: repeat-x;
    background-size: auto 100%;
    background-position: 30% 0;
    opacity: 0.2;
