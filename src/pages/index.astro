---
// Startseite – ruhig, klar, hochwertig.
// Aufbau nach Moodboard (evnia, Speechless, Whole Body Beauty, Nerea, Salvia):
// Salvia-Blue-Streifen mit hohem Raumfoto, feine Grossbuchstaben (Source Sans 3), warmes Creme,
// Deep Indigo für Schrift, rechteckige Buttons, eng gesetzte transparente Signets
// und nur sanfte Einblendungen (Fade + leichtes Einschieben).
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import StudioCalm from '../components/StudioCalm.astro';
import { services, chf, duration, type Group } from '../data/services';
import { googleRating, pickReview } from '../data/reviews';
import { site } from '../data/site';

import imgHero from '../assets/shoot/sessel.jpg';
import imgWord from '../assets/shoot/relief-sessel.jpg';
import imgPflanze from '../assets/shoot/detail-pflanze.jpg';
import imgObjekte from '../assets/shoot/detail-objekte.jpg';
import imgLiege from '../assets/shoot/liege-fenster.jpg';
import imgStep1 from '../assets/shoot/beratung-haende.jpg';
import imgStep2 from '../assets/shoot/detail-tuecher.jpg';
import imgStep3 from '../assets/shoot/laser-achsel.jpg';
import imgStep4 from '../assets/shoot/caro-beratung-2.jpg';

const rating = googleRating.rating.toFixed(1).replace('.', ',');

const steps = [
  { img: imgStep1, title: 'Beratung', alt: 'Hände mit Tablet beim Beratungsgespräch', pos: 'center 40%', text: 'Ehrlich und ohne Zeitdruck.' },
  { img: imgStep2, title: 'Vorbereitung', alt: 'Frische, gefaltete Handtücher im Studio', pos: 'center 60%', text: 'Saubere Liege, kühlendes Gel.' },
  { img: imgStep3, title: 'Behandlung', alt: 'Laserhaarentfernung an der Achsel mit Schutzbrille', pos: 'center 30%', text: 'Medizinischer Diodenlaser, sanft gekühlt.' },
  { img: imgStep4, title: 'Begleitung', alt: 'Caro im Gespräch mit einer Kundin', pos: 'center 30%', text: 'Folgetermine passend zum Haarzyklus.' },
];

const pick: Record<Group, string[]> = {
  frauen: ['achseln', 'bikini-intim', 'kombi-intim-achseln', 'unterschenkel', 'beine-komplett', 'ganzkoerper'],
  maenner: ['achseln-1', 'brust-bauch', 'ruecken-inkl-nacken', 'beine', 'ganzkoerper-1'],
};
const list = (g: Group) => pick[g].map((id) => services.find((s) => s.id === id)).filter((s) => !!s);
const groups: { id: Group; label: string }[] = [
  { id: 'frauen', label: 'Frauen' },
  { id: 'maenner', label: 'Männer' },
];

const voices = ['Julia F.', 'Dina G.', 'Cindy A.', 'Gökce', 'Natalie B.', 'Amy H.'].map(pickReview).filter(Boolean);

// Signet als eng gesetztes, sehr transparentes Muster (Deep Indigo, Deckkraft über CSS)
const signetPaths = [
  'M165.63 2.986c10.504 0 25.65 8.292 25.871 35.711h9.398C200.899 6.634 178.787 0 165.519 0c-13.156 0-35.27 6.634-35.27 38.698h9.397c.222-27.42 15.37-35.712 25.984-35.712zM220.729 0h9.397v38.698h-9.397zM136.703 77.394c13.269 0 35.38-6.632 35.38-38.696h-9.397c-.221 27.419-15.367 35.712-25.872 35.712-10.613 0-25.762-8.293-25.982-35.712h-9.398c-.001 32.064 22.113 38.696 35.269 38.696z',
  'M224.118 77.394c22.887 0 26.093-23.771 26.203-36.816v-1.88h-2.984v1.88c-.221 27.308-12.716 33.833-23.219 33.833-10.505 0-22.998-6.524-23.219-33.833v-2.383l-9.398.503v1.991c0 31.841 19.459 36.705 32.617 36.705z',
];
const signetSvg = (vb: string) =>
  `url("data:image/svg+xml,${encodeURIComponent(
    `<svg xmlns='http://www.w3.org/2000/svg' viewBox='${vb}'><g fill='#2b2f40'>${signetPaths.map((d) => `<path d='${d}'/>`).join('')}</g></svg>`,
  )}")`;
const signetRow = signetSvg('96 -2 160 82');
const signetOne = signetSvg('100 0 151 78');
---

<Base
  title="Laserhaarentfernung in Amriswil | Eloure The Studio"
  description="Dauerhaft glatte Haut in Amriswil: Laserhaarentfernung mit medizinischem Diodenlaser, persönlich betreut von Gründerin Caro. Ø 5,0 aus 126 Google-Bewertungen. Preise ab CHF 29, bezahlt wird erst vor Ort."
  headerTone="calm"
  theme="calm"
  announce={false}
>
  <!-- 1 · Start: Salvia-Streifen, hohes Raumfoto, feine Typo überlappt -->
  <section class="c-hero">
    <div class="c-hero-band" aria-hidden="true"></div>
    <figure class="c-hero-img" data-anim="soft">
      <Image src={imgHero} alt="Heller Behandlungsraum mit weissem Sessel am Fenster" widths={[600, 900, 1300]} sizes="(min-width: 900px) 30vw, 80vw" loading="eager" />
    </figure>
    <div class="c-hero-text">
      <h1 class="c-hero-title" data-slide="left">
        <span>Laserhaar-</span><span>entfernung</span>
        <small>in Amriswil</small>
      </h1>
    </div>
    <a class="c-btn c-btn-dark c-hero-cta" href="/termin" data-anim="up">Termin buchen</a>
  </section>

  <!-- 2 · Haltung -->
  <section class="c-intro">
    <figure class="c-intro-img c-intro-img-l" data-slide="left">
      <Image src={imgPflanze} alt="" widths={[300, 500]} sizes="16vw" />
    </figure>
    <figure class="c-intro-img c-intro-img-r" data-slide="right">
      <Image src={imgObjekte} alt="" widths={[300, 500]} sizes="14vw" />
    </figure>
    <div class="c-narrow">
      <h2 class="c-ttl reveal">Ein Studio.<br />Eine Sache.</h2>
      <p class="reveal">
        Eloure ist auf Laserhaarentfernung spezialisiert – und auf nichts anderes. Jede Behandlung beginnt mit einem ehrlichen
        Gespräch und einem Plan, der zu deiner Haut passt.
      </p>
    </div>
  </section>

  <!-- Signet-Linie über beide Sections -->
  <div class="c-band" aria-hidden="true" style={`--signet:${signetRow}`}><div class="c-band-strip"></div></div>

  <!-- 3 · Grosses Wort über hellem Raumfoto -->
  <section class="c-word on-salvia" aria-label="Glatte Haut">
    <figure class="c-word-img" data-anim="soft">
      <Image src={imgWord} alt="Helle Lounge mit weissem Sessel und Reliefwand" widths={[700, 1100, 1500]} sizes="(min-width: 900px) 40vw, 80vw" style="object-position:center 30%" />
    </figure>
    <p class="c-word-text" aria-hidden="true" data-anim="up">Glatte Haut</p>
  </section>

  <!-- 4 · Ablauf in vier Bildern -->
  <section class="c-steps">
    <div class="c-wrap">
      <h2 class="c-ttl reveal">In vier ruhigen<br />Schritten</h2>
    </div>
    <ol class="c-steps-row">
      {
        steps.map((s, i) => (
          <li class="c-step" data-anim="soft" style={`--d:${i * 0.12}`}>
            <figure class="c-step-img">
              <Image src={s.img} alt={s.alt} widths={[500, 800, 1100]} sizes="(min-width: 900px) 25vw, 50vw" style={`object-position:${s.pos}`} />
            </figure>
            <h3 class="c-step-title">
              <small>0{i + 1}</small> {s.title}
            </h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="c-band" aria-hidden="true" style={`--signet:${signetRow}`}><div class="c-band-strip c-band-strip-2"></div></div>

  <!-- 5 · Beliebte Zonen auf Salvia Blue -->
  <section class="c-prices on-salvia" id="zonen" data-c-prices>
    <div class="c-wrap c-prices-grid">
      <figure class="c-prices-img" data-slide="left">
        <Image src={imgLiege} alt="Behandlungsliege am Fenster im hellen Behandlungsraum" widths={[600, 900, 1300]} sizes="(min-width: 900px) 34vw, 90vw" />
      </figure>
      <div class="c-prices-list">
        <h2 class="c-ttl reveal">Beliebte Zonen</h2>
        <div class="c-tabs reveal" role="tablist" aria-label="Zonen für">
          {
            groups.map((g, i) => (
              <button type="button" role="tab" aria-selected={String(i === 0)} data-c-tab={g.id}>
                {g.label}
              </button>
            ))
          }
        </div>
        {
          groups.map((g, i) => (
            <ul class="c-list reveal" data-c-list={g.id} hidden={i !== 0}>
              {list(g.id).map((s) => (
                <li>
                  <a href={`/termin?behandlung=${s!.id}&gruppe=${g.id}`}>
                    <span class="c-l-name">{s!.name}</span>
                    <span class="c-l-dur">{duration(s!.minutes)}</span>
                    <span class="c-l-price">{chf(s!.price)}</span>
                    <span class="c-l-go" aria-hidden="true">
                      <Icon name="arrow" size={16} />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ))
        }
        <div class="c-prices-foot reveal">
          <a class="c-btn c-btn-dark" href="/preise">Alle Zonen & Preise</a>
          <span>Bezahlt wird erst vor Ort.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 · Ruhepunkt -->
  <StudioCalm />

  <!-- 7 · Kundenstimmen -->
  <section class="c-voices" data-c-voices aria-label="Kundenstimmen">
    <div class="c-voices-inner">
      <button type="button" class="c-arrow c-arrow-l" aria-label="Vorherige Stimme" data-c-prev><span></span></button>
      <div class="c-voices-body reveal">
        <p class="c-voices-stars" aria-label={`${rating} von 5 Sternen`}>★★★★★</p>
        <div class="c-voices-quotes">
          {
            voices.map((v, i) => (
              <figure class="c-quote" data-c-quote hidden={i !== 0}>
                <blockquote>«{v!.short ?? v!.text}»</blockquote>
                <figcaption>— {v!.name} —</figcaption>
              </figure>
            ))
          }
        </div>
        <a class="c-link" href={site.googleReviewsUrl} target="_blank" rel="noopener">{rating} · {googleRating.count} Google-Bewertungen</a>
      </div>
      <button type="button" class="c-arrow c-arrow-r" aria-label="Nächste Stimme" data-c-next><span></span></button>
    </div>
  </section>

  <!-- 8 · Abschluss auf Salvia Blue -->
  <section class="c-end on-salvia" style={`--signet:${signetOne}`}>
    <div class="c-end-signet" aria-hidden="true"></div>
    <div class="c-narrow c-end-inner">
      <h2 class="c-ttl reveal">Bereit für<br />glatte Haut?</h2>
      <div class="c-end-btns reveal">
        <a class="c-btn c-btn-dark" href="/termin">Termin buchen</a>
        <a class="c-btn c-btn-line" href="/termin?behandlung=beratungsgespraech">Kostenlos beraten lassen</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Frauen / Männer
  const prices = document.querySelector<HTMLElement>('[data-c-prices]');
  prices?.querySelectorAll<HTMLButtonElement>('[data-c-tab]').forEach((btn) => {
    btn.addEventListener('click', () => {
      prices.querySelectorAll<HTMLButtonElement>('[data-c-tab]').forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
      prices.querySelectorAll<HTMLElement>('[data-c-list]').forEach((l) => {
        l.hidden = l.dataset.cList !== btn.dataset.cTab;
        l.style.opacity = '1';
        l.style.transform = 'none';
      });
    });
  });

  // Kundenstimmen
  const voices = document.querySelector<HTMLElement>('[data-c-voices]');
  if (voices) {
    const quotes = [...voices.querySelectorAll<HTMLElement>('[data-c-quote]')];
    let i = 0;
    const show = (n: number) => {
      i = (n + quotes.length) % quotes.length;
      quotes.forEach((q, k) => {
        q.hidden = k !== i;
        if (k === i) q.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 700, easing: 'ease-out' });
      });
    };
    voices.querySelector('[data-c-prev]')?.addEventListener('click', () => show(i - 1));
    voices.querySelector('[data-c-next]')?.addEventListener('click', () => show(i + 1));
  }
</script>

<style>
  /* ——— Grundlagen dieser Seite ——— */
  .c-ttl {
    font-family: var(--sans);
    font-weight: 350;
    font-stretch: 100%;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.06;
    font-size: clamp(2.5rem, 4.6vw, 4.6rem);
    color: var(--head);
    margin: 0 0 0.55em;
    text-wrap: balance;
  }

  p {
    font-weight: 350;
    font-size: clamp(1.15rem, 1.35vw, 1.35rem);
    line-height: 1.7;
    color: var(--ink-body);
  }

  .c-wrap {
    width: 100%;
    max-width: 1360px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .c-narrow {
    position: relative;
    z-index: 2;
    max-width: 760px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    text-align: center;
  }

  /* Flächen in Salvia Blue: alle Schriftstufen in Indigo */
  .on-salvia {
    background: var(--salvia);
    --ink-body: var(--indigo);
    --ink-2: var(--indigo-soft);
    --muted: var(--indigo-soft);
    --line: rgba(43, 47, 64, 0.2);
    --line-strong: rgba(43, 47, 64, 0.42);
  }

  /* Rechteckige Buttons */
  .c-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 36px;
    font-size: 0.9rem;
    font-weight: 450;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid;
    transition:
      background 0.4s ease,
      color 0.4s ease,
      border-color 0.4s ease;
  }

  .c-btn-dark {
    background: var(--indigo);
    border-color: var(--indigo);
    color: #fff;
  }

  .c-btn-dark:hover {
    background: var(--indigo-soft);
    border-color: var(--indigo-soft);
  }

  .c-btn-line {
    color: var(--indigo);
    border-color: var(--indigo);
  }

  .c-btn-line:hover {
    background: var(--indigo);
    color: #fff;
  }

  .c-link {
    display: inline-block;
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.3s ease;
  }

  .c-link:hover {
    border-color: var(--ink);
  }

  /* Signet-Linie: gross, eng gesetzt, sehr transparent, über der Section-Grenze */
  .c-band {
    position: relative;
    z-index: 6;
    height: 0;
    overflow: visible;
    pointer-events: none;
  }

  .c-band-strip {
    position: absolute;
    left: 0;
    right: 0;
    top: clamp(-80px, -5.5vw, -40px);
    height: clamp(80px, 11vw, 160px);
    background-image: var(--signet);
    background-repeat: repeat-x;
    background-size: auto 100%;
    background-position: 30% 0;
    opacity: 0.07;
  }

  .c-band-strip-2 {
    background-position: 70% 0;
  }

  /* ——— 1 · Start ——— */
  .c-hero {
    position: relative;
    height: 100svh;
    min-height: 720px;
    max-height: 1080px;
    overflow: hidden;
    background: var(--bg);
  }

  .c-hero-band {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 72%;
    background: var(--salvia);
  }

  .c-hero-img {
    position: absolute;
    left: 38%;
    width: 30%;
    top: 13%;
    bottom: 7%;
    margin: 0;
    overflow: hidden;
    z-index: 1;
  }

  .c-hero-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% center;
  }

  .c-hero-text {
    position: absolute;
    z-index: 2;
    left: 7%;
    top: 26%;
    pointer-events: none;
  }

  .c-hero-title {
    margin: 0;
    font-family: var(--sans);
    font-weight: 300;
    font-stretch: 100%;
    text-transform: uppercase;
    font-size: clamp(3rem, 6.6vw, 7.8rem);
    line-height: 0.98;
    letter-spacing: 0.03em;
    color: var(--indigo);
  }

  .c-hero-title span {
    display: block;
    white-space: nowrap;
  }

  .c-hero-title small {
    display: block;
    margin-top: 0.9em;
    font-size: 0.17em;
    font-weight: 400;
    letter-spacing: 0.36em;
  }

  .c-hero-cta {
    position: absolute;
    z-index: 3;
    left: calc(68% - 96px);
    top: 62%;
  }

  /* ——— 2 · Haltung ——— */
  .c-intro {
    position: relative;
    padding-block: clamp(150px, 16vw, 240px) clamp(170px, 18vw, 260px);
  }

  .c-intro .c-ttl {
    margin-bottom: 0.8em;
  }

  .c-intro-img {
    position: absolute;
    margin: 0;
    overflow: hidden;
  }

  .c-intro-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .c-intro-img-l {
    left: 5%;
    top: 20%;
    width: 15%;
    aspect-ratio: 3 / 4;
  }

  .c-intro-img-r {
    right: 6%;
    top: 44%;
    width: 13%;
    aspect-ratio: 4 / 5;
  }

  /* ——— 3 · Grosses Wort ——— */
  .c-word {
    position: relative;
    height: clamp(620px, 64vw, 920px);
    overflow: hidden;
    background: var(--salvia-soft);
  }

  .c-word-img {
    position: absolute;
    left: 31%;
    width: 38%;
    top: 10%;
    bottom: 10%;
    margin: 0;
    overflow: hidden;
    z-index: 1;
  }

  .c-word-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .c-word-text {
    position: absolute;
    left: 0;
    width: 100%;
    top: 50%;
    margin: -0.5em 0 0;
    z-index: 2;
    text-align: center;
    white-space: nowrap;
    font-weight: 300;
    font-size: clamp(3.4rem, 12.4vw, 14rem);
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--indigo);
    pointer-events: none;
  }

  /* ——— 4 · Ablauf ——— */
  .c-steps {
    padding-block: clamp(140px, 14vw, 210px) clamp(140px, 14vw, 200px);
  }

  .c-steps .c-ttl {
    margin-bottom: clamp(52px, 6vw, 88px);
  }

  .c-steps-row {
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(14px, 1.6vw, 24px);
    max-width: 1520px;
    margin-inline: auto;
  }

  .c-step-img {
    margin: 0;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .c-step-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .c-step-title {
    margin: 22px 0 6px;
    font-family: var(--sans);
    font-weight: 400;
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .c-step-title small {
    font-size: 0.8em;
    color: var(--salvia-ink);
    margin-right: 6px;
  }

  .c-step p {
    margin: 0;
    font-size: clamp(1.02rem, 1.1vw, 1.1rem);
    line-height: 1.6;
    color: var(--ink-2);
  }

  /* ——— 5 · Beliebte Zonen ——— */
  .c-prices {
    padding-block: clamp(150px, 15vw, 220px) clamp(130px, 13vw, 190px);
    overflow-x: clip;
  }

  .c-prices-grid {
    display: grid;
    gap: 64px clamp(56px, 8vw, 150px);
  }

  .c-prices-img {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .c-prices-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .c-tabs {
    display: flex;
    gap: 32px;
    margin: 4px 0 30px;
  }

  .c-tabs button {
    border: 0;
    background: none;
    padding: 0 0 6px;
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid transparent;
    cursor: pointer;
    opacity: 0.75;
  }

  .c-tabs button[aria-selected='true'] {
    color: var(--ink);
    border-color: var(--ink);
    opacity: 1;
  }

  .c-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }

  .c-list li {
    border-bottom: 1px solid var(--line);
  }

  .c-list a {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: baseline;
    gap: 8px 32px;
    padding: 26px 0;
    text-decoration: none;
    color: var(--ink);
  }

  .c-l-name {
    font-weight: 350;
    font-size: clamp(1.25rem, 1.8vw, 1.65rem);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .c-l-dur {
    white-space: nowrap;
    font-size: 1rem;
    color: var(--muted);
  }

  .c-l-price {
    white-space: nowrap;
    font-weight: 450;
    font-size: clamp(1.1rem, 1.3vw, 1.25rem);
    min-width: 5.5em;
    text-align: right;
  }

  .c-l-go {
    display: none;
    transition: transform 0.4s var(--ease);
  }

  .c-list a:hover .c-l-go {
    transform: translateX(4px);
  }

  .c-prices-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
