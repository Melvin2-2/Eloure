---
// Startseite – ruhig, hell, klinisch-hochwertig.
// Aufbau nach Moodboard (u. a. evnia, Whole Body Beauty, Nerea, Salvia): heller Bildstreifen mit
// hohem Video-Fenster, feine Grossbuchstaben-Typo (Source Sans 3 Light), warmes Off-White,
// Deep Indigo für Schrift, schlanke Pill-Buttons, grosse transparente Signets als Linie
// und nur wenige, sehr ruhige Scroll-Effekte.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import StudioCalm from '../components/StudioCalm.astro';
import { services, chf, duration, type Group } from '../data/services';
import { googleRating, pickReview } from '../data/reviews';
import { site } from '../data/site';

import imgGel from '../assets/shoot/gel-achsel.jpg';
import imgRelief from '../assets/shoot/detail-relief.jpg';
import imgPflanze from '../assets/shoot/detail-pflanze.jpg';
import imgSessel from '../assets/shoot/sessel.jpg';
import imgLiege from '../assets/shoot/liege-fenster.jpg';
import imgStep1 from '../assets/shoot/beratung-haende.jpg';
import imgStep2 from '../assets/shoot/detail-tuecher.jpg';
import imgStep3 from '../assets/shoot/laser-achsel.jpg';
import imgStep4 from '../assets/shoot/caro-beratung-2.jpg';

const rating = googleRating.rating.toFixed(1).replace('.', ',');

const steps = [
  { img: imgStep1, title: 'Beratung', alt: 'Hände mit Tablet beim Beratungsgespräch', pos: 'center 40%', text: 'Wir lernen dich, deine Haut und deine Wünsche kennen – ehrlich und ohne Zeitdruck.' },
  { img: imgStep2, title: 'Vorbereitung', alt: 'Frische, gefaltete Handtücher im Studio', pos: 'center 60%', text: 'Saubere Liege, frische Tücher, kühlendes Gel. Wir erklären jeden Schritt, bevor er passiert.' },
  { img: imgStep3, title: 'Behandlung', alt: 'Laserhaarentfernung an der Achsel mit Schutzbrille', pos: 'center 30%', text: 'Medizinischer Diodenlaser, sanft gekühlt. Kleine Zonen dauern oft nur 15 Minuten.' },
  { img: imgStep4, title: 'Begleitung', alt: 'Caro im Gespräch mit einer Kundin', pos: 'center 30%', text: 'Wir planen deine Folgetermine passend zum Haarzyklus und bleiben per WhatsApp erreichbar.' },
];

const pick: Record<Group, string[]> = {
  frauen: ['achseln', 'bikini-intim', 'kombi-intim-achseln', 'unterschenkel', 'beine-komplett', 'ganzkoerper'],
  maenner: ['achseln-1', 'brust-bauch', 'ruecken-inkl-nacken', 'beine', 'ganzkoerper-1'],
};
const list = (g: Group) => pick[g].map((id) => services.find((s) => s.id === id)).filter((s) => !!s);
const groups: { id: Group; label: string }[] = [
  { id: 'frauen', label: 'Frauen' },
  { id: 'maenner', label: 'Männer' },
];

const voices = ['Julia F.', 'Dina G.', 'Cindy A.', 'Gökce', 'Natalie B.', 'Amy H.'].map(pickReview).filter(Boolean);

// Signet als grosses, sehr transparentes Muster (Deep Indigo, Deckkraft über CSS)
const signetPaths = [
  'M165.63 2.986c10.504 0 25.65 8.292 25.871 35.711h9.398C200.899 6.634 178.787 0 165.519 0c-13.156 0-35.27 6.634-35.27 38.698h9.397c.222-27.42 15.37-35.712 25.984-35.712zM220.729 0h9.397v38.698h-9.397zM136.703 77.394c13.269 0 35.38-6.632 35.38-38.696h-9.397c-.221 27.419-15.367 35.712-25.872 35.712-10.613 0-25.762-8.293-25.982-35.712h-9.398c-.001 32.064 22.113 38.696 35.269 38.696z',
  'M224.118 77.394c22.887 0 26.093-23.771 26.203-36.816v-1.88h-2.984v1.88c-.221 27.308-12.716 33.833-23.219 33.833-10.505 0-22.998-6.524-23.219-33.833v-2.383l-9.398.503v1.991c0 31.841 19.459 36.705 32.617 36.705z',
];
const signetPattern = `url("data:image/svg+xml,${encodeURIComponent(
  `<svg xmlns='http://www.w3.org/2000/svg' viewBox='15 -2 321 82'><g fill='#2b2f40'>${signetPaths.map((d) => `<path d='${d}'/>`).join('')}</g></svg>`,
)}")`;
---

<Base
  title="Laserhaarentfernung in Amriswil | Eloure The Studio"
  description="Dauerhaft glatte Haut in Amriswil: Laserhaarentfernung mit medizinischem Diodenlaser, persönlich betreut von Gründerin Caro. Ø 5,0 aus 126 Google-Bewertungen. Preise ab CHF 29, bezahlt wird erst vor Ort."
  headerTone="calm"
  theme="calm"
  announce={false}
>
  <!-- 1 · Start: heller Bildstreifen, hohes Video-Fenster, Typo überlappt beides -->
  <section class="c-hero">
    <div class="c-hero-band" aria-hidden="true">
      <Image src={imgRelief} alt="" widths={[1400, 2200]} sizes="100vw" loading="eager" />
    </div>

    <h1 class="c-hero-type">
      <span class="c-hl">Laserhaar-</span>
      <span class="c-hl">entfernung</span>
      <span class="c-hl c-hl-sub">in Amriswil</span>
    </h1>

    <div class="c-hero-panel">
      <video autoplay muted loop playsinline preload="auto" poster="/video/studio-2026.jpg" aria-label="Einblick in das Eloure Studio in Amriswil">
        <source src="/video/studio-2026.mp4" type="video/mp4" />
      </video>
      <p class="c-hero-type c-hero-type-in" aria-hidden="true">
        <span class="c-hl">Laserhaar-</span>
        <span class="c-hl">entfernung</span>
        <span class="c-hl c-hl-sub">in Amriswil</span>
      </p>
    </div>

    <a class="c-btn c-btn-dark c-hero-cta" href="/termin">Termin buchen</a>

    <p class="c-hero-info c-hero-info-l">
      <span>{site.address.street}, {site.address.zip} {site.address.city}</span>
      <span>Mo–Fr 10–20 · Sa 10–16</span>
    </p>
    <p class="c-hero-info c-hero-info-r">
      <a href={site.phoneHref}>{site.phone}</a>
      <a href={site.googleReviewsUrl} target="_blank" rel="noopener">{rating} ★ · {googleRating.count} Google-Bewertungen</a>
    </p>
  </section>

  <!-- 2 · Haltung, gerahmt von zwei Detailbildern -->
  <section class="c-intro">
    <figure class="c-intro-img c-intro-img-l">
      <Image src={imgPflanze} alt="" widths={[300, 500]} sizes="16vw" />
    </figure>
    <figure class="c-intro-img c-intro-img-r">
      <Image src={imgSessel} alt="" widths={[300, 500]} sizes="14vw" />
    </figure>
    <div class="c-narrow">
      <h2 class="c-ttl reveal">Ein Studio.<br />Eine Sache.</h2>
      <p class="reveal">
        Eloure ist auf Laserhaarentfernung spezialisiert – und auf nichts anderes. Jede Behandlung beginnt mit einem ehrlichen
        Gespräch und einem Plan, der zu deiner Haut passt.
      </p>
      <p class="reveal">Helle Räume, medizinische Technik, viel Ruhe.</p>
    </div>
  </section>

  <!-- Signet-Linie über beide Sections -->
  <div class="c-band" aria-hidden="true" style={`--signet:${signetPattern}`}><div class="c-band-strip" data-drift="1"></div></div>

  <!-- 3 · Grosses Wort über Bild und Textur -->
  <section class="c-word" aria-label="Glatte Haut">
    <div class="c-texture" aria-hidden="true">
      <Image src={imgRelief} alt="" widths={[1200, 2000]} sizes="100vw" />
    </div>
    <p class="c-word-text" aria-hidden="true">Glatte Haut</p>
    <figure class="c-word-img">
      <Image src={imgGel} alt="Kühlendes Gel wird vor der Laserbehandlung auf die Achsel aufgetragen" widths={[700, 1100, 1500]} sizes="(min-width: 900px) 40vw, 80vw" data-parallax="4" />
      <p class="c-word-text c-word-text-in" aria-hidden="true">Glatte Haut</p>
    </figure>
    <p class="c-word-note reveal">Für Frauen und Männer.<br />Über 30 Zonen, einzeln oder als Kombi.</p>
  </section>

  <!-- 4 · Ablauf in vier Bildern -->
  <section class="c-steps">
    <div class="c-wrap c-steps-head">
      <h2 class="c-ttl reveal">In vier ruhigen<br />Schritten</h2>
      <p class="reveal">Von der ersten Frage bis zum Ergebnis – du weisst immer, was als Nächstes passiert.</p>
    </div>
    <ol class="c-steps-row">
      {
        steps.map((s, i) => (
          <li class="c-step reveal">
            <figure class="c-step-img">
              <Image src={s.img} alt={s.alt} widths={[500, 800, 1100]} sizes="(min-width: 900px) 25vw, 50vw" style={`object-position:${s.pos}`} />
              <span class="c-step-title">
                <small>0{i + 1}</small>
                {s.title}
              </span>
            </figure>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="c-band" aria-hidden="true" style={`--signet:${signetPattern}`}><div class="c-band-strip c-band-strip-2" data-drift="-1"></div></div>

  <!-- 5 · Beliebte Zonen: Raumfoto + ruhige Liste -->
  <section class="c-prices" id="zonen" data-c-prices>
    <div class="c-wrap c-prices-grid">
      <figure class="c-prices-img">
        <Image src={imgLiege} alt="Behandlungsliege am Fenster im hellen Behandlungsraum" widths={[600, 900, 1300]} sizes="(min-width: 900px) 34vw, 90vw" />
        <figcaption>Bezahlt wird erst vor Ort.<br />Kostenlos absagen bis 24 Stunden vorher.</figcaption>
      </figure>
      <div class="c-prices-list">
        <h2 class="c-ttl reveal">Beliebte Zonen</h2>
        <div class="c-tabs reveal" role="tablist" aria-label="Zonen für">
          {
            groups.map((g, i) => (
              <button type="button" role="tab" aria-selected={String(i === 0)} data-c-tab={g.id}>
                {g.label}
              </button>
            ))
          }
        </div>
        {
          groups.map((g, i) => (
            <ul class="c-list" data-c-list={g.id} hidden={i !== 0}>
              {list(g.id).map((s) => (
                <li>
                  <a href={`/termin?behandlung=${s!.id}&gruppe=${g.id}`}>
                    <span class="c-l-name">{s!.name}</span>
                    <span class="c-l-dur">{duration(s!.minutes)}</span>
                    <span class="c-l-price">{chf(s!.price)}</span>
                    <span class="c-l-go" aria-hidden="true">
                      <Icon name="arrow" size={16} />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ))
        }
        <a class="c-btn c-btn-line c-prices-all reveal" href="/preise">Alle Zonen & Preise</a>
      </div>
    </div>
  </section>

  <!-- 6 · Ruhepunkt -->
  <StudioCalm />

  <!-- 7 · Kundenstimmen: ruhig, ohne Grossbild – feine Linien, Sterne, Zitat -->
  <section class="c-voices" data-c-voices aria-label="Kundenstimmen">
    <div class="c-voices-inner">
      <button type="button" class="c-arrow c-arrow-l" aria-label="Vorherige Stimme" data-c-prev><span></span></button>
      <div class="c-voices-body">
        <p class="c-voices-stars" aria-label={`${rating} von 5 Sternen`}>★★★★★</p>
        <div class="c-voices-quotes">
          {
            voices.map((v, i) => (
              <figure class="c-quote" data-c-quote hidden={i !== 0}>
                <blockquote>«{v!.short ?? v!.text}»</blockquote>
                <figcaption>— {v!.name} —</figcaption>
              </figure>
            ))
          }
        </div>
        <a class="c-link" href={site.googleReviewsUrl} target="_blank" rel="noopener">{rating} · {googleRating.count} Google-Bewertungen</a>
      </div>
      <button type="button" class="c-arrow c-arrow-r" aria-label="Nächste Stimme" data-c-next><span></span></button>
    </div>
  </section>

  <!-- 8 · Abschluss -->
  <section class="c-end" style={`--signet:${signetPattern}`}>
    <div class="c-texture" aria-hidden="true">
      <Image src={imgRelief} alt="" widths={[1200, 2000]} sizes="100vw" />
    </div>
    <div class="c-end-signet" aria-hidden="true"></div>
    <div class="c-narrow c-end-inner">
      <h2 class="c-ttl reveal">Bereit für<br />glatte Haut?</h2>
      <p class="reveal">Buche deinen Termin direkt online – oder komm zuerst zu einem kostenlosen Beratungsgespräch.</p>
      <div class="c-end-btns reveal">
        <a class="c-btn c-btn-dark" href="/termin">Termin buchen</a>
        <a class="c-btn c-btn-line" href="/termin?behandlung=beratungsgespraech">Kostenlos beraten lassen</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Frauen / Männer
  const prices = document.querySelector<HTMLElement>('[data-c-prices]');
  prices?.querySelectorAll<HTMLButtonElement>('[data-c-tab]').forEach((btn) => {
    btn.addEventListener('click', () => {
      prices.querySelectorAll<HTMLButtonElement>('[data-c-tab]').forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
      prices.querySelectorAll<HTMLElement>('[data-c-list]').forEach((l) => (l.hidden = l.dataset.cList !== btn.dataset.cTab));
    });
  });

  // Kundenstimmen
  const voices = document.querySelector<HTMLElement>('[data-c-voices]');
  if (voices) {
    const quotes = [...voices.querySelectorAll<HTMLElement>('[data-c-quote]')];
    let i = 0;
    const show = (n: number) => {
      i = (n + quotes.length) % quotes.length;
      quotes.forEach((q, k) => {
        q.hidden = k !== i;
        if (k === i) q.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 700, easing: 'ease-out' });
      });
    };
    voices.querySelector('[data-c-prev]')?.addEventListener('click', () => show(i - 1));
    voices.querySelector('[data-c-next]')?.addEventListener('click', () => show(i + 1));
  }
</script>

<style>
  /* ——— Grundlagen dieser Seite ——— */
  .c-ttl {
    font-family: var(--sans);
    font-weight: 300;
    font-stretch: 100%;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.06;
    font-size: clamp(2.5rem, 4.6vw, 4.6rem);
    color: var(--head);
    margin: 0 0 0.55em;
    text-wrap: balance;
  }

  p {
    font-weight: 300;
    font-size: clamp(1.15rem, 1.35vw, 1.35rem);
    line-height: 1.7;
    color: var(--ink-body);
  }

  .c-wrap {
    width: 100%;
    max-width: 1360px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .c-narrow {
    position: relative;
    z-index: 2;
    max-width: 760px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    text-align: center;
  }

  /* Schlanke Pill-Buttons statt Kästen */
  .c-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 36px;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid;
    transition:
      background 0.4s ease,
      color 0.4s ease,
      border-color 0.4s ease;
  }

  .c-btn-dark {
    background: var(--indigo);
    border-color: var(--indigo);
    color: #fff;
  }

  .c-btn-dark:hover {
    background: transparent;
    color: var(--indigo);
  }

  .c-btn-line {
    color: var(--indigo);
    border-color: rgba(43, 47, 64, 0.35);
  }

  .c-btn-line:hover {
    background: var(--indigo);
    border-color: var(--indigo);
    color: #fff;
  }

  .c-link {
    display: inline-block;
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.3s ease;
  }

  .c-link:hover {
    border-color: var(--ink);
  }

  figure :global(img[data-parallax]),
  .c-hero-panel video {
    position: absolute;
    left: 0;
    top: -3%;
    width: 100%;
    height: 106%;
    object-fit: cover;
  }

  /* Signet-Linie: wenige, grosse, sehr transparente Signets über der Section-Grenze */
  .c-band {
    position: relative;
    z-index: 6;
    height: 0;
    overflow: visible;
    pointer-events: none;
  }

  .c-band-strip {
    position: absolute;
    left: -6%;
    width: 112%;
    top: clamp(-90px, -6vw, -46px);
    height: clamp(92px, 12vw, 180px);
    background-image: var(--signet);
    background-repeat: repeat-x;
    background-size: auto 100%;
    background-position: 8% 0;
    opacity: 0.06;
  }

  .c-band-strip-2 {
    background-position: 46% 0;
  }

  /* Texturen aus eigenen Detailfotos */
  .c-texture {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .c-texture :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.22;
    filter: grayscale(1) contrast(0.9);
    mix-blend-mode: multiply;
  }

  /* ——— 1 · Start (Aufbau nach evnia) ——— */
  .c-hero {
    position: relative;
    height: 100svh;
    min-height: 720px;
    max-height: 1100px;
    overflow: hidden;
    background: var(--bg);
  }

  .c-hero-band {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 74%;
    overflow: hidden;
    background: #ebe8e1;
  }

  .c-hero-band :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
    filter: grayscale(1) contrast(0.85) brightness(1.06);
    mix-blend-mode: multiply;
  }

  .c-hero-panel {
    position: absolute;
    left: 34%;
    width: 32%;
    top: 11%;
    bottom: 0;
    overflow: hidden;
    z-index: 2;
    background: #d9d4ca;
  }

  .c-hero-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(17, 19, 28, 0.12);
  }

  /* Typo zweimal deckungsgleich: Indigo auf dem Streifen, Weiss im Video-Fenster.
     Fenster: links 34 %, Breite 32 %, oben 11 %, unten 0 → Typo-Mitte bei 36 % */
  .c-hero-type {
    position: absolute;
    z-index: 1;
    left: 0;
    width: 100%;
    top: 36%;
    transform: translateY(-50%);
    margin: 0;
    padding-left: 7%;
    font-family: var(--sans);
    font-weight: 200;
    font-stretch: 100%;
    text-transform: uppercase;
    font-size: clamp(3rem, 6.4vw, 7.6rem);
    line-height: 0.98;
    letter-spacing: 0.03em;
    color: var(--indigo);
    pointer-events: none;
  }

  .c-hero-type-in {
    left: -106.25%;
    width: 312.5%;
    top: 28.0899%;
    padding-left: 21.875%;
    z-index: 3;
    color: #fff;
  }

  .c-hl {
    display: block;
    white-space: nowrap;
  }

  .c-hl-sub {
    margin-top: 0.5em;
    font-size: 0.28em;
    letter-spacing: 0.34em;
    font-weight: 300;
  }

  .c-hero-cta {
    position: absolute;
    z-index: 4;
    left: calc(66% - 110px);
    top: 66%;
  }

  .c-hero-info {
    position: absolute;
    z-index: 4;
    top: 80%;
    width: 26%;
    display: grid;
    gap: 6px;
    margin: 0;
    font-size: 0.82rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-align: center;
    color: var(--ink-2);
  }

  .c-hero-info a {
    color: inherit;
    text-decoration: none;
  }

  .c-hero-info a:hover {
    color: var(--ink);
  }

  .c-hero-info-l {
    left: 4%;
  }

  .c-hero-info-r {
    right: 4%;
  }

  /* ——— 2 · Haltung ——— */
  .c-intro {
    position: relative;
    padding-block: clamp(150px, 16vw, 240px) clamp(170px, 18vw, 260px);
  }

  .c-intro .c-ttl {
    margin-bottom: 0.8em;
  }

  .c-intro p + p {
    margin-top: 1.1em;
  }

  .c-intro-img {
    position: absolute;
    margin: 0;
    overflow: hidden;
  }

  .c-intro-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .c-intro-img-l {
    left: 5%;
    top: 20%;
    width: 15%;
    aspect-ratio: 3 / 4;
  }

  .c-intro-img-r {
    right: 6%;
    top: 44%;
    width: 13%;
    aspect-ratio: 4 / 5;
  }

  /* ——— 3 · Grosses Wort ——— */
  .c-word {
    position: relative;
    height: clamp(620px, 66vw, 940px);
    overflow: hidden;
    background: #f3f1ea;
  }

  .c-word-img {
    position: absolute;
    left: 30%;
    width: 40%;
    top: 9%;
    bottom: 9%;
    margin: 0;
    overflow: hidden;
    z-index: 2;
  }

  .c-word-img :global(img) {
    object-position: center 55%;
  }

  .c-word-text {
    position: absolute;
    left: 0;
    width: 100%;
    top: 50%;
    transform: translateY(-50%);
    margin: 0;
    z-index: 1;
    text-align: center;
    white-space: nowrap;
    font-weight: 200;
    font-size: clamp(3.4rem, 12.6vw, 14rem);
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--indigo);
    pointer-events: none;
  }

  .c-word-text-in {
    left: -75%;
    width: 250%;
    z-index: 3;
    color: #fff;
  }

  .c-word-note {
    position: absolute;
    z-index: 4;
    right: var(--gutter);
    bottom: 9%;
    margin: 0;
    max-width: 20em;
    font-size: clamp(1rem, 1.15vw, 1.15rem);
    line-height: 1.6;
    text-align: right;
    color: var(--ink-2);
  }

  /* ——— 4 · Ablauf ——— */
  .c-steps {
