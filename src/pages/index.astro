---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Lines from '../components/Lines.astro';
import TrustBand from '../components/TrustBand.astro';
import ZoneHighlights from '../components/ZoneHighlights.astro';
import StoryPath from '../components/StoryPath.astro';
import StudioCalm from '../components/StudioCalm.astro';
import VoicesFaq from '../components/VoicesFaq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { site } from '../data/site';
import { shortFaqs } from '../data/faq';
import { googleRating } from '../data/reviews';

import imgRoom from '../assets/shoot/laser-achsel.jpg';
import imgCaro from '../assets/shoot/caro-stehend.jpg';

const rating = googleRating.rating.toFixed(1).replace('.', ',');
const intro = [
  { icon: 'venus', title: 'Für Frauen', text: 'Gesicht, Achseln, Bikini, Beine' },
  { icon: 'mars', title: 'Für Männer', text: 'Rücken, Brust, Konturen, Beine' },
  { icon: 'zones', title: 'Über 30 Zonen', text: 'einzeln oder als Kombi' },
] as const;
---

<Base
  title="Laserhaarentfernung in Amriswil | Eloure The Studio"
  description="Dauerhaft glatte Haut in Amriswil: Laserhaarentfernung mit medizinischem Diodenlaser, persönlich betreut von Gründerin Caro. Ø 5,0 aus 126 Google-Bewertungen. Preise ab CHF 29, bezahlt wird erst vor Ort."
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: shortFaqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ]}
>
  <!-- 1 · HERO – Vollbild-Video, klares Versprechen, zwei Wege, Beweis -->
  <section class="hero bg-dark">
    <video class="hero-video" autoplay muted loop playsinline preload="auto" poster="/video/studio-2026.jpg" aria-label="Laserbehandlung im Eloure Studio in Amriswil">
      <source src="/video/studio-2026.mp4" type="video/mp4" />
    </video>
    <div class="hero-shade"></div>

    <div class="wrap hero-inner">
      <Lines as="h1" class="display hero-title" lines={['Dauerhaft glatte Haut.', 'In Amriswil.']} />
      <p class="hero-sub" data-anim="up">Laserhaarentfernung mit medizinischem Diodenlaser</p>
      <p class="lead" data-anim="up">
        Ehrlich beraten, sanft behandelt und persönlich begleitet – von Caro, Gründerin von Eloure.
      </p>
      <div class="btn-row" data-anim="up">
        <a class="btn btn-primary" href="/termin">Termin buchen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
        <a class="btn btn-ghost" href="#zonen">Zonen & Preise</a>
      </div>
      <a class="hero-rating" href={site.googleReviewsUrl} target="_blank" rel="noopener" data-anim="up">
        <span class="stars">★★★★★</span>
        <span><b>{rating}</b> aus {googleRating.count} Google-Bewertungen</span>
      </a>
    </div>
  </section>

  <!-- 3 · EINSTIEG: worum es bei Eloure geht -->
  <section class="intro bg-paper">
    <div class="in-stage">
      <figure class="in-big" data-anim="img">
        <Image src={imgRoom} alt="Kundin mit Schutzbrille bei der Laserhaarentfernung an der Achsel" widths={[700, 1100, 1600]} sizes="(min-width: 1000px) 40vw, 100vw" style="object-position:center 35%" />
      </figure>
      <figure class="in-small" data-drift-y="-10">
        <Image src={imgCaro} alt="Caro, Gründerin von Eloure, im Studio" widths={[400, 700]} sizes="(min-width: 1000px) 15vw, 40vw" />
      </figure>
      <div class="in-text">
        <Lines lines={['Glatte Haut.', 'Gutes Gefühl.']} class="in-title" />
        <p class="in-lead reveal">
          Eloure ist dein Studio für Laserhaarentfernung in Amriswil. Mit medizinischem Diodenlaser reduzieren wir störende Haare
          langfristig – persönlich betreut von Gründerin Caro und ihrem Team.
        </p>
        <ul class="in-facts">
          {
            intro.map((f, i) => (
              <li class="reveal" style={`--d:${i * 80}ms`}>
                <Icon name={f.icon} size={40} stroke={1.15} />
                <span>
                  <strong>{f.title}</strong>
                  {f.text}
                </span>
              </li>
            ))
          }
        </ul>
        <div class="btn-row reveal">
          <a class="btn btn-primary" href="/termin">Termin buchen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
          <a class="text-link" href="#zonen">Zonen & Preise</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · ENTSCHEIDUNG -->
  <ZoneHighlights />

  <!-- 4b · SOFORT-BEWEIS -->
  <TrustBand />

  <!-- 5 · ABLAUF ALS SCROLL-STORY -->
  <StoryPath />

  <!-- 6 · RUHEPUNKT: Studio-Impression -->
  <StudioCalm />

  <!-- 7 · STIMMEN & FRAGEN -->
  <VoicesFaq />

  <!-- 8 · ABSCHLUSS -->
  <CtaFinal />
</Base>

<style>
  /* ——— Hero ——— */
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% center;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(27, 30, 42, 0.88) 0%, rgba(27, 30, 42, 0.45) 45%, rgba(27, 30, 42, 0.2) 75%),
      linear-gradient(90deg, rgba(27, 30, 42, 0.55) 0%, rgba(27, 30, 42, 0) 60%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    padding-top: 80px;
    padding-bottom: clamp(48px, 7vw, 96px);
  }

  .hero-inner :global(.hero-title) {
    font-size: clamp(2.5rem, 6.6vw, 6.8rem);
    line-height: 0.93;
    margin-bottom: 22px;
    color: var(--cream);
    --head: currentColor;
  }

  .hero-sub {
    margin: 0 0 14px;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lime);
  }

  .hero-inner .lead {
    max-width: 32em;
    margin-bottom: 34px;
    color: rgba(244, 246, 247, 0.9);
  }

  .hero-rating {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
    padding: 12px 18px;
    background: rgba(244, 246, 247, 0.12);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(244, 246, 247, 0.25);
    color: var(--cream);
    --head: currentColor;
    text-decoration: none;
    font-size: 1.02rem;
  }

  .stars {
    color: var(--lime);
    letter-spacing: 3px;
  }

  /* ——— Einstieg ——— */
  .intro {
    padding: clamp(72px, 9vw, 136px) var(--gutter);
    overflow: hidden;
  }

  .in-stage {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .in-text {
    position: relative;
    z-index: 3;
  }

  .in-text :global(.in-title) {
    margin: 0 0 clamp(24px, 3vw, 40px);
    font-size: clamp(3rem, 13vw, 9.6rem);
    line-height: 0.92;
    color: var(--ink);
    --head: currentColor;
  }

  .in-lead {
    margin: 0 0 32px;
    max-width: 34em;
    font-size: clamp(1.15rem, 1.45vw, 1.35rem);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .in-facts {
    list-style: none;
    margin: 0 0 40px;
    padding: 0;
    display: grid;
    gap: 22px 32px;
  }

  .in-facts li {
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--ink-2);
    font-size: 0.98rem;
    line-height: 1.35;
  }

  .in-facts :global(svg) {
    flex: none;
    color: var(--salvia-ink);
  }

  .in-facts strong {
    display: block;
    font-family: var(--serif);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    text-transform: uppercase;
    font-size: 1.25rem;
    letter-spacing: var(--display-ls);
    color: var(--ink);
    --head: currentColor;
  }

  .in-big,
  .in-small {
    margin: 0;
    overflow: hidden;
  }

  .in-big :global(img),
  .in-small :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .in-big {
    position: relative;
    aspect-ratio: 4 / 4.2;
  }

  @media (max-width: 999px) {
    .in-big::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(0deg, rgba(250, 251, 252, 0.95) 0%, rgba(250, 251, 252, 0) 45%);
    }
  }

  .in-text {
    margin-top: -2.3rem;
  }

  .in-small {
    display: none;
    position: absolute;
    z-index: 4;
    aspect-ratio: 3 / 4;
    outline: 8px solid var(--paper);
  }

  .intro .text-link {
    color: var(--salvia-ink);
  }

  @media (min-width: 640px) {
    .in-facts {
      grid-template-columns: repeat(3, auto);
      justify-content: start;
    }
  }

  @media (min-width: 1000px) {
    .in-stage {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      align-items: center;
      gap: 0 clamp(40px, 5vw, 88px);
      min-height: min(72vh, 760px);
    }
    .in-text {
      grid-column: 1;
      grid-row: 1;
      margin-top: 0;
    }
    .in-text :global(.in-title) {
      font-size: clamp(3.2rem, 8vw, 9.6rem);
      width: max-content;
      margin-right: -12vw;
    }
    .in-big {
      grid-column: 2;
      grid-row: 1;
      aspect-ratio: auto;
      height: min(72vh, 760px);
      margin: 0;
    }
    .in-small {
      display: block;
      right: -1px;
      bottom: calc(-1 * clamp(32px, 6vh, 64px));
      width: 11vw;
    }
  }
</style>
