---
// Startseite – ruhig, hell, klinisch-hochwertig.
// Feine Schrift (Source Sans 3 Light, Grossbuchstaben), warmes Off-White, Deep Indigo für Schrift,
// Salvia Blue als leiser Akzent, das Eloure-Signet als durchlaufende Linie, Frosted-Glass-Elemente
// und zurückhaltende Scroll-Effekte (Parallaxe, wandernde Typo, schwebende Detailbilder).
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import StudioCalm from '../components/StudioCalm.astro';
import { services, chf, duration, type Group } from '../data/services';
import { googleRating, pickReview } from '../data/reviews';
import { site } from '../data/site';

import imgGel from '../assets/shoot/gel-achsel.jpg';
import imgRelief from '../assets/shoot/detail-relief.jpg';
import imgTulpen from '../assets/shoot/detail-tulpen.jpg';
import imgObjekte from '../assets/shoot/detail-objekte.jpg';
import imgPflanze from '../assets/shoot/detail-pflanze.jpg';
import imgSessel from '../assets/shoot/sessel.jpg';
import imgLiege from '../assets/shoot/liege-fenster.jpg';
import imgLounge from '../assets/shoot/lounge.jpg';
import imgStep1 from '../assets/shoot/beratung-haende.jpg';
import imgStep2 from '../assets/shoot/detail-tuecher.jpg';
import imgStep3 from '../assets/shoot/laser-achsel.jpg';
import imgStep4 from '../assets/shoot/caro-beratung-2.jpg';

const rating = googleRating.rating.toFixed(1).replace('.', ',');

const steps = [
  { img: imgStep1, title: 'Beratung', alt: 'Hände mit Tablet beim Beratungsgespräch', pos: 'center 40%', text: 'Wir lernen dich, deine Haut und deine Wünsche kennen – ehrlich und ohne Zeitdruck.' },
  { img: imgStep2, title: 'Vorbereitung', alt: 'Frische, gefaltete Handtücher im Studio', pos: 'center 60%', text: 'Saubere Liege, frische Tücher, kühlendes Gel. Wir erklären jeden Schritt, bevor er passiert.' },
  { img: imgStep3, title: 'Behandlung', alt: 'Laserhaarentfernung an der Achsel mit Schutzbrille', pos: 'center 30%', text: 'Medizinischer Diodenlaser, sanft gekühlt. Kleine Zonen dauern oft nur 15 Minuten.' },
  { img: imgStep4, title: 'Begleitung', alt: 'Caro im Gespräch mit einer Kundin', pos: 'center 30%', text: 'Wir planen deine Folgetermine passend zum Haarzyklus und bleiben per WhatsApp erreichbar.' },
];

const pick: Record<Group, string[]> = {
  frauen: ['achseln', 'bikini-intim', 'kombi-intim-achseln', 'unterschenkel', 'beine-komplett', 'ganzkoerper'],
  maenner: ['achseln-1', 'brust-bauch', 'ruecken-inkl-nacken', 'beine', 'ganzkoerper-1'],
};
const list = (g: Group) => pick[g].map((id) => services.find((s) => s.id === id)).filter((s) => !!s);
const groups: { id: Group; label: string }[] = [
  { id: 'frauen', label: 'Frauen' },
  { id: 'maenner', label: 'Männer' },
];

const voices = ['Julia F.', 'Dina G.', 'Cindy A.', 'Gökce', 'Natalie B.', 'Amy H.'].map(pickReview).filter(Boolean);

// Signet als feines, wiederholtes Linienmuster (Salvia Blue)
const signetPaths = [
  'M165.63 2.986c10.504 0 25.65 8.292 25.871 35.711h9.398C200.899 6.634 178.787 0 165.519 0c-13.156 0-35.27 6.634-35.27 38.698h9.397c.222-27.42 15.37-35.712 25.984-35.712zM220.729 0h9.397v38.698h-9.397zM136.703 77.394c13.269 0 35.38-6.632 35.38-38.696h-9.397c-.221 27.419-15.367 35.712-25.872 35.712-10.613 0-25.762-8.293-25.982-35.712h-9.398c-.001 32.064 22.113 38.696 35.269 38.696z',
  'M224.118 77.394c22.887 0 26.093-23.771 26.203-36.816v-1.88h-2.984v1.88c-.221 27.308-12.716 33.833-23.219 33.833-10.505 0-22.998-6.524-23.219-33.833v-2.383l-9.398.503v1.991c0 31.841 19.459 36.705 32.617 36.705z',
];
const signetPattern = `url("data:image/svg+xml,${encodeURIComponent(
  `<svg xmlns='http://www.w3.org/2000/svg' viewBox='20 -4 311 86'><g fill='#9baec9'>${signetPaths.map((d) => `<path d='${d}'/>`).join('')}</g></svg>`,
)}")`;
---

<Base
  title="Laserhaarentfernung in Amriswil | Eloure The Studio"
  description="Dauerhaft glatte Haut in Amriswil: Laserhaarentfernung mit medizinischem Diodenlaser, persönlich betreut von Gründerin Caro. Ø 5,0 aus 126 Google-Bewertungen. Preise ab CHF 29, bezahlt wird erst vor Ort."
  headerTone="calm"
  theme="calm"
  announce={false}
>
  <!-- 1 · Start: Video-Fenster, grosse feine Typo darüber, schwebende Details, Glas-Karte -->
  <section class="c-hero">
    <figure class="c-float c-float-l" data-drift-y="-30">
      <Image src={imgTulpen} alt="" widths={[300, 500]} sizes="14vw" />
    </figure>
    <figure class="c-float c-float-r" data-drift-y="-55">
      <Image src={imgObjekte} alt="" widths={[300, 500]} sizes="12vw" />
    </figure>

    <h1 class="c-hero-type">
      <span class="c-hl c-hl1"><span data-drift="-4">Laserhaar</span></span>
      <span class="c-hl c-hl2"><span data-drift="4">entfernung</span></span>
      <span class="sr-only"> in Amriswil</span>
    </h1>

    <div class="c-hero-panel">
      <video autoplay muted loop playsinline preload="auto" poster="/video/studio-2026.jpg" aria-label="Einblick in das Eloure Studio in Amriswil" data-parallax="10">
        <source src="/video/studio-2026.mp4" type="video/mp4" />
      </video>
      <p class="c-hero-type c-hero-type-in" aria-hidden="true">
        <span class="c-hl c-hl1"><span data-drift="-4">Laserhaar</span></span>
        <span class="c-hl c-hl2"><span data-drift="4">entfernung</span></span>
      </p>
    </div>

    <p class="c-hero-meta" data-anim="up">
      <span>In Amriswil</span>
      <span>{site.address.street} · {site.address.zip} {site.address.city}</span>
      <span>Mo–Fr 10–20 · Sa 10–16</span>
    </p>

    <div class="c-glass c-hero-card" data-anim="up">
      <a class="c-hero-rating" href={site.googleReviewsUrl} target="_blank" rel="noopener">
        <span class="c-stars">★★★★★</span>
        <span><b>{rating}</b> · {googleRating.count} Google-Bewertungen</span>
      </a>
      <p>Medizinischer Diodenlaser, persönlich begleitet von Caro. Bezahlt wird erst vor Ort.</p>
      <div class="c-hero-actions">
        <a class="c-btn c-btn-dark" href="/termin">Termin buchen</a>
        <a class="c-link" href="#zonen">Zonen & Preise</a>
      </div>
    </div>
  </section>

  <!-- 2 · Haltung, umrahmt von schwebenden Details -->
  <section class="c-intro">
    <figure class="c-intro-img c-intro-img-l" data-drift-y="-18">
      <Image src={imgPflanze} alt="" widths={[300, 500]} sizes="16vw" />
    </figure>
    <figure class="c-intro-img c-intro-img-r" data-drift-y="-34">
      <Image src={imgSessel} alt="" widths={[300, 500]} sizes="14vw" />
    </figure>
    <div class="c-narrow">
      <h2 class="c-ttl reveal">Ein Studio.<br />Eine Sache.</h2>
      <p class="reveal">
        Eloure ist auf Laserhaarentfernung spezialisiert – und auf nichts anderes. Jede Behandlung beginnt mit einem ehrlichen
        Gespräch und einem Plan, der zu deiner Haut passt.
      </p>
      <p class="reveal">Helle Räume, medizinische Technik, viel Ruhe.</p>
    </div>
  </section>

  <!-- Signet-Linie über beide Sections -->
  <div class="c-band" aria-hidden="true" style={`--signet:${signetPattern}`}><div class="c-band-strip" data-drift="6"></div></div>

  <!-- 3 · Grosses Wort über Bild und Textur -->
  <section class="c-word" aria-label="Glatte Haut">
    <div class="c-texture" aria-hidden="true">
      <Image src={imgRelief} alt="" widths={[1200, 2000]} sizes="100vw" data-parallax="12" />
    </div>
    <p class="c-word-text" aria-hidden="true"><span data-drift="5">Glatte Haut</span></p>
    <figure class="c-word-img">
      <Image src={imgGel} alt="Kühlendes Gel wird vor der Laserbehandlung auf die Achsel aufgetragen" widths={[700, 1100, 1500]} sizes="(min-width: 900px) 40vw, 80vw" data-parallax="10" />
      <p class="c-word-text c-word-text-in" aria-hidden="true"><span data-drift="5">Glatte Haut</span></p>
    </figure>
    <div class="c-glass c-word-note reveal">
      <p>Für Frauen und Männer. Über 30 Zonen, einzeln oder als Kombi – sanft gekühlt und medizinisch präzise.</p>
    </div>
  </section>

  <!-- 4 · Ablauf in vier Bildern -->
  <section class="c-steps">
    <div class="c-wrap c-steps-head">
      <h2 class="c-ttl reveal">In vier ruhigen<br />Schritten</h2>
      <p class="reveal">Von der ersten Frage bis zum Ergebnis – du weisst immer, was als Nächstes passiert.</p>
    </div>
    <ol class="c-steps-row">
      {
        steps.map((s, i) => (
          <li class="c-step reveal" style={`--d:${i * 90}ms`}>
            <figure class="c-step-img">
              <Image src={s.img} alt={s.alt} widths={[500, 800, 1100]} sizes="(min-width: 900px) 25vw, 50vw" style={`object-position:${s.pos}`} data-parallax="8" />
              <span class="c-step-title">
                {s.title}
                <small>0{i + 1}</small>
              </span>
            </figure>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="c-band" aria-hidden="true" style={`--signet:${signetPattern}`}><div class="c-band-strip" data-drift="-6"></div></div>

  <!-- 5 · Beliebte Zonen: Bild mit Glas-Hinweis + ruhige Liste -->
  <section class="c-prices" id="zonen" data-c-prices>
    <div class="c-wrap c-prices-grid">
      <div class="c-prices-media">
        <figure class="c-prices-img">
          <Image src={imgLiege} alt="Behandlungsliege am Fenster im hellen Behandlungsraum" widths={[600, 900, 1300]} sizes="(min-width: 900px) 34vw, 90vw" data-parallax="10" />
        </figure>
        <div class="c-glass c-prices-note reveal">
          <p>Bezahlt wird erst vor Ort. Kostenlos absagen bis 24 Stunden vorher.</p>
        </div>
      </div>
      <div class="c-prices-list">
        <h2 class="c-ttl reveal">Beliebte Zonen</h2>
        <div class="c-tabs reveal" role="tablist" aria-label="Zonen für">
          {
            groups.map((g, i) => (
              <button type="button" role="tab" aria-selected={String(i === 0)} data-c-tab={g.id}>
                {g.label}
              </button>
            ))
          }
        </div>
        {
          groups.map((g, i) => (
            <ul class="c-list" data-c-list={g.id} hidden={i !== 0}>
              {list(g.id).map((s) => (
                <li>
                  <a href={`/termin?behandlung=${s!.id}&gruppe=${g.id}`}>
                    <span class="c-l-name">{s!.name}</span>
                    <span class="c-l-dur">{duration(s!.minutes)}</span>
                    <span class="c-l-price">{chf(s!.price)}</span>
                    <span class="c-l-go">
                      Buchen <Icon name="arrow" size={14} />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ))
        }
        <a class="c-link c-prices-all reveal" href="/preise">Alle Zonen & Preise</a>
      </div>
    </div>
  </section>

  <!-- 6 · Ruhepunkt -->
  <StudioCalm />

  <!-- 7 · Kundenstimmen: Glas-Karte über der Lounge -->
  <section class="c-voices" data-c-voices aria-label="Kundenstimmen">
    <div class="c-voices-bg" aria-hidden="true">
      <Image src={imgLounge} alt="" widths={[1200, 2000, 2600]} sizes="100vw" data-parallax="14" />
    </div>
    <div class="c-glass c-voices-card reveal">
      <p class="c-voices-score">{rating}</p>
      <p class="c-voices-meta"><span class="c-stars">★★★★★</span> {googleRating.count} Bewertungen auf Google</p>
      <div class="c-voices-quotes">
        {
          voices.map((v, i) => (
            <figure class="c-quote" data-c-quote hidden={i !== 0}>
              <blockquote>«{v!.short ?? v!.text}»</blockquote>
              <figcaption>{v!.name}</figcaption>
            </figure>
          ))
        }
      </div>
      <div class="c-voices-nav">
        <button type="button" aria-label="Vorherige Stimme" data-c-prev><span class="c-flip"><Icon name="arrow" size={16} /></span></button>
        <span data-c-count>01 / 0{voices.length}</span>
        <button type="button" aria-label="Nächste Stimme" data-c-next><Icon name="arrow" size={16} /></button>
      </div>
      <a class="c-link" href={site.googleReviewsUrl} target="_blank" rel="noopener">Alle Bewertungen</a>
    </div>
  </section>

  <!-- 8 · Abschluss -->
  <section class="c-end" style={`--signet:${signetPattern}`}>
    <div class="c-texture" aria-hidden="true">
      <Image src={imgRelief} alt="" widths={[1200, 2000]} sizes="100vw" data-parallax="12" />
    </div>
    <div class="c-end-band" aria-hidden="true"></div>
    <div class="c-narrow c-end-inner">
      <h2 class="c-ttl reveal">Bereit für<br />glatte Haut?</h2>
      <p class="reveal">Buche deinen Termin direkt online – oder komm zuerst zu einem kostenlosen Beratungsgespräch.</p>
      <div class="c-end-btns reveal">
        <a class="c-btn c-btn-dark" href="/termin">Termin buchen</a>
        <a class="c-btn c-btn-line" href="/termin?behandlung=beratungsgespraech">Kostenlos beraten lassen</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Frauen / Männer
  const prices = document.querySelector<HTMLElement>('[data-c-prices]');
  prices?.querySelectorAll<HTMLButtonElement>('[data-c-tab]').forEach((btn) => {
    btn.addEventListener('click', () => {
      prices.querySelectorAll<HTMLButtonElement>('[data-c-tab]').forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
      prices.querySelectorAll<HTMLElement>('[data-c-list]').forEach((l) => (l.hidden = l.dataset.cList !== btn.dataset.cTab));
    });
  });

  // Kundenstimmen
  const voices = document.querySelector<HTMLElement>('[data-c-voices]');
  if (voices) {
    const quotes = [...voices.querySelectorAll<HTMLElement>('[data-c-quote]')];
    const count = voices.querySelector<HTMLElement>('[data-c-count]')!;
    let i = 0;
    const show = (n: number) => {
      i = (n + quotes.length) % quotes.length;
      quotes.forEach((q, k) => {
        q.hidden = k !== i;
        if (k === i) q.animate([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], { duration: 600, easing: 'ease-out' });
      });
      count.textContent = `${String(i + 1).padStart(2, '0')} / ${String(quotes.length).padStart(2, '0')}`;
    };
    voices.querySelector('[data-c-prev]')?.addEventListener('click', () => show(i - 1));
    voices.querySelector('[data-c-next]')?.addEventListener('click', () => show(i + 1));
  }
</script>

<style>
  /* ——— Grundlagen dieser Seite ——— */
  .c-ttl {
    font-family: var(--sans);
    font-weight: 300;
    font-stretch: 100%;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.08;
    font-size: clamp(2rem, 3.6vw, 3.4rem);
    color: var(--head);
    margin: 0 0 0.6em;
    text-wrap: balance;
  }

  p {
    font-weight: 300;
    font-size: clamp(1.02rem, 1.15vw, 1.15rem);
    line-height: 1.75;
    color: var(--ink-body);
  }

  .c-wrap {
    width: 100%;
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .c-narrow {
    position: relative;
    z-index: 2;
    max-width: 640px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    text-align: center;
  }

  .c-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 30px;
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid;
    transition:
      background 0.35s ease,
      color 0.35s ease,
      border-color 0.35s ease;
  }

  .c-btn-dark {
    background: var(--indigo);
    border-color: var(--indigo);
    color: #fff;
  }

  .c-btn-dark:hover {
    background: var(--indigo-soft);
    border-color: var(--indigo-soft);
  }

  .c-btn-line {
    color: var(--indigo);
    border-color: var(--line-strong);
  }

  .c-btn-line:hover {
    border-color: var(--indigo);
  }

  .c-link {
    display: inline-block;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.3s ease;
  }

  .c-link:hover {
    border-color: var(--ink);
  }

  .c-stars {
    letter-spacing: 3px;
    color: var(--salvia-ink);
  }

  /* Frosted Glass */
  .c-glass {
    background: rgba(251, 250, 246, 0.58);
    -webkit-backdrop-filter: blur(22px) saturate(1.25);
    backdrop-filter: blur(22px) saturate(1.25);
    border: 1px solid rgba(255, 255, 255, 0.65);
    box-shadow: 0 30px 60px -40px rgba(27, 30, 42, 0.35);
  }

  /* Bilder mit Parallaxe: etwas höher als ihr Rahmen */
  figure :global(img[data-parallax]),
  .c-texture :global(img),
  .c-voices-bg :global(img),
  .c-hero-panel video {
    position: absolute;
    left: 0;
    top: -6%;
    width: 100%;
    height: 112%;
    object-fit: cover;
  }

  /* Signet-Linie: wiederholtes Signet, läuft über die Grenze zweier Sections */
  .c-band {
    position: relative;
    z-index: 6;
    height: 0;
    overflow: visible;
    pointer-events: none;
  }

  .c-band-strip {
    position: absolute;
    left: -25%;
    width: 150%;
    top: -10px;
    height: 20px;
    background-image: var(--signet);
    background-repeat: repeat-x;
    background-size: auto 100%;
  }

  /* Texturen aus eigenen Detailfotos */
  .c-texture {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .c-texture :global(img) {
    opacity: 0.22;
    filter: grayscale(1) contrast(0.9);
    mix-blend-mode: multiply;
  }

  /* ——— 1 · Start ——— */
  .c-hero {
    position: relative;
    height: 100svh;
    min-height: 680px;
    overflow: hidden;
    background: var(--bg);
  }

  .c-hero-panel {
    position: absolute;
    left: 33%;
    width: 34%;
    top: 14%;
    bottom: 8%;
    overflow: hidden;
    z-index: 2;
    background: #e9e6de;
  }

  .c-hero-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(17, 19, 28, 0.16);
  }

  /* Typo zweimal deckungsgleich: Indigo auf der Fläche, Weiss im Video-Fenster */
  .c-hero-type {
    position: absolute;
    z-index: 1;
    left: 0;
    width: 100%;
    top: 50%;
    transform: translateY(-50%);
    margin: 0;
    font-family: var(--sans);
    font-weight: 200;
    font-stretch: 100%;
    text-transform: uppercase;
    font-size: clamp(3rem, 10.6vw, 12.5rem);
    line-height: 0.92;
    letter-spacing: 0.02em;
    color: var(--indigo);
    pointer-events: none;
  }

  .c-hero-type-in {
    left: -97.0588%;
    width: 294.1176%;
    top: 46.1538%;
    z-index: 3;
    color: #fff;
  }

  .c-hl {
    display: block;
    white-space: nowrap;
  }

  .c-hl > span {
    display: block;
  }

  .c-hl1 {
    padding-left: 5%;
  }

  .c-hl2 {
    text-align: right;
    padding-right: 5%;
  }

  .c-float {
    position: absolute;
    margin: 0;
    overflow: hidden;
    z-index: 0;
  }

  .c-float :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .c-float-l {
    left: 8%;
    top: 54%;
    width: 10%;
    aspect-ratio: 3 / 4;
  }

  .c-float-r {
    right: 7%;
    top: 22%;
    width: 11%;
    aspect-ratio: 1;
  }

  .c-hero-meta {
    position: absolute;
    z-index: 4;
    left: var(--gutter);
    bottom: clamp(24px, 4vh, 44px);
    display: grid;
    gap: 2px;
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .c-hero-meta span:first-child {
    color: var(--ink);
    margin-bottom: 6px;
  }

  .c-hero-card {
    position: absolute;
    z-index: 4;
    right: max(var(--gutter), 14%);
    bottom: clamp(24px, 5vh, 52px);
    width: min(360px, 30vw);
    padding: 26px 28px 28px;
  }

  .c-hero-rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--ink);
  }

  .c-hero-rating b {
    font-weight: 500;
  }

  .c-hero-card p {
    font-size: 0.98rem;
    line-height: 1.65;
    margin: 14px 0 22px;
  }

  .c-hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 22px;
  }

  /* ——— 2 · Haltung ——— */
