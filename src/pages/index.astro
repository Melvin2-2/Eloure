---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Lines from '../components/Lines.astro';
import TrustBand from '../components/TrustBand.astro';
import ZoneHighlights from '../components/ZoneHighlights.astro';
import StoryPath from '../components/StoryPath.astro';
import StudioCalm from '../components/StudioCalm.astro';
import VoicesFaq from '../components/VoicesFaq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { site } from '../data/site';
import { shortFaqs } from '../data/faq';
import { googleRating, pickReview } from '../data/reviews';

import imgCaro from '../assets/shoot/caro-laechelt.jpg';

const proof = pickReview('Luli');
const rating = googleRating.rating.toFixed(1).replace('.', ',');
---

<Base
  title="Laserhaarentfernung in Amriswil | Eloure The Studio"
  description="Dauerhaft glatte Haut in Amriswil: Laserhaarentfernung mit medizinischem Diodenlaser, persönlich betreut von Gründerin Caro. Ø 5,0 aus 126 Google-Bewertungen. Preise ab CHF 29, bezahlt wird erst vor Ort."
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: shortFaqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ]}
>
  <!-- 1 · HERO – Vollbild-Video, klares Versprechen, zwei Wege, Beweis -->
  <section class="hero bg-dark">
    <video class="hero-video" autoplay muted loop playsinline preload="auto" poster="/video/studio-2026.jpg" aria-label="Laserbehandlung im Eloure Studio in Amriswil">
      <source src="/video/studio-2026.mp4" type="video/mp4" />
    </video>
    <div class="hero-shade"></div>

    <div class="wrap hero-inner">
      <Lines as="h1" class="display hero-title" lines={['Dauerhaft glatte Haut.', 'In Amriswil.']} />
      <p class="hero-sub" data-anim="up">Laserhaarentfernung mit medizinischem Diodenlaser</p>
      <p class="lead" data-anim="up">
        Ehrlich beraten, sanft behandelt und persönlich begleitet – von Caro, Gründerin von Eloure.
      </p>
      <div class="btn-row" data-anim="up">
        <a class="btn btn-primary" href="/termin">Termin buchen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
        <a class="btn btn-ghost" href="#zonen">Zonen & Preise</a>
      </div>
      <a class="hero-rating" href={site.googleReviewsUrl} target="_blank" rel="noopener" data-anim="up">
        <span class="stars">★★★★★</span>
        <span><b>{rating}</b> aus {googleRating.count} Google-Bewertungen</span>
      </a>
    </div>
  </section>

  <!-- 2 · SOFORT-BEWEIS -->
  <TrustBand />

  <!-- 3 · USP: warum Eloure -->
  <section class="usp bg-paper">
    <div class="u-img" data-anim="img">
      <Image src={imgCaro} alt="Caro, Gründerin von Eloure, lächelt in der Studio-Lounge" widths={[700, 1100, 1600]} sizes="(min-width: 1000px) 44vw, 100vw" />
      <figure class="u-proof glass">
        <span class="stars">★★★★★</span>
        <blockquote>«{proof.short}»</blockquote>
        <figcaption>{proof.name} · Google</figcaption>
      </figure>
    </div>
    <div class="u-text">
      <Lines lines={['Keine leeren', 'Versprechen.']} class="ol u-title" />
      <p class="lead reveal">
        Bevor wir lasern, sagen wir dir ehrlich, was bei deiner Haut realistisch ist – und was nicht.
      </p>
      <div class="btn-row reveal">
        <a class="btn btn-dark" href="/termin">Ersten Termin buchen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
        <a class="text-link" href="/termin?behandlung=beratungsgespraech">Erst kostenlos beraten lassen</a>
      </div>
    </div>
  </section>

  <!-- 4 · ENTSCHEIDUNG -->
  <ZoneHighlights />

  <!-- 5 · ABLAUF ALS SCROLL-STORY -->
  <StoryPath />

  <!-- 6 · RUHEPUNKT: Studio-Impression -->
  <StudioCalm />

  <!-- 7 · STIMMEN & FRAGEN -->
  <VoicesFaq />

  <!-- 8 · ABSCHLUSS -->
  <CtaFinal />
</Base>

<style>
  /* ——— Hero ——— */
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% center;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(36, 25, 19, 0.88) 0%, rgba(36, 25, 19, 0.45) 45%, rgba(36, 25, 19, 0.2) 75%),
      linear-gradient(90deg, rgba(36, 25, 19, 0.55) 0%, rgba(36, 25, 19, 0) 60%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    padding-top: 80px;
    padding-bottom: clamp(48px, 7vw, 96px);
  }

  .hero-inner :global(.hero-title) {
    font-size: clamp(2.5rem, 6.6vw, 6.8rem);
    line-height: 0.93;
    margin-bottom: 22px;
    color: var(--cream);
  }

  .hero-sub {
    margin: 0 0 14px;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lime);
  }

  .hero-inner .lead {
    max-width: 32em;
    margin-bottom: 34px;
    color: rgba(246, 241, 234, 0.9);
  }

  .hero-rating {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
    padding: 12px 18px;
    background: rgba(246, 241, 234, 0.12);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(246, 241, 234, 0.25);
    color: var(--cream);
    text-decoration: none;
    font-size: 1.02rem;
  }

  .stars {
    color: var(--lime);
    letter-spacing: 3px;
  }

  /* ——— USP ——— */
  .usp {
    display: grid;
  }

  .u-img {
    position: relative;
    overflow: hidden;
    min-height: 112vw;
  }

  .u-img :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  @media (min-width: 1000px) {
    .usp {
      grid-template-columns: 0.9fr 1.1fr;
      min-height: 100vh;
    }
    .u-img {
      min-height: 0;
    }
  }

  .u-proof {
    position: absolute;
    z-index: 2;
    left: var(--gutter);
    right: var(--gutter);
    top: var(--gutter);
    margin: 0;
    padding: 18px 22px;
    max-width: 380px;
    background: rgba(36, 25, 19, 0.62);
  }

  @media (min-width: 1000px) {
    .u-proof {
      top: auto;
      bottom: var(--gutter);
    }
  }

  .u-proof blockquote {
    margin: 8px 0;
    font-size: 1.12rem;
    line-height: 1.35;
  }

  .u-proof figcaption {
    font-size: 0.9rem;
    opacity: 0.85;
  }

  .u-text {
    padding: var(--section) var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 820px;
  }

  @media (min-width: 1000px) {
    .u-text {
      justify-content: flex-start;
      padding-top: clamp(72px, 9vw, 140px);
    }
  }

  .u-text :global(.u-title) {
    font-size: clamp(2.8rem, 6vw, 6.6rem);
    line-height: 0.93;
  }

</style>
