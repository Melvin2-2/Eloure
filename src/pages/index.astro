---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Lines from '../components/Lines.astro';
import TrustBand from '../components/TrustBand.astro';
import ZoneHighlights from '../components/ZoneHighlights.astro';
import StoryPath from '../components/StoryPath.astro';
import FaqList from '../components/FaqList.astro';
import Reviews from '../components/Reviews.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { site } from '../data/site';
import { pickFaqs, topFaqIds } from '../data/faq';
import { googleRating, pickReview } from '../data/reviews';

import imgCaro from '../assets/shoot/caro-laechelt.jpg';
import imgConsult from '../assets/shoot/beratung-kundin.jpg';
import imgCaroSw from '../assets/shoot/caro-sw.jpg';

const faqs = pickFaqs(topFaqIds);
const fearQuote = pickReview('Cindy A.');
const rating = googleRating.rating.toFixed(1).replace('.', ',');
---

<Base
  title="Laserhaarentfernung in Amriswil | Eloure The Studio"
  description="Dauerhaft glatte Haut in Amriswil: Laserhaarentfernung mit medizinischem Diodenlaser, persönlich betreut von Gründerin Caro. Ø 5,0 aus 126 Google-Bewertungen. Preise ab CHF 29, bezahlt wird erst vor Ort."
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() },
      })),
    },
  ]}
>
  <!-- 1 · HERO – Vollbild-Video, klares Versprechen, zwei Wege, Beweis -->
  <section class="hero bg-dark">
    <video class="hero-video" autoplay muted loop playsinline preload="auto" poster="/video/hero.jpg" aria-label="Laserbehandlung im Eloure Studio in Amriswil">
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-shade"></div>

    <div class="wrap hero-inner">
      <Lines as="h1" class="display hero-title" lines={['Dauerhaft glatte Haut.', 'In Amriswil.']} />
      <p class="hero-sub" data-anim="up">Laserhaarentfernung mit medizinischem Diodenlaser</p>
      <p class="lead" data-anim="up">
        Ehrlich beraten, sanft behandelt und persönlich begleitet – von Caro, Gründerin von Eloure.
      </p>
      <div class="btn-row" data-anim="up">
        <a class="btn btn-primary" href="/termin">Termin buchen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
        <a class="btn btn-ghost" href="#zonen">Zonen & Preise</a>
      </div>
      <a class="hero-rating" href={site.googleReviewsUrl} target="_blank" rel="noopener" data-anim="up">
        <span class="stars">★★★★★</span>
        <span><b>{rating}</b> aus {googleRating.count} Google-Bewertungen</span>
      </a>
    </div>
  </section>

  <!-- 2 · SOFORT-BEWEIS -->
  <TrustBand />

  <!-- 3 · POSITIONIERUNG -->
  <section class="pos bg-paper">
    <div class="pos-text">
      <Lines lines={['Nur Laser.', 'Dafür richtig.']} class="pos-title" />
      <p class="lead reveal">
        Wir sind kein Beauty-Allrounder. Wir konzentrieren uns zu 100&nbsp;% auf Laserhaarentfernung – darum wissen wir, was
        bei deiner Haut und deinen Haaren realistisch ist. Und sagen es dir ehrlich.
      </p>
      <div class="pos-facts">
        <div class="reveal"><span class="big">5 Jahre</span><span>Erfahrung in der Laserhaarentfernung</span></div>
        <div class="reveal"><span class="big">3 Jahre</span><span>eigenes Studio in Amriswil</span></div>
        <div class="reveal"><span class="big">100&nbsp;%</span><span>Fokus auf Laser – nichts anderes</span></div>
      </div>
      <div class="btn-row reveal">
        <a class="btn btn-dark" href="/termin">Ersten Termin buchen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
        <a class="text-link" href="/studio">Wer wir sind</a>
      </div>
    </div>
    <div class="pos-img" data-anim="img">
      <Image src={imgCaro} alt="Caro, Gründerin von Eloure, lächelt in der Studio-Lounge" widths={[700, 1100, 1600]} sizes="(min-width: 1000px) 42vw, 100vw" />
    </div>
  </section>

  <!-- 4 · ENTSCHEIDUNG -->
  <ZoneHighlights />

  <!-- 5 · ABLAUF ALS SCROLL-STORY -->
  <StoryPath />

  <!-- 6 · BEWEIS -->
  <Reviews />

  <!-- 7 · SORGEN -->
  <section class="fears bg-dark">
    <div class="f-img" data-anim="img">
      <Image src={imgConsult} alt="Kundin lacht im Beratungsgespräch im Eloure Studio" widths={[700, 1100, 1600]} sizes="(min-width: 1000px) 45vw, 100vw" />
      <figure class="f-quote glass">
        <span class="stars">★★★★★</span>
        <blockquote>«{fearQuote.short}»</blockquote>
        <figcaption>{fearQuote.name} · Google</figcaption>
      </figure>
    </div>
    <div class="f-content">
      <Lines lines={['Unsicher?', 'Ganz normal.']} />
      <p class="lead reveal">Die ehrlichen Antworten auf die Fragen, die uns fast alle beim ersten Mal stellen.</p>
      <div class="reveal"><FaqList items={faqs} open="schmerz" tone="dark" /></div>
      <div class="btn-row reveal f-cta">
        <a class="btn btn-primary" href="/termin?behandlung=beratungsgespraech">Kostenlos beraten lassen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
        <a class="btn btn-ghost" href={site.whatsappHref} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- 8 · PERSON -->
  <section class="team bg-sand">
    <div class="t-img" data-anim="img">
      <Image src={imgCaroSw} alt="Caro, Gründerin von Eloure The Studio" widths={[700, 1100, 1600]} sizes="(min-width: 1000px) 46vw, 100vw" />
      <span class="t-cap glass">Caro · Gründerin & deine Ansprechpartnerin</span>
    </div>
    <div class="t-content">
      <Lines lines={['Hey,', 'ich bin Caro.']} class="t-title" />
      <p class="lead reveal">
        Ich habe Eloure gegründet und bin deine Ansprechpartnerin – vom ersten Gespräch bis zum Ergebnis. Ich weiss, dass sich
        eine Behandlung am Anfang ungewohnt anfühlen kann, gerade an intimen Stellen.
      </p>
      <p class="reveal">
        Darum nehme ich mir Zeit, erkläre jeden Schritt in Ruhe und bin auch zwischen den Terminen für dich da – per WhatsApp
        oder Telefon. Du gibst das Tempo vor.
      </p>
      <div class="btn-row reveal">
        <a class="btn btn-dark" href="/termin">Termin bei Caro buchen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
        <a class="text-link" href="/studio">Studio & Team</a>
      </div>
    </div>
  </section>

  <!-- 9 · ABSCHLUSS -->
  <CtaFinal />
</Base>

<style>
  /* ——— Hero ——— */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% center;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(36, 25, 19, 0.88) 0%, rgba(36, 25, 19, 0.45) 45%, rgba(36, 25, 19, 0.2) 75%),
      linear-gradient(90deg, rgba(36, 25, 19, 0.55) 0%, rgba(36, 25, 19, 0) 60%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    padding-top: calc(var(--header-h) + 80px);
    padding-bottom: clamp(48px, 7vw, 96px);
  }

  .hero-inner :global(.hero-title) {
    font-size: clamp(3.2rem, 8.4vw, 8.4rem);
    line-height: 0.93;
    margin-bottom: 22px;
    color: var(--cream);
  }

  .hero-sub {
    margin: 0 0 14px;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lime);
  }

  .hero-inner .lead {
    max-width: 32em;
    margin-bottom: 34px;
    color: rgba(246, 241, 234, 0.9);
  }

  .hero-rating {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
    padding: 12px 18px;
    background: rgba(246, 241, 234, 0.12);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(246, 241, 234, 0.25);
    color: var(--cream);
    text-decoration: none;
    font-size: 1.02rem;
  }

  .stars {
    color: var(--lime);
    letter-spacing: 3px;
  }

  /* ——— Positionierung ——— */
  .pos {
    display: grid;
  }

  @media (min-width: 1000px) {
    .pos {
      grid-template-columns: 1.05fr 0.95fr;
      min-height: 92vh;
    }
  }

  .pos-text {
    padding: var(--section) var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .pos-text :global(.pos-title) {
    font-size: clamp(3.2rem, 6.6vw, 6.6rem);
    line-height: 0.95;
  }

  .pos-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 40px 0 44px;
  }

  .pos-facts div {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--ink-2);
  }

  .big {
    font-size: clamp(2rem, 3vw, 2.8rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--mocha);
  }

  @media (max-width: 640px) {
    .pos-facts {
      grid-template-columns: 1fr;
    }
  }

  .pos-img {
    position: relative;
    min-height: 90vw;
    overflow: hidden;
  }

  @media (min-width: 1000px) {
    .pos-img {
      min-height: 0;
    }
  }

  .pos-img :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  /* ——— Sorgen ——— */
  .fears {
    display: grid;
  }

  .f-img {
    position: relative;
    overflow: hidden;
    min-height: 110vw;
  }

  .f-img :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
  }

  @media (min-width: 1000px) {
    .fears {
      grid-template-columns: 0.9fr 1.1fr;
    }
    .fears .f-img {
      position: sticky;
      top: 0;
      height: 100vh;
      min-height: 0;
    }
  }

  .f-quote {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: var(--gutter);
    margin: 0;
    padding: 22px 24px;
    max-width: 440px;
  }

  .f-quote blockquote {
    margin: 10px 0 10px;
    font-size: 1.2rem;
    line-height: 1.35;
  }

  .f-quote figcaption {
    font-size: 0.94rem;
    opacity: 0.85;
  }

  .f-content {
    padding: var(--section) var(--gutter);
    max-width: 820px;
  }

  .f-cta {
    margin-top: 40px;
  }

  /* ——— Caro ——— */
  .team {
    display: grid;
  }

  @media (min-width: 1000px) {
    .team {
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
    }
  }

  .t-img {
    position: relative;
    overflow: hidden;
    min-height: 110vw;
  }

  @media (min-width: 1000px) {
    .t-img {
      min-height: 0;
    }
  }

  .t-img :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  .t-cap {
    position: absolute;
    left: var(--gutter);
    bottom: var(--gutter);
    padding: 12px 18px;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .t-content {
    padding: var(--section) var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 760px;
  }

  .t-content :global(.t-title) {
    font-size: clamp(3.2rem, 6.4vw, 6.6rem);
    line-height: 0.95;
  }

  .t-content p:not(.lead) {
    color: var(--ink-2);
    max-width: 34em;
    margin-bottom: 32px;
  }
</style>
