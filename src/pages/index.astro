---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Lines from '../components/Lines.astro';
import ImageExpand from '../components/ImageExpand.astro';
import ZoneFinder from '../components/ZoneFinder.astro';
import Counters from '../components/Counters.astro';
import StickySteps from '../components/StickySteps.astro';
import FaqList from '../components/FaqList.astro';
import Gallery from '../components/Gallery.astro';
import Reviews from '../components/Reviews.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { site } from '../data/site';
import { pickFaqs, topFaqIds } from '../data/faq';
import { googleRating, pickReview } from '../data/reviews';

import imgHero from '../assets/shoot/laser-achsel.jpg';
import imgCaro from '../assets/shoot/caro-laechelt.jpg';
import imgExhale from '../assets/shoot/raum-exhale.jpg';
import imgHands from '../assets/shoot/beratung-haende.jpg';
import imgCaroSw from '../assets/shoot/caro-sw.jpg';

const faqs = pickFaqs(topFaqIds);
const fearQuote = pickReview('Cindy A.');
const rating = googleRating.rating.toFixed(1).replace('.', ',');
---

<Base
  title="Laserhaarentfernung in Amriswil | Eloure The Studio"
  description="Laserhaarentfernung in Amriswil mit medizinischem Diodenlaser – persönlich betreut von Caro & Sarah. Transparente Preise ab CHF 29, bezahlt wird erst vor Ort. Jetzt Termin buchen."
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() },
      })),
    },
  ]}
>
  <!-- 1 · HERO – Was, wo, warum. Headline läuft über das Bild. -->
  <section class="hero bg-dark">
    <div class="hero-img">
      <Image src={imgHero} alt="Laserhaarentfernung an der Achsel mit medizinischem Diodenlaser" widths={[700, 1100, 1600, 2000]} sizes="(min-width: 1000px) 56vw, 100vw" loading="eager" fetchpriority="high" data-parallax="10" />
      <div class="hero-shade"></div>
    </div>

    <div class="hero-content">
      <Lines as="h1" class="display hero-title" lines={['Dauerhaft', 'glatte Haut.']}>
        <span class="hero-sub" data-anim="up">Laserhaarentfernung in Amriswil</span>
      </Lines>
      <p class="lead" data-anim="up">
        Medizinischer Diodenlaser, ehrliche Beratung und ein Plan, der zu deinem Körper passt. Persönlich betreut von Caro &
        Sarah.
      </p>
      <div class="btn-row" data-anim="up">
        <a class="btn btn-primary" href="/termin">Termin buchen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
        <a class="btn btn-ghost" href="#zonen">Zonen & Preise</a>
      </div>
    </div>

    <div class="hero-card glass" data-anim="up">
      <ul>
        <li><Icon name="check" size={16} /> Ab CHF 29 pro Zone</li>
        <li><Icon name="check" size={16} /> Bezahlt wird erst vor Ort</li>
        <li><Icon name="check" size={16} /> Sachkunde nach V‑NISSG</li>
      </ul>
      <a href={site.googleReviewsUrl} target="_blank" rel="noopener" class="g">
        <span class="stars">★★★★★</span> <b>{rating}</b> · {googleRating.count} Google-Bewertungen <Icon name="arrow" size={14} />
      </a>
    </div>
  </section>

  <!-- 2 · POSITIONIERUNG – Wer wir sind, warum uns vertrauen -->
  <section class="pos bg-paper">
    <div class="pos-text">
      <Lines lines={['Nur Laser.', 'Dafür richtig.']} class="pos-title" />
      <p class="lead reveal">
        Wir sind kein Beauty-Allrounder. Wir konzentrieren uns zu 100&nbsp;% auf Laserhaarentfernung – darum wissen wir, was
        bei deiner Haut und deinen Haaren realistisch ist. Und sagen es dir ehrlich.
      </p>
      <div class="pos-facts">
        <div class="reveal">
          <span class="serif big">5 Jahre</span>
          <span>Erfahrung, davon 3 im eigenen Studio</span>
        </div>
        <div class="reveal">
          <span class="serif big">Dioden­laser</span>
          <span>medizinisch, präzise, schonend</span>
        </div>
        <div class="reveal">
          <span class="serif big">V‑NISSG</span>
          <span>Ausbildung & Sachkunde nach Schweizer Verordnung</span>
        </div>
      </div>
      <div class="btn-row reveal">
        <a class="btn btn-dark" href="/termin">Ersten Termin buchen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
        <a class="text-link" href="/studio">Wer wir sind</a>
      </div>
    </div>
    <div class="pos-img" data-anim="img">
      <Image src={imgCaro} alt="Caro, Gründerin von Eloure, lächelt in der Studio-Lounge" widths={[700, 1100, 1600]} sizes="(min-width: 1000px) 42vw, 100vw" />
    </div>
  </section>

  <!-- 3 · ATMOSPHÄRE – fixierte Section, Bild öffnet sich -->
  <ImageExpand
    image={imgExhale}
    alt="Behandlungsraum mit dem Schriftzug Exhale the bullshit"
    word="Exhale."
    title="Ein Ort zum Durchatmen."
    text="Kein Klinik-Gefühl, kein Fliessband. Ein heller, ruhiger Raum, in dem du ankommen, Fragen stellen und dich entspannen darfst."
    ctaHref="/studio"
    ctaLabel="Studio ansehen"
  />

  <!-- 4 · ZONEN & PREISE – Entscheidung -->
  <ZoneFinder />

  <!-- 5 · BEWEIS -->
  <Counters
    items={[
      { value: 5, label: 'Jahre Erfahrung in der Laserhaarentfernung' },
      { value: 3, label: 'Jahre im eigenen Studio in Amriswil' },
      { value: 30, suffix: '+', label: 'Zonen für Frauen und Männer' },
      { value: googleRating.count, label: `Google-Bewertungen · Ø ${rating} Sterne` },
    ]}
  />

  <!-- 6 · ABLAUF – Sicherheit durch Klarheit -->
  <StickySteps />

  <!-- 7 · SORGEN – Ängste abbauen -->
  <section class="fears bg-dark">
    <div class="f-img" data-anim="img">
      <Image src={imgHands} alt="Beratung mit Tablet im Studio" widths={[700, 1100, 1600]} sizes="(min-width: 1000px) 45vw, 100vw" />
      <figure class="f-quote glass">
        <span class="stars">★★★★★</span>
        <blockquote class="serif">«{fearQuote.short}»</blockquote>
        <figcaption>{fearQuote.name} · Google</figcaption>
      </figure>
    </div>
    <div class="f-content">
      <Lines lines={['Unsicher?', 'Ganz normal.']} class="f-title" />
      <p class="lead reveal">Die ehrlichen Antworten auf die Fragen, die uns fast alle beim ersten Mal stellen.</p>
      <div class="reveal"><FaqList items={faqs} open="schmerz" tone="dark" /></div>
      <div class="btn-row reveal f-cta">
        <a class="btn btn-primary" href="/termin?behandlung=beratungsgespraech">Kostenlos beraten lassen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
        <a class="btn btn-ghost" href={site.whatsappHref} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- 8 · MENSCHEN -->
  <section class="team bg-sand">
    <div class="t-img" data-anim="img">
      <Image src={imgCaroSw} alt="Caro, Gründerin und Inhaberin von Eloure The Studio" widths={[700, 1100, 1600]} sizes="(min-width: 1000px) 46vw, 100vw" />
      <span class="t-cap glass">Caro · Gründerin & Inhaberin</span>
    </div>
    <div class="t-content">
      <Lines lines={['Hey, wir sind', 'Caro & Sarah.']} class="t-title" />
      <p class="lead reveal">
        Caro hat Eloure gegründet, Sarah ist an ihrer Seite. Wir wissen, dass sich eine Behandlung am Anfang ungewohnt anfühlen
        kann – gerade an intimen Stellen.
      </p>
      <p class="reveal">
        Darum nehmen wir uns Zeit, erklären jeden Schritt in Ruhe und sind auch zwischen den Terminen für dich da. Du gibst das
        Tempo vor.
      </p>
      <div class="btn-row reveal">
        <a class="btn btn-dark" href="/termin">Termin bei uns buchen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
        <a class="text-link" href="/studio">Mehr über uns</a>
      </div>
    </div>
  </section>

  <!-- 9 · ORT -->
  <Gallery />

  <!-- 10 · STIMMEN -->
  <Reviews />

  <!-- 11 · ABSCHLUSS -->
  <CtaFinal />
</Base>

<style>
  /* ——— Hero ——— */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    overflow: hidden;
  }

  .hero-img {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 56%;
    overflow: hidden;
  }

  .hero-img :global(img) {
    position: absolute;
    inset: -6% 0;
    width: 100%;
    height: 112%;
    object-fit: cover;
    object-position: center 30%;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(43, 31, 26, 0.85) 0%, rgba(43, 31, 26, 0.15) 45%, rgba(43, 31, 26, 0) 70%),
      linear-gradient(0deg, rgba(43, 31, 26, 0.55), rgba(43, 31, 26, 0) 40%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding: calc(var(--header-h) + 64px) var(--gutter) clamp(48px, 7vw, 96px);
    max-width: 920px;
  }

  .hero-content :global(.hero-title) {
    width: max-content;
    max-width: 92vw;
    margin-bottom: 28px;
  }

  .hero-sub {
    display: block;
    margin-top: 22px;
    font-family: var(--sans);
    font-size: clamp(0.9rem, 1.2vw, 1.05rem);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--lime);
  }

  .hero-content .lead {
    max-width: 30em;
    margin-bottom: 36px;
  }

  .hero-card {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(48px, 7vw, 96px);
    z-index: 3;
    padding: 24px 26px;
    min-width: 280px;
  }

  .hero-card ul {
    list-style: none;
    margin: 0 0 16px;
    padding: 0 0 16px;
    display: grid;
    gap: 8px;
    border-bottom: 1px solid var(--line-light);
    font-weight: 600;
  }

  .hero-card li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hero-card li :global(svg) {
    color: var(--lime);
  }

  .hero-card .g {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.92rem;
    text-decoration: none;
  }

  .stars {
    color: var(--lime);
    letter-spacing: 2px;
  }

  @media (max-width: 999px) {
    .hero {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    .hero-img {
      position: relative;
      width: 100%;
      height: 92vw;
      max-height: 680px;
      order: 0;
    }
    .hero-shade {
      background: linear-gradient(0deg, rgba(43, 31, 26, 1) 0%, rgba(43, 31, 26, 0) 55%);
    }
    .hero-content {
      order: 1;
      margin-top: -34vw;
      padding-top: 0;
    }
    .hero-card {
      position: relative;
      right: auto;
      bottom: auto;
      order: 2;
      margin: 0 var(--gutter) 48px;
    }
  }

  /* ——— Positionierung ——— */
  .pos {
    display: grid;
  }

  @media (min-width: 1000px) {
    .pos {
      grid-template-columns: 1.05fr 0.95fr;
      min-height: 100vh;
    }
  }

  .pos-text {
    position: relative;
    z-index: 2;
    padding: var(--section) var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (min-width: 1000px) {
    .pos-text :global(.pos-title) {
      width: max-content;
      font-size: clamp(4rem, 8vw, 8.6rem);
      line-height: 0.9;
    }
  }

  .pos-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 48px 0;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .pos-facts div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .big {
    font-size: clamp(1.6rem, 2.4vw, 2.2rem);
    line-height: 1;
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .pos-facts {
      grid-template-columns: 1fr;
    }
  }

  .pos-img {
    position: relative;
    min-height: 80vw;
    overflow: hidden;
  }

  @media (min-width: 1000px) {
    .pos-img {
      min-height: 0;
    }
  }

  .pos-img :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  /* ——— Sorgen ——— */
  .fears {
    display: grid;
  }

  @media (min-width: 1000px) {
    .fears {
      grid-template-columns: 0.85fr 1.15fr;
    }
    .f-img {
      position: sticky;
      top: 0;
      height: 100vh;
    }
  }

  .f-img {
    overflow: hidden;
    min-height: 70vw;
    position: relative;
  }

  .f-img :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .f-content {
    position: relative;
    z-index: 2;
    padding: var(--section) var(--gutter);
    max-width: 820px;
  }

  @media (min-width: 1000px) {
    .f-content :global(.f-title) {
      width: max-content;
      margin-left: calc(-12vw - var(--gutter));
      font-size: clamp(4rem, 7.6vw, 8rem);
      line-height: 0.9;
    }
  }

  .f-cta {
    margin-top: 40px;
  }

  /* ——— Team ——— */
  .team {
    display: grid;
  }

  @media (min-width: 1000px) {
    .team {
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
    }
  }

  .t-img {
    position: relative;
    overflow: hidden;
    min-height: 110vw;
  }

  @media (min-width: 1000px) {
    .t-img {
      min-height: 0;
    }
  }

  .t-img :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  .t-cap {
    position: absolute;
    left: var(--gutter);
    bottom: var(--gutter);
    padding: 12px 18px;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .t-content {
    position: relative;
    z-index: 2;
    padding: var(--section) var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 760px;
  }

  @media (min-width: 1000px) {
    .t-content :global(.t-title) {
      width: max-content;
      margin-left: calc(-10vw - var(--gutter));
      font-size: clamp(3.6rem, 6.8vw, 7.4rem);
      line-height: 0.92;
    }
  }

  .t-content p:not(.lead) {
    color: var(--ink-2);
    max-width: 34em;
    margin-bottom: 32px;
  }

  @media (min-width: 1000px) {
    .fears .f-img {
      position: sticky;
      top: 0;
      height: 100vh;
    }
  }

  .f-quote {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: var(--gutter);
    margin: 0;
    padding: 24px 26px;
    max-width: 460px;
  }

  .f-quote blockquote {
    margin: 10px 0 12px;
    font-size: clamp(1.2rem, 1.6vw, 1.5rem);
    line-height: 1.3;
  }

  .f-quote figcaption {
    font-size: 0.88rem;
    opacity: 0.8;
  }
</style>
