---
// Kontakt: zwei klar getrennte Wege (Termin buchen · Frage stellen), darunter eigenständig das Formular
// und die Anfahrt. Grossflächig, ruhig, Linien statt Boxen.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import imgHero from '../assets/shoot/raum-weit.jpg';
import imgTuecher from '../assets/shoot/detail-tuecher.jpg';

const channels = [
  { label: 'WhatsApp', value: 'Nachricht schreiben', href: site.whatsappHref, ext: true },
  { label: 'Telefon', value: site.phone, href: site.phoneHref },
  { label: 'E-Mail', value: site.email, href: `mailto:${site.email}?subject=Anfrage` },
  { label: 'Instagram', value: site.instagramHandle, href: site.instagram, ext: true },
];
---

<Base
  title="Kontakt & Anfahrt | Eloure The Studio Amriswil"
  description="Eloure The Studio, Bahnhofstrasse 20, 8580 Amriswil. Mo–Fr 10–20 Uhr, Sa 10–16 Uhr. Erreiche uns per Telefon, WhatsApp, E-Mail oder buche direkt online."
>
  <PageHero title={['Meld dich.', 'Wir freuen uns.']} image={imgHero} alt="Helle Lounge im Eloure Studio" position="center 55%" lead="Termin buchen oder kurz nachfragen – wie es dir am liebsten ist." />

  <!-- Zwei Wege -->
  <section class="ways">
    <div class="ways-grid">
      <a class="way way-book" href="/termin" data-anim="soft">
        <h2>Termin<br />buchen</h2>
        <p>Freie Zeiten sehen und direkt online buchen. Bezahlt wird vor Ort.</p>
        <span class="way-btn">Zur Buchung</span>
      </a>

      <div class="way way-ask" data-anim="soft">
        <h2>Frage<br />stellen</h2>
        <p>Wir antworten persönlich – am schnellsten per WhatsApp.</p>
        <ul class="lines">
          {
            channels.map((c) => (
              <li>
                <a href={c.href} target={c.ext ? '_blank' : undefined} rel={c.ext ? 'noopener' : undefined}>
                  <span class="l-label">{c.label}</span>
                  <span class="l-value">{c.value}</span>
                  <span class="l-arrow" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Nachricht schreiben: eigenständig -->
  <section class="write" id="nachricht">
    <div class="write-in">
      <div class="write-head">
        <h2 class="reveal">Nachricht<br />schreiben</h2>
        <p class="reveal">Für alles, was etwas mehr Platz braucht. Wir antworten persönlich.</p>
      </div>
      <form class="form reveal" data-contact-form>
        <div class="row2">
          <label>Vorname<input name="vorname" autocomplete="given-name" required /></label>
          <label>Nachname<input name="nachname" autocomplete="family-name" /></label>
        </div>
        <div class="row2">
          <label>E-Mail<input type="email" name="email" autocomplete="email" required /></label>
          <label><span>Telefon <span class="opt">(optional)</span></span><input type="tel" name="telefon" autocomplete="tel" /></label>
        </div>
        <label>Deine Nachricht<textarea name="nachricht" rows="5" required></textarea></label>
        <label class="consent">
          <input type="checkbox" required />
          <span>Ich bin einverstanden, dass meine Angaben zur Beantwortung meiner Anfrage verwendet werden. Mehr in der <a href="/datenschutz">Datenschutzerklärung</a>.</span>
        </label>
        <button class="send" type="submit">Nachricht senden</button>
        <p class="sent" hidden data-sent>Danke! Wir haben deine Nachricht erhalten und melden uns so schnell wie möglich.</p>
      </form>
    </div>
  </section>

  <!-- Anfahrt -->
  <section class="visit">
    <div class="visit-grid">
      <div class="visit-text">
        <h2 class="reveal">So findest<br />du zu uns.</h2>
        <address class="reveal">
          {site.address.street}<br />
          {site.address.zip} {site.address.city}
        </address>
        <dl class="hours reveal">
          {
            site.hours.map((h) => (
              <div>
                <dt>{h.days}</dt>
                <dd>{h.time}</dd>
              </div>
            ))
          }
        </dl>
        <p class="park reveal">{site.parking} · Bezahlung: {site.paymentMethods}</p>
        <a class="route reveal" href={site.mapsUrl} target="_blank" rel="noopener">Route planen</a>
      </div>
      <figure class="visit-img" data-anim="soft">
        <Image src={imgTuecher} alt="Frische Tücher im Behandlungsraum" widths={[500, 800, 1100]} sizes="(min-width: 900px) 44vw, 100vw" />
      </figure>
    </div>
  </section>
</Base>

<style>
  h2 {
    font-family: var(--sans);
    font-style: normal;
    font-weight: 200;
    text-transform: uppercase;
    line-height: 1;
    letter-spacing: 0.005em;
    color: var(--ink);
  }

  /* ——— Zwei Wege ——— */
  .ways {
    padding-block: clamp(110px, 11vw, 170px);
  }

  .ways-grid {
    display: grid;
    gap: 14px;
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  @media (min-width: 900px) {
    .ways-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .way {
    display: flex;
    flex-direction: column;
    padding: clamp(32px, 4.4vw, 64px);
    min-height: clamp(420px, 42vw, 560px);
    color: var(--ink);
    text-decoration: none;
  }

  .way h2 {
    margin: 0 0 22px;
    font-size: clamp(2.6rem, 4.8vw, 5rem);
  }

  .way p {
    max-width: 24em;
    margin: 0;
    font-size: 1.05rem;
    color: var(--ink-2);
  }

  .way-book {
    background: var(--frost);
    --ink-2: #33363a;
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }

  .way-book:hover {
    transform: translateY(-3px);
    box-shadow: 0 26px 48px -30px rgba(40, 50, 62, 0.55);
  }

  .way-btn {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 58px;
    margin-top: auto;
    padding: 0 40px;
    font-size: 0.88rem;
    font-weight: 450;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #fff;
    background: var(--cta);
    transition: background 0.3s ease;
  }

  .way-book:hover .way-btn {
    background: var(--cta-hover);
  }

  .way-ask {
    background: var(--veil);
  }

  .lines {
    list-style: none;
    margin: auto 0 0;
    padding: 32px 0 0;
  }

  .lines li {
    border-top: 1px solid var(--line-strong);
  }

  .lines li:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .lines a {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 18px 4px;
    text-decoration: none;
    color: var(--ink);
    transition: padding 0.3s var(--ease);
  }

  .lines a:hover {
    padding-left: 12px;
  }

  .l-label {
    font-size: 0.76rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .l-value {
    overflow-wrap: anywhere;
    font-size: 1.05rem;
  }

  .l-arrow {
    position: relative;
    width: 22px;
    height: 1px;
    background: currentColor;
  }

  .l-arrow::after {
    content: '';
    position: absolute;
    right: 0;
    top: -4px;
    width: 8px;
    height: 8px;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    transform: rotate(45deg);
  }

  /* ——— Nachricht ——— */
  .write {
    padding-block: clamp(110px, 11vw, 170px);
    background: var(--veil);
  }

  .write-in {
    display: grid;
    gap: 48px clamp(48px, 7vw, 120px);
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  @media (min-width: 960px) {
    .write-in {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }

  .write-head h2 {
    margin: 0 0 22px;
    font-size: clamp(2.6rem, 4.4vw, 4.6rem);
  }

  .write-head p {
    max-width: 22em;
    margin: 0;
    color: var(--ink-2);
  }

  .form {
    display: grid;
    gap: 22px;
  }

  .row2 {
    display: grid;
    gap: 22px;
  }

  @media (min-width: 560px) {
    .row2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form label:not(.consent) {
    display: grid;
    gap: 8px;
    font-size: 0.76rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .opt {
    letter-spacing: 0.06em;
    text-transform: none;
    color: var(--muted);
  }

  input:not([type='checkbox']),
  textarea {
    width: 100%;
    padding: 14px 0;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    border-radius: 0;
    background: transparent;
    font: inherit;
    font-size: 1.05rem;
    letter-spacing: normal;
    text-transform: none;
    color: var(--ink);
  }

  textarea {
    resize: vertical;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--cta);
  }

  .consent {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 12px;
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .consent input {
    width: 18px;
    height: 18px;
    margin-top: 3px;
    accent-color: var(--cta);
  }

  .send {
    justify-self: start;
    min-height: 58px;
    padding: 0 40px;
    border: 1px solid var(--cta);
    background: var(--cta);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 450;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #fff;
    cursor: pointer;
  }

  .send:hover {
    background: var(--cta-hover);
  }

  .send:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .sent {
    margin: 0;
    color: var(--cta);
  }

  /* ——— Anfahrt ——— */
  .visit {
    padding-block: clamp(110px, 11vw, 170px);
  }

  .visit-grid {
    display: grid;
    gap: 48px clamp(48px, 7vw, 120px);
    align-items: center;
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  @media (min-width: 900px) {
    .visit-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .visit-text h2 {
    margin: 0 0 28px;
    font-size: clamp(2.6rem, 4.4vw, 4.6rem);
  }

  address {
    margin-bottom: 28px;
    font-style: normal;
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .hours {
    margin: 0 0 20px;
    border-top: 1px solid var(--line-strong);
  }

  .hours div {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .hours dt {
    color: var(--ink-2);
  }

  .hours dd {
    margin: 0;
    color: var(--ink);
  }

  .park {
    margin: 0 0 28px;
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .route {
    display: inline-block;
    padding-bottom: 6px;
    font-size: 0.86rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--line-strong);
  }

  .visit-img {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .visit-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script>
  // Visuelle Demo: Vor dem Livegang an einen Formular-Dienst (z. B. Formspree, Netlify Forms) anbinden.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    form.querySelector<HTMLElement>('[data-sent]')!.hidden = false;
    form.querySelector<HTMLButtonElement>('button[type=submit]')!.disabled = true;
  });
</script>
