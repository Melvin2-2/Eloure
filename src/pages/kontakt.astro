---
// Kontakt: zwei klar getrennte Wege (Termin buchen · Frage stellen), darunter die Anfahrt. Grossflächig, ruhig, Linien statt Boxen.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import imgHero from '../assets/shoot/raum-weit.jpg';
import imgTuecher from '../assets/shoot/detail-tuecher.jpg';

const dest = encodeURIComponent(`${site.address.street}, ${site.address.zip} ${site.address.city}`);
const appleMaps = `https://maps.apple.com/?daddr=${dest}&q=${encodeURIComponent(site.name)}`;
const googleMaps = `https://www.google.com/maps/dir/?api=1&destination=${dest}`;

const channels = [
  { label: 'WhatsApp', value: 'Nachricht schreiben', href: site.whatsappHref, ext: true },
  { label: 'Telefon', value: site.phone, href: site.phoneHref },
  { label: 'E-Mail', value: site.email, href: `mailto:${site.email}?subject=Anfrage` },
  { label: 'Instagram', value: site.instagramHandle, href: site.instagram, ext: true },
];
---

<Base
  title="Kontakt & Anfahrt | Eloure The Studio Amriswil"
  description="Eloure The Studio, Bahnhofstrasse 20, 8580 Amriswil. Mo–Fr 10–20 Uhr, Sa 10–16 Uhr. Erreiche uns per Telefon, WhatsApp, E-Mail oder buche direkt online."
>
  <PageHero title={['Meld dich.', 'Wir freuen uns.']} image={imgHero} alt="Helle Lounge im Eloure Studio" position="center 55%" lead="Termin buchen oder kurz nachfragen – wie es dir am liebsten ist." />

  <!-- Zwei Wege -->
  <section class="ways">
    <div class="ways-grid">
      <a class="way way-book" href="/termin" data-anim="soft">
        <h2>Termin<br />buchen</h2>
        <p>Freie Zeiten sehen und direkt online buchen. Bezahlt wird vor Ort.</p>
        <span class="way-btn">Zur Buchung</span>
      </a>

      <div class="way way-ask" data-anim="soft">
        <h2>Frage<br />stellen</h2>
        <p>Wir antworten persönlich – am schnellsten per WhatsApp.</p>
        <ul class="lines">
          {
            channels.map((c) => (
              <li>
                <a href={c.href} target={c.ext ? '_blank' : undefined} rel={c.ext ? 'noopener' : undefined}>
                  <span class="l-label">{c.label}</span>
                  <span class="l-value">{c.value}</span>
                  <span class="l-arrow" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Anfahrt -->
  <section class="visit">
    <div class="visit-grid">
      <div class="visit-text">
        <h2 class="reveal">So findest<br />du zu uns.</h2>
        <address class="reveal">
          {site.address.street}<br />
          {site.address.zip} {site.address.city}
        </address>
        <p class="routes reveal">
          <a href={appleMaps} target="_blank" rel="noopener">Route in Apple Karten</a>
          <a href={googleMaps} target="_blank" rel="noopener">Route in Google Maps</a>
        </p>
        <dl class="hours reveal">
          {
            site.hours.map((h) => (
              <div>
                <dt>{h.days}</dt>
                <dd>{h.time}</dd>
              </div>
            ))
          }
        </dl>
        <p class="park reveal">{site.parking} · Bezahlung: {site.paymentMethods}</p>
      </div>
      <figure class="visit-img" data-anim="soft">
        <Image src={imgTuecher} alt="Frische Tücher im Behandlungsraum" widths={[500, 800, 1100]} sizes="(min-width: 900px) 44vw, 100vw" />
      </figure>
    </div>
  </section>
</Base>

<style>
  h2 {
    font-family: var(--sans);
    font-style: normal;
    font-weight: 200;
    text-transform: uppercase;
    line-height: 1;
    letter-spacing: 0.005em;
    color: var(--ink);
  }

  /* ——— Zwei Wege ——— */
  .ways {
    padding-block: clamp(110px, 11vw, 170px);
  }

  .ways-grid {
    display: grid;
    gap: 14px;
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  @media (min-width: 900px) {
    .ways-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .way {
    display: flex;
    flex-direction: column;
    padding: clamp(32px, 4.4vw, 64px);
    min-height: clamp(420px, 42vw, 560px);
    color: var(--ink);
    text-decoration: none;
  }

  .way h2 {
    margin: 0 0 22px;
    font-size: clamp(2.6rem, 4.8vw, 5rem);
  }

  .way p {
    max-width: 24em;
    margin: 0;
    font-size: 1.05rem;
    color: var(--ink-2);
  }

  .way-book {
    background: var(--frost);
    --ink-2: #33363a;
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }

  .way-book:hover {
    transform: translateY(-3px);
    box-shadow: 0 26px 48px -30px rgba(40, 50, 62, 0.55);
  }

  .way-btn {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 58px;
    margin-top: auto;
    padding: 0 40px;
    font-size: 0.88rem;
    font-weight: 450;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #fff;
    background: var(--cta);
    transition: background 0.3s ease;
  }

  .way-book:hover .way-btn {
    background: var(--cta-hover);
  }

  .way-ask {
    background: var(--veil);
  }

  .lines {
    list-style: none;
    margin: auto 0 0;
    padding: 32px 0 0;
  }

  .lines li {
    border-top: 1px solid var(--line-strong);
  }

  .lines li:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .lines a {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 18px 4px;
    text-decoration: none;
    color: var(--ink);
    transition: padding 0.3s var(--ease);
  }

  .lines a:hover {
    padding-left: 12px;
  }

  .l-label {
    font-size: 0.76rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .l-value {
    overflow-wrap: anywhere;
    font-size: 1.05rem;
  }

  .l-arrow {
    position: relative;
    width: 22px;
    height: 1px;
    background: currentColor;
  }

  .l-arrow::after {
    content: '';
    position: absolute;
    right: 0;
    top: -4px;
    width: 8px;
    height: 8px;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    transform: rotate(45deg);
  }

  /* ——— Anfahrt ——— */
  .visit {
    padding-block: clamp(110px, 11vw, 170px);
    background: var(--veil);
  }

  .routes {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 32px;
    margin: -8px 0 32px;
  }

  .routes a {
    padding-bottom: 6px;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--line-strong);
  }

  .routes a:hover {
    border-color: var(--cta);
    color: var(--cta);
  }

  .visit-grid {
    display: grid;
    gap: 48px clamp(48px, 7vw, 120px);
    align-items: center;
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  @media (min-width: 900px) {
    .visit-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .visit-text h2 {
    margin: 0 0 28px;
    font-size: clamp(2.6rem, 4.4vw, 4.6rem);
  }

  address {
    margin-bottom: 28px;
    font-style: normal;
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .hours {
    margin: 0 0 20px;
    border-top: 1px solid var(--line-strong);
  }

  .hours div {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .hours dt {
    color: var(--ink-2);
  }

  .hours dd {
    margin: 0;
    color: var(--ink);
  }

  .park {
    margin: 0 0 28px;
    font-size: 0.95rem;
    color: var(--ink-2);
  }


  .visit-img {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .visit-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
