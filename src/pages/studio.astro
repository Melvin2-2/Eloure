---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Lines from '../components/Lines.astro';
import ImageExpand from '../components/ImageExpand.astro';
import Reviews from '../components/Reviews.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

import imgHero from '../assets/shoot/raum-fenster.jpg';
import imgCaro from '../assets/shoot/caro-sw.jpg';
import imgCaro2 from '../assets/shoot/caro-lacht.jpg';
import imgCaro3 from '../assets/shoot/caro-sessel.jpg';
import imgRoom from '../assets/shoot/raum-weit.jpg';
import imgV1 from '../assets/shoot/detail-relief.jpg';
import imgV2 from '../assets/shoot/detail-pflanze.jpg';
---

<Base
  title="Über uns – Caro & Sarah | Eloure The Studio Amriswil"
  description="Lerne Caro & Sarah kennen: zertifizierte Expertinnen für Laserhaarentfernung in Amriswil. Ein ruhiges Studio mit offener, vertrauensvoller Atmosphäre, fairen Preisen und viel Zeit für dich."
>
  <PageHero
    title={['Grüezi.', 'Schön bist du da.']}
    sub="Studio & Team in Amriswil"
    image={imgHero}
    alt="Heller Behandlungsraum mit grossem Fenster"
    lead="Wir sind Eloure – zertifizierte Expertinnen für Laserhaarentfernung im Herzen von Amriswil. Und wir haben uns ganz bewusst auf genau eine Sache spezialisiert."
  >
    <div class="btn-row">
      <a class="btn btn-primary" href="/termin">Termin buchen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
      <a class="btn btn-ghost" href="#team">Das Team</a>
    </div>
  </PageHero>

  <!-- Team -->
  <section class="team bg-sand" id="team">
    <div class="t-img" data-anim="img">
      <Image src={imgCaro} alt="Caro, Gründerin und Inhaberin von Eloure" widths={[700, 1100, 1600]} sizes="(min-width: 1000px) 46vw, 100vw" />
      <span class="t-cap glass">Caro · Gründerin & Inhaberin</span>
    </div>
    <div class="t-content">
      <Lines lines={['Hey, wir sind', 'Caro & Sarah.']} class="t-title" />
      <p class="lead reveal">
        Ein eingespieltes Team voller Leidenschaft, Kompetenz und Einfühlungsvermögen. Unser Ziel: dass du dich in deiner Haut
        rundum wohlfühlst.
      </p>
      <p class="reveal">
        Caro hat Eloure gegründet und führt das Studio als Inhaberin, Sarah ist an ihrer Seite. Seit drei Jahren gibt es unser
        eigenes Studio in Amriswil – Erfahrung in der Laserhaarentfernung bringen wir schon zwei Jahre länger mit.
      </p>
      <p class="reveal">
        Unser Anspruch: faire Preise und beste Qualität. Und eine offene, vertrauensvolle Atmosphäre bei jeder einzelnen
        Behandlung.
      </p>
      <div class="t-pics">
        <div class="tp" data-anim="img"><Image src={imgCaro2} alt="Caro lacht in der Lounge" widths={[400, 700]} sizes="(min-width: 1000px) 16vw, 45vw" /></div>
        <div class="tp" data-anim="img"><Image src={imgCaro3} alt="Caro entspannt im Sessel" widths={[400, 700]} sizes="(min-width: 1000px) 16vw, 45vw" /></div>
      </div>
    </div>
  </section>

  <!-- Werte -->
  <section class="values bg-dark">
    <div class="wrap">
      <div class="v-head">
        <Lines lines={['Worauf du dich', 'verlassen kannst.']} />
      </div>
      <ul class="v-list">
        <li class="reveal">
          <span class="v-no serif">01</span>
          <h3 class="serif">Ehrliche Beratung</h3>
          <p>Wir sagen dir, was realistisch ist – auch wenn das mal nicht das ist, was du hören möchtest.</p>
        </li>
        <li class="reveal">
          <span class="v-no serif">02</span>
          <h3 class="serif">Zertifizierte Sicherheit</h3>
          <p>Medizinischer Diodenlaser, Ausbildung und Sachkundenachweis nach V‑NISSG, 5 Jahre Erfahrung.</p>
        </li>
        <li class="reveal">
          <span class="v-no serif">03</span>
          <h3 class="serif">Individuell statt Schema F</h3>
          <p>Einstellungen, Abstände und Plan passen wir laufend an deine Haut, deine Haare und deine Ziele an.</p>
        </li>
        <li class="reveal">
          <span class="v-no serif">04</span>
          <h3 class="serif">Ruhe und Diskretion</h3>
          <p>Ein heller, privater Ort ohne Hektik. Du gibst das Tempo vor, und jede Frage ist willkommen.</p>
        </li>
      </ul>
      <div class="v-pics">
        <div class="vp" data-anim="img"><Image src={imgV1} alt="Strukturierte Wanddekoration im Studio" widths={[500, 900]} sizes="(min-width: 900px) 50vw, 100vw" /></div>
        <div class="vp" data-anim="img"><Image src={imgV2} alt="Pflanze im Studio" widths={[500, 900]} sizes="(min-width: 900px) 50vw, 100vw" /></div>
      </div>
    </div>
  </section>

  <ImageExpand
    image={imgRoom}
    alt="Behandlungsraum mit Laserliege und Pflanzen"
    word="Ruhe."
    title="Kein Klinik-Gefühl."
    text="Neu, hell und mit viel Liebe eingerichtet: Bei uns wartest du nicht im Neonlicht, sondern kommst in einer ruhigen Lounge an."
    ctaHref="/termin"
    ctaLabel="Termin buchen"
  />

  <!-- Besuch -->
  <section class="visit bg-lime">
    <div class="wrap v-grid">
      <Lines lines={['Hier findest', 'du uns.']} />
      <div class="reveal">
        <p class="addr serif">{site.address.street}<br />{site.address.zip} {site.address.city}</p>
        <p>{site.parking}.</p>
        <dl>
          {site.hours.map((h) => (<div><dt>{h.days}</dt><dd>{h.time}</dd></div>))}
        </dl>
        <div class="btn-row">
          <a class="btn btn-dark" href="/termin">Termin buchen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
          <a class="text-link" href={site.mapsUrl} target="_blank" rel="noopener">Route planen</a>
        </div>
      </div>
    </div>
  </section>

  <Reviews />
  <CtaFinal title="Lust, uns kennenzulernen?" />
</Base>

<style>
  .team {
    display: grid;
  }

  @media (min-width: 1000px) {
    .team {
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
    }
  }

  .t-img {
    position: relative;
    overflow: hidden;
    min-height: 110vw;
  }

  @media (min-width: 1000px) {
    .t-img {
      min-height: 0;
    }
  }

  .t-img :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  .t-cap {
    position: absolute;
    left: var(--gutter);
    bottom: var(--gutter);
    padding: 12px 18px;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .t-content {
    position: relative;
    z-index: 2;
    padding: var(--section) var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 780px;
  }

  @media (min-width: 1000px) {
    .t-content :global(.t-title) {
      width: max-content;
      margin-left: calc(-10vw - var(--gutter));
    }
  }

  .t-content p:not(.lead) {
    color: var(--ink-2);
  }

  .t-pics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-top: 32px;
    max-width: 520px;
  }

  .tp {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .tp :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .values {
    padding-block: var(--section);
  }

  .v-head {
    margin-bottom: 56px;
  }

  .v-list {
    list-style: none;
    margin: 0 0 64px;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line-light);
  }

  @media (min-width: 900px) {
    .v-list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .v-list li {
    padding: 32px 28px 32px 0;
    border-bottom: 1px solid var(--line-light);
  }

  @media (min-width: 900px) {
    .v-list li {
      border-bottom: 0;
      padding-right: 32px;
    }
  }

  .v-no {
    display: block;
    color: var(--lime);
    font-size: 2.4rem;
    line-height: 1;
    margin-bottom: 28px;
  }

  .v-list h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.8rem;
    line-height: 1.08;
  }

  .v-list p {
    color: rgba(246, 241, 234, 0.75);
  }

  .v-pics {
    display: grid;
    gap: 6px;
  }

  @media (min-width: 900px) {
    .v-pics {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .vp {
    position: relative;
    height: clamp(320px, 60vh, 640px);
    overflow: hidden;
  }

  .vp :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .visit {
    padding-block: var(--section);
  }

  .v-grid {
    display: grid;
    gap: 24px 80px;
  }

  @media (min-width: 960px) {
    .v-grid {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }

  .addr {
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    line-height: 1.1;
    margin-bottom: 12px;
  }

  dl {
    margin: 24px 0 32px;
    max-width: 380px;
    display: grid;
    gap: 6px;
  }

  dl div {
    display: flex;
    justify-content: space-between;
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(43, 31, 26, 0.3);
  }

  dd {
    margin: 0;
    font-weight: 600;
  }
</style>
