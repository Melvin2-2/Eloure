---
// Paid-Ads-Landingpage (Verkaufsseite). Nicht in Navigation, Sitemap oder Suchmaschinen.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Lines from '../components/Lines.astro';
import ZoneHighlights from '../components/ZoneHighlights.astro';
import StoryPath from '../components/StoryPath.astro';
import FaqList from '../components/FaqList.astro';
import Reviews from '../components/Reviews.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { site, promo } from '../data/site';
import { pickFaqs } from '../data/faq';
import { googleRating } from '../data/reviews';

import imgDevice from '../assets/shoot/geraet.jpg';
import uRoom from '../assets/shoot/geraet-2.jpg';
import uCaro from '../assets/shoot/caro-beratung-2.jpg';
import uDisplay from '../assets/shoot/display.jpg';
import uLounge from '../assets/shoot/lounge-tuer.jpg';

const q = `code=${promo.code}`;
const pct = `${promo.percent} %`;

const usps = [
  { img: imgDevice, alt: 'Medizinischer Diodenlaser im Studio', title: 'Medizinischer Diodenlaser', text: 'Schonend, präzise und für verschiedene Haut- und Haartypen geeignet.' },
  { img: uCaro, alt: 'Caro berät eine Kundin', title: 'Ehrliche Beratung', text: 'Keine Standard-Versprechen. Wir sagen dir, was bei dir realistisch ist.' },
  { img: uDisplay, alt: 'Display des Lasergeräts', title: '100 % spezialisiert', text: 'Keine Allround-Behandlungen, sondern volle Expertise in einem Bereich.' },
  { img: uLounge, alt: 'Lounge im Eloure Studio', title: 'Ruhe statt Klinik', text: 'Ein heller, privater Ort. Du gibst das Tempo vor – jede Frage ist willkommen.' },
];

const faqs = [
  {
    id: 'code',
    q: `Wie löse ich den Code ${promo.code} ein?`,
    a: `<p>Wähle deine Zone und deinen Wunschtermin. Im letzten Schritt gibst du <strong>${promo.code}</strong> ein – der Rabatt wird sofort abgezogen. Bezahlt wird erst vor Ort, nach deinem Termin.</p>`,
  },
  {
    id: 'gilt',
    q: 'Für welche Behandlungen gilt der Rabatt?',
    a: `<p>Für <strong>jede Zone bei deinem ersten Besuch</strong> – ob Achseln, Beine oder Ganzkörper, für Frauen und Männer.</p>`,
  },
  ...pickFaqs(['schmerz', 'sitzungen', 'geeignet', 'bezahlen']),
];
---

<Base
  title={`${pct} auf deine erste Laserbehandlung | Eloure Amriswil`}
  description={`Dauerhaft glatte Haut mit medizinischem Diodenlaser in Amriswil. Als Neukund:in ${pct} auf deine erste Behandlung mit dem Code ${promo.code}. Bezahlt wird erst vor Ort.`}
  variant="minimal"
  noindex
  ctaHref={`/termin?${q}`}
  ctaLabel={`${pct} sichern`}
  mobileNote={`Code ${promo.code}`}
  announce={{ text: `Neukundenangebot: ${pct} auf deine erste Behandlung · Code ${promo.code}`, href: `/termin?${q}`, cta: 'Jetzt einlösen' }}
>
  <!-- HERO -->
  <section class="hero bg-dark">
    <div class="hero-img">
      <video class="hero-video" autoplay muted loop playsinline preload="auto" poster="/video/studio-2026.jpg" aria-label="Eindrücke einer Laserbehandlung im Eloure Studio">
        <source src="/video/studio-2026.mp4" type="video/mp4" />
      </video>
      <div class="hero-shade"></div>
    </div>

    <div class="hero-content">
      <Lines as="h1" class="display hero-title" lines={[`${pct} auf deine`, 'erste Behandlung.']}>
        <span class="hero-sub" data-anim="up">Laserhaarentfernung in Amriswil</span>
      </Lines>
      <p class="lead" data-anim="up">
        Dauerhaft glatte Haut mit medizinischem Diodenlaser. Ohne Rasieren, ohne Pickel, ohne Stress – und ohne Vorauszahlung.
      </p>

      <div class="code-box" data-anim="up">
        <div>
          <small>Dein Code – im Checkout eingeben</small>
          <strong>{promo.code}</strong>
        </div>
        <button type="button" class="copy" data-copy={promo.code}><Icon name="copy" size={16} /> <span>Kopieren</span></button>
      </div>

      <div class="btn-row" data-anim="up">
        <a class="btn btn-primary" href={`/termin?${q}`}>{pct} Rabatt sichern<span class="arrow"><Icon name="arrow" size={16} /></span></a>
        <a class="btn btn-ghost" href="#zonen">Alle Preise</a>
      </div>
    </div>

    <div class="hero-card glass" data-anim="up">
      <span class="label">So einfach geht’s</span>
      <ol>
        <li><b>1</b> Zone & Termin wählen</li>
        <li><b>2</b> Code {promo.code} eingeben</li>
        <li><b>3</b> Vor Ort bezahlen</li>
      </ol>
      <a href={site.googleReviewsUrl} target="_blank" rel="noopener" class="g"><span class="stars">★★★★★</span> <b>{googleRating.rating.toFixed(1).replace('.', ',')}</b> · {googleRating.count} Google-Bewertungen</a>
    </div>
  </section>

  <!-- ALLE ZONEN mit Rabatt -->
  <ZoneHighlights code={promo.code} discount={promo.percent} title={['Alle Topseller', `${pct} günstiger.`]} />

  <!-- WARUM ELOURE: Bildkacheln mit Glas-Text -->
  <section class="why bg-dark">
    <div class="wrap why-head">
      <Lines lines={['Warum so viele', 'bei uns bleiben.']} />
      <p class="lead reveal">
        Wir sind kein Beauty-Allrounder, sondern ein Studio, das sich zu 100&nbsp;% auf Laserhaarentfernung konzentriert.
      </p>
    </div>
    <div class="tiles">
      {
        usps.map((u) => (
          <div class="tile zoom" data-anim="img">
            <Image src={u.img} alt={u.alt} widths={[600, 900, 1200]} sizes="(min-width: 900px) 50vw, 100vw" />
            <div class="tile-card glass">
              <h3 class="serif">{u.title}</h3>
              <p>{u.text}</p>
            </div>
          </div>
        ))
      }
    </div>
    <div class="wrap why-cta">
      <a class="btn btn-primary reveal" href={`/termin?${q}`}>Ersten Termin mit {pct} buchen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
    </div>
  </section>

  <!-- ABLAUF -->
  <StoryPath title={['So läuft dein', 'erster Termin.']} ctaHref={`/termin?${q}`} ctaLabel={`Mit ${pct} starten`} />

  <!-- SICHERHEIT -->
  <section class="safe bg-mocha">
    <div class="safe-img" data-anim="img">
      <Image src={uRoom} alt="Medizinischer Diodenlaser im Behandlungsraum" widths={[700, 1100, 1600]} sizes="(min-width: 1000px) 50vw, 100vw" />
    </div>
    <div class="safe-content">
      <Lines lines={['Sicherheit', 'zuerst.']} />
      <p class="lead reveal">
        5 Jahre Erfahrung – ausschliesslich in der Laserhaarentfernung, seit 3 Jahren im eigenen Studio in Amriswil.
      </p>
      <ul class="check-list reveal">
        <li>Medizinischer Diodenlaser</li>
        <li>Ausbildung & Sachkundenachweis nach V‑NISSG</li>
        <li>Ehrliche Einschätzung vor der ersten Session</li>
        <li>Bezahlt wird vor Ort – bar, TWINT oder Karte</li>
      </ul>
      <div class="btn-row reveal">
        <a class="btn btn-primary" href={`/termin?${q}`}>{pct} Rabatt sichern<span class="arrow"><Icon name="arrow" size={16} /></span></a>
        <a class="btn btn-ghost" href={`/termin?behandlung=beratungsgespraech&${q}`}>Erst kostenlos beraten</a>
      </div>
    </div>
  </section>

  <Reviews title={['Ø 5,0 aus', '126 Bewertungen.']} ctaHref={`/termin?${q}`} ctaLabel={`${pct} Rabatt sichern`} />

  <!-- FAQ -->
  <section class="section bg-paper">
    <div class="wrap faq-grid">
      <div>
        <Lines lines={['Kurz &', 'ehrlich.']} />
        <p class="lead reveal">Was Neukundinnen am häufigsten fragen.</p>
        <a class="btn btn-dark reveal" href={`/termin?${q}`}>Termin buchen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
      </div>
      <div class="reveal"><FaqList items={faqs} open="code" /></div>
    </div>
  </section>

  <CtaFinal title={`Dein erster Schritt – ${pct} günstiger.`} code={promo.code} />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    overflow: hidden;
  }

  .hero-img {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 52%;
    overflow: hidden;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(43, 31, 26, 0.85) 0%, rgba(43, 31, 26, 0.1) 45%, rgba(43, 31, 26, 0) 70%),
      linear-gradient(0deg, rgba(43, 31, 26, 0.6), rgba(43, 31, 26, 0) 40%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding: calc(var(--header-h) + 56px) var(--gutter) clamp(48px, 6vw, 88px);
    max-width: 920px;
  }

  .hero-content :global(.hero-title) {
    width: max-content;
    max-width: 92vw;
    margin-bottom: 24px;
    font-size: clamp(2.5rem, 6.4vw, 6.8rem);
  }

  .hero-sub {
    display: block;
    margin-top: 20px;
    font-family: var(--sans);
    font-size: clamp(0.9rem, 1.2vw, 1.05rem);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--lime);
  }

  .hero-content .lead {
    max-width: 30em;
    margin-bottom: 28px;
  }

  .code-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: 480px;
    margin-bottom: 28px;
    padding: 16px 16px 16px 22px;
    background: var(--lime);
    color: var(--espresso);
    border: 1.5px dashed var(--espresso);
  }

  .code-box small {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .code-box strong {
    font-family: var(--serif);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    text-transform: uppercase;
    font-size: 2.4rem;
    line-height: 1.05;
    letter-spacing: var(--display-ls);
  }

  .copy {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border: 0;
    background: var(--espresso);
    color: var(--cream);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    flex: none;
  }

  .hero-card {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(48px, 6vw, 88px);
    z-index: 3;
    padding: 24px 26px;
    min-width: 280px;
  }

  .hero-card ol {
    list-style: none;
    margin: 14px 0 16px;
    padding: 0 0 16px;
    display: grid;
    gap: 10px;
    border-bottom: 1px solid var(--line-light);
    font-weight: 600;
  }

  .hero-card b {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin-right: 10px;
    background: var(--lime);
    color: var(--espresso);
    font-size: 0.94rem;
  }

  .hero-card .g {
    font-size: 0.92rem;
    text-decoration: none;
  }

  .stars {
    color: var(--lime);
    letter-spacing: 2px;
  }

  @media (max-width: 999px) {
    .hero {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    .hero-img {
      position: relative;
      width: 100%;
      height: 92vw;
      max-height: 680px;
    }
    .hero-shade {
      background: linear-gradient(0deg, rgba(43, 31, 26, 1) 0%, rgba(43, 31, 26, 0) 55%);
    }
    .hero-content {
      margin-top: -32vw;
      padding-top: 0;
    }
    .hero-card {
      position: relative;
      right: auto;
      bottom: auto;
      margin: 0 var(--gutter) 48px;
    }
  }

  /* Beliebte Zonen */
  .top {
    padding-block: clamp(72px, 10vw, 128px);
  }

  .top-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 48px;
  }

  .top-head :global(h2) {
    margin: 0;
  }

  .top-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--espresso);
  }

  @media (min-width: 900px) {
    .top-list {
      grid-template-columns: repeat(4, 1fr);
      border-top: 0;
    }
  }

  .top-list li a {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
    padding: 28px 24px;
    border-bottom: 1px solid var(--espresso);
    text-decoration: none;
    transition: background 0.3s;
  }

  @media (min-width: 900px) {
    .top-list li a {
      border: 1px solid var(--espresso);
      border-right: 0;
    }
    .top-list li:last-child a {
      border-right: 1px solid var(--espresso);
    }
  }

  .top-list li a:hover {
    background: var(--espresso);
    color: var(--lime);
  }

  .t-name {
    font-size: clamp(1.8rem, 2.4vw, 2.3rem);
    line-height: 1.05;
  }

  .t-prices {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: auto;
  }

  .t-prices strong {
    font-size: clamp(2.4rem, 3.4vw, 3.2rem);
    font-weight: 400;
    line-height: 1;
  }

  .t-go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* Warum */
  .why {
    padding-block: var(--section);
  }

  .why-head {
    display: grid;
    gap: 24px 64px;
    margin-bottom: 56px;
  }

  @media (min-width: 900px) {
    .why-head {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: end;
    }
  }

  .tiles {
    display: grid;
    gap: 6px;
  }

  @media (min-width: 900px) {
    .tiles {
      grid-template-columns: 1fr 1fr;
    }
  }

  .tile {
    position: relative;
    overflow: hidden;
    height: clamp(420px, 70vh, 760px);
  }

  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile-card {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: var(--gutter);
    max-width: 440px;
    padding: 24px 26px;
  }

  .tile-card h3 {
    font-family: var(--serif);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    text-transform: uppercase;
    font-size: clamp(1.8rem, 2.6vw, 2.4rem);
    line-height: 1.05;
  }

  .tile-card p {
    opacity: 0.85;
  }

  .why-cta {
    margin-top: 56px;
  }

  /* Sicherheit */
  .safe {
    display: grid;
  }

  @media (min-width: 1000px) {
    .safe {
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
    }
  }

  .safe-img {
    position: relative;
    overflow: hidden;
    min-height: 80vw;
  }

  @media (min-width: 1000px) {
    .safe-img {
      min-height: 0;
    }
  }

  .safe-img :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .safe-content {
    padding: var(--section) var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 760px;
  }

  .safe-content .check-list {
    margin: 12px 0 40px;
    font-weight: 600;
  }

  /* FAQ */
  .faq-grid {
    display: grid;
    gap: 40px 80px;
  }

  @media (min-width: 960px) {
    .faq-grid {
      grid-template-columns: 0.8fr 1.2fr;
    }
    .faq-grid > div:first-child {
      position: sticky;
      top: calc(var(--header-h) + 32px);
      align-self: start;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector('span')!;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        label.textContent = 'Kopiert!';
      } catch {
        label.textContent = btn.dataset.copy!;
      }
      setTimeout(() => (label.textContent = 'Kopieren'), 2200);
    });
  });
</script>
