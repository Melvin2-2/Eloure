---
// Paid-Ads-Landingpage. Nicht in Navigation, Sitemap oder Suchmaschinen (noindex).
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Steps from '../components/Steps.astro';
import FaqList from '../components/FaqList.astro';
import Reviews from '../components/Reviews.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { site, promo } from '../data/site';
import { services, chf, discounted, duration } from '../data/services';
import { pickFaqs } from '../data/faq';

import imgDuo from '../assets/img/team-duo.jpg';
import imgConsult from '../assets/img/consultation.jpg';
import imgRoom from '../assets/img/room-window.jpg';
import imgSofa from '../assets/img/lounge-sofa.jpg';

const q = `code=${promo.code}`;
const examples = {
  Frauen: ['ganzkoerper', 'kombi-intim-achseln', 'beine-komplett', 'unterschenkel'],
  Männer: ['brust-bauch', 'ruecken-inkl-nacken'],
};
const svc = (id: string) => services.find((s) => s.id === id)!;

const faqs = [
  {
    id: 'code',
    q: `Wie löse ich den Code ${promo.code} ein?`,
    a: `<p>Wähle deine Behandlung und deinen Wunschtermin aus. Im letzten Schritt gibst du den Code <strong>${promo.code}</strong> ein – der Rabatt wird sofort abgezogen. Bezahlt wird erst vor Ort, nach deinem Termin.</p>`,
  },
  {
    id: 'gilt',
    q: 'Für welche Behandlungen gilt der Rabatt?',
    a: `<p>Für <strong>jede Zone bei deinem ersten Besuch</strong> bei uns – egal ob Achseln, Beine oder Ganzkörper, für Frauen und Männer.</p>`,
  },
  ...pickFaqs(['schmerz', 'sitzungen', 'geeignet']),
];
---

<Base
  title={`${promo.percent} % Neukundenrabatt – Laserhaarentfernung Amriswil | Eloure`}
  description={`Dauerhaft glatte Haut mit medizinischem Diodenlaser in Amriswil. Als Neukund:in ${promo.percent} % auf deine erste Behandlung mit dem Code ${promo.code}. Bezahlt wird erst vor Ort.`}
  variant="minimal"
  noindex
  ctaHref={`/termin?${q}`}
  ctaLabel={`${promo.percent} % sichern`}
  mobileNote={`Code ${promo.code}`}
>
  <!-- ——— Hero ——— -->
  <section class="lp-hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="offer-pill"><span class="dot"></span> Neukundenangebot · nur für kurze Zeit</p>
        <h1>Glatte Haut ohne Rasieren. Jetzt {promo.percent} % günstiger starten.</h1>
        <p class="lead">
          Laserhaarentfernung in Amriswil – mit medizinischem Diodenlaser, ehrlicher Beratung und viel Zeit für dich. Ohne Rasieren,
          ohne Pickel, ohne Stress.
        </p>

        <div class="code-box">
          <div>
            <small>Dein Code für {promo.percent} % auf die erste Behandlung</small>
            <strong data-code>{promo.code}</strong>
          </div>
          <button type="button" class="copy" data-copy={promo.code}>
            <Icon name="copy" size={16} /> <span>Kopieren</span>
          </button>
        </div>

        <div class="btn-row">
          <a class="btn btn-primary" href={`/termin?${q}`}>{promo.percent} % Rabatt sichern<span class="arrow"><Icon name="arrow" size={15} /></span></a>
          <span class="muted small">Bezahlt wird erst vor Ort.</span>
        </div>

        <ul class="trust">
          <li><Icon name="shield" size={18} /> V‑NISSG-zertifiziert</li>
          <li><Icon name="spark" size={18} /> Medizinischer Diodenlaser</li>
          <li><Icon name="heart" size={18} /> {site.experience}</li>
        </ul>
      </div>

      <div class="hero-visual">
        <div class="media v-main">
          <video autoplay muted loop playsinline preload="metadata" poster="/videos/behandlung-beine.jpg" aria-label="Laserbehandlung an den Beinen im Eloure Studio">
            <source src="/videos/behandlung-beine.mp4" type="video/mp4" />
          </video>
        </div>
        <div class="media v-side">
          <Image src={imgDuo} alt="Caro und Sarah von Eloure" widths={[360, 600]} sizes="(min-width: 900px) 18vw, 40vw" loading="eager" />
        </div>
        <div class="v-tag">
          <strong>Caro & Sarah</strong>
          <span>freuen sich auf dich</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ——— Preise ——— -->
  <section class="section bg-paper" id="preise">
    <div class="wrap">
      <div class="section-head">
        <h2>Dein Neukunden-Vorteil: {promo.percent} % auf jede erste Behandlung</h2>
        <p class="lead">Ein paar Beispiele. Der Rabatt gilt für alle Zonen – für Frauen und Männer.</p>
      </div>

      {
        Object.entries(examples).map(([label, ids]) => (
          <div class="ex-group">
            <h3>{label}</h3>
            <ul class="ex">
              {ids.map(svc).map((s) => (
                <li>
                  <a href={`/termin?behandlung=${s.id}&${q}`}>
                    <span class="ex-name">{s.name}</span>
                    <span class="ex-meta">{duration(s.minutes)}</span>
                    <span class="ex-prices">
                      <s>{chf(s.price)}</s>
                      <strong>{chf(discounted(s.price!, promo.percent))}</strong>
                    </span>
                    <span class="ex-go">
                      Buchen <Icon name="arrow" size={15} />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="ex-foot muted small">
        Preise pro Sitzung, bezahlt wird vor Ort. <a class="text-link" href="/preise">Alle Zonen & Preise ansehen</a>
      </p>
    </div>
  </section>

  <!-- ——— USPs ——— -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Warum Eloure?</h2>
        <p class="lead">
          Wir sind kein Beauty-Allrounder, sondern ein Studio, das sich zu 100 % auf Laserhaarentfernung konzentriert. Präzise
          Behandlungen, hochwertige medizinische Technologie und echte Expertise – für Ergebnisse, die bleiben.
        </p>
      </div>
      <ul class="usps">
        <li class="reveal">
          <Icon name="spark" size={26} />
          <h3>Modernste Laser-Technologie</h3>
          <p>Medizinischer Diodenlaser: schonend, präzise und für verschiedene Haut- und Haartypen geeignet.</p>
        </li>
        <li class="reveal">
          <Icon name="shield" size={26} />
          <h3>Offiziell geschultes Team</h3>
          <p>Ausbildung und Sachkundenachweis nach V‑NISSG. Sicher und effektiv.</p>
        </li>
        <li class="reveal">
          <Icon name="heart" size={26} />
          <h3>100 % auf Laser spezialisiert</h3>
          <p>Keine Allround-Behandlungen, sondern volle Expertise in einem Bereich.</p>
        </li>
        <li class="reveal">
          <Icon name="leaf" size={26} />
          <h3>Sichtbare Ergebnisse</h3>
          <p>Schon nach wenigen Sitzungen merkbar glattere und feinere Haut.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- ——— Ehrlich ——— -->
  <section class="section bg-ink">
    <div class="wrap split">
      <div class="media honest-img">
        <Image src={imgConsult} alt="Persönliches Beratungsgespräch in der Studio-Lounge" widths={[480, 800]} sizes="(min-width: 900px) 44vw, 100vw" />
      </div>
      <div>
        <h2>Wie wirkt Laserhaarentfernung wirklich?</h2>
        <p class="lead">
          Das Licht des Lasers wird vom Farbstoff im Haar aufgenommen, in Wärme umgewandelt und zerstört gezielt die
          Haarwurzel – ohne die Haut stark zu belasten.
        </p>
        <p class="muted">
          Weil nur Haare in der Wachstumsphase wirksam behandelt werden können, braucht es mehrere Sitzungen in regelmässigen
          Abständen. Wie viele es bei dir sind, ist <strong style="color:var(--paper)">sehr individuell</strong> – das besprechen wir ehrlich mit dir.
        </p>
        <p class="promise">
          Wir arbeiten nicht mit Standard-Versprechen wie «8 Behandlungen für alle», sondern passen deinen Plan an deinen Körper
          und deine Ziele an.
        </p>
      </div>
    </div>
  </section>

  <!-- ——— Ablauf ——— -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>So läuft dein erster Termin ab</h2>
        <p class="lead">Klar, transparent und so, dass du dich von Anfang an sicher fühlst.</p>
      </div>
      <Steps />
      <div class="mid-cta">
        <a class="btn btn-primary" href={`/termin?${q}`}>Ersten Termin buchen<span class="arrow"><Icon name="arrow" size={15} /></span></a>
        <span class="muted small">Code <strong>{promo.code}</strong> im Checkout eingeben</span>
      </div>
    </div>
  </section>

  <!-- ——— Sicherheit + Studio ——— -->
  <section class="section bg-linen">
    <div class="wrap">
      <div class="split">
        <div>
          <h2>Sicherheit und Qualität an erster Stelle</h2>
          <p class="lead">
            Wir arbeiten mit einem medizinischen Diodenlaser und haben 5 Jahre Erfahrung – ausschliesslich in der
            Laserhaarentfernung. Jede Behandlung wird verantwortungsvoll, präzise und nach aktuellen Standards durchgeführt.
          </p>
          <ul class="check-list">
            <li>Medizinischer Diodenlaser</li>
            <li>Ausbildung & Sachkundenachweis nach V‑NISSG</li>
            <li>5 Jahre Erfahrung, davon 3 im eigenen Studio</li>
            <li>Ruhiges, privates Studio in Amriswil</li>
          </ul>
        </div>
        <div class="studio-pics">
          <div class="media sp1"><Image src={imgRoom} alt="Heller Behandlungsraum im Eloure Studio" widths={[480, 800]} sizes="(min-width: 900px) 26vw, 60vw" /></div>
          <div class="media sp2"><Image src={imgSofa} alt="Lounge im Eloure Studio" widths={[360, 600]} sizes="(min-width: 900px) 18vw, 40vw" /></div>
        </div>
      </div>
    </div>
  </section>

  <Reviews />

  <!-- ——— FAQ ——— -->
  <section class="section">
    <div class="wrap wrap-narrow">
      <div class="section-head">
        <h2>Kurz und ehrlich beantwortet</h2>
      </div>
      <FaqList items={faqs} open="code" />
    </div>
  </section>

  <CtaFinal title={`Dein erster Schritt – ${promo.percent} % günstiger`} code={promo.code} />
</Base>

<style>
  .lp-hero {
    padding-block: clamp(24px, 4vw, 56px) clamp(56px, 8vw, 104px);
  }

  .hero-grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 64px;
    }
  }

  .offer-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
    font-size: 0.86rem;
    font-weight: 500;
    margin-bottom: 22px;
  }


  .code-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: 460px;
    margin: 28px 0 24px;
    padding: 14px 14px 14px 20px;
    border-radius: var(--radius);
    background: var(--lime);
    border: 1.5px dashed rgba(46, 45, 43, 0.4);
  }

  .code-box small {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .code-box strong {
    font-family: var(--sans);
    line-height: 1.05;
    letter-spacing: 0.06em;
    font-size: 1.7rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-radius: 999px;
    border: 0;
    background: var(--ink);
    color: var(--paper);
    font-weight: 500;
    font-size: 0.86rem;
    cursor: pointer;
    flex: none;
  }

  .trust {
    list-style: none;
    padding: 24px 0 0;
    margin: 28px 0 0;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  .trust li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hero-visual {
    position: relative;
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 12px;
    align-items: end;
  }

  .v-main {
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-l);
  }

  .v-side {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-l);
    margin-bottom: 56px;
  }

  .v-side img {
    object-position: 30% center;
  }

  .v-tag {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    padding: 12px 16px;
    border-radius: 14px;
    background: var(--paper);
    box-shadow: var(--shadow);
    font-size: 0.85rem;
    line-height: 1.3;
  }

  .v-tag span {
    color: var(--muted);
  }

  /* Preisbeispiele */
  .ex-group + .ex-group {
    margin-top: 32px;
  }

  .ex-group h3 {
    font-family: var(--sans);
    margin-bottom: 12px;
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .ex {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  @media (min-width: 640px) {
    .ex {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .ex {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .ex a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    height: 100%;
    padding: 22px;
    border-radius: var(--radius);
    background: var(--bg);
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  }

  .ex a:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: var(--line);
  }

  .ex-name {
    font-family: var(--sans);
    line-height: 1.25;
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .ex-meta {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .ex-prices {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 18px;
  }

  .ex-prices s {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .ex-prices strong {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--ink);
  }

  .ex-go {
    margin-top: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
    font-size: 0.88rem;
  }

  .ex-foot {
    margin-top: 24px;
  }

  /* USPs */
  .usps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  @media (min-width: 700px) {
    .usps {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1100px) {
    .usps {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .usps li {
    padding: 28px;
    border-radius: var(--radius);
    background: var(--paper);
    border: 1px solid var(--line);
  }

  .usps :global(svg) {
    margin-bottom: 28px;
  }

  .usps p {
    color: var(--ink-2);
    font-size: 0.97rem;
  }

  .honest-img {
    aspect-ratio: 4 / 5;
    max-height: 640px;
  }

  .promise {
    margin-top: 24px;
    padding: 18px 20px;
    border-radius: var(--radius);
    background: var(--linen);
    color: var(--ink);
    font-weight: 600;
  }

  .mid-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 36px;
  }

  .studio-pics {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 12px;
    align-items: end;
  }

  .sp1 {
    aspect-ratio: 4 / 5;
  }

  .sp2 {
    aspect-ratio: 1;
    margin-bottom: 40px;
  }

  .bg-linen .check-list {
    margin-top: 24px;
    font-weight: 600;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector('span')!;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        label.textContent = 'Kopiert!';
      } catch {
        label.textContent = btn.dataset.copy!;
      }
      setTimeout(() => (label.textContent = 'Kopieren'), 2200);
    });
  });
</script>
