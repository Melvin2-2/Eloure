---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, promo } from '../data/site';
import { booking } from '../data/booking';
import { googleRating } from '../data/reviews';
import { services, firstVisit, byRegion, chf, duration, type Group } from '../data/services';

const rating = googleRating.rating.toFixed(1).replace('.', ',');
const quick = (g: Group) => services.filter((s) => s.group === g && s.tag);
const groups: { id: Group; label: string }[] = [
  { id: 'frauen', label: 'Frauen' },
  { id: 'maenner', label: 'Männer' },
];

const data = {
  services: [...firstVisit, ...services].map((s) => ({
    id: s.id,
    name: s.name,
    group: s.group,
    minutes: s.minutes,
    price: s.price,
    priceLabel: s.priceLabel ?? null,
    single: !!s.single,
    requires: s.requires ?? [],
    note: s.note ?? '',
  })),
  opening: site.openingSpec,
  promo,
  cancellationHours: site.cancellationHours,
  booking: { api: booking.api, timeZone: booking.timeZone, windowDays: booking.windowDays, slotStep: booking.slotStep, durations: booking.durations, staff: booking.staff },
  contact: { whatsapp: site.whatsappHref, phone: site.phone, phoneHref: site.phoneHref },
};
---

<Base headerTone="light" announce={false}
  title="Termin buchen | Eloure The Studio Amriswil"
  description="Buche deine Laserhaarentfernung bei Eloure in Amriswil online – in wenigen Schritten. Bezahlt wird erst vor Ort."
  variant="minimal"
  noindex
  mobileBar={false}
  ctaHref={site.phoneHref}
  ctaLabel={`Fragen? ${site.phone}`}
>
  <section class="booking" data-booking>
    <div class="b-band bg-dark">
      <div class="wrap">
        <header class="b-head">
          <div>
            <h1>Dein Termin bei Eloure.</h1>
            <ul class="b-trust">
              <li><span class="stars">★★★★★</span> <b>{rating}</b> aus {googleRating.count} Google-Bewertungen</li>
              <li><Icon name="check" size={16} /> Bezahlt wird erst vor Ort</li>
              <li><Icon name="check" size={16} /> Kostenlos absagen bis {site.cancellationHours} Std. vorher</li>
            </ul>
          </div>
          <ol class="stepper" aria-label="Fortschritt">
            <li data-stepper="1" class="is-current"><span>1</span> Behandlung</li>
            <li data-stepper="2"><span>2</span> Termin</li>
            <li data-stepper="3"><span>3</span> Angaben</li>
            <li data-stepper="4"><span>4</span> Bestätigen</li>
          </ol>
        </header>
      </div>
    </div>

    <div class="wrap">
      <div class="b-grid">
        <div class="b-main">
          <!-- ——— Schritt 1: Behandlung ——— -->
          <div class="step" data-step="1">
            <div class="step-head">
              <h2>Was dürfen wir für dich tun?</h2>
              <p class="muted">Wähle eine oder mehrere Zonen. Du kannst alles beim Termin noch mit uns anpassen.</p>
            </div>

            <div class="seg" role="radiogroup" aria-label="Behandlung für">
              {
                groups.map((g, i) => (
                  <label>
                    <input type="radio" name="gruppe" value={g.id} checked={i === 0} data-group-input />
                    <span>{g.label}</span>
                  </label>
                ))
              }
            </div>

            {
              groups.map((g, gi) => (
                <div class="group-panel" data-group-panel={g.id} hidden={gi !== 0}>
                  <p class="quick-title">Topseller & Kombis</p>
                  <div class="quick">
                    {quick(g.id).map((s) => (
                      <button type="button" class:list={['qk', s.tag === 'Kombi' ? 'qk-k' : 'qk-t']} data-quick={s.id}>
                        <span class="qk-badge">{s.tag}</span>
                        <span class="qk-name">{s.name}</span>
                        <span class="qk-meta">{duration(s.minutes)}</span>
                        <span class="qk-price">{chf(s.price)}</span>
                        <span class="qk-check" aria-hidden="true"><Icon name="check" size={14} /></span>
                      </button>
                    ))}
                  </div>
                  <p class="quick-title">Alle Zonen</p>
                  <a class="unsure" href={`#erstbesuch-${g.id}`}>
                    <Icon name="chat" size={16} /> Noch unsicher? Starte mit einer kostenlosen Beratung
                  </a>

                  {byRegion(g.id).map(([region, list]) => (
                    <fieldset class="region">
                      <legend>{region}</legend>
                      {list.map((s) => (
                        <label class="opt" data-opt={s.id}>
                          <input type="checkbox" value={s.id} data-service />
                          <span class="box" aria-hidden="true">
                            <Icon name="check" size={13} />
                          </span>
                          <span class="o-name">
                            <span>
                              {s.name}
                              {s.tag && <em class:list={['o-tag', s.tag === 'Kombi' ? 'o-k' : 'o-t']}>{s.tag}</em>}
                            </span>
                            <small>
                              {duration(s.minutes)}
                              {s.note && <> · {s.note}</>}
                            </small>
                          </span>
                          <span class="o-price">{chf(s.price)}</span>
                        </label>
                      ))}
                    </fieldset>
                  ))}

                  <div class="first-visit" id={`erstbesuch-${g.id}`} data-first-visit>
                    <p class="fv-title">Noch unsicher?</p>
                    <p class="fv-sub">Kein Problem – lern uns erst einmal kennen. Kostenlos und unverbindlich.</p>
                    <div class="fv-grid">
                      {firstVisit
                        .filter((s) => g.id === 'frauen' || s.id === 'beratungsgespraech')
                        .map((s) => (
                          <label class="fv-card">
                            <input type="checkbox" value={s.id} data-service />
                            <span class="fv-body">
                              <strong>{s.name}</strong>
                              <small>{s.note}</small>
                              <span class="fv-meta">
                                {duration(s.minutes)} · {s.price === null ? <b>kostenlos</b> : <b>{chf(s.price)}</b>}
                              </span>
                            </span>
                            <span class="tick" aria-hidden="true">
                              <Icon name="check" size={14} />
                            </span>
                          </label>
                        ))}
                    </div>
                    <p class="fv-hint">
                      <Icon name="heart" size={15} /> Gut zu wissen: Bei jedem ersten Behandlungstermin beraten wir dich ohnehin
                      ausführlich – du kannst also auch direkt starten.
                    </p>
                  </div>

                </div>
              ))
            }

            <label class="zones-note" hidden data-zones-note>
              Welche 3 Zonen wünschst du dir für deine Ganzkörperbehandlung? <span class="opt-t">(optional – klären wir
              auch gerne vor Ort)</span>
              <textarea rows="2" name="zonen" placeholder="z. B. Achseln, Intim, Beine komplett"></textarea>
            </label>
          </div>

          <!-- ——— Schritt 2: Termin ——— -->
          <div class="step" data-step="2" hidden>
            <div class="step-head">
              <h2>Wann passt es dir?</h2>
              <p class="muted">
                Mo–Fr 10–20 Uhr, Sa 10–16 Uhr. Absagen oder verschieben ist bis {site.cancellationHours} Std. vorher kostenlos.
              </p>
            </div>
            <div class="cal-wrap">
              <div class="cal">
                <div class="cal-top">
                  <button type="button" class="cal-nav" data-cal-prev aria-label="Vorheriger Monat"><Icon name="arrow" size={18} class="flip" /></button>
                  <strong data-cal-title></strong>
                  <button type="button" class="cal-nav" data-cal-next aria-label="Nächster Monat"><Icon name="arrow" size={18} /></button>
                </div>
                <div class="cal-dow" aria-hidden="true"><span>Mo</span><span>Di</span><span>Mi</span><span>Do</span><span>Fr</span><span>Sa</span><span>So</span></div>
                <div class="cal-days" data-cal-days role="grid"></div>
              </div>
              <div class="slots" data-slots>
                <p class="muted slots-empty">Wähle zuerst einen Tag aus.</p>
              </div>
            </div>
          </div>

          <!-- ——— Schritt 3: Angaben ——— -->
          <form class="step form" data-step="3" hidden data-details novalidate>
            <div class="step-head">
              <h2>Fast geschafft. Wer kommt zu uns?</h2>
              <p class="muted">Wir nutzen deine Angaben nur für deinen Termin – versprochen.</p>
            </div>
            <div class="row2">
              <label>Vorname<input name="vorname" autocomplete="given-name" required /></label>
              <label>Nachname<input name="nachname" autocomplete="family-name" required /></label>
            </div>
            <div class="row2">
              <label>E-Mail<input type="email" name="email" autocomplete="email" required /></label>
              <label>Mobilnummer<input type="tel" name="telefon" autocomplete="tel" required placeholder="079 123 45 67" /></label>
            </div>
            <fieldset class="newbie">
              <legend>Warst du schon einmal bei uns?</legend>
              <div class="seg small">
                <label><input type="radio" name="neukunde" value="ja" required /><span>Nein, das ist mein erster Besuch</span></label>
                <label><input type="radio" name="neukunde" value="nein" /><span>Ja, ich war schon da</span></label>
              </div>
            </fieldset>
            <label>
              Möchtest du uns noch etwas sagen? <span class="opt-t">(optional)</span>
              <textarea name="nachricht" rows="3" placeholder="z. B. Fragen oder Wünsche zum Termin"></textarea>
            </label>
            <label class="consent">
              <input type="checkbox" name="agb" required />
              <span>
                Ich akzeptiere die <a href="/agb" target="_blank">AGB</a> und die
                <a href="/datenschutz" target="_blank">Datenschutzerklärung</a>. Falls ich nicht kann, sage ich mindestens
                {site.cancellationHours} Std. vorher ab.
              </span>
            </label>
            <p class="form-error" data-form-error hidden>Bitte fülle alle Pflichtfelder aus.</p>
          </form>

          <!-- ——— Schritt 4: Bestätigen ——— -->
          <div class="step" data-step="4" hidden>
            <div class="step-head">
              <h2>Alles richtig so?</h2>
              <p class="muted">Prüfe kurz deine Angaben. Bezahlt wird erst vor Ort, nach deinem Termin.</p>
            </div>
            <dl class="review" data-review></dl>

            <div class="code">
              <label for="code-input">Gutscheincode</label>
              <div class="code-row">
                <input id="code-input" data-code-input autocomplete="off" placeholder="z. B. NEU26" />
                <button type="button" class="btn btn-ghost" data-code-apply>Einlösen</button>
              </div>
              <p class="code-msg" data-code-msg aria-live="polite"></p>
            </div>
            <p class="form-error" data-submit-error hidden aria-live="assertive"></p>
          </div>

          <!-- ——— Erfolg ——— -->
          <div class="step success" data-step="5" hidden>
            <span class="ok-icon"><Icon name="check" size={30} /></span>
            <h2 data-success-title>Danke! Deine Anfrage ist bei uns.</h2>
            <p class="lead" data-success-text></p>
            <div class="prep">
              <h3>So bereitest du dich vor</h3>
              <ul class="check-list">
                <li>24–48 Std. vorher die Zone rasieren – leichte Stoppeln sind perfekt</li>
                <li>4 Wochen vorher nicht mehr wachsen, zupfen oder epilieren</li>
                <li>14 Tage vorher keine direkte Sonne und keine frische Bräune</li>
                <li>Nimmst du Medikamente? Sag uns kurz Bescheid</li>
              </ul>
            </div>
            <div class="btn-row">
              <a class="btn btn-primary" href="/">Zur Startseite</a>
              <a class="text-link" href="/laserhaarentfernung#vorbereitung">Alle Tipps zur Vorbereitung</a>
            </div>
          </div>

          <div class="b-nav" data-nav>
            <button type="button" class="btn btn-ghost" data-back hidden>Zurück</button>
            <button type="button" class="btn btn-primary" data-next disabled>
              <span data-next-label>Weiter</span><span class="arrow"><Icon name="arrow" size={15} /></span>
            </button>
          </div>
        </div>

        <!-- ——— Zusammenfassung ——— -->
        <aside class="summary" data-summary aria-label="Deine Auswahl">
          <div class="sum-card">
            <h2 class="sum-title">Deine Auswahl</h2>
            <ul class="sum-list" data-sum-list>
              <li class="sum-empty">Noch nichts ausgewählt.</li>
            </ul>
            <p class="sum-when" data-sum-when hidden><Icon name="calendar" size={16} /> <span></span></p>
            <div class="sum-totals">
              <div><span>Dauer</span><span data-sum-duration>–</span></div>
              <div class="sum-discount" data-sum-discount hidden><span data-sum-discount-label></span><span data-sum-discount-value></span></div>
              <div class="sum-total"><span>Total</span><span data-sum-total>CHF 0</span></div>
            </div>
            <button type="button" class="btn btn-primary btn-block sum-cta" data-next-sum disabled>
              <span data-sum-cta-label>Weiter</span><span class="arrow"><Icon name="arrow" size={16} /></span>
            </button>
            <ul class="sum-trust">
              <li><Icon name="check" size={15} /> Bezahlt wird vor Ort – bar, TWINT oder Karte</li>
              <li><Icon name="check" size={15} /> Kostenlos absagen bis {site.cancellationHours} Std. vorher</li>
              <li><Icon name="check" size={15} /> Persönliche Beratung inklusive</li>
            </ul>
          </div>
          <p class="sum-help">
            Fragen? <a href={site.whatsappHref} target="_blank" rel="noopener">WhatsApp</a> oder <a href={site.phoneHref}>{site.phone}</a>
          </p>
        </aside>
      </div>
    </div>

    <!-- Mobile Summary Bar -->
    <div class="m-sum" data-m-sum>
      <div class="m-sum-info">
        <strong data-m-total>CHF 0</strong>
        <small data-m-count>Keine Auswahl</small>
      </div>
      <button type="button" class="btn btn-primary" data-m-next disabled>
        <span data-m-next-label>Weiter</span><span class="arrow"><Icon name="arrow" size={15} /></span>
      </button>
    </div>
  </section>

  <script type="application/json" id="booking-data" set:html={JSON.stringify(data)} />
</Base>

<style>
  .booking {
    padding-block: clamp(24px, 4vw, 48px) 120px;
  }

  .b-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px 40px;
    margin-bottom: 32px;
  }

  .b-head h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    margin: 0;
  }

  .stepper {
    list-style: none;
    display: flex;
    gap: 6px;
    margin: 0;
    padding: 0;
    font-size: 0.94rem;
    font-weight: 600;
    color: var(--muted);
  }

  .stepper li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 6px;
    border-radius: 0;
    background: var(--linen);
  }

  .stepper span {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 0;
    background: var(--paper);
    font-size: 0.85rem;
  }

  .stepper .is-current {
    background: var(--ink);
    color: var(--paper);
  }

  .stepper .is-current span {
    background: var(--linen);
    color: var(--ink);
  }

  .stepper .is-done span {
    background: var(--ink);
    color: var(--paper);
  }

  @media (max-width: 720px) {
    .stepper li:not(.is-current) {
      font-size: 0;
      gap: 0;
      padding: 6px;
    }
    .stepper li:not(.is-current) span {
      font-size: 0.85rem;
    }
  }

  .b-grid {
    display: grid;
    gap: 32px;
    align-items: start;
  }

  @media (min-width: 1000px) {
    .b-grid {
      grid-template-columns: 1fr 360px;
      gap: 48px;
    }
  }

  .step-head {
    margin-bottom: 24px;
  }

  .step-head h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    margin-bottom: 0.2em;
  }

  .step[hidden] {
    display: none;
  }

  /* Segment */
  .seg {
    display: inline-flex;
    flex-wrap: wrap;
    padding: 5px;
    border-radius: 0;
    background: var(--linen);
    margin-bottom: 28px;
  }

  .seg label {
    position: relative;
  }

  .seg input {
    position: absolute;
    opacity: 0;
    inset: 0;
  }

  .seg span {
    display: block;
    padding: 10px 24px;
    border-radius: 0;
    font-weight: 500;
    color: var(--muted);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .seg input:checked + span {
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06), 0 4px 12px -4px rgba(0, 0, 0, 0.12);
  }

  .seg input:focus-visible + span {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  .seg.small {
    border-radius: 0;
    margin: 0;
  }

  .seg.small span {
    padding: 10px 16px;
    font-size: 0.92rem;
    border-radius: 0;
  }

  /* Erster Besuch */
  .first-visit {
    padding: 20px;
    border-radius: 0;
    background: var(--linen);
    margin: 8px 0 28px;
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .fv-sub {
    font-size: 0.92rem;
    color: var(--ink-2);
    margin-bottom: 14px;
  }

  .unsure {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: -8px 0 24px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }

  .fv-title {
    font-family: var(--sans);
    line-height: 1;
    margin-bottom: 6px;
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .fv-grid {
    display: grid;
    gap: 10px;
  }

  @media (min-width: 640px) {
    .fv-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .fv-card {
    position: relative;
    display: flex;
    gap: 12px;
    padding: 16px 48px 16px 16px;
    border-radius: 0;
    border: 1.5px solid transparent;
    background: var(--paper);
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }

  .fv-card input {
    position: absolute;
    opacity: 0;
  }

  .fv-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .fv-body small {
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.4;
  }

  .fv-meta {
    font-size: 0.94rem;
  }

  .fv-meta b {
    color: var(--ok);
  }

  .tick {
    position: absolute;
    right: 14px;
    top: 16px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 0;
    border: 1.5px solid var(--line-strong);
    color: transparent;
  }

  .fv-card:has(input:checked) {
    border-color: var(--ink);
    background: var(--paper);
  }

  .fv-card:has(input:checked) .tick {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .fv-card:has(input:focus-visible) {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  .fv-hint {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    margin: 14px 0 0;
    font-size: 0.94rem;
    color: var(--ink-2);
  }

  .fv-hint :global(svg) {
    flex: none;
    margin-top: 3px;
  }

  /* Zonen */
  .region {
    border: 0;
    padding: 0;
    margin: 0 0 28px;
  }

  .region legend {
    font-family: var(--sans);
    margin-bottom: 8px;
    padding: 0;
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .opt {
    position: relative;
    display: grid;
    grid-template-columns: 24px 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 14px 16px;
    margin-bottom: 6px;
    border-radius: 0;
    background: var(--paper);
    border: 1.5px solid transparent;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s, opacity 0.2s;
  }

  .opt:hover {
    border-color: var(--line-strong);
  }

  .opt input {
    position: absolute;
    opacity: 0;
  }

  .box {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 0;
    border: 1.5px solid var(--line-strong);
    color: transparent;
    transition: background 0.2s;
  }

  .opt:has(input:checked) {
    border-color: var(--ink);
  }

  .opt:has(input:checked) .box {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .opt:has(input:focus-visible) {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  .opt:has(input:disabled) {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .o-name {
    display: flex;
    flex-direction: column;
    font-weight: 500;
  }

  .o-name small {
    font-weight: 500;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .o-price {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .zones-note {
    display: grid;
    gap: 8px;
    font-weight: 600;
    font-size: 0.93rem;
  }

  .zones-note[hidden] {
    display: none;
  }

  .opt-t {
    font-weight: 400;
    color: var(--muted);
  }

  /* Kalender */
  .cal-wrap {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 760px) {
    .cal-wrap {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: start;
    }
  }

  .cal {
    padding: 20px;
    border-radius: 0;
    background: var(--paper);
    border: 1px solid var(--line);
  }

  .cal-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .cal-top strong {
    font-family: var(--sans);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .cal-nav {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 0;
