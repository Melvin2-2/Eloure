  .slots :global(.slot-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(76px, 1fr));
    gap: 6px;
  }

  .slots :global(.slot-grid button) {
    padding: 10px 0;
    border-radius: 10px;
    border: 1.5px solid var(--line-strong);
    background: transparent;
    font-weight: 700;
    cursor: pointer;
    font-variant-numeric: tabular-nums;
  }

  .slots :global(.slot-grid button:hover) {
    border-color: var(--ink);
  }

  .slots :global(.slot-grid button[aria-pressed='true']) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--lime);
  }

  /* Formular */
  .form {
    display: grid;
    gap: 16px;
  }

  .row2 {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 560px) {
    .row2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form label:not(.consent):not(.seg label) {
    display: grid;
    gap: 6px;
    font-weight: 600;
    font-size: 0.92rem;
  }

  .form input:not([type='checkbox']):not([type='radio']),
  textarea,
  .code input {
    width: 100%;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    font-weight: 500;
    font-size: 1rem;
  }

  .form input:focus,
  textarea:focus,
  .code input:focus {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 4px var(--lime);
  }

  .form .is-invalid {
    border-color: #b4483a !important;
  }

  .newbie {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .newbie legend {
    font-weight: 600;
    font-size: 0.92rem;
    margin-bottom: 8px;
    padding: 0;
  }

  .consent {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 10px;
    font-size: 0.88rem;
    color: var(--ink-2);
  }

  .consent input {
    width: 18px;
    height: 18px;
    margin-top: 2px;
    accent-color: var(--ink);
  }

  .form-error {
    color: #b4483a;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .form-error[hidden] {
    display: none;
  }

  /* Review */
  .review {
    margin: 0 0 24px;
    border-radius: var(--radius);
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 8px 20px;
  }

  .review :global(div) {
    display: grid;
    grid-template-columns: 130px 1fr auto;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }

  .review :global(div:last-child) {
    border-bottom: 0;
  }

  .review :global(dt) {
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .review :global(dd) {
    margin: 0;
    font-weight: 600;
  }

  .review :global(button) {
    border: 0;
    background: none;
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }

  @media (max-width: 520px) {
    .review :global(div) {
      grid-template-columns: 1fr auto;
    }
    .review :global(dd) {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  .code label {
    display: block;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .code-row {
    display: flex;
    gap: 8px;
  }

  .code-row input {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .code-row .btn {
    min-height: 50px;
  }

  .code-msg {
    margin-top: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    min-height: 1.4em;
  }

  .code-msg.ok {
    color: var(--ok);
  }

  .code-msg.err {
    color: #b4483a;
  }

  /* Erfolg */
  .success {
    padding: clamp(24px, 4vw, 48px);
    border-radius: var(--radius-l);
    background: var(--paper);
    border: 1px solid var(--line);
  }

  .ok-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--lime);
    margin-bottom: 24px;
  }

  .success h2 {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .prep {
    margin: 28px 0;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--bg);
  }

  /* Navigation */
  .b-nav {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .b-nav [data-next] {
    margin-left: auto;
  }

  .btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
  }

  /* Summary */
  .summary {
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }

  .sum-card {
    padding: 24px;
    border-radius: var(--radius);
    background: var(--paper);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .sum-title {
    font-size: 1.7rem;
    margin-bottom: 14px;
  }

  .sum-list {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
  }

  .sum-list :global(li) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px dashed var(--line-strong);
    font-size: 0.94rem;
  }

  .sum-list :global(.sum-empty) {
    color: var(--muted);
    border: 0;
  }

  .sum-when {
    display: flex;
    gap: 8px;
    align-items: center;
    font-weight: 600;
    font-size: 0.92rem;
    padding: 10px 12px;
    border-radius: 10px;
    background: var(--linen);
  }

  .sum-when[hidden] {
    display: none;
  }

  .sum-totals {
    display: grid;
    gap: 6px;
    margin-top: 12px;
