---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import imgHeroF from '../assets/shoot/cd-bein.jpg';
import imgHeroM from '../assets/shoot/geraet-2.jpg';
import imgConsult from '../assets/shoot/beratung-haende.jpg';
import { site, promo } from '../data/site';
import { booking } from '../data/booking';
import { googleRating } from '../data/reviews';
import { services, firstVisit, byRegion, chf, duration, type Group } from '../data/services';

const rating = googleRating.rating.toFixed(1).replace('.', ',');
// Topseller & Kombis, teuerste zuerst – mit Ersparnis gegenüber den Einzelzonen.
// Kombis mit festen Zonen: exakter Vergleich. Ganzkörper (3 Zonen deiner Wahl): Beispielrechnung.
const bundles: Record<string, { parts: string[]; example?: boolean }> = {
  'kombi-intim-achseln': { parts: ['bikini-intim', 'achseln'] },
  'beine-komplett': { parts: ['unterschenkel', 'oberschenkel'] },
  'brust-bauch': { parts: ['brust', 'bauch-1'] },
  ganzkoerper: { parts: ['beine-komplett', 'bikini-intim', 'achseln'], example: true },
  'ganzkoerper-halbes-bein': { parts: ['unterschenkel', 'bikini-intim', 'achseln'], example: true },
  'ganzkoerper-1': { parts: ['beine', 'ruecken-inkl-nacken', 'brust'], example: true },
};
const byIdS = (id: string) => services.find((s) => s.id === id);
// Einzelpreis wie in der Buchung: klassische Paare zählen automatisch zum Kombipreis
const pairs = [
  { pair: ['unterschenkel', 'oberschenkel'], into: 'beine-komplett' },
  { pair: ['bikini-intim', 'achseln'], into: 'kombi-intim-achseln' },
  { pair: ['brust', 'bauch-1'], into: 'brust-bauch' },
];
const bestSum = (ids: string[], skip: string) => {
  const left = new Set(ids);
  let total = 0;
  for (const m of pairs) {
    if (m.into === skip || !m.pair.every((x) => left.has(x))) continue;
    m.pair.forEach((x) => left.delete(x));
    total += byIdS(m.into)?.price ?? 0;
  }
  return total + [...left].reduce((a, x) => a + (byIdS(x)?.price ?? 0), 0);
};
const instead = (id: string) => (bundles[id] ? bestSum(bundles[id].parts, id) : 0);
const exampleText = (id: string) => (bundles[id]?.example ? `z. B. ${bundles[id].parts.map((x) => byIdS(x)?.name).join(' + ')}` : '');
const heroImg = { frauen: imgHeroF, maenner: imgHeroM };

// Ganzkörper-Pakete: 3 Zonen deiner Wahl zum Paketpreis, jede weitere Zone mit Aufpreis.
// Voreinstellung = klassische Kombination. Ist die Auswahl einzeln günstiger, wird einzeln berechnet.
const packages = [
  { id: 'ganzkoerper', group: 'frauen', name: 'Ganzkörper', price: 179, minutes: 75, extra: 10, extraMinutes: 0, legs: 'full', preset: ['beine-komplett', 'bikini-intim', 'achseln'] },
  { id: 'ganzkoerper-halbes-bein', group: 'frauen', name: 'Ganzkörper halbes Bein', price: 169, minutes: 60, extra: 10, extraMinutes: 0, legs: 'half', preset: ['unterschenkel', 'bikini-intim', 'achseln'] },
  { id: 'ganzkoerper-1', group: 'maenner', name: 'Ganzkörper', price: 249, minutes: 120, extra: 15, extraMinutes: 25, legs: 'any', preset: ['beine', 'ruecken-inkl-nacken', 'brust'] },
];
const pkgIds = new Set([...packages.map((x) => x.id), 'jede-weitere-zone-2']);
const zoneRegions = (g: Group) =>
  byRegion(g)
    .map(([r, list]) => [r, list.filter((x) => !pkgIds.has(x.id))] as const)
    .filter(([, list]) => list.length);
const quick = (g: Group) => services.filter((s) => s.group === g && s.tag).sort((a, b) => (b.price ?? 0) - (a.price ?? 0));
const groups: { id: Group; label: string }[] = [
  { id: 'frauen', label: 'Frauen' },
  { id: 'maenner', label: 'Männer' },
];

const data = {
  services: [...firstVisit, ...services].map((s) => ({
    id: s.id,
    name: s.name,
    group: s.group,
    minutes: s.minutes,
    price: s.price,
    priceLabel: s.priceLabel ?? null,
    was: s.was ?? null,
    tag: s.tag ?? null,
    single: !!s.single,
    requires: s.requires ?? [],
    note: s.note ?? '',
  })),
  opening: site.openingSpec,
  packages,
  promo,
  cancellationHours: site.cancellationHours,
  booking: { api: booking.api, timeZone: booking.timeZone, windowDays: booking.windowDays, slotStep: booking.slotStep, durations: booking.durations, staff: booking.staff },
  contact: { whatsapp: site.whatsappHref, phone: site.phone, phoneHref: site.phoneHref, address: `${site.address.street}, ${site.address.zip} ${site.address.city}` },
};
---

<Base headerTone="light" announce={false}
  title="Termin buchen | Eloure The Studio Amriswil"
  description="Buche deine Laserhaarentfernung bei Eloure in Amriswil online – in wenigen Schritten. Bezahlt wird erst vor Ort."
  variant="minimal"
  noindex
  mobileBar={false}
  ctaHref={site.phoneHref}
  ctaLabel={`Fragen? ${site.phone}`}
>
  <section class="booking" data-booking>
    <div class="b-top wrap">
      <h1>Termin buchen</h1>
      <p class="b-trust">
        <span><span class="stars" aria-hidden="true">★★★★★</span> {rating} aus {googleRating.count} Bewertungen</span>
        <span>Bezahlt wird vor Ort</span>
        <span>Kostenlos absagen bis {site.cancellationHours} Std. vorher</span>
      </p>
    </div>

    <!-- Fortschritt: bleibt oben stehen, zeigt immer, was zu tun ist -->
    <div class="b-steps" data-steps-bar>
      <div class="wrap b-steps-in">
        <ol class="stepper" aria-label="Fortschritt">
          <li data-stepper="1" class="is-current">Behandlung</li>
          <li data-stepper="2">Termin</li>
          <li data-stepper="3">Angaben</li>
          <li data-stepper="4">Bestätigen</li>
        </ol>
        <p class="b-todo" data-todo aria-live="polite"></p>
      </div>
      <span class="b-progress" data-progress aria-hidden="true"></span>
    </div>

    <div class="wrap">
      <div class="b-grid">
        <div class="b-main">
          <!-- ——— Schritt 1: Behandlung ——— -->
          <div class="step" data-step="1">
            <h2 class="sr-only">Zonen wählen</h2>
            <!-- zuerst: für wen? -->
            <div class="who" data-who>
              {
                groups.map((g) => (
                  <button type="button" class:list={['who-tile', `who-${g.id}`]} data-who-pick={g.id}>
                    <span class="who-name">{g.label}</span>
                    <span class="who-go" aria-hidden="true">Angebote ansehen</span>
                  </button>
                ))
              }
            </div>
            <div class="seg" role="radiogroup" aria-label="Behandlung für" data-seg hidden>
              {
                groups.map((g) => (
                  <label>
                    <input type="radio" name="gruppe" value={g.id} data-group-input />
                    <span>{g.label}</span>
                  </label>
                ))
              }
            </div>

            {
              groups.map((g, gi) => (
                <div class="group-panel" data-group-panel={g.id} hidden>
                  <div class="quick">
                    {quick(g.id).map((s, i) => {
                      const was = instead(s.id);
                      const save = was - (s.price ?? 0);
                      return (
                        <button
                          type="button"
                          class:list={['qk', { 'qk-hero': i === 0, 'qk-kombi': s.tag === 'Kombi' }]}
                          data-quick={pkgIds.has(s.id) ? undefined : s.id}
                          data-pkg={pkgIds.has(s.id) ? s.id : undefined}
                          aria-pressed="false"
                        >
                          {i === 0 && (
                            <span class="qk-img" aria-hidden="true">
                              <Image src={heroImg[g.id]} alt="" widths={[400, 700]} sizes="(min-width: 1000px) 22vw, 90vw" />
                            </span>
                          )}
                          <span class="qk-body">
                            <span class="qk-top">
                              <span class="qk-badge">{s.tag}</span>
                              {save > 0 && <span class="qk-save">– {chf(save)}</span>}
                            </span>
                            <span class="qk-name">{s.name}</span>
                            <span class="qk-meta">
                              {duration(s.minutes)}
                              {s.note && <> · {s.note}</>}
                            </span>
                            <span class="qk-price">
                              {chf(s.price)}
                              {save > 0 && <s class="qk-was">einzeln {chf(was)}</s>}
                            </span>
                            {exampleText(s.id) && <span class="qk-ex">{exampleText(s.id)}</span>}
                            {pkgIds.has(s.id) && <span class="qk-inc" data-pkg-inc={s.id} hidden />}
                          </span>
                          <span class="qk-check" aria-hidden="true"><Icon name="check" size={14} /></span>
                        </button>
                      );
                    })}
                  </div>

                  <!-- Ganzkörper: Zonen im Overlay-Fenster wählen -->
                  <dialog class="pick" data-pkg-pick aria-label="Ganzkörper: Zonen wählen"></dialog>

                  <!-- Erstbesuch: Glas-Karte über Foto -->
                  <div class="first-visit" id={`erstbesuch-${g.id}`} data-first-visit>
                    <Image class="fv-bg" src={imgConsult} alt="" widths={[800, 1400]} sizes="(min-width: 1000px) 60vw, 100vw" />
                    <div class="fv-glass">
                      <p class="fv-title">Noch unsicher?</p>
                      <p class="fv-sub">Lern uns zuerst kostenlos kennen – beraten wirst du bei jedem ersten Termin ohnehin.</p>
                      <div class="fv-grid">
                        {firstVisit
                          .filter((s) => g.id === 'frauen' || s.id === 'beratungsgespraech')
                          .map((s) => (
                            <label class="fv-card">
                              <input type="checkbox" value={s.id} data-service />
                              <span class="fv-body">
                                <strong>{s.name}</strong>
                                <span class="fv-meta">
                                  {duration(s.minutes)} · {s.was && <s>{chf(s.was)}</s>} {s.price === null ? 'kostenlos' : chf(s.price)}
                                  {s.was && <em class="fv-deal">Neukunden –50 %</em>}
                                </span>
                              </span>
                              <span class="tick" aria-hidden="true">
                                <Icon name="check" size={14} />
                              </span>
                            </label>
                          ))}
                      </div>
                    </div>
                  </div>

                  <div class="zones">
                    {zoneRegions(g.id).map(([region, list]) => (
                      <fieldset class="region">
                        <legend>{region}</legend>
                        {list.map((s) => (
                          <label class="opt" data-opt={s.id}>
                            <input type="checkbox" value={s.id} data-service />
                            <span class="box" aria-hidden="true">
                              <Icon name="check" size={13} />
                            </span>
                            <span class="o-name">
                              <span>
                                {s.name}
                                {s.tag && <em class:list={['o-tag', s.tag === 'Kombi' ? 'o-k' : 'o-t']}>{s.tag}</em>}
                              </span>
                              <small>
                                {duration(s.minutes)}
                                {s.note && <> · {s.note}</>}
                              </small>
                            </span>
                            <span class="o-price">{chf(s.price)}</span>
                          </label>
                        ))}
                      </fieldset>
                    ))}
                  </div>

                  <!-- Ganzkörper: Ersparnis bzw. Hinweis, wenn sich ein Paket lohnt (klebt beim Auswählen unten) -->
                  <div class="pkg-box" data-pkg-box hidden aria-live="polite"></div>
                </div>
              ))
            }

            <label class="zones-note" hidden data-zones-note>
              Welche 3 Zonen wünschst du dir für deine Ganzkörperbehandlung? <span class="opt-t">(optional – klären wir
              auch gerne vor Ort)</span>
              <textarea rows="2" name="zonen" placeholder="z. B. Achseln, Intim, Beine komplett"></textarea>
            </label>
          </div>

          <!-- ——— Schritt 2: Termin ——— -->
          <div class="step" data-step="2" hidden>
            <div class="step-head">
              <h2>Wann passt es dir?</h2>
              <p class="muted">
                Mo–Fr 10–20 Uhr, Sa 10–16 Uhr. Absagen oder verschieben ist bis {site.cancellationHours} Std. vorher kostenlos.
              </p>
            </div>
            <div class="cal-wrap">
              <div class="cal">
                <div class="cal-top">
                  <button type="button" class="cal-nav" data-cal-prev aria-label="Vorheriger Monat"><Icon name="arrow" size={18} class="flip" /></button>
                  <strong data-cal-title></strong>
                  <button type="button" class="cal-nav" data-cal-next aria-label="Nächster Monat"><Icon name="arrow" size={18} /></button>
                </div>
                <div class="cal-dow" aria-hidden="true"><span>Mo</span><span>Di</span><span>Mi</span><span>Do</span><span>Fr</span><span>Sa</span><span>So</span></div>
                <div class="cal-days" data-cal-days role="grid"></div>
              </div>
              <div class="slots" data-slots>
                <p class="muted slots-empty">Wähle zuerst einen Tag aus.</p>
              </div>
            </div>
          </div>

          <!-- ——— Schritt 3: Angaben ——— -->
          <form class="step form" data-step="3" hidden data-details novalidate>
            <div class="step-head">
              <h2>Deine Angaben</h2>
              <p class="muted">Wir nutzen deine Angaben nur für deinen Termin – versprochen.</p>
            </div>
            <div class="row2">
              <label>Vorname<input name="vorname" autocomplete="given-name" required /></label>
              <label>Nachname<input name="nachname" autocomplete="family-name" required /></label>
            </div>
            <div class="row2">
              <label>E-Mail<input type="email" name="email" autocomplete="email" required /></label>
              <label>Mobilnummer<input type="tel" name="telefon" autocomplete="tel" required placeholder="079 123 45 67" /></label>
            </div>
            <fieldset class="newbie">
              <legend>Warst du schon einmal bei uns?</legend>
              <div class="seg small">
                <label><input type="radio" name="neukunde" value="ja" required /><span>Nein, das ist mein erster Besuch</span></label>
                <label><input type="radio" name="neukunde" value="nein" /><span>Ja, ich war schon da</span></label>
              </div>
            </fieldset>
            <label>
              Möchtest du uns noch etwas sagen? <span class="opt-t">(optional)</span>
              <textarea name="nachricht" rows="3" placeholder="z. B. Fragen oder Wünsche zum Termin"></textarea>
            </label>
            <label class="consent">
              <input type="checkbox" name="agb" required />
              <span>
                Ich akzeptiere die <a href="/agb" target="_blank">AGB</a>{' und die '}<a href="/datenschutz" target="_blank">Datenschutzerklärung</a>.{' '}Falls ich nicht kann, sage ich mindestens {site.cancellationHours} Std. vorher ab.
              </span>
            </label>
            <p class="form-error" data-form-error hidden>Bitte fülle alle Pflichtfelder aus.</p>
          </form>

          <!-- ——— Schritt 4: Bestätigen ——— -->
          <div class="step" data-step="4" hidden>
            <div class="step-head">
              <h2>Alles richtig so?</h2>
              <p class="muted">Prüfe kurz deine Angaben. Bezahlt wird erst vor Ort, nach deinem Termin.</p>
            </div>
            <dl class="review" data-review></dl>

            <div class="code">
              <label for="code-input">Gutscheincode</label>
              <div class="code-row">
                <input id="code-input" data-code-input autocomplete="off"  />
                <button type="button" class="btn btn-ghost" data-code-apply>Einlösen</button>
              </div>
              <p class="code-msg" data-code-msg aria-live="polite"></p>
            </div>
            <p class="form-error" data-submit-error hidden aria-live="assertive"></p>
          </div>

          <!-- ——— Erfolg ——— -->
          <div class="step success" data-step="5" hidden>
            <span class="ok-icon"><Icon name="check" size={30} /></span>
            <h2 data-success-title>Danke! Deine Anfrage ist bei uns.</h2>
            <p class="lead" data-success-text></p>
            <div class="add-cal" data-add-cal hidden>
              <span class="add-cal-label">In deinen Kalender eintragen</span>
              <div class="add-cal-btns">
                <a class="add-cal-btn" data-cal-apple download="eloure-termin.ics">Apple Kalender</a>
                <a class="add-cal-btn" data-cal-google target="_blank" rel="noopener">Google Kalender</a>
                <a class="add-cal-btn" data-cal-outlook target="_blank" rel="noopener">Outlook</a>
              </div>
            </div>
            <div class="manage" data-manage hidden>
              <span class="add-cal-label">Termin ändern</span>
              <div class="add-cal-btns">
                <a class="add-cal-btn" data-manage-reschedule target="_blank" rel="noopener">Termin verschieben</a>
                <a class="add-cal-btn" data-manage-cancel target="_blank" rel="noopener">Termin stornieren</a>
              </div>
            </div>
            <div class="prep">
              <h3>So bereitest du dich vor</h3>
              <ul class="check-list">
                <li>24–48 Std. vorher die Zone rasieren – leichte Stoppeln sind perfekt</li>
                <li>4 Wochen vorher nicht mehr wachsen, zupfen oder epilieren</li>
                <li>14 Tage vorher keine direkte Sonne und keine frische Bräune</li>
                <li>Nimmst du Medikamente? Sag uns kurz Bescheid</li>
              </ul>
            </div>
            <div class="btn-row">
              <a class="btn btn-primary" href="/">Zur Startseite</a>
              <a class="text-link" href="/laserhaarentfernung#vorbereitung">Alle Tipps zur Vorbereitung</a>
            </div>
          </div>

          <div class="b-nav" data-nav>
            <button type="button" class="b-back" data-back hidden>Zurück</button>
            <p class="b-hint" data-hint></p>
            <button type="button" class="btn btn-primary" data-next disabled>
              <span data-next-label>Weiter</span>
            </button>
          </div>
        </div>

        <!-- ——— Zusammenfassung ——— -->
        <aside class="summary" data-summary aria-label="Deine Auswahl">
          <div class="sum-card">
            <h2 class="sum-title">Deine Auswahl</h2>
            <ul class="sum-list" data-sum-list>
              <li class="sum-empty">Noch nichts ausgewählt.</li>
            </ul>
            <p class="sum-when" data-sum-when hidden><Icon name="calendar" size={16} /> <span></span></p>
            <div class="sum-totals">
              <div><span>Dauer</span><span data-sum-duration>–</span></div>
              <div class="sum-discount" data-sum-discount hidden><span data-sum-discount-label></span><span data-sum-discount-value></span></div>
              <div class="sum-total"><span>Total</span><span data-sum-total>CHF 0</span></div>
            </div>
            <button type="button" class="btn btn-primary btn-block sum-cta" data-next-sum disabled>
              <span data-sum-cta-label>Weiter</span>
            </button>
            <p class="sum-hint" data-sum-hint></p>
            <ul class="sum-trust">
              <li>Bezahlt wird vor Ort – bar, TWINT oder Karte</li>
              <li>Kostenlos absagen bis {site.cancellationHours} Std. vorher</li>
              <li>Persönliche Beratung inklusive</li>
            </ul>
          </div>
          <p class="sum-help">
            Fragen? <a href={site.whatsappHref} target="_blank" rel="noopener">WhatsApp</a> oder <a href={site.phoneHref}>{site.phone}</a>
          </p>
        </aside>
      </div>
    </div>

    <!-- Mobile Summary Bar -->
    <div class="m-sum" data-m-sum>
      <div class="m-sum-info">
        <strong data-m-total>CHF 0</strong>
        <small data-m-count>Keine Auswahl</small>
      </div>
      <button type="button" class="btn btn-primary" data-m-next disabled>
        <span data-m-next-label>Weiter</span>
      </button>
    </div>
  </section>

  <script type="application/json" id="booking-data" set:html={JSON.stringify(data)} />
</Base>

<style>
  /* ——— Buchung im Eloure-Stil: hell, Linien, feine Grossbuchstaben, ein klarer nächster Schritt ——— */
  .booking {
    padding-bottom: 140px;
    --sel: rgba(62, 92, 124, 0.07);
  }

  .booking :global(h2),
  .booking :global(h3) {
    font-family: var(--sans);
    font-style: normal;
  }

  /* Kopf */
  .b-top {
    padding-block: clamp(40px, 5vw, 72px) clamp(24px, 3vw, 36px);
    text-align: center;
  }

  .b-top h1 {
    margin: 0 0 16px;
    font-weight: 200;
    font-size: clamp(2.4rem, 4.6vw, 4.4rem);
    letter-spacing: 0.01em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
  }

  .b-trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 28px;
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .stars {
    margin-right: 6px;
    letter-spacing: 2px;
    color: var(--cta);
  }

  /* Fortschritt – klebt oben */
  .b-steps {
    position: sticky;
    isolation: isolate;
    top: 0;
    z-index: 30;
    margin-bottom: clamp(32px, 4vw, 56px);
    background: rgba(236, 235, 230, 0.94);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-block: 1px solid var(--line);
  }

  .b-steps-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 32px;
    min-height: 60px;
  }

  .b-progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 2px;
    width: var(--p, 25%);
    background: var(--cta);
    transition: width 0.7s var(--ease);
  }

  .stepper {
    list-style: none;
    display: flex;
    gap: clamp(14px, 3vw, 40px);
    margin: 0;
    padding: 0;
    counter-reset: st;
  }

  .stepper li {
    position: relative;
    padding: 20px 0 18px;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .stepper li::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: transparent;
  }

  .stepper .is-done {
    color: var(--ink-2);
  }

  .stepper .is-current {
    color: var(--ink);
  }

  .stepper .is-current::after {
    background: transparent;
  }

  .b-todo {
    margin: 0;
    font-size: 0.98rem;
    color: var(--cta);
  }

  .b-todo:empty {
    display: none;
  }

  /* Raster */
  .b-grid {
    display: grid;
    gap: 40px;
    align-items: start;
  }

  @media (min-width: 1000px) {
    .b-grid {
      grid-template-columns: 1fr 340px;
      gap: clamp(48px, 5vw, 88px);
    }
  }

  .step[hidden] {
    display: none;
  }

  .step {
    scroll-margin-top: 90px;
  }

  .step-head {
    margin-bottom: 32px;
  }

  .step-head h2 {
    margin: 0 0 10px;
    font-weight: 200;
    font-size: clamp(2rem, 3.4vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .step-head p {
    margin: 0;
    font-size: 1.05rem;
    color: var(--ink-2);
  }

  /* Zuerst: für wen? */
  .who {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .who[hidden],
  .seg[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .who-tile {
      min-height: 170px;
      padding: 18px;
    }
    .who-name {
      font-size: 1.5rem;
      letter-spacing: 0.01em;
    }
    .who-go {
      font-size: 0.68rem;
      letter-spacing: 0.14em;
    }
  }

  .who-tile {
    min-width: 0;
    display: grid;
    align-content: end;
    gap: 14px;
    min-height: clamp(220px, 26vw, 340px);
    padding: clamp(24px, 3vw, 40px);
    border: 0;
    font: inherit;
    text-align: left;
    color: var(--ink);
    cursor: pointer;
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }

  .who-frauen {
    background: var(--frost);
  }

  .who-maenner {
    background: var(--veil);
  }

  .who-tile:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 44px -30px rgba(40, 50, 62, 0.55);
  }

  .who-tile:focus-visible {
    outline: 2px solid var(--cta);
    outline-offset: 3px;
  }

  .who-name {
    font-weight: 200;
    font-size: clamp(2.6rem, 5vw, 4.4rem);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .who-go {
    justify-self: start;
    padding-bottom: 5px;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    border-bottom: 1px solid currentColor;
  }

  /* Ganzkörper: Zonenwahl als Overlay-Fenster */
  .pick {
    width: min(880px, calc(100vw - 32px));
    max-height: calc(100dvh - 48px);
    margin: auto;
    padding: clamp(24px, 3.4vw, 48px);
    border: 0;
    background: var(--bg);
    color: var(--ink);
    overflow: auto;
    box-shadow: 0 40px 80px -40px rgba(20, 28, 38, 0.6);
  }

  .pick::backdrop {
    background: rgba(48, 56, 64, 0.78);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .pick[open] {
    animation: pick-in 0.35s var(--ease);
  }

  @keyframes pick-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .pick :global(.pick-x) {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .pick :global(.pick-x span),
  .pick :global(.pick-x span::after) {
    position: absolute;
    left: 12px;
    top: 21px;
    width: 20px;
    height: 1px;
    background: var(--ink);
    transform: rotate(45deg);
  }

  .pick :global(.pick-x span::after) {
    content: '';
    left: 0;
    top: 0;
    transform: rotate(90deg);
  }

  .pick :global(.pick-foot) {
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--line-strong);
  }

  .pick :global(.pick-actions) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 14px 24px;
    margin-top: 16px;
  }

  .pick :global(.pick-remove) {
    padding: 0 0 4px;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    background: none;
    font: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
    cursor: pointer;
  }

  @media (max-width: 640px) {
    .pick {
      width: 100vw;
      max-width: 100vw;
      height: 100dvh;
      max-height: 100dvh;
      padding: 56px 18px 0;
    }
    .pick :global(.pick-foot) {
      position: sticky;
      bottom: 0;
      margin-inline: -18px;
      padding: 14px 18px calc(14px + env(safe-area-inset-bottom));
      background: var(--bg);
    }
    .pick :global(.pick-actions) {
      margin-top: 10px;
      justify-content: space-between;
    }
  }

  .pick :global(.pick-head) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 20px;
    margin-bottom: 18px;
  }

  .pick :global(.pick-t) {
    margin: 0;
    font-weight: 300;
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .pick :global(.pick-r) {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-2);
  }

  .pick :global(.pick-l) {
    display: flex;
    justify-content: space-between;
    margin: 16px 0 10px;
    font-size: 0.76rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .pick :global(.pick-l span) {
    letter-spacing: 0.08em;
    text-transform: none;
    color: var(--cta);
  }

  .pick :global(.chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pick :global(.chip) {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding: 10px 14px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    font: inherit;
    font-size: 0.95rem;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }

  .pick :global(.chip small) {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .pick :global(.chip:hover) {
    border-color: var(--ink-2);
  }

  .pick :global(.chip[aria-pressed='true']) {
    background: var(--cta);
    border-color: var(--cta);
    color: #fff;
  }

  .pick :global(.chip[aria-pressed='true'] small) {
    color: rgba(255, 255, 255, 0.8);
  }

  .pick :global(.pick-status) {
    margin: 0;
    font-size: 1rem;
    color: var(--ink);
  }

  .pick :global(.pick-status b) {
    font-weight: 500;
    font-size: 1.15rem;
  }

  .pick :global(.pick-status s) {
    color: var(--muted);
  }

  .pick :global(.pick-save) {
    margin-left: 6px;
    padding: 3px 8px;
    font-size: 0.82rem;
    background: var(--cta);
    color: #fff;
  }

  /* Ganzkörper-Hinweis (klebt beim Auswählen unten) */
  .pkg-box {
    position: sticky;
    bottom: 16px;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 4px 20px;
    margin-top: 8px;
    padding: 18px 22px;
    background: var(--cta);
    color: #fff;
    box-shadow: 0 18px 40px -24px rgba(30, 44, 60, 0.7);
  }

  .pkg-box[hidden] {
    display: none;
  }

  .pkg-box :global(.pkg-t) {
    grid-column: 1;
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pkg-box :global(.pkg-x) {
    grid-column: 1;
    margin: 0;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.88);
  }

  .pkg-box :global(.pkg-x b) {
    font-weight: 500;
    color: #fff;
  }

  .pkg-box :global(.pkg-save) {
    margin-left: 8px;
    padding: 2px 8px;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    background: #fff;
    color: var(--cta);
  }

  .pkg-box :global(.pkg-btn) {
    grid-column: 2;
    grid-row: 1 / 3;
    padding: 14px 20px;
    border: 1px solid #fff;
    background: #fff;
    font: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cta);
    cursor: pointer;
  }

  .pkg-box :global(.pkg-btn:hover) {
    background: transparent;
    color: #fff;
  }

  @media (max-width: 999px) {
    .pkg-box {
      bottom: calc(84px + env(safe-area-inset-bottom));
    }
  }

  @media (max-width: 560px) {
    .pkg-box {
      gap: 2px 12px;
      padding: 12px 14px;
    }
    .pkg-box :global(.pkg-t) {
      font-size: 0.86rem;
      letter-spacing: 0.05em;
    }
    .pkg-box :global(.pkg-x) {
      font-size: 0.84rem;
    }
    .pkg-box :global(.pkg-btn) {
      padding: 10px 12px;
      font-size: 0.68rem;
      letter-spacing: 0.1em;
    }
  }

  /* Frauen / Männer */
  .seg {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 32px;
    margin-bottom: 40px;
  }

  .seg label {
    position: relative;
  }

  .seg input {
    position: absolute;
    opacity: 0;
    inset: 0;
  }

  .seg span {
    display: block;
    padding: 4px 0 8px;
    font-weight: 300;
    font-size: clamp(1.2rem, 1.6vw, 1.5rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid transparent;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }

  .seg input:checked + span {
    color: var(--ink);
    border-color: var(--ink);
  }

  .seg input:focus-visible + span {
    outline: 2px solid var(--cta);
    outline-offset: 4px;
  }

  .seg.small {
    gap: 10px;
    margin: 0;
  }

  .seg.small span {
    padding: 12px 18px;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-transform: none;
    font-weight: 400;
    border: 1px solid var(--line-strong);
  }

  .seg.small input:checked + span {
    border-color: var(--cta);
    background: var(--sel);
  }

  /* Topseller & Kombis */
  .quick {
    display: grid;
    gap: 12px;
    margin-bottom: 16px;
  }

  @media (min-width: 640px) {
    .quick {
      grid-template-columns: repeat(2, 1fr);
    }
    .qk-hero {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1600px) {
    .quick {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .qk {
    position: relative;
    display: grid;
    text-align: left;
    font: inherit;
    color: var(--ink);
    padding: 0;
    border: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.4);
    cursor: pointer;
    overflow: hidden;
    transition:
      border-color 0.25s,
      background 0.25s,
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }

  .qk:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 36px -24px rgba(40, 50, 62, 0.45);
    border-color: var(--ink-2);
  }

  .qk-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-content: end;
    gap: 6px 16px;
    padding: 22px 22px 20px;
  }

  .qk-top {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
    padding-right: 34px;
  }

  .qk-badge {
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--cta);
  }

  .qk-save {
    padding: 4px 9px;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: #fff;
    background: var(--cta);
  }

  .qk-name {
    grid-column: 1;
    font-weight: 300;
    font-size: clamp(1.25rem, 1.7vw, 1.55rem);
    line-height: 1.15;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .qk-meta {
    grid-column: 1;
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  .qk-price {
    grid-column: 2;
    grid-row: 2 / 4;
    align-self: end;
    display: grid;
    justify-items: end;
    gap: 2px;
    font-size: 1.35rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .qk-was {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .qk-inc {
    grid-column: 1 / -1;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid rgba(51, 54, 58, 0.25);
    font-size: 0.9rem;
    color: var(--ink);
  }

  .qk-inc[hidden] {
    display: none;
  }

  .qk.is-on .qk-ex {
    display: none;
  }

  .qk :global(.qk-edit) {
    margin-left: 8px;
    padding-bottom: 2px;
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cta);
    border-bottom: 1px solid currentColor;
  }

  .qk-ex {
    grid-column: 1 / -1;
    margin-top: 8px;
    font-size: 0.84rem;
    color: var(--ink-2);
  }

  /* Kombis farbig */
  .qk-kombi {
    background: var(--veil);
    border-color: var(--veil);
  }

  /* grösste Karte mit Bild (Pinterest-Kachel) */
  .qk-hero {
    border: 0;
    background: var(--frost);
    --ink-2: #33363a;
    --muted: #3f4246;
  }

  .qk-hero .qk-body {
    padding: clamp(26px, 3vw, 40px);
  }

  .qk-hero .qk-badge {
    color: #243a51;
  }

  .qk-hero .qk-name {
    font-weight: 200;
    font-size: clamp(2rem, 3.4vw, 3rem);
    letter-spacing: 0.03em;
  }

  .qk-hero .qk-price {
    font-size: 1.7rem;
  }

  .qk-img {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .qk-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(0.92) saturate(0.85);
    transition: transform 1.2s var(--ease);
  }

  .qk-hero:hover .qk-img :global(img) {
    transform: scale(1.04);
  }

  @media (min-width: 640px) {
    .qk-hero {
      grid-template-columns: 0.9fr 1.1fr;
    }
    .qk-img {
      aspect-ratio: auto;
      min-height: 260px;
    }
  }

  .qk-check {
    position: absolute;
    top: 18px;
    right: 18px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.6);
    color: transparent;
  }

  .qk.is-on {
    border-color: var(--cta);
    box-shadow: inset 0 0 0 1px var(--cta);
  }

  .qk.is-on .qk-check {
    background: var(--cta);
    border-color: var(--cta);
    color: #fff;
  }

  .qk:focus-visible {
    outline: 2px solid var(--cta);
    outline-offset: 2px;
  }

  /* Alle Zonen als Linien – auf breiten Bildschirmen zweispaltig */
  .zones {
    margin-top: 48px;
  }

  @media (min-width: 1100px) {
    .zones {
      columns: 2;
      column-gap: clamp(32px, 4vw, 56px);
    }
  }

  .region {
    break-inside: avoid;
    border: 0;
    padding: 0;
    margin: 0 0 36px;
  }

  .region legend {
    margin-bottom: 8px;
    padding: 0;
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .opt {
    position: relative;
    display: grid;
    grid-template-columns: 20px 1fr auto;
    gap: 18px;
    align-items: center;
    padding: 13px 8px;
    border-top: 1px solid var(--line-strong);
    cursor: pointer;
    transition: background 0.2s, opacity 0.2s;
  }

  .opt:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .opt:hover {
    background: rgba(255, 255, 255, 0.35);
  }

  .opt input {
    position: absolute;
    opacity: 0;
  }

  .box {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border: 1px solid var(--line-strong);
    color: transparent;
    transition: background 0.2s;
  }

  .opt:has(input:checked) {
    background: var(--sel);
  }

  .opt:has(input:checked) .box {
    background: var(--cta);
    border-color: var(--cta);
    color: #fff;
  }

  .opt:has(input:focus-visible) {
    outline: 2px solid var(--cta);
    outline-offset: -2px;
  }

  /* Zone steckt im Paket oder in einer Kombi */
  .opt[data-cover] .o-price {
    opacity: 0.45;
  }

  .opt[data-cover]::after {
    content: attr(data-cover);
    position: absolute;
    right: 8px;
    top: 6px;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cta);
  }

  .opt:has(input:disabled) {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .o-name {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-weight: 350;
    font-size: 1.1rem;
    color: var(--ink);
  }

  .o-name small {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .o-tag {
    margin-left: 10px;
    font-style: normal;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    vertical-align: 2px;
    color: var(--cta);
  }

  .o-price {
    font-size: 1.08rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--ink);
  }

  /* Erstbesuch: Glas-Karte über Close-up (zurückhaltend aufgehellt) */
  .first-visit {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 0;
    margin: 16px 0 0;
    padding: clamp(16px, 2.4vw, 32px);
    overflow: hidden;
    background: linear-gradient(120deg, var(--veil) 0%, var(--frost) 100%);
    scroll-margin-top: 100px;
  }

  .first-visit :global(.fv-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
    filter: saturate(0.6) contrast(0.88);
  }

  .first-visit::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(223, 226, 225, 0.5);
  }

  .fv-glass {
    position: relative;
    z-index: 1;
    max-width: 620px;
    padding: clamp(18px, 2.4vw, 28px);
    color: var(--ink);
    background: rgba(255, 255, 255, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.75);
    box-shadow: 0 20px 40px -30px rgba(40, 50, 62, 0.5);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .fv-title {
    margin: 0 0 8px;
    font-weight: 300;
    font-size: clamp(1.3rem, 1.9vw, 1.7rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .fv-sub {
    margin: 0 0 16px;
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .fv-grid {
    display: grid;
    gap: 10px;
  }

  @media (min-width: 640px) {
    .fv-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* gut sichtbare Auswahl-Knöpfe */
  .fv-card {
    position: relative;
    display: flex;
    padding: 16px 48px 16px 18px;
    background: #fff;
    border: 1px solid rgba(69, 71, 75, 0.18);
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .fv-card:hover {
    background: #fff;
  }

  .fv-card input {
    position: absolute;
    opacity: 0;
  }

  .fv-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .fv-body strong {
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.3;
  }

  .fv-meta {
    font-size: 0.88rem;
    color: var(--cta);
  }

  .tick {
    position: absolute;
    right: 14px;
    top: 50%;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1px solid var(--line-strong);
    color: transparent;
    transform: translateY(-50%);
  }

  .fv-card:has(input:checked) {
    background: var(--cta);
    color: #fff;
  }

  .fv-meta s {
    color: var(--muted);
  }

  .fv-deal {
    display: inline-block;
    margin-left: 8px;
    padding: 1px 7px;
