<script>
  type Svc = {
    id: string;
    name: string;
    group: 'frauen' | 'maenner';
    minutes: number;
    price: number | null;
    priceLabel: string | null;
    single: boolean;
    requires: string[];
    note: string;
  };
  type Data = {
    services: Svc[];
    opening: { days: number[]; open: string; close: string }[];
    promo: { code: string; percent: number; label: string };
    cancellationHours: number;
    booking: { api: string; timeZone: string; windowDays: number; slotStep: number; durations: number[]; staff: { id: string; name: string; hostId: string; treatment: string; consult: string }[] };
    contact: { whatsapp: string; phone: string; phoneHref: string };
  };

  const data: Data = JSON.parse(document.getElementById('booking-data')!.textContent!);
  const root = document.querySelector<HTMLElement>('[data-booking]')!;
  const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = root) => el.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = root) => [...el.querySelectorAll<T>(s)];
  const byId = new Map(data.services.map((s) => [s.id, s]));

  const state = {
    step: 1,
    group: 'frauen' as 'frauen' | 'maenner',
    selected: new Set<string>(),
    date: null as Date | null,
    time: null as string | null,
    slot: null as Slot | null,
    code: null as string | null,
    returning: false,
    month: new Date(new Date().getFullYear(), new Date().getMonth(), 1),
  };

  // ——— Hilfsfunktionen ———
  const fmtChf = (v: number) => 'CHF ' + (Number.isInteger(v) ? String(v) : v.toFixed(2));
  const fmtDur = (m: number) => (m < 60 ? `${m} Min.` : `${Math.floor(m / 60)} Std.${m % 60 ? ` ${m % 60} Min.` : ''}`);
  const round05 = (v: number) => Math.round(v / 0.05) * 0.05;
  const toMin = (t: string) => +t.slice(0, 2) * 60 + +t.slice(3, 5);
  const toTime = (m: number) => `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
  const dayKey = (d: Date) => `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const maxDate = new Date(today);
  maxDate.setDate(maxDate.getDate() + data.booking.windowDays);

  const selectedList = () => [...state.selected].map((id) => byId.get(id)!).filter(Boolean);
  const totalMinutes = () => selectedList().reduce((a, s) => a + s.minutes, 0);
  const subtotal = () => selectedList().reduce((a, s) => a + (s.price ?? 0), 0);
  // Rabatt pro Behandlung auf ganze Franken gerundet (identisch mit den Preisen auf der Landingpage)
  const discount = () => {
    if (!state.code || state.returning) return 0;
    return selectedList().reduce((a, s) => a + (s.price ? s.price - Math.round((s.price * (100 - data.promo.percent)) / 100) : 0), 0);
  };

  // ——— Schritt 1: Auswahl ———
  const groupInputs = $$<HTMLInputElement>('[data-group-input]');
  const serviceInputs = $$<HTMLInputElement>('[data-service]');

  function setGroup(g: 'frauen' | 'maenner') {
    if (state.group !== g) state.selected.clear();
    state.group = g;
    groupInputs.forEach((i) => (i.checked = i.value === g));
    $$('[data-group-panel]').forEach((p) => (p.hidden = p.dataset.groupPanel !== g));
    syncChecks();
  }

  function syncChecks() {
    serviceInputs.forEach((i) => {
      i.checked = state.selected.has(i.value);
      const svc = byId.get(i.value);
      if (svc?.requires.length) {
        const ok = svc.requires.some((r) => state.selected.has(r));
        i.disabled = !ok;
        if (!ok) {
          state.selected.delete(svc.id);
          i.checked = false;
        }
      }
    });
    const needsZones = [...state.selected].some((id) => id.startsWith('ganzkoerper'));
    $('[data-zones-note]').hidden = !needsZones;
    render();
  }

  groupInputs.forEach((i) => i.addEventListener('change', () => setGroup(i.value as 'frauen' | 'maenner')));
  serviceInputs.forEach((i) =>
    i.addEventListener('change', () => {
      const svc = byId.get(i.value)!;
      if (i.checked) {
        if (svc.single) state.selected.clear();
        else [...state.selected].forEach((id) => byId.get(id)?.single && state.selected.delete(id));
        state.selected.add(svc.id);
      } else {
        state.selected.delete(svc.id);
      }
      // Zeitslot ggf. neu wählen, wenn sich die Dauer ändert
      state.time = null;
      state.slot = null;
      syncChecks();
    }),
  );

  // ——— Schritt 2: Kalender (freie Zeiten live aus meetergo) ———
  type StaffPick = { id: string; hostId: string; meetingTypeId: string; adj: boolean };
  type Slot = { time: string; iso: string; staff: StaffPick[]; adj: boolean };
  const DURATIONS = [...data.booking.durations].sort((x, y) => x - y);
  const avail = { key: '', status: 'idle' as 'idle' | 'loading' | 'ready' | 'error', days: new Map<string, Slot[]>() };
  let showAll = false;
  let slotNotice = '';

  const ymd = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  const isConsultOnly = () => selectedList().length > 0 && selectedList().every((s) => s.id === 'beratungsgespraech');
  // Dauer der gewählten Zonen → nächstlängerer buchbarer Termintyp
  const bookingLength = () => DURATIONS.find((d) => d >= Math.max(totalMinutes(), 15)) ?? null;
  const typeKey = () => (isConsultOnly() ? 'consult' : String(bookingLength() ?? 'too-long'));
  const contactLinks = () =>
    `<a href="${data.contact.whatsapp}" target="_blank" rel="noopener">WhatsApp</a> oder <a href="${data.contact.phoneHref}">${data.contact.phone}</a>`;

  async function loadAvailability(force = false) {
    const key = typeKey();
    if (!force && avail.key === key && avail.status !== 'error') return renderStep2();
    avail.key = key;
    avail.days = new Map();
    showAll = false;
    if (key === 'too-long') {
      avail.status = 'ready';
      return renderStep2();
    }
    avail.status = 'loading';
    renderStep2();
    const end = new Date(maxDate);
    end.setDate(end.getDate() + 1);
    try {
      const perStaff = await Promise.all(
        data.booking.staff.map(async (st) => {
          const meetingTypeId = key === 'consult' ? st.consult : st.treatment;
          const q = new URLSearchParams({
            meetingTypeId,
            hostIds: st.hostId,
            start: ymd(today),
            end: ymd(end),
            timezone: data.booking.timeZone,
          });
          if (key !== 'consult') q.set('meetingDuration', key);
          const res = await fetch(`${data.booking.api}/booking-availability?${q}`);
          if (!res.ok) throw new Error(`slots ${res.status}`);
          const json = await res.json();
          const days: Record<string, string[]> = {};
          for (const d of (json.dates ?? []) as { date: string; spots: { startTime: string }[] }[]) {
            days[d.date] = (d.spots ?? []).map((x) => x.startTime);
          }
          return { st, meetingTypeId, days };
        }),
      );
      if (avail.key !== key) return; // Auswahl hat sich inzwischen geändert
      const step = data.booking.slotStep;
      const merged = new Map<string, Map<string, Slot>>();
      for (const { st, meetingTypeId, days } of perStaff) {
        for (const [day, list] of Object.entries(days)) {
          const mins = new Set(list.map((x) => toMin(x.slice(11, 16))));
          const byTime = merged.get(day) ?? new Map<string, Slot>();
          for (const iso of list) {
            const t = iso.slice(11, 16);
            const m = toMin(t);
            // Anschlusszeit: direkt nach einem Termin/Öffnungsbeginn oder direkt vor dem nächsten Termin/Feierabend
            const adj = !mins.has(m - step) || !mins.has(m + step);
            const slot = byTime.get(t) ?? { time: t, iso, staff: [], adj: false };
            slot.staff.push({ id: st.id, hostId: st.hostId, meetingTypeId, adj });
            slot.adj = slot.adj || adj;
            byTime.set(t, slot);
          }
          merged.set(day, byTime);
        }
      }
      for (const [day, byTime] of merged) {
        const list = [...byTime.values()].sort((x, y) => toMin(x.time) - toMin(y.time));
        if (list.length) avail.days.set(day, list);
      }
      avail.status = 'ready';
      if (state.date && !avail.days.has(ymd(state.date))) {
        state.date = null;
        state.time = null;
        state.slot = null;
      }
      if (!state.date) {
        const first = [...avail.days.keys()].sort()[0];
        if (first) {
          const [y, mo] = first.split('-').map(Number);
          state.month = new Date(y, mo - 1, 1);
        }
      }
    } catch (e) {
      if (avail.key === key) avail.status = 'error';
    }
    renderStep2();
  }

  function renderStep2() {
    renderCalendar();
    renderSlots();
    render();
  }

  function renderCalendar() {
    const m = state.month;
    $('[data-cal-title]').textContent = m.toLocaleDateString('de-CH', { month: 'long', year: 'numeric' });
    $<HTMLButtonElement>('[data-cal-prev]').disabled = m <= new Date(today.getFullYear(), today.getMonth(), 1);
    $<HTMLButtonElement>('[data-cal-next]').disabled = new Date(m.getFullYear(), m.getMonth() + 1, 1) > maxDate;

    const grid = $('[data-cal-days]');
    grid.classList.toggle('is-loading', avail.status === 'loading');
    grid.innerHTML = '';
    const offset = (new Date(m.getFullYear(), m.getMonth(), 1).getDay() + 6) % 7;
    for (let i = 0; i < offset; i++) grid.append(document.createElement('span'));
    const days = new Date(m.getFullYear(), m.getMonth() + 1, 0).getDate();
    for (let n = 1; n <= days; n++) {
      const d = new Date(m.getFullYear(), m.getMonth(), n);
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = String(n);
      b.setAttribute('aria-label', d.toLocaleDateString('de-CH', { weekday: 'long', day: 'numeric', month: 'long' }));
      const has = avail.status === 'ready' && (avail.days.get(ymd(d))?.length ?? 0) > 0;
      b.disabled = !has;
      if (has) b.classList.add('has-slots');
      if (state.date && d.getTime() === state.date.getTime()) b.setAttribute('aria-pressed', 'true');
      b.addEventListener('click', () => {
        state.date = d;
        state.time = null;
        state.slot = null;
        showAll = false;
        slotNotice = '';
        renderStep2();
      });
      grid.append(b);
    }
  }

  function renderSlots() {
    const box = $('[data-slots]');
    const notice = slotNotice ? `<p class="slot-notice">${slotNotice}</p>` : '';
    if (avail.status === 'loading' || avail.status === 'idle') {
      box.innerHTML = `${notice}<p class="muted slots-empty">Freie Termine werden geladen …</p>`;
      return;
    }
    if (avail.status === 'error') {
      box.innerHTML = `<p class="slots-empty">Die freien Termine konnten gerade nicht geladen werden. Bitte versuch es gleich nochmals – oder melde dich per ${contactLinks()}.</p><button type="button" class="btn btn-ghost" data-retry>Nochmals laden</button>`;
      box.querySelector('[data-retry]')!.addEventListener('click', () => loadAvailability(true));
      return;
    }
    if (avail.key === 'too-long') {
      box.innerHTML = `<p class="slots-empty">Für diese Kombination (${fmtDur(totalMinutes())}) planen wir deinen Termin gerne persönlich mit dir – kurz per ${contactLinks()}.</p>`;
      return;
    }
    if (!avail.days.size) {
      box.innerHTML = `<p class="slots-empty">In den nächsten ${Math.round(data.booking.windowDays / 7)} Wochen ist online leider nichts mehr frei. Melde dich per ${contactLinks()} – wir finden einen Termin.</p>`;
      return;
    }
    if (!state.date) {
      box.innerHTML = `${notice}<p class="muted slots-empty">Wähle einen Tag aus – alle markierten Tage haben freie Termine.</p>`;
      return;
    }
    const all = avail.days.get(ymd(state.date)) ?? [];
    const recommended = all.filter((x) => x.adj);
    const list = showAll ? all : recommended;
    const title = state.date.toLocaleDateString('de-CH', { weekday: 'long', day: 'numeric', month: 'long' });
    const parts: [string, (m: number) => boolean][] = [
      ['Vormittag', (m) => m < 12 * 60],
      ['Nachmittag', (m) => m >= 12 * 60 && m < 17 * 60],
      ['Abend', (m) => m >= 17 * 60],
    ];
    box.innerHTML = `${notice}<h3>${title}</h3>`;
    for (const [label, test] of parts) {
      const group = list.filter((x) => test(toMin(x.time)));
      if (!group.length) continue;
      const g = document.createElement('div');
      g.className = 'slot-group';
      g.innerHTML = `<p class="slot-label">${label}</p><div class="slot-grid"></div>`;
      const grid = g.querySelector('.slot-grid')!;
      group.forEach((x) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = x.time;
        if (state.time === x.time) b.setAttribute('aria-pressed', 'true');
        b.addEventListener('click', () => {
          state.time = x.time;
          state.slot = x;
          slotNotice = '';
          renderSlots();
          render();
        });
        grid.append(b);
      });
      box.append(g);
    }
    const more = all.length - recommended.length;
    if (more > 0) {
      const t = document.createElement('button');
      t.type = 'button';
      t.className = 'slot-more';
      t.textContent = showAll ? 'Nur empfohlene Zeiten zeigen' : `Weitere Uhrzeiten anzeigen (${more})`;
      t.addEventListener('click', () => {
        showAll = !showAll;
        renderSlots();
      });
      box.append(t);
    }
  }

  $('[data-cal-prev]').addEventListener('click', () => {
    state.month = new Date(state.month.getFullYear(), state.month.getMonth() - 1, 1);
    renderCalendar();
  });
  $('[data-cal-next]').addEventListener('click', () => {
    state.month = new Date(state.month.getFullYear(), state.month.getMonth() + 1, 1);
    renderCalendar();
  });

  // ——— Schritt 3: Formular ———
  const form = $<HTMLFormElement>('[data-details]');
  form.addEventListener('input', () => {
    state.returning = (form.elements.namedItem('neukunde') as RadioNodeList).value === 'nein';
    form.querySelectorAll('.is-invalid').forEach((el) => {
      if ((el as HTMLInputElement).checkValidity()) el.classList.remove('is-invalid');
    });
    render();
  });

  function validateForm() {
    let ok = true;
    form.querySelectorAll<HTMLInputElement>('input[required]').forEach((el) => {
      const valid = el.checkValidity();
      if (!valid && el.type !== 'radio') el.classList.add('is-invalid');
      if (!valid) ok = false;
    });
    $('[data-form-error]').hidden = ok;
    return ok;
  }

  // ——— Schritt 4: Code ———
  const codeInput = $<HTMLInputElement>('[data-code-input]');
  const codeMsg = $('[data-code-msg]');

  function applyCode(raw: string, silent = false) {
    const c = raw.trim().toUpperCase();
    codeMsg.className = 'code-msg';
    if (!c) {
      state.code = null;
      codeMsg.textContent = '';
    } else if (c === data.promo.code) {
      state.code = c;
      codeInput.value = c;
      if (state.returning) {
        codeMsg.classList.add('err');
        codeMsg.textContent = `Der Code ${c} gilt nur für deinen ersten Besuch bei uns.`;
      } else {
        codeMsg.classList.add('ok');
        codeMsg.textContent = `Code ${c} eingelöst – ${data.promo.percent} % Neukundenrabatt.`;
      }
    } else if (!silent) {
      state.code = null;
      codeMsg.classList.add('err');
      codeMsg.textContent = 'Dieser Code ist leider nicht gültig.';
    }
    render();
  }

  $('[data-code-apply]').addEventListener('click', () => applyCode(codeInput.value));
  codeInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      applyCode(codeInput.value);
    }
  });

  // ——— Navigation ———
  const canProceed = () => {
    if (state.step === 1) return state.selected.size > 0;
    if (state.step === 2) return !!state.date && !!state.time && !!state.slot;
    if (state.step === 3) return true; // Validierung beim Klick
    if (state.step === 4) return !submitting;
    return false;
  };
  let submitting = false;
  const nextLabel = () => (state.step === 4 ? (submitting ? 'Wird gebucht …' : 'Termin buchen') : 'Weiter');

  function go(step: number) {
    state.step = step;
    $$('[data-step]').forEach((s) => (s.hidden = Number(s.dataset.step) !== step));
    $$('[data-stepper]').forEach((li) => {
      const n = Number(li.dataset.stepper);
      li.classList.toggle('is-current', n === step);
      li.classList.toggle('is-done', n < step);
    });
    $('[data-back]').hidden = step === 1 || step === 5;
    $('[data-nav]').hidden = step === 5;
    $('[data-m-sum]').hidden = step === 5;
    if (step === 2) {
      if (state.date) state.month = new Date(state.date.getFullYear(), state.date.getMonth(), 1);
      loadAvailability();
    }
    if (step === 4) renderReview();
    render();
    root.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function next() {
    if (!canProceed()) return;
    if (state.step === 3 && !validateForm()) return;
    if (state.step === 4) return submit();
    go(state.step + 1);
  }

  $('[data-next]').addEventListener('click', next);
  $('[data-m-next]').addEventListener('click', next);
  $('[data-next-sum]').addEventListener('click', next);
  root.querySelectorAll<HTMLButtonElement>('[data-quick]').forEach((b) =>
    b.addEventListener('click', () => {
      const input = root.querySelector<HTMLInputElement>(`[data-group-panel="${state.group}"] input[data-service][value="${b.dataset.quick}"]`);
      if (!input || input.disabled) return;
      input.checked = !input.checked;
      input.dispatchEvent(new Event('change', { bubbles: true }));
    }),
  );
  $('[data-back]').addEventListener('click', () => go(Math.max(1, state.step - 1)));

  function whenText() {
    if (!state.date || !state.time) return '';
    return `${state.date.toLocaleDateString('de-CH', { weekday: 'short', day: 'numeric', month: 'long' })} · ${state.time} Uhr`;
  }

  function renderReview() {
    const f = new FormData(form);
    const rows: [string, string, number][] = [
      ['Behandlung', selectedList().map((s) => s.name).join(', '), 1],
      ['Termin', whenText(), 2],
      ['Name', `${f.get('vorname')} ${f.get('nachname')}`, 3],
      ['Kontakt', `${f.get('email')} · ${f.get('telefon')}`, 3],
    ];
    const zonenField = $<HTMLTextAreaElement>('textarea[name=zonen]');
    const zonen = zonenField.closest('[hidden]') ? '' : zonenField.value.trim();
    if (zonen) rows.splice(1, 0, ['Zonen', zonen, 1]);
    const msg = String(f.get('nachricht') ?? '').trim();
    if (msg) rows.push(['Nachricht', msg, 3]);
    const dl = $('[data-review]');
    dl.innerHTML = '';
    rows.forEach(([k, v, step]) => {
      const div = document.createElement('div');
      const dt = document.createElement('dt');
      dt.textContent = k;
      const dd = document.createElement('dd');
      dd.textContent = v;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = 'Ändern';
      btn.addEventListener('click', () => go(step));
      div.append(dt, dd, btn);
      dl.append(div);
    });
  }

  // Kurzbezeichnung für den Kalendertitel, z. B. „Achseln + Bikini / Intim · 30 Min.“
  function treatmentTitle() {
    const names = selectedList().map((s) => s.name);
    const len = isConsultOnly() ? 25 : bookingLength() ?? totalMinutes();
    return `${names.join(' + ')} · ${fmtDur(len)}`;
  }

  // Angaben zum Termin – erscheinen im Kalendereintrag und in der Bestätigung der Kundin,
  // deshalb nur neutrale Angaben (keine Gesundheitsdaten).
  function bookingNotes(f: FormData) {
    const list = selectedList();
    const zonenField = $<HTMLTextAreaElement>('textarea[name=zonen]');
    const zonen = zonenField.closest('[hidden]') ? '' : zonenField.value.trim();
    const disc = discount();
    const total = round05(subtotal() - disc);
    const len = isConsultOnly() ? null : bookingLength();
    const msg = String(f.get('nachricht') ?? '').trim();
    const dur = `${fmtDur(totalMinutes())}${len && len !== totalMinutes() ? `, eingeplant ${fmtDur(len)}` : ''}`;
    const notes: Record<string, string> = {
      Behandlung: `${list.map((s) => s.name).join(' + ')} (${dur})`,
    };
    if (zonen) notes['Ganzkörper-Zonen'] = zonen;
    notes.Preis = `${fmtChf(total)} vor Ort${disc > 0 ? ` · Code ${state.code} –${fmtChf(round05(disc))}` : ''}`;
    notes['Erster Besuch'] = state.returning ? 'nein' : 'ja';
    if (msg) notes.Nachricht = msg;
    return notes;
  }

  const submitError = $('[data-submit-error]');
  function showSubmitError(html: string) {
    submitError.innerHTML = html;
    submitError.hidden = false;
  }

  async function submit() {
    if (submitting || !state.slot) return;
    const f = new FormData(form);
    const slot = state.slot;
    const pick = slot.staff.find((x) => x.adj) ?? slot.staff[0];
    const name = `${String(f.get('vorname') ?? '').trim()} ${String(f.get('nachname') ?? '').trim()}`.trim();
    submitError.hidden = true;
    submitting = true;
    render();
    const phone = String(f.get('telefon') ?? '').trim();
    const notes = bookingNotes(f);
    try {
      const body: Record<string, unknown> = {
        meetingTypeId: pick.meetingTypeId,
        hostIds: [pick.hostId],
        start: slot.iso,
        attendee: {
          firstname: String(f.get('vorname') ?? '').trim(),
          lastname: String(f.get('nachname') ?? '').trim(),
          email: String(f.get('email') ?? '').trim(),
          phone,
          language: 'de',
          timezone: data.booking.timeZone,
          receiveReminders: true,
          dataPolicyAccepted: true,
          notes,
        },
        sourceChannel: 'embed',
        referrerUrl: location.href.slice(0, 2048),
        icsTitle: `${name} · ${treatmentTitle()}`.slice(0, 200),
        icsDescription: [`Telefon: ${phone}`, ...Object.entries(notes).map(([k, v]) => `${k}: ${v}`)].join('\n').slice(0, 2000),
      };
      if (!isConsultOnly()) body.duration = bookingLength();
      const post = (b: Record<string, unknown>) =>
        fetch(`${data.booking.api}/booking`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(b),
        });
      let res = await post(body);
      // Falls meetergo eigene Kalendertitel ablehnt: mit dem Standardtitel nochmals buchen
      if (res.status === 400) {
        const peek = JSON.stringify(await res.clone().json().catch(() => ({})));
        if (/ics/i.test(peek)) {
          delete body.icsTitle;
          delete body.icsDescription;
          res = await post(body);
        }
      }
      const json = await res.json().catch(() => ({}));
      if (!res.ok) throw { status: res.status, ...json };

      const first = String(f.get('vorname') ?? '').trim();
      $('[data-success-title]').textContent = `Danke${first ? ', ' + first : ''}! Dein Termin steht.`;
      $('[data-success-text]').textContent = `Wir haben deinen Termin am ${whenText()} fest für dich eingeplant. Du bekommst gleich eine Bestätigung per E-Mail – mit allen Infos und einem Link, falls du verschieben oder absagen musst. ${
        isConsultOnly() ? 'Bring einfach all deine Fragen mit.' : 'Wir freuen uns auf dich!'
      }`;
      go(5);
    } catch (err: any) {
      const raw = err?.message ?? err?.error?.message ?? '';
      const msg = Array.isArray(raw) ? raw.join(' ') : String(raw);
      if (/email/i.test(msg)) {
        showSubmitError('Diese E-Mail-Adresse scheint keine Post empfangen zu können. Bitte prüfe sie <button type="button" class="link-btn" data-fix-mail>hier</button>.');
        submitError.querySelector('[data-fix-mail]')?.addEventListener('click', () => go(3));
      } else if (err?.status === 409 || /avail|slot|booked|conflict|taken|occupied|no_available/i.test(msg)) {
        slotNotice = 'Dieser Termin wurde gerade vergeben. Bitte wähle eine andere Uhrzeit.';
        state.time = null;
        state.slot = null;
        avail.key = '';
        go(2);
      } else {
        showSubmitError(`Das hat leider nicht geklappt. Bitte versuch es nochmals – oder melde dich per ${contactLinks()}.`);
      }
    } finally {
      submitting = false;
      render();
    }
  }

  // ——— Zusammenfassung ———
  function render() {
    const list = selectedList();
    const ul = $('[data-sum-list]');
    ul.innerHTML = '';
    if (!list.length) ul.innerHTML = '<li class="sum-empty">Noch nichts ausgewählt.</li>';
    list.forEach((s) => {
      const li = document.createElement('li');
      li.innerHTML = `<span></span><span>${s.priceLabel ?? (s.price === null ? 'kostenlos' : fmtChf(s.price))}</span>`;
      li.firstElementChild!.textContent = s.name;
      ul.append(li);
    });

    const when = $('[data-sum-when]');
    when.hidden = !whenText();
    when.querySelector('span')!.textContent = whenText();

    $('[data-sum-duration]').textContent = list.length ? fmtDur(totalMinutes()) : '–';
    const disc = discount();
    $('[data-sum-discount]').hidden = disc <= 0;
    $('[data-sum-discount-label]').textContent = `Code ${state.code ?? ''} (–${data.promo.percent} %)`;
    $('[data-sum-discount-value]').textContent = `– ${fmtChf(round05(disc))}`;
    const total = round05(subtotal() - disc);
    $('[data-sum-total]').textContent = fmtChf(total);

    $('[data-m-total]').textContent = list.length ? fmtChf(total) : 'CHF 0';
    $('[data-m-count]').textContent = list.length
      ? `${list.length} ${list.length === 1 ? 'Behandlung' : 'Behandlungen'} · ${fmtDur(totalMinutes())}`
      : 'Keine Auswahl';

    const enabled = canProceed();
    $<HTMLButtonElement>('[data-next]').disabled = !enabled;
    $<HTMLButtonElement>('[data-m-next]').disabled = !enabled;
    $<HTMLButtonElement>('[data-next-sum]').disabled = !enabled;
    $('[data-sum-cta-label]').textContent = nextLabel();
    root.querySelectorAll<HTMLElement>('[data-quick]').forEach((b) => b.classList.toggle('is-on', state.selected.has(b.dataset.quick!)));
    $('[data-next-label]').textContent = nextLabel();
    $('[data-m-next-label]').textContent = nextLabel();
  }

  // ——— Start: URL-Parameter (?behandlung=…&gruppe=…&code=…) ———
  const params = new URLSearchParams(location.search);
  const pre = params.get('behandlung');
  const preSvc = pre ? byId.get(pre) : undefined;
  const preGroup = (params.get('gruppe') as 'frauen' | 'maenner' | null) ?? preSvc?.group ?? 'frauen';
  setGroup(preGroup === 'maenner' ? 'maenner' : 'frauen');
  if (preSvc && (preSvc.group === state.group || preSvc.id === 'beratungsgespraech')) {
    state.selected.add(preSvc.id);
    syncChecks();
    requestAnimationFrame(() => {
      const el = root.querySelector(`[data-group-panel="${state.group}"] input[value="${preSvc.id}"]`);
      el?.closest('label')?.scrollIntoView({ block: 'center' });
    });
  }
  const preCode = params.get('code');
  if (preCode) applyCode(preCode, true);
  render();
</script>
