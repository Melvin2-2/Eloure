<script>
  type Svc = {
    id: string;
    name: string;
    group: 'frauen' | 'maenner';
    minutes: number;
    price: number | null;
    priceLabel: string | null;
    was: number | null;
    tag: string | null;
    single: boolean;
    requires: string[];
    note: string;
  };
  type Pkg = { id: string; group: 'frauen' | 'maenner'; name: string; price: number; minutes: number; extra: number; extraMinutes: number; legs: string; preset: string[] };
  type Line = { id: string; name: string; price: number | null; minutes: number; priceLabel: string | null; single: boolean };
  type Data = {
    services: Svc[];
    opening: { days: number[]; open: string; close: string }[];
    packages: Pkg[];
    promo: { code: string; percent: number; label: string };
    cancellationHours: number;
    booking: { api: string; timeZone: string; windowDays: number; slotStep: number; durations: number[]; staff: { id: string; name: string; hostId: string; treatment: string; consult: string }[] };
    contact: { whatsapp: string; phone: string; phoneHref: string; address: string };
  };

  const data: Data = JSON.parse(document.getElementById('booking-data')!.textContent!);
  const root = document.querySelector<HTMLElement>('[data-booking]')!;
  const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = root) => el.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = root) => [...el.querySelectorAll<T>(s)];
  const byId = new Map(data.services.map((s) => [s.id, s]));

  const state = {
    step: 1,
    group: null as 'frauen' | 'maenner' | null,
    selected: new Set<string>(),
    date: null as Date | null,
    time: null as string | null,
    slot: null as Slot | null,
    code: null as string | null,
    returning: false,
    month: new Date(new Date().getFullYear(), new Date().getMonth(), 1),
  };

  // ——— Hilfsfunktionen ———
  const fmtChf = (v: number) => 'CHF ' + (Number.isInteger(v) ? String(v) : v.toFixed(2));
  const fmtDur = (m: number) => (m < 60 ? `${m} Min.` : `${Math.floor(m / 60)} Std.${m % 60 ? ` ${m % 60} Min.` : ''}`);
  const round05 = (v: number) => Math.round(v / 0.05) * 0.05;
  const toMin = (t: string) => +t.slice(0, 2) * 60 + +t.slice(3, 5);
  const toTime = (m: number) => `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
  const dayKey = (d: Date) => `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const maxDate = new Date(today);
  maxDate.setDate(maxDate.getDate() + data.booking.windowDays);

  // ——— Preise ———
  // Ganzkörper (Frauen) = Beine komplett + 2 Zonen, halbes Bein = Unter- oder Oberschenkel + 2 Zonen,
  // Männer = 3 Zonen; jede weitere Zone mit Aufpreis. Ohne Beine kein Ganzkörper (Frauen).
  // Klassische Paare werden automatisch zum günstigeren Kombipreis zusammengefasst.
  const pkgIdSet = new Set([...data.packages.map((x) => x.id), 'jede-weitere-zone-2']);
  const eligible = (x: Svc) => !x.single && x.tag !== 'Kombi' && !pkgIdSet.has(x.id);
  const LEG_FULL = 'beine-komplett';
  const LEG_HALF = ['unterschenkel', 'oberschenkel'];
  const isLeg = (id: string) => id === LEG_FULL || LEG_HALF.includes(id);
  const MERGES = [
    { pair: ['unterschenkel', 'oberschenkel'], into: 'beine-komplett' },
    { pair: ['bikini-intim', 'achseln'], into: 'kombi-intim-achseln' },
    { pair: ['brust', 'bauch-1'], into: 'brust-bauch' },
  ];
  const asLine = (x: Svc): Line => ({ id: x.id, name: x.name, price: x.price, minutes: x.minutes, priceLabel: x.priceLabel, single: x.single });
  // bester Einzelpreis: Paare automatisch als Kombi
  function bestSingles(list: Svc[]) {
    const ids = new Set(list.map((x) => x.id));
    const lines: Line[] = [];
    const merged: string[] = [];
    for (const m of MERGES) {
      const into = byId.get(m.into);
      if (!into || ids.has(m.into) || !m.pair.every((id) => ids.has(id))) continue;
      const sep = m.pair.reduce((a, id) => a + (byId.get(id)?.price ?? 0), 0);
      if ((into.price ?? 0) < sep) {
        m.pair.forEach((id) => ids.delete(id));
        merged.push(...m.pair);
        lines.push(asLine(into));
      }
    }
    list.forEach((x) => ids.has(x.id) && lines.push(asLine(x)));
    return { lines, merged, sum: lines.reduce((a, l) => a + (l.price ?? 0), 0) };
  }
  const pkgsFor = () => data.packages.filter((x) => x.group === state.group);

  // Kombi-Produkte bestehen aus ihren Zonen: so zählen sie im Ganzkörper-Paket als 2 Zonen
  const EXPANDS: Record<string, string[]> = {
    'kombi-intim-achseln': ['bikini-intim', 'achseln'],
    'brust-bauch': ['brust', 'bauch-1'],
  };
  // Leistungen, die sich ausschliessen (eine enthält die andere): beim Anhaken wird die andere abgewählt
  const CONFLICTS: string[][] = [
    ['oberlippe', 'oberlippe-kinn', 'gesicht'],
    ['beine-komplett', 'unterschenkel'],
    ['beine-komplett', 'oberschenkel'],
    ['bikinilinie', 'bikini-intim'],
    ['ruecken-inkl-nacken', 'nacken'],
    ['arme-komplett', 'oberarme'],
  ];
  function addSvc(id: string) {
    if (EXPANDS[id]) return EXPANDS[id].forEach((x) => addSvc(x));
    // Unter- und Oberschenkel zusammen = Beine komplett
    const other = LEG_HALF.find((x) => x !== id);
    if (LEG_HALF.includes(id) && other && state.selected.has(other)) {
      state.selected.delete(other);
      id = LEG_FULL;
    }
    for (const g of CONFLICTS) if (g.includes(id)) g.forEach((x) => x !== id && state.selected.delete(x));
    state.selected.add(id);
  }
  function pricing() {
    const sel = [...state.selected].map((id) => byId.get(id)!).filter(Boolean);
    const zones = sel.filter(eligible);
    const rest = sel.filter((x) => !eligible(x));
    const single = bestSingles(zones);
    const sum = single.sum;
    const mins = zones.reduce((a, x) => a + x.minutes, 0);
    const n = zones.length;
    let pk: Pkg | undefined;
    if (state.group === 'frauen') {
      const ids = new Set(zones.map((z) => z.id));
      const half = !ids.has(LEG_FULL) && LEG_HALF.some((x) => ids.has(x));
      pk = pkgsFor().find((x) => x.legs === (half ? 'half' : 'full'));
    } else pk = pkgsFor()[0];
    const included = 3;
    const need = Math.max(0, included - n);
    const ok = !!pk && need === 0;
    const pkgPrice = ok ? pk!.price + (n - included) * pk!.extra : 0;
    const save = ok ? sum - pkgPrice : 0;
    // automatisch, sobald das Paket günstiger ist
    const apply = ok && save > 0;
    const restCalc = bestSingles(rest);
    const allCalc = bestSingles([...zones, ...rest]);
    const lines: Line[] = apply
      ? [
          {
            id: pk!.id,
            name: `${pk!.name} (${zones.map((z) => z.name).join(', ')})`,
            price: pkgPrice,
            minutes: Math.max(pk!.minutes + Math.max(0, n - included) * pk!.extraMinutes, mins),
            priceLabel: null,
            single: false,
          },
          ...restCalc.lines,
        ]
      : allCalc.lines;
    // Zonen, die in einem Paket/einer Kombi stecken (in der Liste nicht einzeln angehakt)
    const inPkg = new Set(apply ? zones.map((z) => z.id) : []);
    const inKombi = new Set(apply ? restCalc.merged : allCalc.merged);
    return { lines, zones, pk, n, sum, pkgPrice, save, apply, ok, need, included, inPkg, inKombi };
  }
  const selectedList = () => pricing().lines;
  const totalMinutes = () => selectedList().reduce((a, s) => a + s.minutes, 0);
  const subtotal = () => selectedList().reduce((a, s) => a + (s.price ?? 0), 0);
  // Rabatt pro Behandlung auf ganze Franken gerundet (identisch mit den Preisen auf der Landingpage)
  const discount = () => {
    if (!state.code || state.returning) return 0;
    // Erstbesuch-Angebote sind bereits vergünstigt und nicht kombinierbar
    return selectedList().reduce((a, s) => a + (s.price && !s.single ? s.price - Math.round((s.price * (100 - data.promo.percent)) / 100) : 0), 0);
  };

  // ——— Schritt 1: Auswahl ———
  const groupInputs = $$<HTMLInputElement>('[data-group-input]');
  const serviceInputs = $$<HTMLInputElement>('[data-service]');

  function setGroup(g: 'frauen' | 'maenner') {
    if (state.group !== g) state.selected.clear();
    state.group = g;
    groupInputs.forEach((i) => (i.checked = i.value === g));
    $$('[data-group-panel]').forEach((p) => (p.hidden = p.dataset.groupPanel !== g));
    $('[data-who]').hidden = true;
    $('[data-seg]').hidden = false;
    syncChecks();
  }
  $$<HTMLButtonElement>('[data-who-pick]').forEach((b) => b.addEventListener('click', () => setGroup(b.dataset.whoPick as 'frauen' | 'maenner')));

  // Ganzkörper wählen: klassische Zonen voreinstellen, danach frei anpassen
  const pickDialog = () => root.querySelector<HTMLDialogElement>(`[data-group-panel="${state.group}"] [data-pkg-pick]`);
  let pickFocus = '';
  function openPick() {
    const d = pickDialog();
    renderPicker();
    if (d && !d.open) d.showModal();
  }
  function removePkg() {
    [...state.selected].forEach((x) => eligible(byId.get(x)!) && state.selected.delete(x));
    state.time = null;
    state.slot = null;
    pickDialog()?.close();
    syncChecks();
  }
  // Karte: Paket mit klassischen Zonen wählen – oder, wenn schon gewählt, bearbeiten
  function applyPkg(id: string) {
    const pk = data.packages.find((x) => x.id === id);
    if (!pk) return;
    const pr = pricing();
    if (!(pr.apply && pr.pk?.id === id)) {
      [...state.selected].forEach((x) => {
        const v = byId.get(x);
        if (!v || v.single || eligible(v)) state.selected.delete(x);
      });
      pk.preset.forEach((x) => addSvc(x));
      state.time = null;
      state.slot = null;
      syncChecks();
    }
    openPick();
  }
  $$<HTMLButtonElement>('[data-pkg]').forEach((b) => b.addEventListener('click', () => applyPkg(b.dataset.pkg!)));

  function syncChecks() {
    const pr = pricing();
    const pkgName = pr.pk?.name ?? 'Ganzkörper';
    serviceInputs.forEach((i) => {
      const id = i.value;
      const row = i.closest<HTMLElement>('.opt');
      let checked = state.selected.has(id);
      let cover = '';
      if (EXPANDS[id]) checked = EXPANDS[id].every((x) => pr.inKombi.has(x));
      else if (pr.inPkg.has(id)) {
        checked = false;
        cover = `in ${pkgName}`;
      } else if (pr.inKombi.has(id)) {
        checked = false;
        cover = 'in Kombi';
      }
      i.checked = checked;
      if (row) {
        if (cover) row.dataset.cover = cover;
        else delete row.dataset.cover;
      }
    });
    $('[data-zones-note]').hidden = true;
    render();
  }

  groupInputs.forEach((i) => i.addEventListener('change', () => setGroup(i.value as 'frauen' | 'maenner')));
  serviceInputs.forEach((i) =>
    i.addEventListener('change', () => {
      const id = i.value;
      const svc = byId.get(id)!;
      const pr = pricing();
      if (pr.inPkg.has(id)) {
        // steckt im Paket: dort bearbeiten
        syncChecks();
        openPick();
        return;
      }
      if (EXPANDS[id]) {
        if (EXPANDS[id].every((x) => pr.inKombi.has(x))) EXPANDS[id].forEach((x) => state.selected.delete(x));
        else {
          [...state.selected].forEach((x) => byId.get(x)?.single && state.selected.delete(x));
          addSvc(id);
        }
      } else if (pr.inKombi.has(id)) {
        state.selected.delete(id);
      } else if (i.checked) {
        if (svc.single) state.selected.clear();
        else [...state.selected].forEach((x) => byId.get(x)?.single && state.selected.delete(x));
        addSvc(id);
      } else {
        state.selected.delete(id);
      }
      // Zeitslot ggf. neu wählen, wenn sich die Dauer ändert
      state.time = null;
      state.slot = null;
      syncChecks();
    }),
  );

  // ——— Schritt 2: Kalender (freie Zeiten live aus meetergo) ———
  type StaffPick = { id: string; hostId: string; meetingTypeId: string; adj: boolean };
  type Slot = { time: string; iso: string; staff: StaffPick[]; adj: boolean };
  const DURATIONS = [...data.booking.durations].sort((x, y) => x - y);
  const avail = { key: '', status: 'idle' as 'idle' | 'loading' | 'ready' | 'error', days: new Map<string, Slot[]>() };
  let showAll = false;
  let slotNotice = '';

  const ymd = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  const isConsultOnly = () => selectedList().length > 0 && selectedList().every((s) => s.id === 'beratungsgespraech');
  // Dauer der gewählten Zonen → nächstlängerer buchbarer Termintyp
  const bookingLength = () => DURATIONS.find((d) => d >= Math.max(totalMinutes(), 15)) ?? null;
  const typeKey = () => (isConsultOnly() ? 'consult' : String(bookingLength() ?? 'too-long'));
  const contactLinks = () =>
    `<a href="${data.contact.whatsapp}" target="_blank" rel="noopener">WhatsApp</a> oder <a href="${data.contact.phoneHref}">${data.contact.phone}</a>`;

  async function loadAvailability(force = false) {
    const key = typeKey();
    if (!force && avail.key === key && avail.status !== 'error') return renderStep2();
    avail.key = key;
    avail.days = new Map();
    showAll = false;
    if (key === 'too-long') {
      avail.status = 'ready';
      return renderStep2();
    }
    avail.status = 'loading';
    renderStep2();
    const end = new Date(maxDate);
    end.setDate(end.getDate() + 1);
    try {
      const perStaff = await Promise.all(
        data.booking.staff.map(async (st) => {
          const meetingTypeId = key === 'consult' ? st.consult : st.treatment;
          const q = new URLSearchParams({
            meetingTypeId,
            hostIds: st.hostId,
            start: ymd(today),
            end: ymd(end),
            timezone: data.booking.timeZone,
          });
          if (key !== 'consult') q.set('meetingDuration', key);
          const res = await fetch(`${data.booking.api}/booking-availability?${q}`);
          if (!res.ok) throw new Error(`slots ${res.status}`);
          const json = await res.json();
          const days: Record<string, string[]> = {};
          for (const d of (json.dates ?? []) as { date: string; spots: { startTime: string }[] }[]) {
            days[d.date] = (d.spots ?? []).map((x) => x.startTime);
          }
          return { st, meetingTypeId, days };
        }),
      );
      if (avail.key !== key) return; // Auswahl hat sich inzwischen geändert
      const step = data.booking.slotStep;
      const merged = new Map<string, Map<string, Slot>>();
      for (const { st, meetingTypeId, days } of perStaff) {
        for (const [day, list] of Object.entries(days)) {
          const mins = new Set(list.map((x) => toMin(x.slice(11, 16))));
          const byTime = merged.get(day) ?? new Map<string, Slot>();
          for (const iso of list) {
            const t = iso.slice(11, 16);
            const m = toMin(t);
            // Anschlusszeit: direkt nach einem Termin/Öffnungsbeginn oder direkt vor dem nächsten Termin/Feierabend
            const adj = !mins.has(m - step) || !mins.has(m + step);
            const slot = byTime.get(t) ?? { time: t, iso, staff: [], adj: false };
            slot.staff.push({ id: st.id, hostId: st.hostId, meetingTypeId, adj });
            slot.adj = slot.adj || adj;
            byTime.set(t, slot);
          }
          merged.set(day, byTime);
        }
      }
      for (const [day, byTime] of merged) {
        const list = [...byTime.values()].sort((x, y) => toMin(x.time) - toMin(y.time));
        if (list.length) avail.days.set(day, list);
      }
      avail.status = 'ready';
      if (state.date && !avail.days.has(ymd(state.date))) {
        state.date = null;
        state.time = null;
        state.slot = null;
      }
      if (!state.date) {
        const first = [...avail.days.keys()].sort()[0];
        if (first) {
          const [y, mo] = first.split('-').map(Number);
          state.month = new Date(y, mo - 1, 1);
        }
      }
    } catch (e) {
      if (avail.key === key) avail.status = 'error';
    }
    renderStep2();
  }

  function renderStep2() {
    renderCalendar();
    renderSlots();
    render();
  }

  function renderCalendar() {
    const m = state.month;
    $('[data-cal-title]').textContent = m.toLocaleDateString('de-CH', { month: 'long', year: 'numeric' });
    $<HTMLButtonElement>('[data-cal-prev]').disabled = m <= new Date(today.getFullYear(), today.getMonth(), 1);
    $<HTMLButtonElement>('[data-cal-next]').disabled = new Date(m.getFullYear(), m.getMonth() + 1, 1) > maxDate;

    const grid = $('[data-cal-days]');
    grid.classList.toggle('is-loading', avail.status === 'loading');
    grid.innerHTML = '';
    const offset = (new Date(m.getFullYear(), m.getMonth(), 1).getDay() + 6) % 7;
    for (let i = 0; i < offset; i++) grid.append(document.createElement('span'));
    const days = new Date(m.getFullYear(), m.getMonth() + 1, 0).getDate();
    for (let n = 1; n <= days; n++) {
      const d = new Date(m.getFullYear(), m.getMonth(), n);
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = String(n);
      b.setAttribute('aria-label', d.toLocaleDateString('de-CH', { weekday: 'long', day: 'numeric', month: 'long' }));
      const has = avail.status === 'ready' && (avail.days.get(ymd(d))?.length ?? 0) > 0;
      b.disabled = !has;
      if (has) b.classList.add('has-slots');
      if (state.date && d.getTime() === state.date.getTime()) b.setAttribute('aria-pressed', 'true');
      b.addEventListener('click', () => {
        state.date = d;
        state.time = null;
        state.slot = null;
        showAll = false;
        slotNotice = '';
        renderStep2();
      });
      grid.append(b);
    }
  }

  function renderSlots() {
    const box = $('[data-slots]');
    const notice = slotNotice ? `<p class="slot-notice">${slotNotice}</p>` : '';
    if (avail.status === 'loading' || avail.status === 'idle') {
      box.innerHTML = `${notice}<p class="muted slots-empty">Freie Termine werden geladen …</p>`;
      return;
    }
    if (avail.status === 'error') {
      box.innerHTML = `<p class="slots-empty">Die freien Termine konnten gerade nicht geladen werden. Bitte versuch es gleich nochmals – oder melde dich per ${contactLinks()}.</p><button type="button" class="btn btn-ghost" data-retry>Nochmals laden</button>`;
      box.querySelector('[data-retry]')!.addEventListener('click', () => loadAvailability(true));
      return;
    }
    if (avail.key === 'too-long') {
      box.innerHTML = `<p class="slots-empty">Für diese Kombination (${fmtDur(totalMinutes())}) planen wir deinen Termin gerne persönlich mit dir – kurz per ${contactLinks()}.</p>`;
      return;
    }
    if (!avail.days.size) {
      box.innerHTML = `<p class="slots-empty">In den nächsten ${Math.round(data.booking.windowDays / 7)} Wochen ist online leider nichts mehr frei. Melde dich per ${contactLinks()} – wir finden einen Termin.</p>`;
      return;
    }
    if (!state.date) {
      box.innerHTML = `${notice}<p class="muted slots-empty">Wähle einen Tag aus – alle markierten Tage haben freie Termine.</p>`;
      return;
    }
    const all = avail.days.get(ymd(state.date)) ?? [];
    // Tag noch ganz frei (durchgehend ab Öffnung)? Dann jede volle Stunde anbieten, damit Termine um feste Zeiten wachsen.
    const op = data.opening.find((o) => o.days.includes(state.date!.getDay()));
    const stepMin = data.booking.slotStep;
    const contiguous = all.every((x, k) => k === 0 || toMin(x.time) - toMin(all[k - 1].time) === stepMin);
    const emptyDay = !!op && all.length > 0 && all[0].time === op.open && contiguous;
    const recommended = emptyDay
      ? all.filter((x, k) => k === 0 || k === all.length - 1 || toMin(x.time) % 60 === 0)
      : all.filter((x) => x.adj);
    const list = showAll ? all : recommended;
    const title = state.date.toLocaleDateString('de-CH', { weekday: 'long', day: 'numeric', month: 'long' });
    const parts: [string, (m: number) => boolean][] = [
      ['Vormittag', (m) => m < 12 * 60],
      ['Nachmittag', (m) => m >= 12 * 60 && m < 17 * 60],
      ['Abend', (m) => m >= 17 * 60],
    ];
    box.innerHTML = `${notice}<h3>${title}</h3>`;
    for (const [label, test] of parts) {
      const group = list.filter((x) => test(toMin(x.time)));
      if (!group.length) continue;
      const g = document.createElement('div');
      g.className = 'slot-group';
      g.innerHTML = `<p class="slot-label">${label}</p><div class="slot-grid"></div>`;
      const grid = g.querySelector('.slot-grid')!;
      group.forEach((x) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = x.time;
        if (state.time === x.time) b.setAttribute('aria-pressed', 'true');
        b.addEventListener('click', () => {
          state.time = x.time;
          state.slot = x;
          slotNotice = '';
          renderSlots();
          render();
        });
        grid.append(b);
      });
      box.append(g);
    }
    const more = all.length - recommended.length;
    if (more > 0) {
      const t = document.createElement('button');
      t.type = 'button';
      t.className = 'slot-more';
      t.textContent = showAll ? 'Nur empfohlene Zeiten zeigen' : `Weitere Uhrzeiten anzeigen (${more})`;
      t.addEventListener('click', () => {
        showAll = !showAll;
        renderSlots();
      });
      box.append(t);
    }
  }

  $('[data-cal-prev]').addEventListener('click', () => {
    state.month = new Date(state.month.getFullYear(), state.month.getMonth() - 1, 1);
    renderCalendar();
  });
  $('[data-cal-next]').addEventListener('click', () => {
    state.month = new Date(state.month.getFullYear(), state.month.getMonth() + 1, 1);
    renderCalendar();
  });

  // ——— Schritt 3: Formular ———
  const form = $<HTMLFormElement>('[data-details]');
  form.addEventListener('input', () => {
    state.returning = (form.elements.namedItem('neukunde') as RadioNodeList).value === 'nein';
    form.querySelectorAll('.is-invalid').forEach((el) => {
      if ((el as HTMLInputElement).checkValidity()) el.classList.remove('is-invalid');
    });
    render();
  });

  function validateForm() {
    let ok = true;
    form.querySelectorAll<HTMLInputElement>('input[required]').forEach((el) => {
      const valid = el.checkValidity();
      if (!valid && el.type !== 'radio') el.classList.add('is-invalid');
      if (!valid) ok = false;
    });
    $('[data-form-error]').hidden = ok;
    return ok;
  }

  // ——— Schritt 4: Code ———
  const codeInput = $<HTMLInputElement>('[data-code-input]');
  const codeMsg = $('[data-code-msg]');

  function applyCode(raw: string, silent = false) {
    const c = raw.trim().toUpperCase();
    codeMsg.className = 'code-msg';
    if (!c) {
      state.code = null;
      codeMsg.textContent = '';
    } else if (c === data.promo.code) {
      state.code = c;
      codeInput.value = c;
      if (state.returning) {
        codeMsg.classList.add('err');
        codeMsg.textContent = `Der Code ${c} gilt nur für deinen ersten Besuch bei uns.`;
      } else {
        codeMsg.classList.add('ok');
        codeMsg.textContent = `Code ${c} eingelöst – ${data.promo.percent} % Neukundenrabatt.`;
      }
    } else if (!silent) {
      state.code = null;
      codeMsg.classList.add('err');
      codeMsg.textContent = 'Dieser Code ist leider nicht gültig.';
    }
    render();
  }

  $('[data-code-apply]').addEventListener('click', () => applyCode(codeInput.value));
  codeInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      applyCode(codeInput.value);
    }
  });

  // ——— Navigation ———
  const canProceed = () => {
    if (state.step === 1) return state.selected.size > 0;
    if (state.step === 2) return !!state.date && !!state.time && !!state.slot;
    if (state.step === 3) return true; // Validierung beim Klick
    if (state.step === 4) return !submitting;
    return false;
  };
  let submitting = false;
  const nextLabel = () =>
    state.step === 4 ? (submitting ? 'Wird gebucht …' : 'Termin verbindlich buchen') : (['', 'Weiter zum Termin', 'Weiter zu den Angaben', 'Weiter zur Übersicht'][state.step] ?? 'Weiter');
  // Was ist jetzt zu tun – und was kommt danach?
  const todo = () => {
    if (state.step === 1) return state.selected.size ? 'Zonen gewählt – weiter zum Termin.' : 'Wähle eine oder mehrere Zonen.';
    if (state.step === 2) return state.time ? 'Termin gewählt – weiter zu deinen Angaben.' : state.date ? 'Wähle eine Uhrzeit.' : 'Wähle einen Tag.';
    if (state.step === 3) return 'Trag deine Kontaktdaten ein.';
    if (state.step === 4) return 'Prüfe alles und buche verbindlich.';
    return '';
  };

  function go(step: number) {
    state.step = step;
    $$('[data-step]').forEach((s) => (s.hidden = Number(s.dataset.step) !== step));
    $$('[data-stepper]').forEach((li) => {
      const n = Number(li.dataset.stepper);
      li.classList.toggle('is-current', n === step);
      li.classList.toggle('is-done', n < step);
    });
    $('[data-back]').hidden = step === 1 || step === 5;
    $('[data-nav]').hidden = step === 5;
    $('[data-m-sum]').hidden = step === 5;
    $('[data-summary]').hidden = step === 5;
    $<HTMLElement>('[data-progress]').style.setProperty('--p', `${Math.min(step, 4) * 25}%`);
    root.querySelector('.b-grid')?.classList.toggle('is-done', step === 5);
    if (step === 2) {
      if (state.date) state.month = new Date(state.date.getFullYear(), state.date.getMonth(), 1);
      loadAvailability();
    }
    if (step === 4) renderReview();
    render();
    // nur so weit scrollen, dass der neue Schritt direkt unter der Fortschrittsleiste beginnt
    const el = root.querySelector<HTMLElement>(`[data-step="${step}"]`);
    const bar = root.querySelector<HTMLElement>('[data-steps-bar]');
    if (el) {
      const top = el.getBoundingClientRect().top - (bar?.offsetHeight ?? 0) - 20;
      if (top < 0 || top > window.innerHeight * 0.45) window.scrollBy({ top, behavior: 'smooth' });
    }
  }

  function next() {
    if (!canProceed()) return;
    if (state.step === 3 && !validateForm()) return;
    if (state.step === 4) return submit();
    go(state.step + 1);
  }

  $('[data-next]').addEventListener('click', next);
  $('[data-m-next]').addEventListener('click', next);
  $('[data-next-sum]').addEventListener('click', next);
  root.querySelectorAll<HTMLButtonElement>('[data-quick]').forEach((b) =>
    b.addEventListener('click', () => {
      const input = root.querySelector<HTMLInputElement>(`[data-group-panel="${state.group}"] input[data-service][value="${b.dataset.quick}"]`);
      if (!input || input.disabled) return;
      input.checked = !input.checked;
      input.dispatchEvent(new Event('change', { bubbles: true }));
    }),
  );
  $('[data-back]').addEventListener('click', () => go(Math.max(1, state.step - 1)));

  // „Zum Kalender hinzufügen“ nach der Buchung: Apple (.ics-Datei), Google, Outlook
  function setupAddToCalendar(manage: { reschedule: string; cancel: string } | null) {
    if (!state.slot) return;
    const start = new Date(state.slot.iso);
    const mins = isConsultOnly() ? 25 : bookingLength() ?? totalMinutes();
    const end = new Date(start.getTime() + mins * 60000);
    const title = `Eloure · ${selectedList().map((s) => s.name).join(' + ')}`;
    const details = manage
      ? `Dein Termin bei Eloure The Studio (${fmtDur(mins)}).\n\nTermin verschieben: ${manage.reschedule}\nTermin stornieren: ${manage.cancel}\n\nFragen? ${data.contact.phone}`
      : `Dein Termin bei Eloure The Studio (${fmtDur(mins)}). Verschieben oder stornieren: über den Link in deiner Bestätigungsmail oder unter ${data.contact.phone}.`;
    const loc = `Eloure The Studio, ${data.contact.address}`;
    const utc = (d: Date) => d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
    const esc = (t: string) => t.replace(/\\/g, '\\\\').replace(/[,;]/g, (c) => '\\' + c).replace(/\n/g, '\\n');
    const ics = [
      'BEGIN:VCALENDAR',
      'VERSION:2.0',
      'PRODID:-//Eloure The Studio//Termin//DE',
      'METHOD:PUBLISH',
      'BEGIN:VEVENT',
      `UID:${utc(start)}-${Math.random().toString(36).slice(2)}@eloure`,
      `DTSTAMP:${utc(new Date())}`,
      `DTSTART:${utc(start)}`,
      `DTEND:${utc(end)}`,
      `SUMMARY:${esc(title)}`,
      `DESCRIPTION:${esc(details)}`,
      `LOCATION:${esc(loc)}`,
      'BEGIN:VALARM',
      'ACTION:DISPLAY',
      'DESCRIPTION:Termin bei Eloure',
      'TRIGGER:-PT2H',
      'END:VALARM',
      'END:VEVENT',
      'END:VCALENDAR',
    ].join('\r\n');
    $<HTMLAnchorElement>('[data-cal-apple]').href = 'data:text/calendar;charset=utf-8,' + encodeURIComponent(ics);
    $<HTMLAnchorElement>('[data-cal-google]').href =
      'https://calendar.google.com/calendar/render?' +
      new URLSearchParams({ action: 'TEMPLATE', text: title, dates: `${utc(start)}/${utc(end)}`, details, location: loc });
    $<HTMLAnchorElement>('[data-cal-outlook]').href =
      'https://outlook.live.com/calendar/0/deeplink/compose?' +
      new URLSearchParams({ path: '/calendar/action/compose', rru: 'addevent', subject: title, startdt: start.toISOString(), enddt: end.toISOString(), body: details, location: loc });
    $('[data-add-cal]').hidden = false;
  }

  function whenText() {
    if (!state.date || !state.time) return '';
    return `${state.date.toLocaleDateString('de-CH', { weekday: 'short', day: 'numeric', month: 'long' })} · ${state.time} Uhr`;
  }

  function renderReview() {
    const f = new FormData(form);
    const rows: [string, string, number][] = [
      ['Behandlung', selectedList().map((s) => s.name).join(', '), 1],
      ['Termin', whenText(), 2],
      ['Name', `${f.get('vorname')} ${f.get('nachname')}`, 3],
      ['Kontakt', `${f.get('email')} · ${f.get('telefon')}`, 3],
    ];
    const zonenField = $<HTMLTextAreaElement>('textarea[name=zonen]');
    const zonen = zonenField.closest('[hidden]') ? '' : zonenField.value.trim();
    if (zonen) rows.splice(1, 0, ['Zonen', zonen, 1]);
    const msg = String(f.get('nachricht') ?? '').trim();
    if (msg) rows.push(['Nachricht', msg, 3]);
    const dl = $('[data-review]');
    dl.innerHTML = '';
    rows.forEach(([k, v, step]) => {
      const div = document.createElement('div');
      const dt = document.createElement('dt');
      dt.textContent = k;
      const dd = document.createElement('dd');
      dd.textContent = v;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = 'Ändern';
      btn.addEventListener('click', () => go(step));
      div.append(dt, dd, btn);
      dl.append(div);
    });
  }

  // Kurzbezeichnung für den Kalendertitel, z. B. „Achseln + Bikini / Intim · 30 Min.“
  function treatmentTitle() {
    const names = selectedList().map((s) => s.name);
    const len = isConsultOnly() ? 25 : bookingLength() ?? totalMinutes();
    return `${names.join(' + ')} · ${fmtDur(len)}`;
  }

  // Angaben zum Termin – erscheinen im Kalendereintrag und in der Bestätigung der Kundin,
  // deshalb nur neutrale Angaben (keine Gesundheitsdaten).
  function bookingNotes(f: FormData) {
    const list = selectedList();
    const zonenField = $<HTMLTextAreaElement>('textarea[name=zonen]');
    const zonen = zonenField.closest('[hidden]') ? '' : zonenField.value.trim();
    const disc = discount();
    const total = round05(subtotal() - disc);
    const len = isConsultOnly() ? null : bookingLength();
    const msg = String(f.get('nachricht') ?? '').trim();
    const dur = `${fmtDur(totalMinutes())}${len && len !== totalMinutes() ? `, eingeplant ${fmtDur(len)}` : ''}`;
    // meetergo sortiert die Angaben nach Länge der Bezeichnung – daher bewusst gewählte Längen:
    // Behandlung (10) → Preis vor Ort (13) → Erster Besuch? (14) → Deine Nachricht (15)
    const notes: Record<string, string> = {
      Behandlung: `${list.map((s) => s.name).join(' + ')}${zonen ? ` (Zonen: ${zonen})` : ''} · ${dur}`,
      'Preis vor Ort': `${fmtChf(total)}${disc > 0 ? ` (Code ${state.code}, –${fmtChf(round05(disc))})` : ''}`,
      'Erster Besuch?': state.returning ? 'Nein' : 'Ja',
    };
    if (msg) notes['Deine Nachricht'] = msg;
    return notes;
  }

  const submitError = $('[data-submit-error]');
  function showSubmitError(html: string) {
    submitError.innerHTML = html;
    submitError.hidden = false;
  }

  async function submit() {
    if (submitting || !state.slot) return;
    const f = new FormData(form);
    const slot = state.slot;
    const pick = slot.staff.find((x) => x.adj) ?? slot.staff[0];
    const name = `${String(f.get('vorname') ?? '').trim()} ${String(f.get('nachname') ?? '').trim()}`.trim();
    submitError.hidden = true;
    submitting = true;
    render();
    const phone = String(f.get('telefon') ?? '').trim();
    const notes = bookingNotes(f);
    try {
      const body: Record<string, unknown> = {
        meetingTypeId: pick.meetingTypeId,
        hostIds: [pick.hostId],
        start: slot.iso,
        attendee: {
          firstname: String(f.get('vorname') ?? '').trim(),
          lastname: String(f.get('nachname') ?? '').trim(),
          email: String(f.get('email') ?? '').trim(),
          phone,
          language: 'de',
          timezone: data.booking.timeZone,
          receiveReminders: true,
          dataPolicyAccepted: true,
          notes,
        },
        sourceChannel: 'embed',
        referrerUrl: location.href.slice(0, 2048),
        icsTitle: `${name} · ${treatmentTitle()}`.slice(0, 200),
      };
      if (!isConsultOnly()) body.duration = bookingLength();
      const post = (b: Record<string, unknown>) =>
        fetch(`${data.booking.api}/booking`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(b),
        });
      let res = await post(body);
      // Falls meetergo eigene Kalendertitel ablehnt: mit dem Standardtitel nochmals buchen
      if (res.status === 400) {
        const peek = JSON.stringify(await res.clone().json().catch(() => ({})));
        if (/ics/i.test(peek)) {
          delete body.icsTitle;
          res = await post(body);
        }
      }
      const json = await res.json().catch(() => ({}));
      if (!res.ok) throw { status: res.status, ...json };

      const first = String(f.get('vorname') ?? '').trim();
      $('[data-success-title]').textContent = `Danke${first ? ', ' + first : ''}! Dein Termin steht.`;
      $('[data-success-text]').textContent = `Wir haben deinen Termin am ${whenText()} fest für dich eingeplant. Du bekommst gleich eine Bestätigung per E-Mail – mit allen Infos und einem Link, falls du verschieben oder absagen musst. ${
        isConsultOnly() ? 'Bring einfach all deine Fragen mit.' : 'Wir freuen uns auf dich!'
      }`;
      // Links zum Verschieben/Stornieren (meetergo-Verwaltungsseite der Buchung)
      let manage: { reschedule: string; cancel: string } | null = null;
      if (json.appointmentId && json.secret) {
        const q = `id=${encodeURIComponent(json.appointmentId)}&secret=${encodeURIComponent(json.secret)}`;
        manage = { reschedule: `https://cal.meetergo.com/reschedule?${q}`, cancel: `https://cal.meetergo.com/cancel?${q}` };
        $<HTMLAnchorElement>('[data-manage-reschedule]').href = manage.reschedule;
        $<HTMLAnchorElement>('[data-manage-cancel]').href = manage.cancel;
        $('[data-manage]').hidden = false;
      }
      setupAddToCalendar(manage);
      go(5);
    } catch (err: any) {
      const raw = err?.message ?? err?.error?.message ?? '';
      const msg = Array.isArray(raw) ? raw.join(' ') : String(raw);
      if (/email/i.test(msg)) {
        showSubmitError('Diese E-Mail-Adresse scheint keine Post empfangen zu können. Bitte prüfe sie <button type="button" class="link-btn" data-fix-mail>hier</button>.');
        submitError.querySelector('[data-fix-mail]')?.addEventListener('click', () => go(3));
      } else if (err?.status === 409 || /avail|slot|booked|conflict|taken|occupied|no_available/i.test(msg)) {
        slotNotice = 'Dieser Termin wurde gerade vergeben. Bitte wähle eine andere Uhrzeit.';
        state.time = null;
        state.slot = null;
        avail.key = '';
        go(2);
      } else {
        showSubmitError(`Das hat leider nicht geklappt. Bitte versuch es nochmals – oder melde dich per ${contactLinks()}.`);
      }
    } finally {
      submitting = false;
      render();
    }
  }

  // Ganzkörper: Zonenwahl im Overlay-Fenster
  function renderPicker() {
    const box = pickDialog();
    $$<HTMLDialogElement>('[data-pkg-pick]').forEach((b) => b !== box && b.open && b.close());
    if (!box) return;
    const pr = pricing();
    const zonesOf = (f: (x: Svc) => boolean) => data.services.filter((x) => x.group === state.group && eligible(x) && f(x));
    const chip = (x: Svc) =>
      `<button type="button" class="chip" data-z="${x.id}" aria-pressed="${state.selected.has(x.id)}"><span>${x.name}</span><small>${fmtChf(x.price ?? 0)}</small></button>`;
    const women = state.group === 'frauen';
    const name = pr.pk?.name ?? 'Ganzkörper';
    let status = '';
    if (pr.need) status = `Wähle noch ${pr.need} ${pr.need === 1 ? 'Zone' : 'Zonen'}.`;
    else if (pr.apply)
      status = `<b>${fmtChf(pr.pkgPrice)}</b> statt einzeln <s>${fmtChf(pr.sum)}</s> <span class="pick-save">– ${fmtChf(pr.save)}</span>`;
    else status = `Einzeln günstiger (${fmtChf(pr.sum)}) – wir berechnen die Zonen einzeln.`;
    const extra = pr.pk?.extra ?? pkgsFor()[0]?.extra ?? 10;
    box.innerHTML = `
      <button type="button" class="pick-x" data-pick-close aria-label="Schliessen"><span aria-hidden="true"></span></button>
      <div class="pick-head">
        <p class="pick-t">${name}</p>
        <p class="pick-r">3 Zonen inklusive · jede weitere + ${fmtChf(extra)}</p>
      </div>
      ${women ? `<p class="pick-l">Beine <span>optional</span></p><div class="chips">${zonesOf((x) => isLeg(x.id)).map(chip).join('')}</div>` : ''}
      <p class="pick-l">${women ? 'Weitere Zonen' : 'Deine Zonen'} <span>${pr.n} von 3 gewählt</span></p>
      <div class="chips">${zonesOf((x) => !women || !isLeg(x.id)).map(chip).join('')}</div>
      <div class="pick-foot">
        <p class="pick-status">${status}</p>
        <div class="pick-actions">
          <button type="button" class="pick-remove" data-pick-remove>Paket entfernen</button>
          <button type="button" class="btn btn-primary" data-pick-close>Übernehmen</button>
        </div>
      </div>`;
    box.querySelectorAll<HTMLButtonElement>('[data-z]').forEach((b) =>
      b.addEventListener('click', () => {
        const id = b.dataset.z!;
        pickFocus = id;
        if (state.selected.has(id)) state.selected.delete(id);
        else {
          // Beine: nur eine Variante
          if (isLeg(id)) [LEG_FULL, ...LEG_HALF].forEach((x) => state.selected.delete(x));
          addSvc(id);
        }
        state.time = null;
        state.slot = null;
        syncChecks();
      }),
    );
    box.querySelectorAll('[data-pick-close]').forEach((b) => b.addEventListener('click', () => box.close()));
    box.querySelector('[data-pick-remove]')?.addEventListener('click', removePkg);
    if (pickFocus) {
      box.querySelector<HTMLButtonElement>(`[data-z="${pickFocus}"]`)?.focus();
      pickFocus = '';
    }
  }
  // Klick auf den abgedunkelten Hintergrund schliesst das Fenster
  $$<HTMLDialogElement>('[data-pkg-pick]').forEach((d) =>
    d.addEventListener('click', (e) => {
      if (e.target === d) d.close();
    }),
  );

  // Hinweis-Leiste: Paket ist aktiv (automatisch oder gewählt) – mit Bearbeiten
  function renderPkgBox() {
    renderPicker();
    const box = root.querySelector<HTMLElement>(`[data-group-panel="${state.group}"] [data-pkg-box]`);
    $$('[data-pkg-box]').forEach((b) => b !== box && (b.hidden = true));
    if (!box) return;
    const pr = pricing();
    let html = '';
    if (pr.apply) {
      html = `<p class="pkg-t">${pr.pk!.name} · ${pr.n} Zonen <span class="pkg-save">– ${fmtChf(pr.save)}</span></p>
        <p class="pkg-x"><b>${fmtChf(pr.pkgPrice)}</b> statt einzeln ${fmtChf(pr.sum)} – automatisch zusammengefasst.</p>
        <button type="button" class="pkg-btn" data-pkg-edit>Bearbeiten</button>`;
    }
    box.hidden = !html;
    box.innerHTML = html;
    box.querySelector('[data-pkg-edit]')?.addEventListener('click', openPick);
    // Paket-Karten: gewählte Zonen anzeigen
    root.querySelectorAll<HTMLElement>('[data-pkg-inc]').forEach((el) => {
      const on = pr.apply && pr.pk?.id === el.dataset.pkgInc;
      el.hidden = !on;
      el.innerHTML = on ? `${pr.zones.map((z) => z.name).join(' · ')} <span class="qk-edit">Bearbeiten</span>` : '';
    });
  }

  // ——— Zusammenfassung ———
  function render() {
    const list = selectedList();
    const ul = $('[data-sum-list]');
    ul.innerHTML = '';
    if (!list.length) ul.innerHTML = '<li class="sum-empty">Noch nichts ausgewählt.</li>';
    list.forEach((s) => {
      const li = document.createElement('li');
      li.innerHTML = `<span></span><span>${s.priceLabel ?? (s.price === null ? 'kostenlos' : fmtChf(s.price))}</span>`;
      li.firstElementChild!.textContent = s.name;
      ul.append(li);
    });

    const when = $('[data-sum-when]');
    when.hidden = !whenText();
    when.querySelector('span')!.textContent = whenText();

    $('[data-sum-duration]').textContent = list.length ? fmtDur(totalMinutes()) : '–';
    const disc = discount();
    $('[data-sum-discount]').hidden = disc <= 0;
    $('[data-sum-discount-label]').textContent = `Code ${state.code ?? ''} (–${data.promo.percent} %)`;
    $('[data-sum-discount-value]').textContent = `– ${fmtChf(round05(disc))}`;
    const total = round05(subtotal() - disc);
    $('[data-sum-total]').textContent = fmtChf(total);

    $('[data-m-total]').textContent = list.length ? fmtChf(total) : 'CHF 0';
    $('[data-m-count]').textContent = canProceed()
      ? list.length
        ? `${list.length} ${list.length === 1 ? 'Behandlung' : 'Behandlungen'} · ${fmtDur(totalMinutes())}`
        : ''
      : todo();
    $('[data-todo]').textContent = todo();
    $('[data-hint]').textContent = canProceed() ? '' : todo();
    $('[data-sum-hint]').textContent = canProceed() ? '' : todo();

    const enabled = canProceed();
    $<HTMLButtonElement>('[data-next]').disabled = !enabled;
    $<HTMLButtonElement>('[data-m-next]').disabled = !enabled;
    $<HTMLButtonElement>('[data-next-sum]').disabled = !enabled;
    $('[data-sum-cta-label]').textContent = nextLabel();
    renderPkgBox();
    const pr = pricing();
    root.querySelectorAll<HTMLElement>('[data-pkg]').forEach((b) => {
      const on = pr.apply && pr.pk?.id === b.dataset.pkg;
      b.classList.toggle('is-on', on);
      b.setAttribute('aria-pressed', String(on));
    });
    root.querySelectorAll<HTMLElement>('[data-quick]').forEach((b) => {
      const box = root.querySelector<HTMLInputElement>(`[data-group-panel="${state.group}"] input[data-service][value="${b.dataset.quick}"]`);
      const on = !!box?.checked;
      b.classList.toggle('is-on', on);
      b.setAttribute('aria-pressed', String(on));
    });
    $('[data-next-label]').textContent = nextLabel();
    $('[data-m-next-label]').textContent = state.step === 4 ? (submitting ? 'Wird gebucht …' : 'Verbindlich buchen') : 'Weiter';
  }

  // ——— Start: URL-Parameter (?behandlung=…&gruppe=…&code=…) ———
  const params = new URLSearchParams(location.search);
  const pre = params.get('behandlung');
  const preSvc = pre ? byId.get(pre) : undefined;
  const preGroup = (params.get('gruppe') as 'frauen' | 'maenner' | null) ?? (preSvc && !preSvc.single ? preSvc.group : null);
  if (preGroup) setGroup(preGroup === 'maenner' ? 'maenner' : 'frauen');
  else if (preSvc?.single) setGroup('frauen');
  if (preSvc && pkgIdSet.has(preSvc.id)) applyPkg(preSvc.id);
  else if (preSvc && (preSvc.group === state.group || preSvc.id === 'beratungsgespraech')) {
    addSvc(preSvc.id);
    syncChecks();
    requestAnimationFrame(() => {
      const el = root.querySelector(`[data-group-panel="${state.group}"] input[value="${preSvc.id}"]`);
      el?.closest('label')?.scrollIntoView({ block: 'center' });
    });
  }
  const preCode = params.get('code');
  if (preCode) applyCode(preCode, true);
  render();
</script>
