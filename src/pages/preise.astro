---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PriceTable from '../components/PriceTable.astro';
import Lines from '../components/Lines.astro';
import TrustBand from '../components/TrustBand.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import imgHero from '../assets/shoot/laser-achsel-quer.jpg';
import imgCost from '../assets/shoot/caro-telefon.jpg';
---

<Base
  headerTone="paper"
  title="Preise Laserhaarentfernung Amriswil | Eloure The Studio"
  description="Alle Preise für Laserhaarentfernung bei Eloure in Amriswil: über 30 Zonen für Frauen und Männer, ab CHF 29 pro Sitzung. Bezahlt wird erst vor Ort."
>
  <PageHero
    title={['Preise, die', 'du verstehst.']}
    sub="Ab CHF 29 pro Zone"
    image={imgHero}
    alt="Laserbehandlung an der Achsel"
    lead="Transparent, pro Sitzung und ohne Vorauszahlung. Wähle deine Zone – um den Rest kümmern wir uns."
  >
    <div class="btn-row">
      <a class="btn btn-primary" href="#liste">Zur Preisliste<span class="arrow"><Icon name="arrow" size={16} /></span></a>
      <a class="btn btn-ghost" href="/termin">Direkt buchen</a>
    </div>
  </PageHero>

  <section class="list bg-sand" id="liste">
    <div class="wrap">
      <div class="list-head">
        <Lines lines={['Alle Zonen.', 'Ein Blick.']} />
        <ul class="facts reveal">
          <li><Icon name="check" size={18} /> Bezahlt wird vor Ort: bar, TWINT oder Karte</li>
          <li><Icon name="check" size={18} /> Beratung bei jedem ersten Termin inklusive</li>
          <li><Icon name="check" size={18} /> Kostenlos absagen bis {site.cancellationHours} Std. vorher</li>
        </ul>
      </div>
      <div class="reveal"><PriceTable /></div>
    </div>
  </section>

  <TrustBand />

  <section class="cost bg-mocha">
    <div class="cost-img" data-anim="img">
      <Image src={imgCost} alt="Caro am Telefon in der Studio-Lounge" widths={[700, 1100, 1600]} sizes="(min-width: 1000px) 50vw, 100vw" />
    </div>
    <div class="cost-content">
      <Lines lines={['Und was kostet', 'es insgesamt?']} class="cost-title" />
      <p class="lead reveal">Eine ehrliche Frage, die eine ehrliche Antwort verdient.</p>
      <p class="reveal">
        Damit möglichst alle Haarwurzeln in ihrer Wachstumsphase erwischt werden, braucht es mehrere Sitzungen. Wie viele, ist <strong>sehr individuell</strong> – Zone, Haardichte, Hauttyp und Hormone spielen mit. Am Anfang liegen meist 4 bis 8
        Wochen dazwischen, später werden die Abstände grösser.
      </p>
      <p class="reveal">
        Du bezahlst immer nur die Sitzung, die du gerade machst. Bei deinem ersten Termin schauen wir uns deine Haut und Haare
        genau an und sagen dir, womit du rechnen kannst. Ohne Schönreden.
      </p>
      <div class="btn-row reveal">
        <a class="btn btn-primary" href="/termin">Termin buchen<span class="arrow"><Icon name="arrow" size={16} /></span></a>
        <a class="btn btn-ghost" href="/termin?behandlung=beratungsgespraech">Kostenlos beraten lassen</a>
      </div>
    </div>
  </section>

  <CtaFinal title="Deine Zone gefunden? Dann lass uns starten." />
</Base>

<style>
  .list {
    padding-block: var(--section);
  }

  .list-head {
    display: grid;
    gap: 24px 64px;
    margin-bottom: 56px;
  }

  @media (min-width: 960px) {
    .list-head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }

  .list-head :global(h2) {
    margin: 0;
  }

  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    font-weight: 600;
  }

  .facts li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .facts :global(svg) {
    color: var(--mocha);
  }

  .cost {
    display: grid;
  }

  @media (min-width: 1000px) {
    .cost {
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
    }
  }

  .cost-img {
    position: relative;
    overflow: hidden;
    min-height: 90vw;
  }

  @media (min-width: 1000px) {
    .cost-img {
      min-height: 0;
    }
  }

  .cost-img :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cost-content {
    position: relative;
    z-index: 2;
    padding: var(--section) var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 780px;
  }

  .cost-content :global(.cost-title) {
    font-size: clamp(2.4rem, 4.6vw, 4.6rem);
    line-height: 0.95;
  }

  .cost-content p:not(.lead) {
    color: rgba(246, 241, 234, 0.82);
  }

  .cost-content .btn-row {
    margin-top: 24px;
  }
</style>
