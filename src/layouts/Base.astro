---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import PaletteSwitcher from '../components/PaletteSwitcher.astro';
import { SHOW_PALETTE_SWITCHER } from '../data/site';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** full = normale Website, minimal = Landingpage ohne Navigation */
  variant?: 'full' | 'minimal';
  noindex?: boolean;
  mobileBar?: boolean;
  /** Ziel der Haupt-CTA im Header / Mobile-Bar */
  ctaHref?: string;
  ctaLabel?: string;
  mobileNote?: string;
  schema?: Record<string, unknown>[];
  ogImage?: string;
}

const {
  title,
  description,
  variant = 'full',
  noindex = false,
  mobileBar = true,
  ctaHref = '/termin',
  ctaLabel = 'Termin buchen',
  mobileNote,
  schema = [],
  ogImage = '/og-image.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'BeautySalon',
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  telephone: '+41 76 529 71 29',
  email: site.email,
  image: new URL('/og-image.jpg', site.url).href,
  priceRange: 'CHF 29 – 249',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.zip,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  openingHoursSpecification: site.openingSpec.map((o) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: o.days.map((d) => ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][d]),
    opens: o.open,
    closes: o.close,
  })),
  sameAs: [site.instagram],
};
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f3eee8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify([localBusiness, ...schema])} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
        try {
          var q = new URLSearchParams(location.search).get('farbe');
          if (q) localStorage.setItem('eloure-palette', q);
          var p = q || localStorage.getItem('eloure-palette');
          if (p) d.setAttribute('data-palette', p);
        } catch (e) {}
      })();
    </script>
  </head>
  <body data-variant={variant}>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <Header variant={variant} ctaHref={ctaHref} ctaLabel={ctaLabel} />
    <main id="main">
      <slot />
    </main>
    <Footer variant={variant} />
    {mobileBar && <MobileBar href={ctaHref} label={ctaLabel} note={mobileNote} />}

    {SHOW_PALETTE_SWITCHER && <PaletteSwitcher />}
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
